                                   rdfs:label "Module quality testing equipment"@en .


###  https://w3id.org/polymat/MolarPermeability-Diffusion
pmat:MolarPermeability-Diffusion rdf:type owl:Class ;
                                 rdfs:subClassOf pmat:Permeability-Diffusion ;
                                 rdfs:comment """The permeability multiplied by density and divided by molar mass of the permeating fluid

P* = V･d･rho / (A･t･p･M) = D･rho / (p･M)

P* = molar permeability (diffusion)
V = Volume of the permeate [m³]
rho = density of the permeate [kg/m³]
M = molar mass of the permeate [kg/mol]
d = thickness of the membrane [m]
A = area of the membrane [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit is mol/(m･s･atm)"""@en ;
                                 rdfs:label "Molar permeability (diffusion)"@en .


###  https://w3id.org/gelmat/MolarRatio
gmat:MolarRatio rdf:type owl:Class ;
                rdfs:subClassOf gmat:ProcessParameter ;
                rdfs:comment "The ratio of moles between two or more substances in a reaction or mixture. Used to describe stoichiometric proportions of reagents (e.g., H2O/MTMS = 59.75)."@en ;
                skos:definition "A process parameter representing the ratio of amounts of substance (moles) between two or more substances in a reaction or mixture"@en ;
                rdfs:label "Molar Ratio"@en .


###  https://w3id.org/gelmat/Mold
gmat:Mold rdf:type owl:Class ;
          rdfs:subClassOf pmat:Apparatus ;
          rdfs:comment "A container or form that gives shape to liquid or semi-solid material during gelation, curing, or solidification processes"@en ;
          skos:definition "An apparatus consisting of a container or form that imparts shape to a liquid or semi-solid material during gelation, curing, or solidification"@en ;
          rdfs:label "Mold"@en .


###  https://w3id.org/polymat/MolecularWeightCutOff
