###  https://w3id.org/gelmat/OrganicAerogel
gmat:OrganicAerogel rdf:type owl:Class ;
                   rdfs:subClassOf gmat:Aerogel ;
                   rdfs:comment "An aerogel in which the solid framework is composed of organic macromolecules (polymers, biopolymers) rather than inorganic networks or elemental carbon"@en ;
                   skos:definition "An aerogel whose solid framework consists of an organic polymer network (e.g. resorcinol-formaldehyde, polyimide, cellulose). Distinguished from carbon aerogels by retention of organic functional groups and from inorganic aerogels by the absence of metal oxide or silica frameworks"@en ;
                   rdfs:label "Organic aerogel"@en .


###  https://w3id.org/gelmat/CarbonAerogel
gmat:CarbonAerogel rdf:type owl:Class ;
                    rdfs:subClassOf gmat:Aerogel ;
                    owl:disjointWith gmat:OrganicAerogel ;
                    rdfs:comment "An aerogel with a purely carbonaceous framework, produced by pyrolysis of an organic precursor aerogel (e.g. resorcinol-formaldehyde) above 700 °C in inert atmosphere. The pyrolysis destroys all organic bonds, leaving an electrically conductive elemental carbon network. Not subclassed under OrganicAerogel — carbon aerogels contain no C-H bonds"@en ;
                    rdfs:label "Carbon aerogel"@en ;
                    skos:definition "A pyrolysed aerogel whose solid framework consists of elemental (sp² or sp³ hybridised) carbon, distinct from organic aerogels which retain organic polymer backbones"@en ;
                    skos:altLabel "Activated carbon aerogel"@en .


