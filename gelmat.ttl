###  https://w3id.org/polymat/RandomCopolymer
pmat:RandomCopolymer rdf:type owl:Class ;
                     rdfs:subClassOf pmat:Copolymer ;
                     rdfs:comment """A copolymer consisting of macromolecules in which the probability of finding a given monomeric unit at any given site in the chain is independent of the nature of the adjacent units
(https://goldbook.iupac.org/terms/view/R05126)"""@en ;
                     rdfs:label "Random copolymer"@en .


###  https://w3id.org/gelmat/RatioValue
gmat:RatioValue rdf:type owl:Class ;
                rdfs:subClassOf om:Measure ;
                rdfs:comment "A value node representing the numerical proportion between substances in a ratio; a dimensionless om:Measure pointed to by a ProcessParameter quality, not a quality itself. Single-valued ratios carry om:hasNumericalValue (xsd:double, unit om:one; two-part ratio a:b = a/b) for numeric querying, alongside the display string in gmat:hasRatioString. Multi-component ratios (e.g. '1:10:4:4') are represented by the string only."@en ;
                skos:definition "A dimensionless measure holding the numerical proportion between substances in a ratio, referenced by a process parameter quality"@en ;
                rdfs:label "Ratio Value"@en .


###  https://w3id.org/gelmat/RawData
gmat:RawData rdf:type owl:Class ;
            rdfs:subClassOf pmat:DataType ;
            rdfs:comment "Original, unprocessed data collected directly from experiment"@en ;
            skos:definition "Original, unprocessed data collected directly from an experiment"@en ;
            rdfs:label "Raw data"@en .


