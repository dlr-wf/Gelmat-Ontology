                  skos:definition "A drying method in which the pore solvent is frozen and removed by sublimation under reduced pressure, yielding cryogels"@en ;
                  rdfs:label "Freeze drying"@en ;
                  skos:altLabel "Lyophilization"@en .


###  https://w3id.org/gelmat/FreezeDryer
gmat:FreezeDryer rdf:type owl:Class ;
                  rdfs:subClassOf gmat:Dryer ;
                  rdfs:comment "Equipment that removes liquid from a frozen material by sublimation under reduced pressure (lyophilisation). Used in aerogel production via the freeze-drying route to obtain cryogels"@en ;
                  skos:definition "A dryer that removes frozen solvent from a material by sublimation under reduced pressure (lyophilisation)"@en ;
                  rdfs:label "Freeze Dryer"@en .


