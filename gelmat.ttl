            rdfs:comment "Starch, the amylose/amylopectin polysaccharide, gelatinised and retrograded to form starch bio-aerogels"@en ;
            rdfs:label "Starch"@en ;
            skos:definition "The plant storage polysaccharide of amylose and amylopectin, used as a bio-aerogel precursor"@en .


