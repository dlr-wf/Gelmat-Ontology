#################################################################
#    General axioms
#################################################################

# The five aerogel defect kinds are mutually exclusive: an individual defect
# state cannot be, e.g., both a crack and residual solvent.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:Cracking
                gmat:IncompleteDrying
                gmat:NonuniformStructure
                gmat:Opacity
                gmat:StructuralCollapse
              )
] .

# --- Sibling disjointness ---------------------------------------------------
# Disjointness is asserted only where sibling classes are genuinely mutually
# exclusive at the individual level. Deliberately NOT declared disjoint:
#  - role-like substance classes (Acid/PHAdjuster, BaseCatalyst/AmmoniumCompound,
#    Surfactant, Crosslinker, ...): one substance routinely plays several roles;
#  - gelation pathways (PhaseSeparation/SolGelPolymerisation): a single gelation
#    can proceed by both simultaneously (e.g. MTMS systems);
#  - PorosityMeasurement vs SpecificSurfaceAreaMeasurement: one BET run yields both;
#  - elastic moduli (YoungsModulus/CompressiveModulus): coincide for isotropic
#    materials;
#  - CompositeAerogel/HybridAerogel vs the material-family classes: composites
#    and hybrids intentionally cross-cut them.

# Physical gel forms: a gel sample at a given time is exactly one of these.
# Cryogel (freeze-dried) and Ambigel (ambient-dried, structure preserved)
# are further mutually exclusive dried-gel forms.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:Aerogel gmat:Ambigel gmat:Cryogel gmat:WetGel gmat:Xerogel )
] .

# Drying methods: one drying process instance follows one route.
# (HighTemperatureSupercriticalDrying is a subclass of SupercriticalDrying
# and therefore not listed here.)
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:AmbientPressureDrying gmat:FreezeDrying
                gmat:MicrowaveDrying gmat:SupercriticalDrying
                gmat:VacuumDrying )
] .

# Density kinds: one density value is of exactly one kind.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:BulkDensity gmat:SkeletalDensity gmat:TapDensity )
] .

# Supercritical media.
gmat:SupercriticalCO2 owl:disjointWith gmat:SupercriticalEthanol .

# Sample geometries.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:Beads gmat:DogBone gmat:Monolith gmat:Slabs )
] .

# Process parameter kinds.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:ExchangeRatio gmat:MolarRatio gmat:PHCondition
                gmat:PressureProfile gmat:StirringRate
                gmat:TemperatureProfile gmat:VolumeRatio )
] .

# Dryer equipment kinds.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:FreezeDryer gmat:Oven gmat:SupercriticalDryer )
] .

# Pump kinds.
gmat:SyringePump owl:disjointWith gmat:VacuumPump .

# Chemically distinct solvents / solvent families.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:Acetone gmat:Alcohol gmat:Water )
] .
gmat:Ethanol owl:disjointWith gmat:Methanol .

# Synthesis step kinds: a whole synthesis is not one of its steps, and the
# named steps are distinct process kinds.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:AerogelSynthesis gmat:Aging gmat:Gelation gmat:SolFormation )
] .
gmat:Pressurization owl:disjointWith gmat:Depressurization .

# Characterisation methods (clearly distinct measurement kinds only; see
# exclusions above for BET/SSA overlap).
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:CompressionTesting gmat:HydrophobicityTesting
                gmat:OpticalTransmittanceMeasurement
                gmat:SkeletalDensityMeasurement gmat:ThermalConductivityTesting )
] .
gmat:BETAnalysis owl:disjointWith gmat:BJHAnalysis .

# Quantity kinds: an individual quantity instance is of exactly one kind.
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( gmat:Density gmat:SurfaceArea gmat:PoreVolume
                gmat:ParticleSize gmat:Duration gmat:VolumetricFlowRate )
] .
gmat:MassFractalDimension owl:disjointWith gmat:SurfaceFractalDimension .

# Material families.
gmat:InorganicAerogel owl:disjointWith gmat:OrganicAerogel .


