###  https://w3id.org/gelmat/IncompleteDrying
gmat:IncompleteDrying rdf:type owl:Class ;
                      rdfs:subClassOf gmat:AerogelDefect ;
                      rdfs:comment "The defect state of residual solvent or moisture remaining in the aerogel pores after the drying step. Denotes the persisting residual-liquid feature of the material, not the (incomplete) drying process itself."@en ;
                      skos:definition "An aerogel defect consisting of residual solvent or moisture remaining in the pore network of the material after drying"@en ;
                      rdfs:label "Residual solvent"@en ;
                      skos:altLabel "Incomplete drying"@en .


