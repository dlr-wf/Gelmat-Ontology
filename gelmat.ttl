pmat:Request rdf:type owl:Class ;
             rdfs:subClassOf pmat:Document ;
             rdfs:comment "A document providing information about procedure (e.g. laboratory test) being requested for"@en ;
             rdfs:label "Request"@en .


###  https://w3id.org/polymat/Result
pmat:Result rdf:type owl:Class ;
            rdfs:subClassOf pmat:DataType ;
            rdfs:comment "The outcome or findings obtained from conducting an experiment, representing data, measurements, observations or conclusions from the laboratory procedure"@en ;
            rdfs:label "Result"@en .


###  https://w3id.org/polymat/Retentate
pmat:Retentate rdf:type owl:Class ;
               rdfs:subClassOf pmat:Role ;
               rdfs:comment "The substance that is retained by and not passing through a membrane"@en ;
               rdfs:label "Retentate"@en .


###  https://w3id.org/polymat/Retention
pmat:Retention rdf:type owl:Class ;
               rdfs:subClassOf pmat:MembranePerformanceForLiquids ;
               rdfs:comment "Withholding a substance by a membrane"@en ;
               rdfs:label "Retention"@en .


###  https://w3id.org/polymat/RetentionTestSetup
pmat:RetentionTestSetup rdf:type owl:Class ;
                        rdfs:subClassOf pmat:LiquidPermeationEquipment ;
                        rdfs:comment "Equipment to measure the retention of a certain molecule when permeating in a solution through a membrane"@en ;
                        rdfs:label "Retention test setup"@en .


###  https://w3id.org/polymat/Role
pmat:Role rdf:type owl:Class ;
          rdfs:subClassOf obo:BFO_0000023 ,
                          prov:Role ;
          rdfs:comment "A purpose that something has or a function that something plays in a particular situation, under certain conditions, within a given process etc."@en ;
          rdfs:label "Role"@en .


###  https://w3id.org/polymat/Room
pmat:Room rdf:type owl:Class ;
          rdfs:subClassOf pmat:PhysicalLocation ;
          rdfs:comment "A portion of space inside of a building separated by walls or partitions from other parts"@en ;
          rdfs:label "Room"@en .


###  https://w3id.org/polymat/RuntimeEnvironment
pmat:RuntimeEnvironment rdf:type owl:Class ;
                        rdfs:subClassOf pmat:Software ;
                        rdfs:comment "A piece of software that is designed to run other software"@en ;
                        rdfs:label "Runtime environment"@en .


###  https://w3id.org/polymat/SRMPPolymerisation
pmat:SRMPPolymerisation rdf:type owl:Class ;
                        rdfs:subClassOf pmat:RadicalPolymerisation ;
                        rdfs:comment """A radical polymerisation method used to synthesize polymers with narrow molecular weight distributions and reactive end groups on each polymer chain; astabilized radical (e.g., TEMPO) is applied to control the molecular weight
(https://de.wikipedia.org/wiki/Stable_Free_Radical_Polymerization) (https://en.wikipedia.org/wiki/Radical_polymerization)"""@en ;
                        rdfs:label "Stable radical-mediated polymerisation"@en ;
                        skos:altLabel "SRMP polymerisation"@en ,
                                      "Stable-free-radical-mediated  (SFRP) polymerisation"@en .


###  https://w3id.org/polymat/Sample
pmat:Sample rdf:type owl:Class ;
            rdfs:subClassOf pmat:Substance ;
            rdfs:comment "A small subset or portion of an object used to represent the whole of it"@en ;
            rdfs:label "Sample"@en .


###  https://w3id.org/polymat/SamplePreparation
pmat:SamplePreparation rdf:type owl:Class ;
                       rdfs:subClassOf pmat:Method ;
                       rdfs:comment "An action of creating a sample or getting it ready for some procedure"@en ;
                       rdfs:label "Sample preparation"@en .


###  https://w3id.org/polymat/ScanningElectronMicroscope
pmat:ScanningElectronMicroscope rdf:type owl:Class ;
                                rdfs:subClassOf pmat:Microscope ;
                                rdfs:comment """A piece of equipment which is used to produce an enlarged image of a specimen by scanning a finely focused (<10 nm diameter) electron beam with an acceleration voltage of 50–150 kV across the specimen under vacuum and measuring the interaction of the electrons with the specimen
(http://purl.obolibrary.org/obo/CHMO_0000941)"""@en ,
                                             """An electron microscope that scans the surface of a sample with a beam of electrons and detects the interaction of the electrons with the atoms on the surface to produce a topographical image of the sample
(http://purl.obolibrary.org/obo/NCIT_C78814)"""@en ;
                                rdfs:label "Scanning electron microscope"@en ;
                                skos:altLabel "SEM"@en .


###  https://w3id.org/polymat/SecondaryElectronDetector
pmat:SecondaryElectronDetector rdf:type owl:Class ;
                               rdfs:subClassOf pmat:Instrument ;
                               rdfs:comment "An instrument that absorbs and amplifies secondary electrons in an electron microscope"@en ;
                               rdfs:label "Secondary electron detector"@en .


###  https://w3id.org/polymat/SecureData
pmat:SecureData rdf:type owl:Class ;
                rdfs:subClassOf pmat:DataType ;
                rdfs:comment "Data with sensitive or confidential content that needs to be protected from unauthorised access, loss, or alteration"@en ;
                rdfs:label "Secure data"@en .


###  https://w3id.org/polymat/Selectivity
pmat:Selectivity rdf:type owl:Class ;
                 rdfs:subClassOf pmat:MembranePerformanceForGases ;
                 rdfs:comment """The ratio of permeability of the relevant substances for a membrane, for example, in a binary gas separation it is the permeability ratio of two gases.
(https://en.wikipedia.org/wiki/Membrane_gas_separation#:~:text=The%20selectivity%20of%20a%20membrane,two%20gases%20in%20binary%20separation)"""@en ;
                 rdfs:label "Selectivity"@en .


###  https://w3id.org/gelmat/SilicaAerogel
gmat:SilicaAerogel rdf:type owl:Class ;
                    rdfs:subClassOf gmat:InorganicAerogel ;                    owl:disjointWith gmat:OrganosilicaAerogel ;

                    rdfs:comment "An aerogel with a pure silicon dioxide (SiO₂) backbone, typically produced from tetraethoxysilane (TEOS) or tetramethylorthosilicate (TMOS) via the sol-gel process followed by supercritical drying"@en ;
                    rdfs:label "Silica aerogel"@en ;
                    skos:definition "An inorganic aerogel in which the solid network consists predominantly of amorphous SiO₂, giving low density (0.003–0.35 g/cm³), high surface area (> 500 m²/g), and low thermal conductivity"@en ;
                    skos:altLabel "SiO₂ aerogel"@en ;
                    skos:closeMatch <http://emmo.info/emmo#EMMO_4207e895> .


###  https://w3id.org/gelmat/SiliconAlkoxidePrecursor
gmat:SiliconAlkoxidePrecursor rdf:type owl:Class ;
                              rdfs:subClassOf gmat:OrganosiliconCompound ,
                                              gmat:SilicaPrecursor ;
                              rdfs:comment "A subclass of organosilicon compounds with silicon bound to alkoxy groups (Si–OR); commonly employed as sol–gel precursors for silica networks"@en ;
                              skos:definition "A silicon compound bearing hydrolysable alkoxy groups (Si-OR), employed as a sol-gel precursor for silica or organosilica networks"@en ;
                              rdfs:label "Silicon alkoxide precursor"@en .


###  https://w3id.org/gelmat/MTMS
gmat:MTMS rdf:type owl:Class ;
          rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
          pmat:hasCASNr "1185-55-3" ;
          pmat:hasIUPACName "trimethoxy(methyl)silane" ;
          pmat:hasAcronym "MTMS" ;
          rdfs:comment "Trimethoxymethylsilane (MTMS, CAS 1185-55-3): an organosilica precursor bearing one methyl group, used to produce hydrophobic methylsilica (organosilica) aerogels via the sol-gel route"@en ;
          rdfs:label "Trimethoxymethylsilane"@en ;
          skos:altLabel "MTMS"@en ,
                        "Methyltrimethoxysilane"@en ;
          skos:definition "A silicon alkoxide precursor with one Si–CH₃ group and three Si–OCH₃ groups, yielding aerogel networks with pendant methyl groups that confer hydrophobicity"@en .


###  https://w3id.org/gelmat/SkeletalDensityMeasurement
gmat:SkeletalDensityMeasurement rdf:type owl:Class ;
                                rdfs:subClassOf pmat:Analysis ;
                                rdfs:comment "Measurement of true density of solid material in aerogel, typically using helium pycnometry"@en ;
                                skos:definition "An analysis that determines the density of the solid skeleton of a porous material, typically by helium pycnometry"@en ;
                                rdfs:label "Skeletal density measurement"@en .


###  https://w3id.org/gelmat/Slabs
gmat:Slabs rdf:type owl:Class ;
           rdfs:subClassOf gmat:Geometry ;
           rdfs:comment "A flat, thick piece of material, typically rectangular in shape, often used for thermal conductivity measurements."@en ;
           skos:definition "A sample geometry consisting of a flat, thick, typically rectangular piece, often used for thermal conductivity measurements"@en ;
           rdfs:label "Slab"@en .


###  https://w3id.org/polymat/Software
pmat:Software rdf:type owl:Class ;
              rdfs:subClassOf prov:Entity ,
                              pmat:Object ;
              rdfs:comment "A set of instructions, data or programs used by a computer"@en ;
              rdfs:label "Software"@en .


###  https://w3id.org/gelmat/Sol
gmat:Sol rdf:type owl:Class ;
         rdfs:subClassOf pmat:Substance ;
         rdfs:comment "A colloidal suspension of solid particles in a liquid, formed during the initial stage of sol-gel synthesis before gelation occurs"@en ;
         skos:definition "A colloidal suspension of solid particles dispersed in a liquid, constituting the initial stage of sol-gel synthesis prior to gelation"@en ;
         rdfs:label "Sol"@en .


###  https://w3id.org/gelmat/SolGelPolymerisation
gmat:SolGelPolymerisation rdf:type owl:Class ;
                            rdfs:subClassOf gmat:GelationPathway ;
                            rdfs:comment "A gelation pathway involving the polymerization of precursors via sol-gel chemistry"@en ;
                            skos:definition "A gelation pathway in which the network forms by polymerisation of precursors via hydrolysis and condensation reactions"@en ;
                            rdfs:label "Sol-gel polymerisation"@en .


###  https://w3id.org/gelmat/SolFormation
gmat:SolFormation rdf:type owl:Class ;
                  rdfs:subClassOf gmat:CreationProcess ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000051 ;
                                    owl:someValuesFrom gmat:Hydrolysis
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000051 ;
                                    owl:someValuesFrom gmat:Condensation
                                  ] ;
                  rdfs:comment "Process of creating a colloidal suspension (sol) by mixing precursors, solvents, and catalysts before gelation. Comprises hydrolysis of alkoxide groups and condensation of silanol intermediates"@en ;
                  skos:definition "The first stage of sol-gel synthesis in which precursor molecules undergo hydrolysis and initial condensation to form a stable colloidal suspension (sol) of nanoscale particles or oligomers in a solvent"@en ;
                  rdfs:label "Sol formation"@en .
gmat:SolFormation gmat:hasStepOrder "1"^^xsd:positiveInteger .


###  https://w3id.org/polymat/Solubility
pmat:Solubility rdf:type owl:Class ;
                rdfs:subClassOf om:Quantity ;
                rdfs:comment """The ability of a substance, the solute, to form a solution with another substance, the solvent
(https://en.wikipedia.org/wiki/Solubility)"""@en ;
                rdfs:label "Solubility"@en .


###  https://w3id.org/polymat/Solute
pmat:Solute rdf:type owl:Class ;
            rdfs:subClassOf pmat:Role ;
            rdfs:comment "A solid or liquid that is dissolved homogeneously in a liquid"@en ;
            rdfs:label "Solute"@en .


###  https://w3id.org/polymat/Solvent
pmat:Solvent rdf:type owl:Class ;
             rdfs:subClassOf pmat:Role ;
             rdfs:comment "A liquid (including water and ionic liquids) that is able to dissolve a solid or another liquid"@en ;
             rdfs:label "Solvent"@en ;
             skos:altLabel "Organic solvent"@en .




###  https://w3id.org/gelmat/Silanol
gmat:Silanol rdf:type owl:Class ;
             rdfs:subClassOf obo:CHEBI_24431 ;
             rdfs:comment "A silicon hydroxide species (Si-OH) formed as an intermediate during hydrolysis of silicon alkoxide precursors. Silanols undergo condensation to form siloxane (Si-O-Si) bonds and build the gel network"@en ;
             rdfs:label "Silanol"@en ;
             skos:definition "An intermediate species containing a silicon-bound hydroxyl group (Si-OH), the key reactive monomer formed by hydrolysis of silicon alkoxides in sol-gel processing"@en .


###  https://w3id.org/gelmat/SilylationAgent
gmat:SilylationAgent rdf:type owl:Class ;
                     rdfs:subClassOf obo:CHEBI_24431 ;
                     rdfs:comment "A reactive organosilicon compound used to replace silanol surface groups with alkylsilyl groups, rendering the gel surface hydrophobic. Applied during surface modification before ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SilylationAgentRole]"@en ;
                     skos:definition "A reactive organosilicon compound that replaces surface silanol groups with alkylsilyl groups, rendering a gel surface hydrophobic"@en ;
                     rdfs:label "Silylation agent"@en ;
                     skos:altLabel "Silylating agent"@en .


###  https://w3id.org/gelmat/Trimethylchlorosilane
gmat:Trimethylchlorosilane rdf:type owl:Class ;
                           rdfs:subClassOf gmat:SilylationAgent ;
                           pmat:hasCASNr "75-77-4" ;
                           pmat:hasIUPACName "chloro(trimethyl)silane" ;
                           pmat:hasAcronym "TMCS" ;
                           rdfs:comment "Trimethylchlorosilane (TMCS, CAS 75-77-4): a reactive chlorosilane that reacts with surface silanol groups to introduce hydrophobic trimethylsilyl groups, enabling ambient pressure drying"@en ;
                 skos:closeMatch <https://pubchem.ncbi.nlm.nih.gov/compound/11636> ;
                 rdfs:comment "PubChem CID 11636 (trimethylchlorosilane, CAS 75-77-4)"@en ;
                           rdfs:label "Trimethylchlorosilane"@en ;
                           skos:altLabel "TMCS"@en ,
                                         "Chlorotrimethylsilane"@en ;
                           skos:definition "A chlorosilane silylating agent that converts hydrophilic surface silanols to hydrophobic trimethylsilyl groups, enabling ambient pressure drying without pore collapse"@en .


###  https://w3id.org/gelmat/Hexamethyldisilazane
gmat:Hexamethyldisilazane rdf:type owl:Class ;
                          rdfs:subClassOf gmat:SilylationAgent ;
                          pmat:hasCASNr "999-97-3" ;
                          pmat:hasIUPACName "N-trimethylsilyl-1,1,1-trimethylsilanamine" ;
                          pmat:hasAcronym "HMDS" ;
                          rdfs:comment "Hexamethyldisilazane (HMDS, CAS 999-97-3): a milder silylating agent than TMCS that reacts with silanol groups producing trimethylsilyl-protected surfaces and ammonia as by-product"@en ;
                          skos:definition "A mild silylating agent (CAS 999-97-3) that reacts with surface silanol groups to install trimethylsilyl groups with ammonia as by-product; preferred over TMCS where HCl by-product is undesirable"@en ;
                 skos:closeMatch <https://pubchem.ncbi.nlm.nih.gov/compound/68519> ;
                 rdfs:comment "PubChem CID 68519 (hexamethyldisilazane, CAS 999-97-3)"@en ;
                          rdfs:label "Hexamethyldisilazane"@en ;
                          skos:altLabel "HMDS"@en ,
                                        "Bis(trimethylsilyl)amine"@en .


###  https://w3id.org/gelmat/SolventExchange
gmat:SolventExchange rdf:type owl:Class ;
                     rdfs:subClassOf pmat:SamplePreparation ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty gmat:transformsGel ;
                                       owl:someValuesFrom gmat:WetGel
                                     ] ;
                     rdfs:comment "Process of systematically replacing pore liquid in wet gel structures (hydrogels or alcogels) with a more volatile or supercritical-compatible solvent through multiple washing cycles"@en ;
                     skos:definition "A sample preparation step in which the pore liquid of a wet gel is progressively replaced by a target solvent (e.g. ethanol, acetone, or liquid CO2) to remove water and residual reactants before drying"@en ;
                     rdfs:label "Solvent exchange"@en .
gmat:SolventExchange gmat:hasStepOrder "4"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/SpecificSurfaceAreaMeasurement
gmat:SpecificSurfaceAreaMeasurement rdf:type owl:Class ;
                                    rdfs:subClassOf pmat:Analysis ;
                                    rdfs:comment "Measurement of specific surface area of porous materials, typically performed using gas adsorption methods such as BET (Brunauer-Emmett-Teller) analysis"@en ;
                                    skos:definition "An analysis that determines the specific surface area of a porous material, typically by gas physisorption"@en ;
                                    rdfs:label "Specific surface area measurement"@en .


###  https://w3id.org/polymat/Specimen
pmat:Specimen rdf:type owl:Class ;
              rdfs:subClassOf pmat:Substance ;
              rdfs:comment "An individual object taken for study or analysis, representing a class of objects"@en ;
              rdfs:label "Specimen"@en .


###  https://w3id.org/polymat/Spectrometer
pmat:Spectrometer rdf:type owl:Class ;
                  rdfs:subClassOf pmat:Equipment ;
                  rdfs:comment """A piece of equipment used to measure a spectrum
(http://purl.obolibrary.org/obo/CHMO_0001234)"""@en ,
                               """A type of analytical equipment used to measure certain physical properties such as energy, mass and wavelength via the dispersion of radiant energy or particles into a spectrum
(http://purl.obolibrary.org/obo/NCIT_C62336)"""@en ,
                               """Scientific equipment used to separate and measure spectral components of a physical phenomenon; the primary application is the determination of chemical composition
(https://en.wikipedia.org/wiki/Spectrometer)"""@en ;
                  rdfs:label "Spectrometer"@en .


###  https://w3id.org/gelmat/StirringRate
gmat:StirringRate rdf:type owl:Class ;
                  rdfs:subClassOf gmat:ProcessParameter ;
                  rdfs:comment "Rotation speed of stirring mechanism during mixing, typically measured in RPM"@en ;
                  skos:definition "A process parameter representing the rotation speed of the stirring mechanism during mixing"@en ;
                  rdfs:label "Stirring rate"@en .


###  https://w3id.org/gelmat/StockSolution
gmat:StockSolution rdf:type owl:Class ;
                   rdfs:subClassOf pmat:Substance ;
                   rdfs:comment "A concentrated solution prepared in advance and stored for repeated use in synthesis procedures to ensure consistency across multiple experiments"@en ;
                   skos:definition "A concentrated solution of defined composition prepared in advance and stored for repeated use in synthesis procedures"@en ;
                   rdfs:label "Stock solution"@en .


###  https://w3id.org/polymat/Stress
pmat:Stress rdf:type owl:Class ;
            rdfs:subClassOf om:Quantity ;
            owl:equivalentClass om:Stress ;
            rdfs:comment """A measure of the forces acting on an object during deformation
(https://en.wikipedia.org/wiki/Stress_(mechanics))

Equivalent to om:Stress, which Gelmat declares locally as the parent of om:CompressiveStress and gmat:FlexuralStrength; the equivalence keeps the Polymat and OM stress hierarchies merged under one concept"""@en ;
            rdfs:label "Stress"@en .


###  https://w3id.org/gelmat/StructuralCollapse
gmat:StructuralCollapse rdf:type owl:Class ;
                        rdfs:subClassOf gmat:AerogelDefect ;
                        rdfs:comment "The defect state of a collapsed or densified aerogel network, typically caused by capillary forces during improper drying. Denotes the persisting collapsed-structure feature of the material, not the collapse event."@en ;
                        skos:definition "An aerogel defect consisting of a collapsed or densified region of the solid network in which the original porous structure is lost"@en ;
                        rdfs:label "Collapsed structure"@en ;
                        skos:altLabel "Structural collapse"@en .


###  https://w3id.org/polymat/Substance
pmat:Substance rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000040 ;
               rdfs:comment "A physical material with particular properties"@en ;
              skos:exactMatch <https://w3id.org/pmd/co/Material> ;
               rdfs:label "Substance"@en ;
               skos:altLabel "Compound"@en ,
                             "Matter"@en .


###  https://w3id.org/gelmat/SupercriticalCO2
gmat:SupercriticalCO2 rdf:type owl:Class ;
                      rdfs:subClassOf gmat:SupercriticalFluid ;
                      rdfs:comment "Carbon dioxide in supercritical state (above 31.1°C and 72.9 bar), commonly used for aerogel drying. The plain gas is modelled separately as gmat:CarbonDioxide; this class denotes the supercritical state of that substance"@en ;
                      skos:exactMatch obo:CHEBI_16526 ;
                      skos:definition "Carbon dioxide in the supercritical state, used as a low-surface-tension drying medium in supercritical drying of gels"@en ;
                      pmat:hasAcronym "scCO2" ;
                      rdfs:label "Supercritical CO2"@en .


###  https://w3id.org/gelmat/SupercriticalDryer
gmat:SupercriticalDryer rdf:type owl:Class ;
                        rdfs:subClassOf gmat:Dryer ;
                        rdfs:comment "Specialized equipment for supercritical drying that heats and pressurizes fluid (typically CO2) above its critical point to extract solvents from gel materials"@en ;
                        skos:definition "A dryer that heats and pressurises a fluid above its critical point to extract pore solvent from a gel without capillary stress"@en ;
                        rdfs:label "Supercritical dryer"@en ;
                        skos:altLabel "Autoclave"@en .


###  https://w3id.org/gelmat/SupercriticalDrying
gmat:SupercriticalDrying rdf:type owl:Class ;
                         rdfs:subClassOf pmat:Drying ;
                         rdfs:comment "Drying method using supercritical fluid (typically CO2) to remove solvent from porous materials while preserving the nanoscale structure by avoiding capillary forces"@en ;
                         skos:definition "A drying method in which the pore liquid is brought above its critical temperature and pressure before venting to gas phase, eliminating the liquid-vapour interface and thus capillary stress, preserving the aerogel network"@en ;
                        rdfs:label "Supercritical drying"@en .


###  https://w3id.org/gelmat/SupercriticalEthanol
gmat:SupercriticalEthanol rdf:type owl:Class ;
                          rdfs:subClassOf gmat:SupercriticalFluid ;
                          rdfs:comment "Ethanol in supercritical state (above 241°C and 61.4 bar), alternative to CO2 for aerogel drying"@en ;
                          skos:relatedMatch obo:CHEBI_16236 ;
                          skos:definition "Ethanol in the supercritical state, used as a high-temperature alternative drying medium in supercritical drying of gels"@en ;
                          rdfs:label "Supercritical ethanol"@en .


###  https://w3id.org/gelmat/SupercriticalFluid
gmat:SupercriticalFluid rdf:type owl:Class ;
                        rdfs:subClassOf pmat:Substance ;
                        rdfs:comment "A substance at temperature and pressure above its critical point, exhibiting properties between gas and liquid phases"@en ;
                        skos:definition "A substance held at a temperature and pressure above its critical point, exhibiting properties intermediate between those of a gas and a liquid"@en ;
                        rdfs:label "Supercritical fluid"@en .


###  https://w3id.org/gelmat/SurfaceModification
gmat:SurfaceModification rdf:type owl:Class ;
                         rdfs:subClassOf pmat:SamplePreparation ;
                         rdfs:comment "Chemical treatment to alter aerogel surface properties, such as hydrophobization or functionalization"@en ;
                         skos:definition "Chemical treatment of the internal pore surfaces of a wet gel to alter surface chemistry, typically to introduce hydrophobic groups that prevent capillary collapse during ambient pressure drying"@en ;
                       rdfs:label "Surface modification"@en .


###  https://w3id.org/gelmat/Surfactant
gmat:Surfactant rdf:type owl:Class ;
                rdfs:subClassOf obo:CHEBI_24431 ;
                rdfs:comment "A surface-active agent used to stabilize emulsions or modify interfacial properties in synthesis. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SurfactantRole]"@en ;
                skos:definition "A surface-active agent that lowers interfacial tension, used to stabilise emulsions or modify interfacial properties during synthesis"@en ;
                rdfs:label "Surfactant"@en .


###  https://w3id.org/gelmat/Water
gmat:Water rdf:type owl:Class ;
           rdfs:subClassOf obo:CHEBI_24431 ;
           rdfs:comment "Water (H2O), used as a reactant in hydrolysis reactions during sol-gel synthesis and as the liquid phase in hydrogels"@en ;
           skos:definition "The chemical substance H2O, serving as a reactant in hydrolysis reactions and as the pore liquid in hydrogels"@en ;
           rdfs:label "Water"@en .


###  https://w3id.org/gelmat/DeionizedWater
gmat:DeionizedWater rdf:type owl:Class ;
                    rdfs:subClassOf gmat:Water ;
                    rdfs:comment "Purified water with ions removed, used in aerogel synthesis to control reaction conditions and avoid contamination"@en ;
                    skos:definition "Water from which dissolved ions have been removed, used to control reaction conditions and avoid ionic contamination"@en ;
                    pmat:hasAcronym "DI water" ;
                    rdfs:label "Deionized water"@en .


###  https://w3id.org/gelmat/SyringePump
gmat:SyringePump rdf:type owl:Class ;
                 rdfs:subClassOf pmat:Pump ;
                 rdfs:comment "A precision fluid delivery device that uses a motor-driven plunger to dispense exact volumes at controlled flow rates. Used in aerogel synthesis for controlled addition of reagents or for supercritical fluid delivery"@en ;
                 skos:definition "A pump that dispenses precise fluid volumes at controlled flow rates by means of a motor-driven plunger"@en ;
                 rdfs:label "Syringe Pump"@en .


###  https://w3id.org/polymat/TargetConcentration
pmat:TargetConcentration rdf:type owl:Class ;
                         rdfs:subClassOf gmat:ProcessParameter ;
                         rdfs:comment "A designed or nominal concentration for a reagent in a synthesis, as distinct from the achieved concentration. Deviations arise from weighing or volumetric uncertainties"@en ;
                         rdfs:label "Target concentration"@en .


###  https://w3id.org/gelmat/TemperatureProfile
gmat:TemperatureProfile rdf:type owl:Class ;
                        rdfs:subClassOf gmat:ProcessParameter ;
                        rdfs:comment "Temperature conditions including set points, ramp rates, and hold times during a process. Use this class only for temperature programmes (ramps, multi-segment profiles); a single constant temperature value should be modelled as an om:Temperature instance linked to the process with pmat:isParameterOf"@en ;
                        skos:definition "A process parameter representing the temperature conditions of a process, including set points, ramp rates, and hold times"@en ;
                        rdfs:label "Temperature profile"@en .


###  https://w3id.org/gelmat/TemperatureRamping
gmat:TemperatureRamping rdf:type owl:Class ;
                        rdfs:subClassOf gmat:ThermalTreatment ;
                        rdfs:comment "Controlled heating or cooling process during synthesis or drying"@en ;
                        skos:definition "A creation process step in which temperature is increased or decreased at a controlled rate during synthesis or drying"@en ;
                        rdfs:label "Temperature ramping"@en .


###  https://w3id.org/polymat/TensileTest
pmat:TensileTest rdf:type owl:Class ;
                 rdfs:subClassOf pmat:Analysis ;
                 rdfs:comment """A standardized materials science and engineering method in which a solid sample is subjected to a controlled tension until failure; properties that are directly measured via a tensile test are ultimate tensile strength, breaking strength, maximum elongation, and reduction in area; from these measurements the following properties can also be determined: Young's modulus (modulus of elasticity), Poisson's ratio, yield strength, and strain-hardening characteristics
(https://en.wikipedia.org/wiki/Tensile_testing)"""@en ;
                 rdfs:label "Tensile test"@en .


###  https://w3id.org/polymat/TensileTestMachine
pmat:TensileTestMachine rdf:type owl:Class ;
                        rdfs:subClassOf pmat:MechanicalTestingEquipment ;
                        rdfs:comment """Equipment for carrying out standardized tensile tests on a solid sample to determine its mechanical properties
(https://en.wikipedia.org/wiki/Tensile_testing#Equipment)"""@en ;
                        rdfs:label "Universal testing machine"@en .


###  https://w3id.org/gelmat/TensileClamps
gmat:TensileClamps rdf:type owl:Class ;
                    rdfs:subClassOf pmat:Instrument ;
                    rdfs:comment "A tool specialized to securely hold a specimen while a pulling (tensile) force is applied."@en ;
                    skos:definition "An instrument that securely grips a specimen while a tensile force is applied"@en ;
                    rdfs:label "Tensile Clamps"@en .


