###  https://w3id.org/gelmat/Gel
gmat:Gel rdf:type owl:Class ;
         rdfs:subClassOf pmat:Substance ;
         rdfs:comment "A gel is a soft material entity consisting of a continuous solid network permeated by a liquid phase, exhibiting both solid-like and liquid-like properties"@en ;
         skos:definition "A nonfluid colloidal or polymer network that is expanded throughout its whole volume by a fluid, exhibiting both solid-like and liquid-like properties"@en ;
         rdfs:label "Gel"@en .


###  https://w3id.org/gelmat/Gelation
gmat:Gelation rdf:type owl:Class ;
              rdfs:subClassOf gmat:CreationProcess ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gmat:usesSubstance ;
                                owl:someValuesFrom pmat:Monomer
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gmat:usesSubstance ;
                                owl:someValuesFrom [ owl:intersectionOf ( pmat:Substance
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty prov:hadRole ;
                                                                            owl:someValuesFrom pmat:Catalyst
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ]
                              ] ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty obo:BFO_0000051 ;
                               owl:someValuesFrom gmat:SolGelTransition
                             ] ;
              rdfs:comment "The sol-gel transition process where a liquid colloidal solution transforms into a solid gel network through hydrolysis and condensation reactions"@en ;
              skos:definition "The sol-gel process stage in which condensation reactions cause the growing network to span the entire reaction volume, producing a solid gel at the gel point (SolGelTransition); the sol irreversibly loses fluidity"@en ;
              rdfs:label "Gelation"@en .
gmat:Gelation gmat:hasStepOrder "2"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/GelationPathway
gmat:GelationPathway rdf:type owl:Class ;
                      rdfs:subClassOf pmat:Feature ;
                      rdfs:comment "The mechanistic route by which a sol transforms into a gel network. A GelationPathway describes the mechanism, not the process itself — it is a feature of the gelation, not an instance of it"@en ;
                      skos:definition "The mechanistic route by which a sol transforms into a gel network; describes the mechanism of a gelation, not the process itself"@en ;
                      rdfs:label "Gelation pathway"@en ;
                      skos:altLabel "Gelation mechanism"@en .


###  https://w3id.org/gelmat/AcidCatalysisPathway
gmat:AcidCatalysisPathway rdf:type owl:Class ;
                         rdfs:subClassOf gmat:GelationPathway ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gmat:realisedAs ;
                                           owl:someValuesFrom gmat:AcidCatalysis
                                         ] ;
                         skos:definition "A gelation pathway realised through acid catalysis: pre-hydrolysis at low pH followed by slow condensation, producing weakly branched polymeric network gels with small, homogeneous pores."@en ;
                         rdfs:label "Acid Catalysis Pathway"@en .


###  https://w3id.org/gelmat/BaseCatalysisPathway
gmat:BaseCatalysisPathway rdf:type owl:Class ;
                         rdfs:subClassOf gmat:GelationPathway ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gmat:realisedAs ;
                                           owl:someValuesFrom gmat:BaseCatalysis
                                         ] ;
                         skos:definition "A gelation pathway realised through base catalysis: fast condensation relative to hydrolysis at high pH, producing highly branched colloidal aggregation networks with larger pore sizes."@en ;
                         rdfs:label "Base Catalysis Pathway"@en .


###  https://w3id.org/gelmat/TwoStepCatalysisPathway
gmat:TwoStepCatalysisPathway rdf:type owl:Class ;
                            rdfs:subClassOf gmat:GelationPathway ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gmat:realisedAs ;
                                              owl:someValuesFrom gmat:TwoStepCatalysis
                                            ] ;
                            skos:definition "A gelation pathway combining an acid pre-hydrolysis step with a subsequent base addition step; the standard pathway for MTMS and BTMSE-based aerogel synthesis."@en ;
                            rdfs:label "Two-Step Catalysis Pathway"@en .




