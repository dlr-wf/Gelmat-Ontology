#################################################################
#    Thermal treatments and preparation steps
#################################################################

###  https://w3id.org/gelmat/ThermalTreatment
gmat:ThermalTreatment rdf:type owl:Class ;
                      rdfs:subClassOf gmat:CreationProcess ;
                      rdfs:comment "A high-temperature post-treatment of a dried gel or aerogel - pyrolysis/carbonisation, calcination, curing, sintering. Characterised by a temperature (om:Temperature or gmat:TemperatureProfile), a gmat:Duration, a gmat:HeatingRate, and a gas atmosphere (gmat:hasAtmosphere)"@en ;
                      rdfs:label "Thermal treatment"@en ;
                      skos:altLabel "Heat treatment"@en ;
                      skos:definition "A creation process step in which a material is held at elevated temperature under a controlled atmosphere to transform its composition or structure"@en .


###  https://w3id.org/gelmat/Pyrolysis
gmat:Pyrolysis rdf:type owl:Class ;
               rdfs:subClassOf gmat:ThermalTreatment ;
               rdfs:comment "Thermal decomposition of an organic aerogel in inert atmosphere (N2, Ar), typically 600-1100 degC, converting it into a carbon aerogel"@en ;
               rdfs:label "Pyrolysis"@en ;
               skos:altLabel "Carbonisation"@en ,
                             "Carbonization"@en ;
               skos:definition "A thermal treatment in inert atmosphere that decomposes an organic network into carbon; the route from organic to carbon aerogels"@en .


###  https://w3id.org/gelmat/Calcination
gmat:Calcination rdf:type owl:Class ;
                 rdfs:subClassOf gmat:ThermalTreatment ;
                 rdfs:comment "Thermal treatment in air or oxygen to remove organic residues, dehydroxylate, or crystallise metal oxide networks (e.g. amorphous titania to anatase)"@en ;
                 rdfs:label "Calcination"@en ;
                 skos:definition "A thermal treatment in oxidising atmosphere that removes organics or induces crystallisation in oxide materials"@en .


###  https://w3id.org/gelmat/Curing
gmat:Curing rdf:type owl:Class ;
            rdfs:subClassOf gmat:ThermalTreatment ;
            rdfs:comment "Moderate-temperature treatment that completes cross-linking or imidisation of a polymer network (e.g. thermal imidisation of poly(amic acid), post-curing of RF gels)"@en ;
            rdfs:label "Curing"@en ;
            skos:definition "A thermal treatment that completes the cross-linking reactions of a polymer or hybrid network"@en .


###  https://w3id.org/gelmat/Sintering
gmat:Sintering rdf:type owl:Class ;
               rdfs:subClassOf gmat:ThermalTreatment ;
               rdfs:comment "High-temperature densification of a porous network by viscous flow or diffusion below the melting point; used deliberately for densification or as an unwanted effect limiting the service temperature of aerogels"@en ;
               rdfs:label "Sintering"@en ;
               skos:definition "A thermal treatment that densifies a porous solid by particle coalescence below the melting point"@en .


###  https://w3id.org/gelmat/Casting
gmat:Casting rdf:type owl:Class ;
             rdfs:subClassOf pmat:SamplePreparation ;
             rdfs:comment "Pouring the sol into a mould (gmat:Mold) where gelation takes place, defining the geometry (monolith, slab) of the resulting gel"@en ;
             rdfs:label "Casting"@en ;
             skos:altLabel "Moulding"@en ,
                           "Molding"@en ;
             skos:definition "A sample preparation step in which a sol is poured into a mould that defines the shape of the gel formed in it"@en .


###  https://w3id.org/gelmat/Sonication
gmat:Sonication rdf:type owl:Class ;
                rdfs:subClassOf pmat:SamplePreparation ;
                rdfs:comment "Application of ultrasound to disperse particles (fibres, GO, CNT) in a sol, accelerate hydrolysis, or degas a mixture"@en ;
                rdfs:label "Sonication"@en ;
                skos:altLabel "Ultrasonication"@en ;
                skos:definition "A sample preparation step in which ultrasound is applied to disperse, mix, or degas a liquid system"@en .


###  https://w3id.org/gelmat/Stirring
gmat:Stirring rdf:type owl:Class ;
              rdfs:subClassOf gmat:Mixing ;
              rdfs:comment "Mechanical agitation of a solution or sol at a controlled stirring rate (gmat:StirringRate) using magnetic or overhead stirrers"@en ;
              rdfs:label "Stirring"@en ;
              skos:definition "A mixing step performed by mechanical agitation at a controlled stirring rate"@en .


###  https://w3id.org/gelmat/IonExchange
gmat:IonExchange rdf:type owl:Class ;
                 rdfs:subClassOf pmat:SamplePreparation ;
                 rdfs:comment "Passing a sodium silicate (water glass) solution through a cation exchange resin to replace Na+ with H+, yielding silicic acid sol; the essential desalination step of the water-glass route"@en ;
                 rdfs:label "Ion exchange"@en ;
                 skos:definition "A sample preparation step in which ions in a solution are replaced by contact with an ion exchange resin, notably the removal of sodium from water glass"@en .


###  https://w3id.org/gelmat/FreezeCasting
gmat:FreezeCasting rdf:type owl:Class ;
                   rdfs:subClassOf pmat:SamplePreparation ;
                   rdfs:comment "Directional or bulk freezing of a suspension or gel so that growing ice crystals template an aligned macroporous architecture, subsequently revealed by freeze drying"@en ;
                   rdfs:label "Freeze casting"@en ;
                   skos:altLabel "Directional freezing"@en ,
                                 "Ice templating"@en ;
                   skos:definition "A sample preparation step in which controlled freezing templates the pore structure of a material via ice crystal growth"@en .


###  https://w3id.org/gelmat/Activation
gmat:Activation rdf:type owl:Class ;
                rdfs:subClassOf gmat:ThermalTreatment ;
                rdfs:comment "Physical (CO2, steam) or chemical (KOH, ZnCl2) activation of carbon aerogels at high temperature to develop microporosity and increase surface area"@en ;
                rdfs:label "Activation"@en ;
                skos:definition "A thermal treatment in which a reactive agent etches microporosity into a carbon material to increase its surface area"@en .


###  https://w3id.org/gelmat/Impregnation
gmat:Impregnation rdf:type owl:Class ;
                  rdfs:subClassOf pmat:SamplePreparation ;
                  rdfs:comment "Infiltrating a porous host (fibre mat, foam) with a sol, or a finished aerogel with a functional phase; the standard route to aerogel blankets and composites (see also pmat:Coating)"@en ;
                  rdfs:label "Impregnation"@en ;
                  skos:altLabel "Infiltration"@en ;
                  skos:definition "A sample preparation step in which a liquid phase is infiltrated into a porous host material"@en .


###  https://w3id.org/gelmat/Cooling
gmat:Cooling rdf:type owl:Class ;
             rdfs:subClassOf pmat:SamplePreparation ;
             rdfs:comment "Controlled reduction of temperature after a thermal step or to induce thermal gelation (e.g. gelatin); the descending counterpart of temperature ramping"@en ;
             rdfs:label "Cooling"@en ;
             skos:definition "A sample preparation step in which the temperature of a sample is lowered in a controlled manner"@en .


###  https://w3id.org/gelmat/MicrowaveDrying
gmat:MicrowaveDrying rdf:type owl:Class ;
                     rdfs:subClassOf pmat:Drying ;
                     rdfs:comment "Drying by volumetric microwave heating of the pore liquid; a fast evaporative route reported for silica and bio-aerogels"@en ;
                     rdfs:label "Microwave drying"@en ;
                     skos:definition "A drying method in which the pore liquid is removed by volumetric microwave heating"@en .


###  https://w3id.org/gelmat/HighTemperatureSupercriticalDrying
gmat:HighTemperatureSupercriticalDrying rdf:type owl:Class ;
                                        rdfs:subClassOf gmat:SupercriticalDrying ;
                                        rdfs:comment "Supercritical drying directly from the organic pore solvent (ethanol or methanol, Tc ~240-243 degC) in an autoclave, without exchange to CO2; the original Kistler-type HOT route, distinguished from low-temperature scCO2 drying"@en ;
                                        rdfs:label "High-temperature supercritical drying"@en ;
                                        skos:altLabel "HOT supercritical drying"@en ,
                                                      "Supercritical ethanol drying"@en ;
                                        skos:definition "A supercritical drying method in which the organic pore solvent itself is brought above its critical point, as opposed to exchange against supercritical CO2"@en .


#################################################################
#    Characterisation methods
#################################################################

###  https://w3id.org/gelmat/SAXS
gmat:SAXS rdf:type owl:Class ;
          rdfs:subClassOf pmat:Analysis ;
          pmat:hasAcronym "SAXS" ;
          rdfs:comment "Small-angle X-ray scattering; yields fractal dimensions (gmat:MassFractalDimension, gmat:SurfaceFractalDimension), Porod exponent, correlation length, and primary particle size of aerogel networks"@en ;
          rdfs:label "Small-angle X-ray scattering"@en ;
          skos:altLabel "SAXS"@en ;
          skos:definition "An analysis that measures elastic X-ray scattering at small angles to characterise nanostructure (fractal scaling, particle and cluster sizes) of a material"@en .


###  https://w3id.org/gelmat/SANS
gmat:SANS rdf:type owl:Class ;
          rdfs:subClassOf pmat:Analysis ;
          pmat:hasAcronym "SANS" ;
          rdfs:comment "Small-angle neutron scattering; complements SAXS with contrast-variation capability for multi-phase and hydrogenous aerogel systems"@en ;
          rdfs:label "Small-angle neutron scattering"@en ;
          skos:altLabel "SANS"@en ;
          skos:definition "An analysis that measures elastic neutron scattering at small angles to characterise nanostructure of a material"@en .


###  https://w3id.org/gelmat/MercuryIntrusionPorosimetry
gmat:MercuryIntrusionPorosimetry rdf:type owl:Class ;
                                 rdfs:subClassOf gmat:PorosityMeasurement ;
                                 pmat:hasAcronym "MIP" ;
                                 rdfs:comment "Determination of macro- and mesopore size distribution by pressurised mercury intrusion; note that compressible aerogels are often crushed rather than intruded, so results need careful interpretation"@en ;
                                 rdfs:label "Mercury intrusion porosimetry"@en ;
                                 skos:altLabel "MIP"@en ;
                                 skos:definition "A porosity measurement in which mercury is forced into the pores of a material under increasing pressure to determine pore volume and size distribution"@en .


###  https://w3id.org/gelmat/HeliumPycnometry
