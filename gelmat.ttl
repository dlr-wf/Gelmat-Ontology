###  https://w3id.org/gelmat/InorganicAerogel
gmat:InorganicAerogel rdf:type owl:Class ;
                       rdfs:subClassOf gmat:Aerogel ;
                       rdfs:comment "An aerogel with an inorganic backbone (e.g. SiO₂, TiO₂, Al₂O₃), typically synthesised from metal alkoxide precursors through sol-gel processing"@en ;
                       skos:definition "An aerogel whose solid framework consists entirely of inorganic components such as metal oxides, silica, or zero-valent metals, containing no covalently bonded organic groups in the network backbone"@en ;
                    rdfs:label "Inorganic aerogel"@en .


###  https://w3id.org/gelmat/OrganosilicaAerogel
gmat:OrganosilicaAerogel rdf:type owl:Class ;
                          rdfs:subClassOf gmat:HybridAerogel ;
                          rdfs:comment "An aerogel derived from organosilica precursors (e.g. MTMS, BTMSE) in which organic groups are covalently bonded within the silica network, imparting hydrophobicity and flexibility compared to pure silica aerogels"@en ;
                          rdfs:label "Organosilica aerogel"@en ;
                          skos:altLabel "Methylsilica aerogel"@en ,
                                        "Hybrid silica aerogel"@en ;
                          skos:definition "A hybrid aerogel in which organic functional groups are incorporated into the inorganic silica backbone via covalent Si–C bonds"@en .


