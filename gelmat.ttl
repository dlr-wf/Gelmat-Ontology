@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pmat: <https://w3id.org/polymat/> .
@prefix gmat: <https://w3id.org/gelmat/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@base <https://w3id.org/gelmat/> .

<https://w3id.org/gelmat/> rdf:type owl:Ontology ;
                            owl:versionIRI <https://w3id.org/gelmat/1.1.0> ;
                            owl:imports <https://w3id.org/polymat/> ,
                                        <http://www.ontology-of-units-of-measure.org/resource/om-2> ;
                            <http://omv.ontoware.org/2005/05/ontology#designedForOntologyTask> "knowledge representation in sol-gel materials synthesis, characterisation, and material properties" ;
                            <http://omv.ontoware.org/2005/05/ontology#usedOntologyEngineeringTool> "https://www.isibang.ac.in/ns/mod/index.html#Protege" ;
                            <http://purl.org/dc/terms/abstract> "Gelmat is an ontology for sol-gel materials. It extends the Polymat domain ontology with classes for sol-gel synthesis processes, gel characterisation methods, drying routes, laboratory equipment, process parameters, and material properties. It enables semantic description and formal documentation of sol-gel and aerogel research workflows, covering silica, organosilica, organic, carbon, and composite sol-gel derived materials." ;
                            <http://purl.org/dc/terms/author> "Prakul Pandit (https://orcid.org/0000-0002-1343-3046), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ,
                                                              "Antoni Dudij, Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ,
                                                              "Barbara Milow (https://orcid.org/0000-0002-6350-7728), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ;
                            <http://purl.org/dc/terms/bibliographicCitation> "Pandit, P., Dudij, A., & Milow, B. (2026). Gelmat: An Ontology for Sol-Gel Materials (Version 1.1.0) [Data set]. Zenodo. https://doi.org/10.5281/zenodo.22915205" ;
                            <http://purl.org/dc/terms/identifier> "https://doi.org/10.5281/zenodo.22915205" ;
                            <http://purl.org/dc/terms/created> "2026-03-12"^^xsd:date ;
                            <http://purl.org/dc/terms/license> <https://spdx.org/licenses/CC-BY-NC-4.0.html> ;
                            <http://purl.org/dc/terms/modified> "2026-09-14"^^xsd:date ;
                            prov:wasDerivedFrom <https://w3id.org/polymat/> ;
                            <http://purl.org/dc/terms/title> "Gelmat: An Ontology for Sol-Gel Materials" ;
                            vann:preferredNamespacePrefix "gmat" ;
                            vann:preferredNamespaceUri "https://w3id.org/gelmat/" ;
                            rdfs:comment "Gelmat is an ontology for sol-gel materials. It extends the Polymat ontology (Dembska, Held, Schindler; DLR/Hereon) with classes for sol-gel synthesis routes, gel types, surface modification, drying methods, characterisation methods, process parameters, and material properties. Covers all major sol-gel derived material classes including silica, organosilica, organic, carbon, and composite aerogels." ;
                            rdfs:label "Gelmat" ;
                            owl:versionInfo "1.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://omv.ontoware.org/2005/05/ontology#designedForOntologyTask
<http://omv.ontoware.org/2005/05/ontology#designedForOntologyTask> rdf:type owl:AnnotationProperty .


###  http://omv.ontoware.org/2005/05/ontology#usedOntologyEngineeringTool
<http://omv.ontoware.org/2005/05/ontology#usedOntologyEngineeringTool> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/identifier
dc:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/author
<http://purl.org/dc/terms/author> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
<http://purl.org/dc/terms/bibliographicCitation> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  https://w3id.org/gelmat/generatesIntermediate
gmat:generatesIntermediate rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf obo:RO_0002234 ;
                           rdfs:domain pmat:Method ;
                           rdfs:range pmat:Substance ;
                           rdfs:comment "Links a process step (creation process or sample preparation step such as solvent exchange) to the intermediate product it generates"@en ;
                           rdfs:label "generates intermediate"@en .


###  https://w3id.org/gelmat/hasPrecursor
gmat:hasPrecursor rdf:type owl:ObjectProperty ;
                  rdfs:domain gmat:Gel ;
                  rdfs:range pmat:Substance ;
                  rdfs:comment "Links an aerogel or gel to its chemical precursor substance"@en ;
                  rdfs:label "has precursor"@en .


###  https://w3id.org/gelmat/realizesProtocol
gmat:realizesProtocol rdf:type owl:ObjectProperty ;
                      rdfs:domain pmat:Procedure ;
                      rdfs:range gmat:SynthesisProtocol ;
                      rdfs:comment "Links a concrete executed procedure (an occurrent) to the SynthesisProtocol (plan specification / recipe) it carries out. Separates the executed run from the reusable recipe it follows. Domain is pmat:Procedure rather than BFO process (BFO_0000015) to stay compatible with Polymat's BFO_0000015-to-prov:Activity mapping."@en ;
                      rdfs:label "realizes protocol"@en .


###  https://w3id.org/gelmat/hasRatioString
gmat:hasRatioString rdf:type owl:DatatypeProperty ;
                    rdfs:domain gmat:RatioValue ;
                    rdfs:range xsd:string ;
                    rdfs:comment "The display/legacy string representation of a molar or volume ratio between components (e.g. '1:10', '1:10:4:4', or '59.75'). For numeric querying, single-valued ratios additionally carry om:hasNumericalValue (xsd:double) with om:hasUnit om:one, using the convention that a two-part ratio a:b has numerical value a/b. Multi-component ratios (e.g. '1:10:4:4') have no single numerical value and are represented by this string only."@en ;
                    rdfs:label "has ratio string"@en .



###  https://w3id.org/gelmat/hasStepOrder
gmat:hasStepOrder rdf:type owl:AnnotationProperty ;
                 rdfs:range xsd:positiveInteger ;
                 skos:definition "An integer indicating the canonical execution order of a sub-process within a synthesis workflow (1 = first step). Used to provide SPARQL-queryable ordering of BFO parthood sub-steps that are otherwise unordered."@en ;
                 rdfs:label "has step order"@en .


###  https://w3id.org/gelmat/hasCanonicalUnit
gmat:hasCanonicalUnit rdf:type owl:AnnotationProperty ;
                      rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> ;
                      skos:definition "Links a quantity class to the canonical (recommended) OM-2 unit of measure in which instances of that quantity are conventionally expressed. Machine-readable counterpart to the unit named in the class definition."@en ;
                      rdfs:label "has canonical unit"@en .




#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000050
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
                  owl:inverseOf obo:BFO_0000051 ;
                  rdfs:comment "Everything is part of itself. Any part of any part of a thing is itself part of that thing. Two distinct things cannot be part of each other."@en ,
                               "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ,
                               """Parthood requires the part and the whole to have compatible classes: only an occurrent can be part of an occurrent; only a process can be part of a process; only a continuant can be part of a continuant; only an independent continuant can be part of an independent continuant; only an immaterial entity can be part of an immaterial entity; only a specifically dependent continuant can be part of a specifically dependent continuant; only a generically dependent continuant can be part of a generically dependent continuant. (This list is not exhaustive.)

A continuant cannot be part of an occurrent: use 'participates in'. An occurrent cannot be part of a continuant: use 'has participant'. A material entity cannot be part of an immaterial entity: use 'has location'. A specifically dependent continuant cannot be part of an independent continuant: use 'inheres in'. An independent continuant cannot be part of a specifically dependent continuant: use 'bearer of'."""@en ,
                               "a core relation that holds between a part and its whole"@en ,
                               "my brain is part of my body (continuant parthood, two material entities)"@en ,
                               "my stomach cavity is part of my stomach (continuant parthood, immaterial entity is part of material entity)"@en ,
                               "this day is part of this year (occurrent parthood)"@en ;
                  rdfs:label "part of"@en .


###  http://purl.obolibrary.org/obo/BFO_0000051
obo:BFO_0000051 rdf:type owl:ObjectProperty ,
                           owl:TransitiveProperty ;
                  rdfs:comment "Everything has itself as a part. Any part of any part of a thing is itself part of that thing. Two distinct things cannot have each other as a part."@en ,
                               "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ,
                               """Parthood requires the part and the whole to have compatible classes: only an occurrent have an occurrent as part; only a process can have a process as part; only a continuant can have a continuant as part; only an independent continuant can have an independent continuant as part; only a specifically dependent continuant can have a specifically dependent continuant as part; only a generically dependent continuant can have a generically dependent continuant as part. (This list is not exhaustive.)

A continuant cannot have an occurrent as part: use 'participates in'. An occurrent cannot have a continuant as part: use 'has participant'. An immaterial entity cannot have a material entity as part: use 'location of'. An independent continuant cannot have a specifically dependent continuant as part: use 'bearer of'. A specifically dependent continuant cannot have an independent continuant as part: use 'inheres in'."""@en ,
                               "a core relation that holds between a whole and its part"@en ,
                               "my body has part my brain (continuant parthood, two material entities)"@en ,
                               "my stomach has part my stomach cavity (continuant parthood, material entity has part immaterial entity)"@en ,
                               "this year has part this day (occurrent parthood)"@en ;
                  rdfs:label "has part"@en .


###  http://purl.obolibrary.org/obo/RO_0000052
obo:RO_0000052 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf obo:RO_0000053 ;
                 rdfs:comment "a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence"@en ;
                 rdfs:label "characteristic of"@en .


###  http://purl.obolibrary.org/obo/RO_0000053
obo:RO_0000053 rdf:type owl:ObjectProperty ;
                 rdfs:range obo:BFO_0000020 ;
                 rdfs:comment "inverse of characteristic_of (http://purl.obolibrary.org/obo/RO_0000052)"@en ;
                 rdfs:label "has characteristic"@en .


###  http://purl.obolibrary.org/obo/RO_0000056
obo:RO_0000056 rdf:type owl:ObjectProperty ;
                 owl:inverseOf obo:RO_0000057 ;
                 rdfs:domain obo:BFO_0000002 ;
                 rdfs:range obo:BFO_0000003 ;
                 rdfs:comment "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
                 rdfs:label "participates in"@en .


###  http://purl.obolibrary.org/obo/RO_0000057
obo:RO_0000057 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:BFO_0000003 ;
                 rdfs:range obo:BFO_0000002 ;
                 rdfs:comment "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
                 rdfs:label "has participant"@en .


###  http://purl.obolibrary.org/obo/RO_0000081
obo:RO_0000081 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000052 ;
                 owl:inverseOf obo:RO_0000087 ;
                 rdfs:comment "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
                 rdfs:label "role of"@en .


###  http://purl.obolibrary.org/obo/RO_0000087
obo:RO_0000087 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000053 ;
                 rdfs:domain obo:BFO_0000004 ;
                 rdfs:range obo:BFO_0000023 ;
                 rdfs:comment "a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence"@en ;
                 rdfs:label "has role"@en .


###  http://purl.obolibrary.org/obo/RO_0001015
obo:RO_0001015 rdf:type owl:ObjectProperty ;
                 owl:inverseOf obo:RO_0001025 ;
                 rdfs:comment "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en ;
                 rdfs:label "location of"@en .


###  http://purl.obolibrary.org/obo/RO_0001018
obo:RO_0001018 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf obo:RO_0001019 ;
                 rdfs:domain obo:BFO_0000040 ;
                 rdfs:range obo:BFO_0000004 ;
                 rdfs:comment """The relation between a physical content and its container. A material entity B is contained in a material entity A if B is located in some cavity of A.  
(inverse of http://purl.allotrope.org/ontologies/property#AFX_0001048)"""@en ;
                 rdfs:label "contained in"@en ;
                 owl:deprecated "true"^^xsd:boolean .


###  http://purl.obolibrary.org/obo/RO_0001019
obo:RO_0001019 rdf:type owl:ObjectProperty ;
                 rdfs:comment """The relation between a container and its physical content. A material entity a contains a material entity b if b is located in some cavity of a.
(http://purl.allotrope.org/ontologies/property#AFX_0001048)"""@en ;
                 rdfs:label "contains"@en ;
                 owl:deprecated "true"^^xsd:boolean .


###  http://purl.obolibrary.org/obo/RO_0001025
obo:RO_0001025 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:BFO_0000004 ,
                             [ owl:intersectionOf ( obo:BFO_0000004
                                                    [ rdf:type owl:Class ;
                                                      owl:complementOf obo:BFO_0000006
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
                 rdfs:range obo:BFO_0000004 ,
                            [ owl:intersectionOf ( obo:BFO_0000004
                                                   [ rdf:type owl:Class ;
                                                     owl:complementOf obo:BFO_0000006
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
                 rdfs:comment "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en ;
                 rdfs:label "located in"@en .


###  http://purl.obolibrary.org/obo/RO_0002233
obo:RO_0002233 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:inverseOf obo:RO_0002352 ;
                 rdfs:domain obo:BFO_0000015 ;
                 rdfs:comment """p has input c iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.
(http://purl.obolibrary.org/obo/RO_0002233)

a relation between a process and an entity, where the entity is present at the beginning of the process
(http://semanticscience.org/resource/SIO_000230)"""@en ;
                 rdfs:label "has input"@en .


###  http://purl.obolibrary.org/obo/RO_0002234
obo:RO_0002234 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:inverseOf obo:RO_0002353 ;
                 rdfs:comment """p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.
(http://purl.obolibrary.org/obo/RO_0002234)

has output is a relation between an process and an entity, where the entity is present at the end of the process.
(http://semanticscience.org/resource/SIO_000229)"""@en ;
                 rdfs:label "has output"@en .


###  http://purl.obolibrary.org/obo/RO_0002352
obo:RO_0002352 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000056 ;
                 rdfs:comment """c is input of p iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.
(inverse of http://purl.obolibrary.org/obo/RO_0002233)"""@en ;
                 rdfs:label "input of"@en .


###  http://purl.obolibrary.org/obo/RO_0002353
obo:RO_0002353 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000056 ;
                 rdfs:comment """c is output of p iff: c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.
(inverse of http://purl.obolibrary.org/obo/RO_0002234)"""@en ;
                 rdfs:label "output of"@en .


###  http://purl.obolibrary.org/obo/RO_0002615
obo:RO_0002615 rdf:type owl:ObjectProperty ;
                 rdfs:comment """a relation between an entity and its model (an artifact), which purports to represent the entity.
(inverse of http://semanticscience.org/resource/SIO_000632)"""@en ;
                 rdfs:label "has model"@en .


###  http://purl.obolibrary.org/obo/RO_0003301
obo:RO_0003301 rdf:type owl:ObjectProperty ;
                 rdfs:comment "a relation between a biological, experimental, or computational artifact and an entity it is used to study, in virtue of its replicating or approximating features of the studied entity"@en ;
                 rdfs:label "has role in modeling"@en .


###  http://purl.obolibrary.org/obo/RO_0004017
obo:RO_0004017 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf obo:RO_0004018 ;
                 rdfs:comment """realizable B has basis in A, if  B could not exist without the existence of A.
inverse of \"is basis for realizable\"."""@en ;
                 rdfs:label "realizable has basis in"@en .


###  http://purl.obolibrary.org/obo/RO_0004018
obo:RO_0004018 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:comment "A is basis for realizable B, if  B could not exist without the existence of A."@en ;
                 rdfs:label "is basis for realizable"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit
om:hasUnit rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain om:Measure ;
           rdfs:range om:Unit ;
           rdfs:label "has unit"@en ,
                      "単位を持つ"@ja .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue
om:hasValue rdf:type owl:ObjectProperty ;
            rdfs:domain om:Quantity ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( om:Measure
                                       om:Point
                                     )
                       ] ;
            rdfs:label "has value"@en ,
                       "値を持つ"@ja .


###  http://www.w3.org/ns/prov#agent
prov:agent rdf:type owl:ObjectProperty ;
           rdfs:domain prov:AgentInfluence ;
           rdfs:range prov:Agent ;
           rdfs:comment "The prov:agent property references an prov:Agent which influenced a resource. This property applies to an prov:AgentInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent."@en ,
                        "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en ;
           rdfs:label "agent" .


###  http://www.w3.org/ns/prov#entity
prov:entity rdf:type owl:ObjectProperty ;
            rdfs:domain prov:EntityInfluence ;
            rdfs:range prov:Entity ;
            rdfs:comment "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en ,
                         "The prov:entity property references an prov:Entity which influenced a resource. This property applies to an prov:EntityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent." ;
            rdfs:label "entity" .


###  http://www.w3.org/ns/prov#generated
prov:generated rdf:type owl:ObjectProperty ;
               owl:inverseOf prov:wasGeneratedBy ;
               rdfs:domain prov:Activity ;
               rdfs:range prov:Entity ;
               rdfs:comment "prov:generated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions."@en ;
               rdfs:label "generated" .


###  http://www.w3.org/ns/prov#hadRole
prov:hadRole rdf:type owl:ObjectProperty ;
             rdfs:domain prov:Influence ,
                         [ rdf:type owl:Class ;
                           owl:unionOf ( prov:Association
                                         prov:InstantaneousEvent
                                       )
                         ] ;
             rdfs:range prov:Role ;
             rdfs:comment "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end."@en ;
             rdfs:label "hadRole" .


###  http://www.w3.org/ns/prov#hadUsage
prov:hadUsage rdf:type owl:ObjectProperty ;
              rdfs:range prov:Usage ;
              rdfs:label "hadUsage" .


###  http://www.w3.org/ns/prov#qualifiedAssociation
prov:qualifiedAssociation rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain prov:Activity ;
                          rdfs:range prov:Association ;
                          rdfs:comment "If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ]."@en ;
                          rdfs:label "qualifiedAssociation" .


###  http://www.w3.org/ns/prov#qualifiedAttribution
prov:qualifiedAttribution rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf owl:topObjectProperty ;
                          rdfs:domain prov:Entity ;
                          rdfs:range prov:Attribution ;
                          rdfs:comment "If this Entity prov:wasAttributedTo Agent :ag, then it can qualify how it was influenced using prov:qualifiedAttribution [ a prov:Attribution;  prov:agent :ag; :foo :bar ]."@en ;
                          rdfs:label "qualifiedAttribution" .


###  http://www.w3.org/ns/prov#qualifiedUsage
prov:qualifiedUsage rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain prov:Activity ;
                    rdfs:range prov:Usage ;
                    rdfs:comment "If this Activity prov:used Entity :e, then it can qualify how it used it using prov:qualifiedUsage [ a prov:Usage; prov:entity :e; :foo :bar ]."@en ;
                    rdfs:label "qualifiedUsage" .


###  http://www.w3.org/ns/prov#used
prov:used rdf:type owl:ObjectProperty ;
          rdfs:domain prov:Activity ;
          rdfs:range prov:Entity ;
          rdfs:comment "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en ,
                       "Aerogel synthesis processes use various chemical substances such as precursors, solvents, and catalysts."@en ;
          rdfs:label "used" .


###  http://www.w3.org/ns/prov#wasAssociatedWith
prov:wasAssociatedWith rdf:type owl:ObjectProperty ;
                       rdfs:domain prov:Activity ;
                       rdfs:range prov:Agent ;
                       rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en ;
                       rdfs:label "wasAssociatedWith" .


###  http://www.w3.org/ns/prov#wasAttributedTo
prov:wasAttributedTo rdf:type owl:ObjectProperty ;
                     rdfs:domain prov:Entity ;
                     rdfs:range prov:Agent ;
                     rdfs:comment "Attribution is the ascribing of an entity to an agent."@en ;
                     rdfs:label "wasAttributedTo" .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty ;
                    rdfs:domain prov:Entity ;
                    rdfs:range prov:Entity ;
                    rdfs:comment "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en ,
                                 "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en ;
                    rdfs:label "wasDerivedFrom" .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain prov:Entity ;
                    rdfs:range prov:Activity ;
                    rdfs:label "wasGeneratedBy" .


###  https://w3id.org/gelmat/hasRatioComponent
gmat:hasRatioComponent rdf:type owl:ObjectProperty ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( gmat:MolarRatio
                                                   gmat:VolumeRatio
                                                 )
                                   ] ;
                       rdfs:range pmat:Substance ;
                       rdfs:comment "Links a volume or molar ratio to the chemical substances it describes the proportion between"@en ;
                       rdfs:label "has ratio component"@en .


###  https://w3id.org/gelmat/isAerogelProductOf
gmat:isAerogelProductOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf gmat:wasProducedBy ;
                        owl:inverseOf gmat:producesAerogel ;
                        rdfs:domain gmat:Aerogel ;
                        rdfs:range pmat:Drying ;
                        rdfs:label "is aerogel product of"@en .


###  https://w3id.org/polymat/isParameterOf
pmat:isParameterOf rdf:type owl:ObjectProperty ;
                   rdfs:domain pmat:Feature ;
                   rdfs:range obo:BFO_0000003 ;
                   rdfs:comment "Relates a quantity or process feature (temperature, duration, pH) to the process it characterises. Preferred over obo:RO_0000052 when the bearer is a process rather than a material entity. Range is BFO occurrent (BFO_0000003) rather than BFO process (BFO_0000015) because process steps are pmat:Method (under pmat:Procedure, a prov:Entity) while BFO_0000015 maps to prov:Activity, which PROV-O declares disjoint from prov:Entity — a BFO_0000015 range would make every class with an isParameterOf existential unsatisfiable"@en ;
                   rdfs:label "is parameter of"@en .


###  https://w3id.org/gelmat/producesAerogel
gmat:producesAerogel rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000057 ;
                     rdfs:domain pmat:Drying ;
                     rdfs:range gmat:Aerogel ;
                     rdfs:comment "Relates a drying process to the aerogel material that results from it (covers supercritical, ambient pressure, freeze, and vacuum drying routes)"@en ;
                     rdfs:label "producesAerogel"@en .


###  https://w3id.org/gelmat/requiresEquipment
gmat:requiresEquipment rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf obo:RO_0000057 ;
                       rdfs:domain [ rdf:type owl:Class ;
                                     owl:unionOf ( pmat:Method
                                                   pmat:Procedure
                                                 )
                                   ] ;
                       rdfs:range pmat:Device ;
                       rdfs:comment "Relates a laboratory method or procedure to equipment that is necessary to perform that method"@en ;
                       rdfs:label "requiresEquipment"@en .


###  https://w3id.org/gelmat/hasDefect
gmat:hasDefect rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:domain gmat:Aerogel ;
               rdfs:range gmat:AerogelDefect ;
               rdfs:comment "Relates an aerogel material to a structural or quality defect (a persisting defect state) observed in it. Sub-property of obo:RO_0000053 (bearer of), consistent with the other characteristic-linking properties."@en ;
               rdfs:label "has defect"@en .


###  https://w3id.org/gelmat/hasGeometry
gmat:hasGeometry rdf:type owl:ObjectProperty ;
                 rdfs:domain pmat:Substance ;
                 rdfs:range gmat:Geometry ;
                 rdfs:comment "Relates a material entity to a description of its shape or geometric configuration"@en ;
                 rdfs:label "has geometry"@en .


###  https://w3id.org/gelmat/transformsGel
gmat:transformsGel rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf obo:RO_0000057 ;
                   rdfs:domain pmat:SamplePreparation ;
                   rdfs:range gmat:Gel ;
                   rdfs:comment "Relates a sample preparation process (like solvent exchange) to the gel material it transforms"@en ;
                   rdfs:label "transformsGel"@en .


###  https://w3id.org/gelmat/usesCrosslinker
gmat:usesCrosslinker rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf gmat:usesSubstance ;
                     rdfs:domain gmat:Gelation ;
                     rdfs:range gmat:Crosslinker ;
                     rdfs:comment "Relates gelation process to crosslinking agents used to form network structure"@en ;
                     rdfs:label "usesCrosslinker"@en .


###  https://w3id.org/polymat/usesOperatingSystem
pmat:usesOperatingSystem rdf:type owl:ObjectProperty ;
                         rdfs:domain pmat:Software ;
                         rdfs:range pmat:OperatingSystem ;
                         rdfs:comment """uses the low-level software which handles the interface to peripheral hardware, schedules tasks, allocates storage, and presents a default interface to the user when no application program is running
(http://purl.obolibrary.org/obo/NCIT_C47908)"""@en ;
                         rdfs:label "uses operating system"@en .


###  https://w3id.org/polymat/usesRuntimeEnvironment
pmat:usesRuntimeEnvironment rdf:type owl:ObjectProperty ;
                            rdfs:domain pmat:Software ;
                            rdfs:range pmat:RuntimeEnvironment ;
                            rdfs:comment """uses a sub-system that exists both in the computer where a program is created, as well as in the computers where the program is intended to be run. 
(https://en.wikipedia.org/wiki/Runtime_system)"""@en ;
                            rdfs:label "uses runtime environment"@en .


###  https://w3id.org/gelmat/usesSubstance
gmat:usesSubstance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf obo:RO_0000057 ;
                   rdfs:domain pmat:Method ;
                   rdfs:range pmat:Substance ;
                   rdfs:comment "Relates a process (creation/synthesis step or sample preparation step such as solvent exchange or drying) to chemical substances used as reactants, catalysts, solvents, or exchange media"@en ;
                   rdfs:label "usesSubstance"@en .


###  https://w3id.org/gelmat/usesSupercriticalFluid
gmat:usesSupercriticalFluid rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf gmat:usesSubstance ;
                            rdfs:domain gmat:SupercriticalDrying ;
                            rdfs:range gmat:SupercriticalFluid ;
                            rdfs:comment "Relates supercritical drying process to the supercritical fluid used (typically CO2)"@en ;
                            rdfs:label "usesSupercriticalFluid"@en .


###  https://w3id.org/gelmat/wasProducedBy
gmat:wasProducedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf obo:RO_0000056 ;
                   rdfs:domain pmat:Substance ;
                   rdfs:range gmat:CreationProcess ;
                   rdfs:comment "Relates a substance to the creation process that produced it"@en ;
                   rdfs:label "wasProducedBy"@en .



###  https://w3id.org/gelmat/hasPHCondition
gmat:hasPHCondition rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf obo:RO_0000057 ;
                    rdfs:domain gmat:CreationProcess ;
                    rdfs:range gmat:PHCondition ;
                    rdfs:comment "Relates a sol-gel process step (sol formation, gelation, aging) to the pH condition maintained during that step"@en ;
                    rdfs:label "has pH condition"@en .


###  https://w3id.org/gelmat/hasGelationRoute
gmat:hasGelationRoute rdf:type owl:ObjectProperty ;
                      rdfs:domain gmat:AerogelSynthesis ;
                      rdfs:range gmat:GelationPathway ;
                      rdfs:comment "Relates an aerogel synthesis to the mechanistic gelation pathway it follows (e.g. acid-catalysed sol-gel polymerisation, base-catalysed, two-step)"@en ;
                      rdfs:label "has gelation route"@en .


###  https://w3id.org/gelmat/hasSilylationAgent
gmat:hasSilylationAgent rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf gmat:usesSubstance ;
                        rdfs:domain gmat:SurfaceModification ;
                        rdfs:range gmat:SilylationAgent ;
                        rdfs:comment "Relates a surface modification step to the silylating agent applied (e.g. TMCS, HMDS) to render the gel surface hydrophobic before ambient pressure drying"@en ;
                        rdfs:label "has silylation agent"@en .


###  https://w3id.org/gelmat/hasIntermediateProduct
gmat:hasIntermediateProduct rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf gmat:generatesIntermediate ;
                            rdfs:domain gmat:SolFormation ;
                            rdfs:range gmat:Silanol ;
                            rdfs:comment "Relates a sol formation step to the silanol intermediates generated during hydrolysis"@en ;
                            rdfs:label "has intermediate product"@en .



###  https://w3id.org/gelmat/realisedAs
gmat:realisedAs rdf:type owl:ObjectProperty ;
                rdfs:domain gmat:GelationPathway ;
                rdfs:range gmat:Gelation ;
                rdfs:comment "Relates a mechanistic GelationPathway (a Feature) to the Gelation process that realises it. For example, a TwoStepAcidBaseCatalysisPathway is realisedAs a TwoStepCatalysis gelation process"@en ;
                rdfs:label "realised as"@en .


###  https://w3id.org/gelmat/hasBulkDensity
gmat:hasBulkDensity rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf gmat:hasDensity ;
                    rdfs:domain pmat:Substance ;
                    rdfs:range gmat:BulkDensity ;
                    rdfs:comment "Relates a substance to its bulk (envelope) density, expressed as a gmat:BulkDensity individual with an om:Measure value in kg/m3"@en ;
                    rdfs:label "has bulk density"@en .


###  https://w3id.org/gelmat/hasSkeletalDensity
gmat:hasSkeletalDensity rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf gmat:hasDensity ;
                        rdfs:domain pmat:Substance ;
                        rdfs:range gmat:SkeletalDensity ;
                        rdfs:comment "Relates a substance to its skeletal (helium pycnometry) density, expressed as a gmat:SkeletalDensity individual with an om:Measure value in kg/m3"@en ;
                        rdfs:label "has skeletal density"@en .


###  https://w3id.org/gelmat/hasPressure
gmat:hasPressure rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000053 ;
                 rdfs:range om:Pressure ;
                 rdfs:comment "Relates a process step or substance to a pressure condition (e.g. autoclave pressure during supercritical drying, vacuum level), expressed as an om:Pressure individual with an om:Measure value in Pa or MPa. For process bearers, pmat:isParameterOf from the pressure to the process is the inverse-direction alternative"@en ;
                 rdfs:label "has pressure"@en .


###  https://w3id.org/gelmat/hasMassFraction
gmat:hasMassFraction rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000053 ;
                     rdfs:domain pmat:Substance ;
                     rdfs:range gmat:MassFraction ;
                     rdfs:comment "Relates a substance (e.g. a composite aerogel or a sol) to a mass fraction such as fibre loading, solid content, or silica content, expressed as a gmat:MassFraction individual with a dimensionless om:Measure value (wt% or fraction)"@en ;
                     rdfs:label "has mass fraction"@en .


###  https://w3id.org/gelmat/hasHeatingRate
gmat:hasHeatingRate rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf obo:RO_0000053 ;
                    rdfs:range gmat:HeatingRate ;
                    rdfs:comment "Relates a thermal process step (drying, pyrolysis, temperature ramping) to its heating rate, expressed as a gmat:HeatingRate individual with an om:Measure value in K/min"@en ;
                    rdfs:label "has heating rate"@en .


###  https://w3id.org/gelmat/hasPoreVolume
gmat:hasPoreVolume rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf obo:RO_0000053 ;
                   rdfs:domain pmat:Substance ;
                   rdfs:range gmat:PoreVolume ;
                   rdfs:comment "Relates a substance to its total pore volume, expressed as a gmat:PoreVolume individual with an om:Measure value (typically cm3/g)"@en ;
                   rdfs:label "has pore volume"@en .


###  https://w3id.org/gelmat/hasParticleSize
gmat:hasParticleSize rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000053 ;
                     rdfs:domain pmat:Substance ;
                     rdfs:range gmat:ParticleSize ;
                     rdfs:comment "Relates a substance to the characteristic size of its primary particles, expressed as a gmat:ParticleSize individual with an om:Measure value in nm"@en ;
                     rdfs:label "has particle size"@en .


###  https://w3id.org/gelmat/hasActivationEnergy
gmat:hasActivationEnergy rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf obo:RO_0000053 ;
                         rdfs:range gmat:ActivationEnergy ;
                         rdfs:comment "Relates a substance or process (e.g. gelation kinetics) to an activation energy, expressed as a gmat:ActivationEnergy individual with an om:Measure value in kJ/mol"@en ;
                         rdfs:label "has activation energy"@en .


###  https://w3id.org/gelmat/hasPoreSizeDistribution
gmat:hasPoreSizeDistribution rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf obo:RO_0000053 ;
                             rdfs:domain pmat:Substance ;
                             rdfs:range gmat:PoreSizeDistribution ;
                             rdfs:comment "Relates a substance to its pore size distribution, expressed as a gmat:PoreSizeDistribution individual"@en ;
                             rdfs:label "has pore size distribution"@en .


###  https://w3id.org/gelmat/hasSolConcentration
gmat:hasSolConcentration rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf obo:RO_0000053 ;
                         rdfs:domain pmat:Substance ;
                         rdfs:range gmat:SolConcentration ;
                         rdfs:comment "Relates a sol (or a synthesis described through it) to the precursor concentration in the sol, expressed as a gmat:SolConcentration individual with an om:Measure value (mol/L or wt%)"@en ;
                         rdfs:label "has sol concentration"@en .


###  https://w3id.org/gelmat/hasAtmosphere
gmat:hasAtmosphere rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf gmat:usesSubstance ;
                   rdfs:domain gmat:ThermalTreatment ;
                   rdfs:range pmat:Substance ;
                   rdfs:comment "Relates a thermal treatment step (pyrolysis, calcination, sintering) to the gas atmosphere in which it is performed, e.g. nitrogen, argon, air, or carbon dioxide"@en ;
                   rdfs:label "has atmosphere"@en .


###  https://w3id.org/gelmat/measuredBy
gmat:measuredBy rdf:type owl:ObjectProperty ;
                rdfs:domain om:Quantity ;
                rdfs:range pmat:Analysis ;
                rdfs:comment "Relates a measured quantity to the characterisation method (analysis) that produced it, e.g. a surface area value measuredBy a BET analysis. Dedicated shortcut for the common query pattern; prov:wasGeneratedBy remains available for full provenance chains"@en ;
                rdfs:label "measured by"@en .


###  https://w3id.org/gelmat/hasMatrix
gmat:hasMatrix rdf:type owl:ObjectProperty ;
               rdfs:domain gmat:CompositeAerogel ;
               rdfs:range pmat:Substance ;
               rdfs:comment "Relates a composite aerogel to the continuous matrix material (e.g. the silica aerogel phase of a fibre-reinforced composite)"@en ;
               rdfs:label "has matrix"@en .


###  https://w3id.org/gelmat/hasReinforcement
gmat:hasReinforcement rdf:type owl:ObjectProperty ;
                      rdfs:domain gmat:CompositeAerogel ;
                      rdfs:range pmat:Substance ;
                      rdfs:comment "Relates a composite aerogel to the reinforcing or filler phase embedded in its matrix (e.g. glass fibre, cellulose fibre, graphene oxide)"@en ;
                      rdfs:label "has reinforcement"@en .


###  https://w3id.org/gelmat/hasApplication
gmat:hasApplication rdf:type owl:ObjectProperty ;
                    rdfs:domain pmat:Substance ;
                    rdfs:range gmat:Application ;
                    rdfs:comment "Relates a material to an application it is intended for or demonstrated in (e.g. thermal insulation, adsorption, drug delivery)"@en ;
                    rdfs:label "has application"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue
om:hasNumericalValue rdf:type owl:DatatypeProperty ;
                     rdfs:domain om:Measure ;
                     rdfs:comment """A numerical value is the size of a particular quantity expressed numerically.
(https://www.oed.com/search/dictionary/?scope=Entries&q=numerical+value)"""@en ;
                     rdfs:label "has numerical value"@en .


###  https://w3id.org/polymat/hasAcronym
pmat:hasAcronym rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string ;
                rdfs:comment "An acronym is used to represent long complex compounds"@en ;
                rdfs:label "has acronym"@en .


###  https://w3id.org/gelmat/hasAgingTime
gmat:hasAgingTime rdf:type owl:DatatypeProperty ;
                  owl:deprecated "true"^^xsd:boolean ;
                  rdfs:domain gmat:Aging ;
                  rdfs:range xsd:float ;
                  rdfs:comment "DEPRECATED: unit-less float shortcut. Model the aging duration as a gmat:Duration (om:Time) instance linked to the gmat:Aging process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. The duration of the aging step after gelation, typically measured in hours"@en ;
                  rdfs:label "has aging time"@en .


###  https://w3id.org/polymat/hasCASNr
pmat:hasCASNr rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf pmat:hasID ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( pmat:Monomer
                                          pmat:Polymer
                                          pmat:Substance
                                        )
                          ] ;
              rdfs:range xsd:string ;
              rdfs:comment "Chemical Abstract Service (CAS) number is a unique identifier assigned to every chemical substance to provide a standardised way of referencing and identifying it"@en ;
              rdfs:label "has CAS nr"@en .


###  https://w3id.org/gelmat/hasDensity
gmat:hasDensity rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:RO_0000053 ;
                rdfs:domain pmat:Substance ;
                rdfs:range gmat:Density ;
                rdfs:comment "Relates a substance to its density, expressed as a gmat:Density individual with an om:Measure value in the canonical SI unit kg/m3 (g/cm3 = 1000 kg/m3 is a common lab convention)"@en ;
                rdfs:label "has density"@en .


###  https://w3id.org/gelmat/hasGelTime
gmat:hasGelTime rdf:type owl:DatatypeProperty ;
                owl:deprecated "true"^^xsd:boolean ;
                rdfs:domain gmat:Gel ;
                rdfs:range xsd:float ;
                rdfs:comment "DEPRECATED: domain error (gel time is a process property, not a material property). Use gmat:hasGelationTimeValue on gmat:Gelation instead. The time duration for sol-gel transition, measured in minutes from when catalysts are mixed until the gel network forms"@en ;
                rdfs:label "has gel time"@en .


###  https://w3id.org/polymat/hasID
pmat:hasID rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           rdfs:comment """An Identifier (ID) is one or more characters used to identify, name, or characterize the nature, properties, or contents of a thing.
(http://purl.obolibrary.org/obo/NCIT_C25364)"""@en ;
           rdfs:label "has ID"@en .


###  https://w3id.org/polymat/hasIUPACName
pmat:hasIUPACName rdf:type owl:DatatypeProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( pmat:Monomer
                                              pmat:Polymer
                                              pmat:Substance
                                            )
                              ] ;
                  rdfs:range xsd:string ;
                  rdfs:comment "IUPAC name is a name of a chemical compound according to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature"@en ;
                  rdfs:label "has IUPAC name"@en .


###  https://w3id.org/gelmat/hasMolarRatio
gmat:hasMolarRatio rdf:type owl:DatatypeProperty ;
                   owl:deprecated "true"^^xsd:boolean ;
                   rdfs:domain gmat:AerogelSynthesis ;
                   rdfs:range xsd:string ;
                   rdfs:comment "DEPRECATED: machine-unreadable string representation. Use gmat:MolarRatio class with gmat:hasRatioComponent and gmat:WaterToSilicaRatio instead. The molar ratio of reactants in the synthesis (e.g., 'TEOS:H2O:Catalyst = 1:4:0.01')"@en ;
                   rdfs:label "has molar ratio"@en .


###  https://w3id.org/polymat/hasOrderNumber
pmat:hasOrderNumber rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf pmat:hasID ;
                    rdfs:domain pmat:ExperimentRequestSubmission ;
                    rdfs:range xsd:string ;
                    rdfs:comment "An order number is a reference number assigned to an experiment when it is submitted for processing."@en ;
                    rdfs:label "has order number"@en .


###  https://w3id.org/polymat/hasPath
pmat:hasPath rdf:type owl:DatatypeProperty ;
             rdfs:domain pmat:DigitalData ;
             rdfs:range xsd:string ;
             rdfs:comment "A path represents the location or address of a file or directory within the file system hierarchy."@en ;
             rdfs:label "has path"@en .


###  https://w3id.org/polymat/hasProductID
pmat:hasProductID rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf pmat:hasID ;
                  rdfs:range xsd:string ;
                  rdfs:comment """A product ID is a permanent, unique identifier assigned to a product by its producer.
(https://ode.rsl.wustl.edu/mars/pagehelp/Content/Frequently_Asked_Questions/Product_ID.htm?Highlight=Product%20ID)"""@en ;
                  rdfs:label "has product ID"@en .


###  https://w3id.org/polymat/hasRequestSubmissionType
pmat:hasRequestSubmissionType rdf:type owl:DatatypeProperty ;
                              rdfs:domain pmat:ExperimentRequestSubmission ;
                              rdfs:range xsd:string ;
                              rdfs:comment "A request submission type is an experiment submission type description, e.g. synthesis, fabrication, analysis."@en ;
                              rdfs:label "has request submission type"@en .


###  https://w3id.org/gelmat/hasSurfaceArea
gmat:hasSurfaceArea rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf obo:RO_0000053 ;
                    rdfs:domain pmat:Substance ;
                    rdfs:range gmat:SurfaceArea ;
                    rdfs:comment "Relates a substance to its BET-determined specific surface area, expressed as a gmat:SurfaceArea individual with an om:Measure value in m2/g"@en ;
                    rdfs:label "has surface area"@en .


###  https://w3id.org/polymat/hasVersion
pmat:hasVersion rdf:type owl:DatatypeProperty ;
                rdfs:domain pmat:Software ;
                rdfs:range xsd:string ;
                rdfs:comment "A version is a specific release of a software system, application, library or any other piece of software"@en ;
                rdfs:label "has version"@en .


###  https://w3id.org/polymat/submissionEndedAt
pmat:submissionEndedAt rdf:type owl:DatatypeProperty ;
                       rdfs:domain pmat:ExperimentRequestSubmission ;
                       rdfs:range xsd:dateTime ;
                       rdfs:comment "end time and date of a given experiment submission"@en ;
                       rdfs:label "submission ended at"@en .


###  https://w3id.org/polymat/submissionStartedAt
pmat:submissionStartedAt rdf:type owl:DatatypeProperty ;
                         rdfs:domain pmat:ExperimentRequestSubmission ;
                         rdfs:range xsd:dateTime ;
                         rdfs:comment "start time and date of a given experiment submission"@en ;
                         rdfs:label "submission started at"@en .




###  https://w3id.org/gelmat/hasThermalConductivity
gmat:hasThermalConductivity rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf obo:RO_0000053 ;
                            rdfs:domain pmat:Substance ;
                            rdfs:range gmat:ThermalConductivity ;
                            rdfs:comment "Relates a substance to its thermal conductivity, expressed as a gmat:ThermalConductivity individual with om:Measure value in W/(m.K)"@en ;
                            rdfs:label "has thermal conductivity"@en .


###  https://w3id.org/gelmat/hasPorosity
gmat:hasPorosity rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000053 ;
                 rdfs:domain pmat:Substance ;
                 rdfs:range gmat:Porosity ;
                 rdfs:comment "Relates a substance to its porosity, expressed as a gmat:Porosity individual with om:Measure value as a fraction or percentage"@en ;
                 rdfs:label "has porosity"@en .


###  https://w3id.org/gelmat/hasMeanPoreSize
gmat:hasMeanPoreSize rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000053 ;
                     rdfs:domain pmat:Substance ;
                     rdfs:range gmat:MeanPoreSize ;
                     rdfs:comment "Relates a substance to its mean pore size (BJH), expressed as a gmat:MeanPoreSize individual with om:Measure value in nm"@en ;
                     rdfs:label "has mean pore size"@en .


###  https://w3id.org/gelmat/hasContactAngle
gmat:hasContactAngle rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000053 ;
                     rdfs:domain pmat:Substance ;
                     rdfs:range gmat:ContactAngle ;
                     rdfs:comment "Relates a substance to its water contact angle, expressed as a gmat:ContactAngle individual with om:Measure value in degrees"@en ;
                     rdfs:label "has contact angle"@en .


###  https://w3id.org/gelmat/hasLinearShrinkage
gmat:hasLinearShrinkage rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0000053 ;
                        rdfs:domain pmat:Substance ;
                        rdfs:range gmat:Shrinkage ;
                        rdfs:comment "Relates a substance to its linear shrinkage during drying, expressed as a gmat:Shrinkage individual with om:Measure value as a percentage"@en ;
                        rdfs:label "has linear shrinkage"@en .


###  https://w3id.org/gelmat/hasCompressiveStrength
gmat:hasCompressiveStrength rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf obo:RO_0000053 ;
                            rdfs:domain pmat:Substance ;
                            rdfs:range gmat:CompressiveStrength ;
                            rdfs:comment "Relates a substance to its maximum compressive strength, expressed as a gmat:CompressiveStrength individual with om:Measure value in kPa or MPa"@en ;
                            rdfs:label "has compressive strength"@en .


###  https://w3id.org/gelmat/hasCompressiveModulus
gmat:hasCompressiveModulus rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf obo:RO_0000053 ;
                           rdfs:domain pmat:Substance ;
                           rdfs:range gmat:CompressiveModulus ;
                           rdfs:comment "Relates a substance to its compressive (Young's) modulus, expressed as a gmat:CompressiveModulus individual with om:Measure value in kPa or MPa"@en ;
                           rdfs:label "has compressive modulus"@en .


###  https://w3id.org/gelmat/hasTransmittance
gmat:hasTransmittance rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf obo:RO_0000053 ;
                      rdfs:domain pmat:Substance ;
                      rdfs:range gmat:Transmittance ;
                      rdfs:comment "Relates a substance to its optical transmittance, expressed as a gmat:Transmittance individual with om:Measure value as percentage (0-100)"@en ;
                      rdfs:label "has transmittance"@en .


###  https://w3id.org/gelmat/hasYoungsModulus
gmat:hasYoungsModulus rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf obo:RO_0000053 ;
                      rdfs:domain pmat:Substance ;
                      rdfs:range gmat:YoungsModulus ;
                      rdfs:comment "Relates a substance to its Young's (elastic) modulus, expressed as a gmat:YoungsModulus individual with om:Measure value in Pa"@en ;
                      rdfs:label "has Young's modulus"@en .


###  https://w3id.org/gelmat/hasTensileStrength
gmat:hasTensileStrength rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0000053 ;
                        rdfs:domain pmat:Substance ;
                        rdfs:range pmat:UltimateTensileStrength ;
                        rdfs:comment "Relates a substance to its ultimate tensile strength, expressed as a pmat:UltimateTensileStrength individual with om:Measure value in Pa"@en ;
                        rdfs:label "has tensile strength"@en .


###  https://w3id.org/gelmat/hasPoissonRatio
gmat:hasPoissonRatio rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf obo:RO_0000053 ;
                     rdfs:domain pmat:Substance ;
                     rdfs:range gmat:PoissonRatio ;
                     rdfs:comment "Relates a substance to its Poisson ratio, expressed as a gmat:PoissonRatio individual with a dimensionless om:Measure value"@en ;
                     rdfs:label "has Poisson ratio"@en .


###  https://w3id.org/gelmat/hasFlexuralStrength
gmat:hasFlexuralStrength rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf obo:RO_0000053 ;
                         rdfs:domain pmat:Substance ;
                         rdfs:range gmat:FlexuralStrength ;
                         rdfs:comment "Relates a substance to its flexural (bending) strength, expressed as a gmat:FlexuralStrength individual with om:Measure value in Pa"@en ;
                         rdfs:label "has flexural strength"@en .


###  https://w3id.org/gelmat/hasFlexuralModulus
gmat:hasFlexuralModulus rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0000053 ;
                        rdfs:domain pmat:Substance ;
                        rdfs:range gmat:FlexuralModulus ;
                        rdfs:comment "Relates a substance to its flexural (bending) modulus, expressed as a gmat:FlexuralModulus individual with om:Measure value in Pa"@en ;
                        rdfs:label "has flexural modulus"@en .


###  https://w3id.org/gelmat/hasSpecificHeatCapacity
gmat:hasSpecificHeatCapacity rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf obo:RO_0000053 ;
                             rdfs:domain pmat:Substance ;
                             rdfs:range gmat:SpecificHeatCapacity ;
                             rdfs:comment "Relates a substance to its specific heat capacity, expressed as a gmat:SpecificHeatCapacity individual with om:Measure value in J/(kg.K)"@en ;
                             rdfs:label "has specific heat capacity"@en .


###  https://w3id.org/gelmat/hasThermalDiffusivity
gmat:hasThermalDiffusivity rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf obo:RO_0000053 ;
                           rdfs:domain pmat:Substance ;
                           rdfs:range gmat:ThermalDiffusivity ;
                           rdfs:comment "Relates a substance to its thermal diffusivity, expressed as a gmat:ThermalDiffusivity individual with om:Measure value in m^2/s"@en ;
                           rdfs:label "has thermal diffusivity"@en .


###  https://w3id.org/gelmat/hasThermalExpansionCoefficient
gmat:hasThermalExpansionCoefficient rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf obo:RO_0000053 ;
                                    rdfs:domain pmat:Substance ;
                                    rdfs:range gmat:ThermalExpansionCoefficient ;
                                    rdfs:comment "Relates a substance to its linear coefficient of thermal expansion, expressed as a gmat:ThermalExpansionCoefficient individual with om:Measure value in K^-1"@en ;
                                    rdfs:label "has thermal expansion coefficient"@en .


###  https://w3id.org/gelmat/hasFractalDimension
gmat:hasFractalDimension rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf obo:RO_0000053 ;
                         rdfs:domain pmat:Substance ;
                         rdfs:range gmat:FractalDimension ;
                         rdfs:comment "Relates a substance to a fractal dimension (mass or surface), expressed as a gmat:FractalDimension individual with a dimensionless om:Measure value. Use gmat:hasMassFractalDimension or gmat:hasSurfaceFractalDimension for the specific type"@en ;
                         rdfs:label "has fractal dimension"@en .


###  https://w3id.org/gelmat/hasMassFractalDimension
gmat:hasMassFractalDimension rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf gmat:hasFractalDimension ;
                             rdfs:domain pmat:Substance ;
                             rdfs:range gmat:MassFractalDimension ;
                             rdfs:comment "Relates a substance to its mass fractal dimension (Dm), expressed as a gmat:MassFractalDimension individual with a dimensionless om:Measure value (1-3)"@en ;
                             rdfs:label "has mass fractal dimension"@en .


###  https://w3id.org/gelmat/hasSurfaceFractalDimension
gmat:hasSurfaceFractalDimension rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf gmat:hasFractalDimension ;
                                rdfs:domain pmat:Substance ;
                                rdfs:range gmat:SurfaceFractalDimension ;
                                rdfs:comment "Relates a substance to its surface fractal dimension (Ds), expressed as a gmat:SurfaceFractalDimension individual with a dimensionless om:Measure value (2-3)"@en ;
                                rdfs:label "has surface fractal dimension"@en .


###  https://w3id.org/gelmat/hasPorodExponent
gmat:hasPorodExponent rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf obo:RO_0000053 ;
                      rdfs:domain pmat:Substance ;
                      rdfs:range gmat:PorodExponent ;
                      rdfs:comment "Relates a substance to the power-law (Porod) exponent of its scattering curve, expressed as a gmat:PorodExponent individual with a dimensionless om:Measure value"@en ;
                      rdfs:label "has Porod exponent"@en .


###  https://w3id.org/gelmat/hasCorrelationLength
gmat:hasCorrelationLength rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf obo:RO_0000053 ;
                          rdfs:domain pmat:Substance ;
                          rdfs:range gmat:CorrelationLength ;
                          rdfs:comment "Relates a substance to the correlation length (ξ, fractal upper cutoff / cluster size) of its network, expressed as a gmat:CorrelationLength individual with om:Measure value in metres (nm scale)"@en ;
                          rdfs:label "has correlation length"@en .


###  https://w3id.org/gelmat/hasPHValue
gmat:hasPHValue rdf:type owl:DatatypeProperty ;
                rdfs:domain gmat:PHCondition ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:onDatatype xsd:float ;
                             owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ]
                                                    [ xsd:maxInclusive "14.0"^^xsd:float ]
                                                  )
                           ] ;
                rdfs:comment "The numeric pH value maintained during a sol-gel process step (typically 1.5-3 for acid catalysis, 7.5-10 for base catalysis). Range restricted to 0.0-14.0"@en ;
                rdfs:label "has pH value"@en .


###  https://w3id.org/gelmat/hasExchangeCount
gmat:hasExchangeCount rdf:type owl:DatatypeProperty ;
                      rdfs:domain gmat:SolventExchange ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "Number of individual solvent exchange (washing) cycles performed to replace the pore liquid"@en ;
                      rdfs:label "has exchange count"@en .


###  https://w3id.org/gelmat/hasGelationTimeValue
gmat:hasGelationTimeValue rdf:type owl:DatatypeProperty ;
                          owl:deprecated "true"^^xsd:boolean ;
                          rdfs:domain gmat:Gelation ;
                          rdfs:range xsd:float ;
                          rdfs:comment "DEPRECATED: unit-less float shortcut. Model the gel time as a gmat:GelationTime (om:Time) instance linked to the gmat:Gelation process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. Observed gel time from initiation of gelation (e.g. mixing of catalyst) to the gel point, typically in minutes"@en ;
                          rdfs:label "has gelation time value"@en .



###  https://w3id.org/gelmat/hasFractalDimensionValue
gmat:hasFractalDimensionValue rdf:type owl:DatatypeProperty ;
                              rdfs:domain gmat:FractalDimension ;
                              rdfs:range [ rdf:type rdfs:Datatype ;
                                           owl:onDatatype xsd:float ;
                                           owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float ]
                                                                  [ xsd:maxInclusive "3.0"^^xsd:float ]
                                                                )
                                         ] ;
                              rdfs:comment "The numeric value of the mass fractal dimension of an aerogel network, dimensionless. Typical range for silica aerogels: 1.7-2.4 (from SAXS/SANS)"@en ;
                              rdfs:label "has fractal dimension value"@en .


###  https://w3id.org/gelmat/hasNetworkConnectivityValue
gmat:hasNetworkConnectivityValue rdf:type owl:DatatypeProperty ;
                                 rdfs:domain gmat:NetworkConnectivity ;
                                 rdfs:range xsd:float ;
                                 rdfs:comment "Average number of siloxane bonds per network node, as determined by solid-state 29Si NMR (Q2/Q3/Q4 species ratios). Higher values indicate more cross-linked, stiffer networks"@en ;
                                 rdfs:label "has network connectivity value"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000002
obo:BFO_0000002 rdf:type owl:Class ;
                  owl:disjointWith obo:BFO_0000003 ;
                  dc:identifier "008-BFO" ;
                  rdfs:label "continuant"@en ;
                  skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en ;
                  skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .


###  http://purl.obolibrary.org/obo/BFO_0000003
obo:BFO_0000003 rdf:type owl:Class ;
                  dc:identifier "077-BFO" ;
                  rdfs:label "occurrent"@en ;
                  skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en ;
                  skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .


###  http://purl.obolibrary.org/obo/BFO_0000004
obo:BFO_0000004 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000002 ;
                  dc:identifier "017-BFO" ;
                  rdfs:label "Independent continuant"@en ;
                  skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en ;
                  skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .


###  http://purl.obolibrary.org/obo/BFO_0000006
obo:BFO_0000006 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000141 ;
                  dc:identifier "035-BFO" ;
                  rdfs:label "spatial region"@en ;
                  skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
                  skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000003 ,
                                  prov:Activity ;
                  dc:identifier "083-BFO" ;
                  rdfs:label "process"@en ;
                  skos:altLabel "event"@en ;
                  skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
                  skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
obo:BFO_0000017 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000020 ;
                  dc:identifier "058-BFO" ;
                  rdfs:label "realizable entity"@en ;
                  skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en ;
                  skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
obo:BFO_0000020 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000002 ;
                  dc:identifier "050-BFO" ;
                  rdfs:label "specifically dependent continuant"@en ;
                  skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en ;
                  skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en ,
                               "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .


###  http://purl.obolibrary.org/obo/BFO_0000031
obo:BFO_0000031 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000002 ;
                  dc:identifier "074-BFO" ;
                  rdfs:label "generically dependent continuant"@en ;
                  skos:definition "b is a generically dependent continuant =Def b is a continuant & there is some time t such that there is some independent continuant c & b s-depends_on c at t"@en ;
                  skos:example "A symphony; a score of a film; a patent; a plan; a procedure; a software algorithm"@en .


###  http://purl.obolibrary.org/obo/BFO_0000023
obo:BFO_0000023 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000017 ;
                  dc:identifier "061-BFO" ;
                  rdfs:label "Role"@en ;
                  skos:altLabel "externally-grounded realizable entity"@en ;
                  skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
                  skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
obo:BFO_0000040 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000004 ,
                                  prov:Entity ;
                  owl:disjointWith obo:BFO_0000141 ;
                  dc:identifier "019-BFO" ;
                  rdfs:label "Material entity"@en ;
                  skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en ;
                  skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en .


###  http://purl.obolibrary.org/obo/BFO_0000141
obo:BFO_0000141 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000004 ;
                  dc:identifier "028-BFO" ;
                  rdfs:label "Immaterial entity"@en ;
                  skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en ;
                  skos:example "As for fiat point, fiat line, fiat surface, site"@en .


###  http://purl.obolibrary.org/obo/CHEBI_24431
obo:CHEBI_24431 rdf:type owl:Class ;
                  rdfs:subClassOf pmat:Substance ;
                  rdfs:comment "A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances."@en ;
                  rdfs:label "Chemical entity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration
om:AmountOfSubstanceConcentration rdf:type owl:Class ;
                                  rdfs:subClassOf om:Quantity ;
                                  rdfs:comment """A measure of the concentration of a chemical species, in particular, of a solute in a solution, in terms of amount of substance per unit volume of solution
(https://en.wikipedia.org/wiki/Molar_concentration)"""@en ;
                                  rdfs:label "Amount of substance concentration"@en ;
                                  skos:altLabel "Amount concentration"@en ,
                                                "Molar concentration"@en ,
                                                "Molarity"@en ,
                                                "Substance concentration"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Length
om:Length rdf:type owl:Class ;
          rdfs:subClassOf om:Quantity ;
          rdfs:comment "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval."@en ;
          rdfs:label "Length"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Measure
om:Measure rdf:type owl:Class ;
           rdfs:comment "A measure combines a number to a unit of measure. For example, \"3 m\" is a measure."@en ;
           rdfs:label "measure"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity
om:ModulusOfElasticity rdf:type owl:Class ;
                       rdfs:subClassOf om:Quantity ;
                       rdfs:comment """the ratio of tensile stress to tensile strain of a material
(http://purl.allotrope.org/ontologies/quality#AFQ_0000341)"""@en ;
                       rdfs:label "Modulus of elasticity"@en ;
                       skos:altLabel "Young’s modulus"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Permeability-EarthScience
om:Permeability-EarthScience rdf:type owl:Class ;
                             rdfs:subClassOf pmat:Permeability-Diffusion ;
                             rdfs:comment """The permeability multiplied by the permeating fluids' viscosity, it is commonly used for porous solids such as rocks

k = eta･V･d / (A･t･p) = eta･nu･d/p = eta･D/p

k = permeability (earth science)
V = Volume of the permeate [m³]
nu = velocity of the permeate [m/s]
eta = dynamic viscosoty of the permeate [Pa･s]
d = thickness of the rock [m]
A = area of the rock [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit of the permeability (earth science) is m², commonly called Darcy"""@en ;
                             rdfs:label "Permeability (earth science)"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Point
om:Point rdf:type owl:Class ;
         rdfs:comment "A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature."@en ;
         rdfs:label "point"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity
om:Quantity rdf:type owl:Class ;
            rdfs:subClassOf pmat:Feature ;
            rdfs:comment """A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, a molecule, or a food product). Quantities are classified according to similarity in their (implicit) metrological aspect, e.g. the length of my table and the length of my chair are both classified as length.
"""@en ;
            rdfs:label "Quantity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature
om:Temperature rdf:type owl:Class ;
               rdfs:subClassOf om:Quantity ;
               rdfs:comment "Temperature is the extent to which an object is hot"@en ;
               rdfs:label "Temperature"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness
om:Thickness rdf:type owl:Class ;
             rdfs:subClassOf om:Length ;
             rdfs:comment "The smallest dimension of a flat object, usually a mean value of several measurements"@en ;
             rdfs:label "Thickness"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Time
om:Time rdf:type owl:Class ;
        rdfs:subClassOf om:Quantity ;
        rdfs:comment "Time is a base quantity in the International System of Units and other systems of units. It is measured by numbers of repetitions of cyclical events."@en ;
        rdfs:label "Time"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Unit
om:Unit rdf:type owl:Class ;
        rdfs:comment "A unit of measure is a definite magnitude of a quantity, defined and adopted by convention or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"."@en ;
        rdfs:label "unit"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Volume
om:Volume rdf:type owl:Class ;
          rdfs:subClassOf om:Quantity ;
          rdfs:comment """Volume is a measure of how much three-dimensional space any phenomenon occupies. It is a derived quantity in the International System of Units

Volume is length to the power 3"""@en ;
          rdfs:label "Volume"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress
om:CompressiveStress rdf:type owl:Class ;
                     rdfs:subClassOf om:Stress ;
                     rdfs:comment "Stress acting to compress an object, i.e. the force per unit area directed towards the material. Declared locally (subclass of om:Stress) so that gmat:CompressiveStrength remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                     rdfs:label "Compressive stress"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure
om:Pressure rdf:type owl:Class ;
            rdfs:subClassOf om:Quantity ;
            rdfs:comment "Pressure is the force applied perpendicular to the surface of an object per unit area. In sol-gel processing it covers autoclave and supercritical drying pressures, vacuum levels, and gas pressures. Declared locally so the class is available without resolving the OM-2 import"@en ;
            gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            rdfs:label "Pressure"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity
om:SpecificHeatCapacity rdf:type owl:Class ;
                        rdfs:subClassOf om:Quantity ;
                        rdfs:comment "Specific heat capacity is the amount of heat required to raise the temperature of a unit mass of substance by one kelvin. Declared locally so that gmat:SpecificHeatCapacity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                        rdfs:label "Specific heat capacity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Stress
om:Stress rdf:type owl:Class ;
          rdfs:subClassOf om:Quantity ;
          rdfs:comment "Stress is the internal force per unit area within a material that arises from externally applied forces. Declared locally so that gmat:FlexuralStrength and om:CompressiveStress remain under om:Quantity even when the OM-2 import is not resolved"@en ;
          rdfs:label "Stress"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity
om:ThermalConductivity rdf:type owl:Class ;
                       rdfs:subClassOf om:Quantity ;
                       rdfs:comment "Thermal conductivity is the property of a material to conduct heat. Declared locally so that gmat:ThermalConductivity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                       rdfs:label "Thermal conductivity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity
om:ThermalDiffusivity rdf:type owl:Class ;
                      rdfs:subClassOf om:Quantity ;
                      rdfs:comment "Thermal diffusivity is the thermal conductivity divided by density and specific heat capacity at constant pressure. Declared locally so that gmat:ThermalDiffusivity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                      rdfs:label "Thermal diffusivity"@en .




###  https://w3id.org/gelmat/Density
gmat:Density rdf:type owl:Class ;
             rdfs:subClassOf om:Quantity ;
             rdfs:comment "The mass per unit volume of a material. Canonical unit: kg/m3 (SI); the lab convention g/cm3 (= 1000 kg/m3) is also common. Bulk density is typically 1-500 kg/m3 (0.001-0.5 g/cm3); skeletal density (determined by He pycnometry) is typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica"@en ;
             gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> ;
             rdfs:label "Density"@en ;
             skos:definition "The ratio of the mass of a material to its volume; for aerogels the bulk density captures the contribution of both the solid skeleton and the gas-filled pore space"@en .


###  https://w3id.org/gelmat/BulkDensity
gmat:BulkDensity rdf:type owl:Class ;
                 rdfs:subClassOf gmat:Density ;
                 rdfs:comment "The mass of a porous body divided by its envelope (geometric) volume, including the pore space. The most commonly reported density of aerogels, typically 1-500 kg/m3 (0.001-0.5 g/cm3) for silica aerogels; determined geometrically or by envelope (powder displacement) pycnometry"@en ;
                 gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> ;
                 rdfs:label "Bulk density"@en ;
                 skos:definition "The density of a porous material computed over its envelope volume, i.e. including both the solid skeleton and the gas-filled pore space"@en ;
                 skos:altLabel "Envelope density"@en ,
                               "Apparent density"@en .


###  https://w3id.org/gelmat/SkeletalDensity
gmat:SkeletalDensity rdf:type owl:Class ;
                     rdfs:subClassOf gmat:Density ;
                     rdfs:comment "The mass of a porous body divided by the volume of its solid skeleton only, excluding open pore space; determined by helium pycnometry (gmat:SkeletalDensityMeasurement). Typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica aerogels"@en ;
                     gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> ;
                     rdfs:label "Skeletal density"@en ;
                     skos:definition "The density of the solid skeleton of a porous material, computed over the skeletal volume that excludes open pores; measured by gas displacement (helium) pycnometry"@en ;
                     skos:altLabel "True density"@en .


###  https://w3id.org/gelmat/TapDensity
gmat:TapDensity rdf:type owl:Class ;
                rdfs:subClassOf gmat:Density ;
                rdfs:comment "The bulk density of a powder or granulate after mechanical tapping of the container until no further volume change occurs; relevant for aerogel powders, beads, and granulates"@en ;
                gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> ;
                rdfs:label "Tap density"@en ;
                skos:definition "The density of a powder or granular material measured after tapping the container to a constant volume"@en .


###  https://w3id.org/gelmat/SurfaceArea
gmat:SurfaceArea rdf:type owl:Class ;
                 rdfs:subClassOf om:Quantity ;
                 rdfs:comment "The specific surface area (BET) of a porous material in m2/g, measured by N2 physisorption and analysis of the adsorption isotherm using the Brunauer-Emmett-Teller model. Aerogels typically exhibit 200-1000 m2/g"@en ;
                 gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerGram> ;
                 rdfs:label "Surface area"@en ;
                 skos:definition "The total internal and external surface area of a porous material per unit mass, determined by BET N2 physisorption; the primary indicator of aerogel texture and catalytic or adsorption capacity"@en ;
                 skos:altLabel "BET surface area"@en ,
                               "Specific surface area"@en .


###  https://w3id.org/gelmat/MeanPoreSize
gmat:MeanPoreSize rdf:type owl:Class ;
                  rdfs:subClassOf om:Length ;
                  owl:equivalentClass pmat:MeanPoreDiameter ;
                  rdfs:comment "The average pore diameter of a porous material, typically determined from BJH analysis of desorption isotherms or from small-angle scattering; expressed in nanometres. Aerogels predominantly exhibit mesopores (2-50 nm). Equivalent to pmat:MeanPoreDiameter, which Polymat declares independently for membrane materials"@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
                  rdfs:label "Mean pore size"@en ;
                  skos:definition "The average equivalent spherical diameter of the pore space distribution in a porous material, expressed in nanometres and typically determined by BJH desorption analysis"@en ;
                  skos:altLabel "Average pore diameter"@en .


###  https://w3id.org/gelmat/CompressiveModulus
gmat:CompressiveModulus rdf:type owl:Class ;
                        rdfs:subClassOf om:ModulusOfElasticity ;
                        rdfs:comment "The ratio of compressive stress to compressive strain in the elastic region of the stress-strain curve, expressed in kPa or MPa. For aerogels this reflects network stiffness and cross-linking density"@en ;
                        gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
                        rdfs:label "Compressive modulus"@en ;
                        skos:definition "The elastic modulus measured under uniaxial compression, equal to the slope of the linear region of the compressive stress-strain curve"@en ;
                        skos:altLabel "Young's modulus (compression)"@en .


###  https://w3id.org/gelmat/ThermalConductivity
gmat:ThermalConductivity rdf:type owl:Class ;
                         rdfs:subClassOf om:ThermalConductivity ;
                         rdfs:comment "The property of a material to conduct heat, defined as the rate of heat flow through a unit thickness per unit area per unit temperature difference. For aerogels, low thermal conductivity is a key performance metric, with values typically in the range 0.012-0.025 W/(m*K)"@en ;
                 skos:definition "A material property quantity representing the rate of heat transfer through a material; expressed as an om:Measure with unit W/(m·K). Lower values indicate better thermal insulation."@en ;
                         gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/wattPerMetreKelvin> ;
                         rdfs:label "Thermal conductivity"@en .


###  https://w3id.org/gelmat/Porosity
gmat:Porosity rdf:type owl:Class ;
              rdfs:subClassOf om:Quantity ;
              rdfs:comment "The ratio of void volume to total volume in a porous material, expressed as a fraction or percentage. Aerogels typically exhibit porosity > 90%, which directly impacts their thermal, acoustic, and mechanical properties"@en ;
                 skos:definition "A material property quantity representing the fraction of void space in a material relative to its total volume; expressed as an om:Measure with unit fraction (0–1) or percent."@en ;
              gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
              rdfs:label "Porosity"@en .


###  https://w3id.org/gelmat/PoreSizeDistribution
gmat:PoreSizeDistribution rdf:type owl:Class ;
                           rdfs:subClassOf om:Quantity ;
                           rdfs:comment "A statistical description of the range and frequency of pore sizes within a porous material, typically determined by BJH analysis or mercury intrusion porosimetry. Aerogels predominantly feature mesopores (2-50 nm)"@en ;
                 skos:definition "A material property describing the statistical distribution of pore sizes within a porous material, typically characterised by BJH analysis of N₂ adsorption isotherms."@en ;
                           gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
                           rdfs:label "Pore size distribution"@en .


###  https://w3id.org/gelmat/ContactAngle
gmat:ContactAngle rdf:type owl:Class ;
                  rdfs:subClassOf om:Quantity ;
                  rdfs:comment "The angle at which a liquid-vapor interface meets a solid surface, quantifying wettability. Key metric for hydrophobic aerogels (contact angle > 90 degrees) and superhydrophobic aerogels (contact angle > 150 degrees)"@en ;
                 skos:definition "A material property quantity representing the angle between a liquid droplet interface and a solid surface, used to quantify hydrophobicity; expressed as an om:Measure with unit degrees. Values above 90° indicate hydrophobic surfaces."@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/radian> ;
                  rdfs:label "Contact angle"@en .


###  https://w3id.org/gelmat/CompressiveStrength
gmat:CompressiveStrength rdf:type owl:Class ;
                         rdfs:subClassOf om:CompressiveStress ;
                         rdfs:comment "The maximum compressive stress a material can sustain before fracture, yielding, or excessive deformation. A critical mechanical property for structural and load-bearing aerogel applications"@en ;
                 skos:definition "A material property quantity representing the maximum compressive stress a material can withstand before failure; expressed as an om:Measure with unit kPa or MPa."@en ;
                         gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
                         rdfs:label "Compressive strength"@en .


###  https://w3id.org/gelmat/Shrinkage
gmat:Shrinkage rdf:type owl:Class ;
               rdfs:subClassOf om:Quantity ;
               rdfs:comment "The relative dimensional change (linear or volumetric) of a gel during the drying process, expressed as a fraction or percentage. High shrinkage indicates capillary-force-driven pore collapse, common in ambient pressure drying"@en ;
                 skos:definition "A material property quantity representing the linear dimensional change of a gel or aerogel during processing (drying, aging) relative to the original gel dimension; expressed as an om:Measure with unit percent."@en ;
               gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
               rdfs:label "Shrinkage"@en .


###  https://w3id.org/gelmat/Transmittance
gmat:Transmittance rdf:type owl:Class ;
                   rdfs:subClassOf om:Quantity ;
                   rdfs:comment "The fraction of incident electromagnetic radiation that passes through a material at a given wavelength. Transparent silica aerogels can exhibit > 90% transmittance in the visible range"@en ;
                 skos:definition "A material property quantity representing the fraction of incident light transmitted through a material at a specified wavelength; expressed as an om:Measure with unit percent or dimensionless (0–1)."@en ;
                   gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                   rdfs:label "Transmittance"@en .


###  https://w3id.org/gelmat/SpecificHeatCapacity
gmat:SpecificHeatCapacity rdf:type owl:Class ;
                          rdfs:subClassOf om:SpecificHeatCapacity ;
                          rdfs:comment "The amount of heat energy required to raise the temperature of a unit mass of material by one degree, typically expressed in J/(kg*K). Relevant for aerogel thermal energy storage applications"@en ;
                 skos:definition "A material property quantity representing the heat energy required to raise the temperature of a unit mass of material by one kelvin; expressed as an om:Measure with unit J/(kg·K)."@en ;
                          gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerKelvinKilogram> ;
                          rdfs:label "Specific heat capacity"@en .


###  https://w3id.org/gelmat/YoungsModulus
gmat:YoungsModulus rdf:type owl:Class ;
                   rdfs:subClassOf om:ModulusOfElasticity ;
                   rdfs:comment "The ratio of tensile (or uniaxial) stress to axial strain in the linear-elastic region of the stress-strain curve, expressed in Pa. Characterises the intrinsic stiffness of the aerogel solid network; typically 10^4-10^7 Pa for silica aerogels"@en ;
                   skos:definition "The elastic modulus relating uniaxial stress to axial strain in the linear-elastic regime; equal to the slope of the initial linear portion of the stress-strain curve"@en ;
                   gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
                   skos:altLabel "Elastic modulus"@en ,
                                 "Modulus of elasticity"@en ;
                   rdfs:label "Young's modulus"@en .


###  https://w3id.org/gelmat/FlexuralModulus
gmat:FlexuralModulus rdf:type owl:Class ;
                     rdfs:subClassOf om:ModulusOfElasticity ;
                     rdfs:comment "The ratio of stress to strain in flexural (bending) deformation, measured by three- or four-point bending, expressed in Pa"@en ;
                     skos:definition "The elastic modulus measured under bending load, equal to the slope of the linear region of the flexural stress-strain curve"@en ;
                     gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
                     skos:altLabel "Bending modulus"@en ;
                     rdfs:label "Flexural modulus"@en .


###  https://w3id.org/gelmat/FlexuralStrength
gmat:FlexuralStrength rdf:type owl:Class ;
                      rdfs:subClassOf om:Stress ;
                      rdfs:comment "The maximum stress at the outer fibre of a specimen at the point of failure under bending load, expressed in Pa"@en ;
                      skos:definition "The maximum bending stress a material can sustain before rupture, determined by three- or four-point flexural testing"@en ;
                      gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
                      skos:altLabel "Modulus of rupture"@en ,
                                    "Bending strength"@en ;
                      rdfs:label "Flexural strength"@en .


###  https://w3id.org/gelmat/PoissonRatio
gmat:PoissonRatio rdf:type owl:Class ;
                  rdfs:subClassOf om:Quantity ;
                  rdfs:comment "The negative ratio of transverse strain to axial strain under uniaxial load; a dimensionless elastic constant. Reported for aerogels to characterise their compressible, low-Poisson network (often 0.1-0.2)"@en ;
                  skos:definition "The dimensionless ratio of transverse contraction strain to longitudinal extension strain in the direction of an applied uniaxial load"@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                  skos:altLabel "Poisson's ratio"@en ;
                  rdfs:label "Poisson ratio"@en .


###  https://w3id.org/gelmat/ThermalDiffusivity
gmat:ThermalDiffusivity rdf:type owl:Class ;
                        rdfs:subClassOf om:ThermalDiffusivity ;
                        rdfs:comment "The rate at which heat diffuses through a material, equal to thermal conductivity divided by the product of density and specific heat capacity, expressed in m^2/s. Very low for aerogels, reflecting their insulating behaviour"@en ;
                        skos:definition "A material property quantity representing the rate of thermal diffusion through a material (thermal conductivity / (density × specific heat capacity)); expressed as an om:Measure with unit m²/s"@en ;
                        gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerSecond-Time> ;
                        rdfs:label "Thermal diffusivity"@en .


###  https://w3id.org/gelmat/ThermalExpansionCoefficient
gmat:ThermalExpansionCoefficient rdf:type owl:Class ;
                                 rdfs:subClassOf om:Quantity ;
                                 rdfs:comment "The fractional change in length (linear) per unit change in temperature at constant pressure, expressed in K^-1. OM-2 defines no dedicated class, so this quantity is placed directly under om:Quantity with a reciprocal-kelvin canonical unit"@en ;
                                 skos:definition "A material property quantity representing the linear coefficient of thermal expansion, i.e. the relative change in a material's length per unit temperature change at constant pressure; expressed as an om:Measure with unit K⁻¹"@en ;
                                 gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalKelvin> ;
                                 skos:altLabel "Coefficient of thermal expansion"@en ,
                                               "CTE"@en ,
                                               "Linear thermal expansion coefficient"@en ;
                                 rdfs:label "Thermal expansion coefficient"@en .


###  https://w3id.org/gelmat/ActivationEnergy
gmat:ActivationEnergy rdf:type owl:Class ;
                      rdfs:subClassOf om:Quantity ;
                      rdfs:comment "The minimum energy required to initiate a chemical reaction; used in Arrhenius analysis of gelation kinetics. Typically expressed in kJ/mol"@en ;
                      gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerMole> ;
                      skos:definition "A quantity representing the minimum energy required to initiate a chemical reaction, obtained in this domain from Arrhenius analysis of gelation kinetics"@en ;
                      rdfs:label "Activation energy"@en ;
                      skos:altLabel "Ea"@en .


###  https://w3id.org/gelmat/ArrheniusConstant
gmat:ArrheniusConstant rdf:type owl:Class ;
                       rdfs:subClassOf om:Quantity ;
                       rdfs:comment "The pre-exponential factor (A) in the Arrhenius equation k = A·exp(−Ea/RT), representing the frequency of molecular collisions with correct orientation. Units match the rate constant (e.g., s⁻¹ for first-order reactions)"@en ;
                       gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalSecond-Time> ;
                       skos:definition "A quantity representing the pre-exponential factor A in the Arrhenius equation, reflecting the frequency of correctly oriented molecular collisions"@en ;
                       rdfs:label "Arrhenius pre-exponential factor"@en ;
                       skos:altLabel "Arrhenius constant"@en ,
                                     "Frequency factor"@en .


###  https://w3id.org/gelmat/CoefficientOfDetermination
gmat:CoefficientOfDetermination rdf:type owl:Class ;
                                rdfs:subClassOf om:Quantity ;
                                rdfs:comment "The coefficient of determination (R²) of a regression fit, quantifying the goodness of fit of a model to experimental data (e.g. an Arrhenius fit of gelation kinetics). Dimensionless, 0-1"@en ;
                                skos:definition "A dimensionless statistical quantity (0 ≤ R² ≤ 1) expressing the proportion of variance in observed data explained by a fitted model"@en ;
                                gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                                skos:altLabel "R-squared"@en ,
                                              "R²"@en ;
                                rdfs:label "Coefficient of determination"@en .


###  http://www.w3.org/ns/prov#Activity
prov:Activity rdf:type owl:Class ;
              owl:disjointWith prov:Entity ;
              rdfs:comment "something that occurs over a period of time and acts upon or with entities. It may include consuming, processing, transforming, modifying, relocating, using, or generating entities"@en ;
              rdfs:label "Activity"@en .


###  http://www.w3.org/ns/prov#Agent
prov:Agent rdf:type owl:Class ;
           owl:disjointWith prov:InstantaneousEvent ;
           rdfs:comment "something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity"@en ;
           rdfs:label "Agent"@en .


###  http://www.w3.org/ns/prov#AgentInfluence
prov:AgentInfluence rdf:type owl:Class ;
                    rdfs:subClassOf prov:Influence ;
                    rdfs:comment "the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other"@en ;
                    rdfs:label "Agent influence"@en .


###  http://www.w3.org/ns/prov#Association
prov:Association rdf:type owl:Class ;
                 rdfs:subClassOf prov:AgentInfluence ;
                 rdfs:comment "an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity"@en ;
                 rdfs:label "Association"@en .


###  http://www.w3.org/ns/prov#Attribution
prov:Attribution rdf:type owl:Class ;
                 rdfs:subClassOf prov:AgentInfluence ;
                 rdfs:comment "the ascribing of an entity to an agent"@en ;
                 rdfs:label "Attribution"@en .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class ;
            owl:disjointWith prov:InstantaneousEvent ;
            rdfs:comment """a physical, digital, conceptual, or other kind of thing with some fixed aspects
(http://www.w3.org/ns/prov#Entity)"""@en ;
            rdfs:label "Entity"@en .


###  http://www.w3.org/ns/prov#EntityInfluence
prov:EntityInfluence rdf:type owl:Class ;
                     rdfs:subClassOf prov:Influence ;
                     rdfs:comment "the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other"@en ;
                     rdfs:label "Entity influence"@en .


###  http://www.w3.org/ns/prov#Influence
prov:Influence rdf:type owl:Class ;
               rdfs:comment "the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation"@en ;
               rdfs:label "Influence"@en .


###  http://www.w3.org/ns/prov#InstantaneousEvent
prov:InstantaneousEvent rdf:type owl:Class ;
                        rdfs:comment "marks a transition in the world. Instantaneous events include generation, usage, or invalidation of entities, as well as starting or ending of activities"@en ;
                        rdfs:label "Instantaneous event"@en .


###  http://www.w3.org/ns/prov#Person
prov:Person rdf:type owl:Class ;
            rdfs:subClassOf prov:Agent ;
            rdfs:comment "Person agents are people."@en ;
            rdfs:label "Person"@en .


###  http://www.w3.org/ns/prov#Role
prov:Role rdf:type owl:Class ;
          rdfs:comment "the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end"@en ;
          rdfs:label "Role"@en .


###  http://www.w3.org/ns/prov#Usage
prov:Usage rdf:type owl:Class ;
           rdfs:subClassOf prov:EntityInfluence ,
                           prov:InstantaneousEvent ;
           rdfs:comment "the beginning of utilizing an entity by an activity"@en ;
           rdfs:label "Usage"@en .


###  https://w3id.org/polymat/ATRPPolymerisation
pmat:ATRPPolymerisation rdf:type owl:Class ;
                        rdfs:subClassOf pmat:RadicalPolymerisation ;
                        rdfs:comment """A living polymerisation process where the chain initiation and chain propagation steps are atom transfer radical addition reactions. Often the atom transfer involves a radical halogen atom and the reaction is catalysed by a transition metal species
(http://purl.obolibrary.org/obo/MOP_0000684)"""@en ;
                        rdfs:label "Atom transfer radical polymerisation"@en ;
                        skos:altLabel "ATRP polymerisation"@en .


###  https://w3id.org/gelmat/Accupyc
gmat:Accupyc rdf:type owl:Class ;
             rdfs:subClassOf pmat:Instrument ;
             rdfs:comment "A gas pycnometer device for measuring skeletal densities of solid materials using helium displacement."@en ;
             skos:definition "A gas displacement pycnometer instrument used to measure the skeletal density of solid materials by helium displacement"@en ;
             rdfs:label "Accupyc"@en .


###  https://w3id.org/gelmat/Acetone
gmat:Acetone rdf:type owl:Class ;
             rdfs:subClassOf obo:CHEBI_24431 ;
             rdfs:comment "A volatile organic solvent (CH3COCH3) commonly used in solvent exchange for aerogel synthesis due to low surface tension and miscibility with alcohols"@en ;
             skos:definition "The ketone solvent propan-2-one (CH3COCH3), used in solvent exchange during aerogel synthesis owing to its miscibility and volatility"@en ;
             rdfs:label "Acetone"@en .


###  https://w3id.org/gelmat/Acid
gmat:Acid rdf:type owl:Class ;
          rdfs:subClassOf obo:CHEBI_24431 ;
          rdfs:comment "A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid). Acids serve as catalysts in many sol-gel processes for aerogel synthesis"@en ;
          skos:definition "A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid)"@en ;
          rdfs:label "Acid"@en .


###  https://w3id.org/gelmat/Aerogel
gmat:Aerogel rdf:type owl:Class ;
             rdfs:subClassOf gmat:Gel ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gmat:wasProducedBy ;
                               owl:someValuesFrom pmat:Drying
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gmat:hasDensity ;
                               owl:someValuesFrom gmat:Density
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gmat:hasSurfaceArea ;
                               owl:someValuesFrom gmat:SurfaceArea
                             ] ;
             owl:disjointWith gmat:Alcogel ,
                              gmat:Hydrogel ,
                              gmat:Xerogel ;
             rdfs:comment "An aerogel is a porous solid material obtained by replacing the liquid phase of a gel with a gas, typically through supercritical drying, while largely retaining the gel’s original network structure."@en ;
           skos:closeMatch <http://emmo.info/emmo#EMMO_4207e895> , <https://w3id.org/pmd/co/Material> ;
             skos:definition "A porous solid material derived from a gel in which the liquid component has been replaced by a gas without significant collapse of the solid network structure, yielding extremely low density, high porosity, and high specific surface area"@en ;
             rdfs:label "Aerogel"@en .


###  https://w3id.org/gelmat/AerogelDefect
gmat:AerogelDefect rdf:type owl:Class ;
                   rdfs:subClassOf pmat:Feature ;
                   rdfs:comment "A structural or quality defect borne by an aerogel — a persisting deviation from the intended structure or quality that arises during synthesis or processing. Subclasses denote the defect state (a specifically dependent continuant inhering in the material), not the formation event; the event that produces a defect should be modelled as a process if needed."@en ;
                   skos:definition "A specifically dependent continuant feature of an aerogel material that constitutes a deviation from the intended structure, composition, or quality of the material"@en ;
                   rdfs:label "Aerogel defect"@en .


###  https://w3id.org/gelmat/AerogelSynthesis
gmat:AerogelSynthesis rdf:type owl:Class ;
                      rdfs:subClassOf gmat:CreationProcess ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000051 ;
                                        owl:someValuesFrom gmat:SolFormation
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000051 ;
                                        owl:someValuesFrom gmat:Gelation
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty obo:BFO_0000051 ;
                                        owl:someValuesFrom pmat:Drying
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gmat:usesSubstance ;
                                        owl:someValuesFrom pmat:Monomer
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gmat:usesSubstance ;
                                        owl:someValuesFrom [ owl:intersectionOf ( pmat:Substance
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty prov:hadRole ;
                                                                                    owl:someValuesFrom pmat:Catalyst
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ]
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gmat:usesSubstance ;
                                        owl:someValuesFrom [ owl:intersectionOf ( pmat:Substance
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty prov:hadRole ;
                                                                                    owl:someValuesFrom pmat:Solvent
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ]
                                      ] ;
                      rdfs:comment "The complete process of synthesizing aerogels from precursor materials through sol-gel chemistry followed by a drying step. Only sol formation, gelation, and drying are asserted as required parts (owl:someValuesFrom); aging, solvent exchange, and surface modification are common but optional steps that many published syntheses omit, so they carry no existential restriction here — asserting them would make every extracted synthesis without such a step inconsistent under OWL reasoning"@en ;
                      skos:definition "The complete multi-step process of producing an aerogel from precursor substances, comprising at minimum sol formation, gelation, and a drying step that preserves pore structure; aging, solvent exchange, and surface modification are frequent optional steps"@en ;
                      rdfs:label "Aerogel synthesis"@en .




###  https://w3id.org/gelmat/APDAerogelSynthesis
gmat:APDAerogelSynthesis rdf:type owl:Class ;
                         rdfs:subClassOf gmat:AerogelSynthesis ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty obo:BFO_0000051 ;
                                           owl:someValuesFrom gmat:SurfaceModification
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty obo:BFO_0000051 ;
                                           owl:someValuesFrom gmat:AmbientPressureDrying
                                         ] ;
                         rdfs:comment "An aerogel synthesis route using ambient pressure drying (APD). Requires a surface modification step (typically silylation with TMCS or HMDS) between solvent exchange and drying to prevent capillary collapse during the drying step"@en ;
                         skos:definition "An aerogel synthesis route in which the wet gel is dried at ambient pressure after mandatory surface silylation; avoids high-pressure equipment of supercritical drying by preventing capillary collapse through hydrophobic surface modification"@en ;
                         rdfs:label "Ambient pressure drying aerogel synthesis"@en ;
                         skos:altLabel "APD synthesis"@en .


###  https://w3id.org/gelmat/Aging
gmat:Aging rdf:type owl:Class ;
           rdfs:subClassOf gmat:CreationProcess ;
           rdfs:comment "Post-gelation maturation process where the gel network strengthens through continued condensation reactions and Ostwald ripening. Typically performed by keeping the wet gel immersed in solvent at elevated temperature"@en ;
           skos:definition "Post-gelation maturation in which the wet gel is kept immersed in solvent at elevated temperature to strengthen the network via continued condensation reactions, Ostwald ripening, and syneresis, reducing later shrinkage during drying"@en ;
           rdfs:label "Aging"@en .
gmat:Aging gmat:hasStepOrder "3"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/Alcogel
gmat:Alcogel rdf:type owl:Class ;
             rdfs:subClassOf gmat:WetGel ;
             owl:disjointWith gmat:Hydrogel ;
             rdfs:comment "An alcogel is a gel in which the liquid phase consists mainly of an alcohol or alcohol-rich solvent mixture."@en ;
             skos:definition "A wet gel in which the liquid pore phase consists primarily of an alcohol or alcohol-rich solvent mixture, formed after solvent exchange from the initial aqueous sol or directly from alkoxide precursors"@en ;
             rdfs:label "Alcogel"@en .


###  https://w3id.org/gelmat/Alcohol
gmat:Alcohol rdf:type owl:Class ;
             rdfs:subClassOf obo:CHEBI_24431 ;
             rdfs:comment "Any organic compound containing one or more hydroxyl groups bound to saturated carbon; commonly used as solvent or reagent"@en ;
             skos:definition "An organic compound bearing one or more hydroxyl groups bound to saturated carbon atoms"@en ;
             rdfs:label "Alcohol"@en .


###  https://w3id.org/gelmat/AlkoxideSolution
gmat:AlkoxideSolution rdf:type owl:Class ;
                      rdfs:subClassOf pmat:Substance ;
                      rdfs:comment "A solution containing metal alkoxide precursor dissolved in organic solvent, prepared as an intermediate in sol-gel synthesis"@en ;
                      skos:definition "A solution of a metal or silicon alkoxide precursor in an organic solvent, prepared as an intermediate in sol-gel synthesis"@en ;
                      rdfs:label "Alkoxide solution"@en .


###  https://w3id.org/gelmat/AmbientPressureDrying
gmat:AmbientPressureDrying rdf:type owl:Class ;
                           rdfs:subClassOf pmat:Drying ;
                           rdfs:comment "Drying method performed at atmospheric pressure, typically requiring surface modification to prevent capillary collapse"@en ;
                           skos:definition "A drying method performed at atmospheric pressure in which capillary collapse is prevented by prior surface silylation of the gel, allowing the hydrophobic network to spring back after compression and recover its pore volume"@en ;
                        rdfs:label "Ambient pressure drying"@en ;
                           skos:altLabel "Evaporative drying"@en ,
                                         "APD"@en .


