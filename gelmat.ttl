                pmat:hasIUPACName "benzene-1,3-diol" ;
                rdfs:comment "Resorcinol (1,3-dihydroxybenzene), the standard phenolic monomer of resorcinol-formaldehyde (RF) organic and carbon aerogels"@en ;
                rdfs:label "Resorcinol"@en ;
                skos:definition "The phenolic compound benzene-1,3-diol, used with formaldehyde as the precursor pair of RF aerogels"@en .


