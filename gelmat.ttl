pmat:Terpolymer rdf:type owl:Class ;
                rdfs:subClassOf pmat:Polymer ;
                rdfs:comment """A polymer that results from copolymerization of three discrete monomers
(https://www.merriam-webster.com/dictionary/terpolymer)"""@en ;
                rdfs:label "Terpolymer"@en .


###  https://w3id.org/gelmat/Tetraethoxysilane
gmat:Tetraethoxysilane rdf:type owl:Class ;
                       rdfs:subClassOf pmat:Monomer ,
                                       gmat:SiliconAlkoxidePrecursor ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000050 ;
                                         owl:someValuesFrom pmat:Monomer
                                       ] ;
                       pmat:hasCASNr "78-10-4" ;
                       pmat:hasAcronym "TEOS" ;
                       rdfs:comment "Tetraethoxysilane (TEOS, Si(OC2H5)4) is a silicon alkoxide used as a silica precursor in hydrolysis–condensation (sol–gel) processes"@en ;
                       skos:definition "The silicon alkoxide Si(OC2H5)4 (TEOS), a widely used silica precursor that undergoes hydrolysis and condensation in sol-gel processing"@en ;
                       rdfs:label "Tetraethoxysilane"@en .


###  https://w3id.org/gelmat/ThermalConductivityTesting
gmat:ThermalConductivityTesting rdf:type owl:Class ;
                                rdfs:subClassOf pmat:Analysis ;
                                rdfs:comment "Measurement of heat transfer properties through aerogel material"@en ;
                                skos:definition "An analysis that measures the heat transport properties of a material"@en ;
                                rdfs:label "Thermal conductivity testing"@en .


###  https://w3id.org/polymat/ThermodynamicTestEquipment
pmat:ThermodynamicTestEquipment rdf:type owl:Class ;
                                rdfs:subClassOf pmat:Equipment ;
                                rdfs:comment """Equipment for measurement of physical parameters (e.g., temperature, heat energy) in thermodynamic systems (isolated, closed, or open)
(https://en.wikipedia.org/wiki/Thermodynamic_instruments) (https://en.wikipedia.org/wiki/Thermodynamic_system)"""@en ;
                                rdfs:label "Thermodynamic test equipment"@en .


###  https://w3id.org/polymat/ThermogravimetricAnalyzer
pmat:ThermogravimetricAnalyzer rdf:type owl:Class ;
                               rdfs:subClassOf pmat:ThermodynamicTestEquipment ;
                               rdfs:comment """A piece of equipment, consisting of a quartz or alumina chamber, a balance, a sample pan and a heating mechanism, which is used to record the mass of a sample as a function of increasing temperature
(http://purl.obolibrary.org/obo/CHMO_0002121)"""@en ,
                                            """Equipment for thermogravimetric analysis (TGA) in which the mass of a sample is measured over time as the temperature changes; it provides information about physical phenomena, such as phase transitions, absorption, adsorption and desorption; as well as chemical phenomena including chemisorption, thermal decomposition, and solid-gas reactions (e.g., oxidation or reduction)
(https://en.wikipedia.org/wiki/Thermogravimetric_analysis)"""@en ;
                               rdfs:label "Thermogravimetric analyzer"@en .


###  https://w3id.org/polymat/Thermometer
pmat:Thermometer rdf:type owl:Class ;
                 rdfs:subClassOf pmat:Instrument ;
                 rdfs:comment "An instrument that records and displays the temperature"@en ;
                 rdfs:label "Thermometer"@en .


###  https://w3id.org/polymat/Thermoplastic
pmat:Thermoplastic rdf:type owl:Class ;
                   rdfs:subClassOf pmat:Plastic ;
                   rdfs:comment """A plastic that can be deformed by heating in a certain temperature range (thermoplastic); this process is reversible and can be repeated as often as desired by cooling and reheating, as long as no thermal decomposition of the material occurs 
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)"""@en ;
                   rdfs:label "Thermoplastic"@en .


###  https://w3id.org/polymat/Thermoset
pmat:Thermoset rdf:type owl:Class ;
               rdfs:subClassOf pmat:Plastic ;
               rdfs:comment """A plastic that retains its state and shape after curing, the process is irreversible due to cross-linked polymer chains
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)"""@en ;
               rdfs:label "Thermoset"@en ;
               skos:altLabel "Duromer"@en ,
                             "Duroplast"@en .


###  https://w3id.org/polymat/TimeLag
pmat:TimeLag rdf:type owl:Class ;
             rdfs:subClassOf pmat:MembranePerformanceForGases ;
             rdfs:comment """A method commonly used to characterize gas separation membranes. It allows the determination of diffusion, permeability, and solubility coefficients from a single dynamic gas permeation experiment; for this experiment, a homogeneous membrane is exposed to a step increase in pressure at one side of the membrane (feed side) and the feed pressure remains constant, while the other side (permeate side) of the membrane remains under vacuum; the diffusion and permeability coefficients are then determined from the resulting permeate pressure-time curve; the solubility coefficient is the permeability coefficient divided by the diffusion coefficient
(https://doi.org/10.1016/j.memsci.2020.118715)"""@en ;
             rdfs:label "Time lag"@en .


###  https://w3id.org/polymat/TransmissionElectronMicroscope
pmat:TransmissionElectronMicroscope rdf:type owl:Class ;
                                    rdfs:subClassOf pmat:Microscope ;
                                    rdfs:comment """A piece of equipment which is used to produce an enlarged image of an electron transparent specimen using a finely focused (<10 nm diameter) electron beam with an acceleration voltage of 50–150 kV under vacuum; the energies and intensities of the transmitted electrons are measured
(http://purl.obolibrary.org/obo/CHMO_0001099)"""@en ,
                                                 """A type of microscope that uses magnetic lenses to transmit a beam of electrons through a thin sample; the electrons are then focused on a fluorescent screen or another detector to form an enlarged image
(https://www.photonics.com/EDU/transmission_electron_microscope_TEM/d7604)"""@en ,
                                                 """An electron microscope that transmits a beam of electrons through a finely sliced section of a specimen and creates an image of the sample based on its effect on the phase of the electrons that pass through
(http://purl.obolibrary.org/obo/NCIT_C78813)"""@en ;
                                    rdfs:label "Transmission electron microscope"@en ;
                                    skos:altLabel "TEM"@en .


###  https://w3id.org/gelmat/Triflex
gmat:Triflex rdf:type owl:Class ;
             rdfs:subClassOf pmat:Instrument ;
             rdfs:comment "A device for physisorption measurements, including pore size distribution and specific surface area analysis."@en ;
             skos:definition "A physisorption analysis instrument used for specific surface area and pore size distribution measurements"@en ;
             rdfs:label "Triflex"@en .


###  https://w3id.org/polymat/UltimateTensileStrength
pmat:UltimateTensileStrength rdf:type owl:Class ;
                             rdfs:subClassOf om:Quantity ;
                             rdfs:comment """The maximum stress that a material can withstand while being stretched before breaking
(https://en.wikipedia.org/wiki/Ultimate_tensile_strength)"""@en ;
                             rdfs:label "Ultimate tensile strength"@en .


###  https://w3id.org/polymat/User
pmat:User rdf:type owl:Class ;
          rdfs:subClassOf pmat:Role ;
          rdfs:comment "A person who is trained to use a specific device"@en ;
          rdfs:label "User"@en .


###  https://w3id.org/gelmat/VacuumDrying
gmat:VacuumDrying rdf:type owl:Class ;
                  rdfs:subClassOf pmat:Drying ;
                  rdfs:comment "Drying method performed under reduced pressure to lower solvent boiling point and facilitate removal"@en ;
                  skos:definition "A drying method performed under reduced pressure to lower the solvent boiling point and facilitate solvent removal"@en ;
                  rdfs:label "Vacuum drying"@en .


###  https://w3id.org/gelmat/VacuumPump
gmat:VacuumPump rdf:type owl:Class ;
                rdfs:subClassOf pmat:Pump ;
                rdfs:comment "Device for removing gas molecules from a sealed volume to create partial vacuum"@en ;
                skos:definition "A pump that removes gas molecules from a sealed volume to create a partial vacuum"@en ;
                rdfs:label "Vacuum pump"@en .


###  https://w3id.org/gelmat/VolumeRatio
gmat:VolumeRatio rdf:type owl:Class ;
                 rdfs:subClassOf gmat:ProcessParameter ;
                 rdfs:comment "The ratio of volumes between two or more substances in a mixture or solution. Used to describe the proportions of reagents by volume (e.g., MTMS:MeOH = 1:10)."@en ;
                 skos:definition "A process parameter representing the ratio of volumes between two or more substances in a mixture or solution"@en ;
                 rdfs:label "Volume Ratio"@en .


###  https://w3id.org/gelmat/VolumetricFlowRate
gmat:VolumetricFlowRate rdf:type owl:Class ;
                        rdfs:subClassOf om:Quantity ;
                        rdfs:comment "Rate at which a volume of fluid flows through a system, typically measured in ml/h or L/min. Used to characterize pump speeds and fluid delivery rates in synthesis processes."@en ;
                        gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetrePerSecond-Time> ;
                        skos:definition "A quantity representing the volume of fluid passing through a system per unit time"@en ;
                        rdfs:label "Volumetric Flow Rate"@en .




###  https://w3id.org/gelmat/GelationTime
gmat:GelationTime rdf:type owl:Class ;
                  rdfs:subClassOf om:Time ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty pmat:isParameterOf ;
                                    owl:someValuesFrom gmat:Gelation
                                  ] ;
                  rdfs:comment "The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event. A key kinetic parameter sensitive to catalyst concentration, pH, temperature, and water-to-precursor ratio"@en ;
                  skos:definition "The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event; a key kinetic parameter controlled by catalyst type, concentration, pH, temperature, and water-to-precursor ratio"@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> ;
                  rdfs:label "Gelation time"@en ;
                  skos:altLabel "Gel time"@en .


###  https://w3id.org/gelmat/SolConcentration
gmat:SolConcentration rdf:type owl:Class ;
                      rdfs:subClassOf om:AmountOfSubstanceConcentration ;
                      rdfs:comment "The molar or mass concentration of the precursor monomer in the sol (mol/L or wt%). Controls the density and pore volume of the final aerogel"@en ;
                      skos:definition "The molar or mass concentration of the precursor monomer in the starting sol, governing the density of the resulting aerogel; higher concentrations yield denser, stronger, less porous aerogels"@en ;
                      gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/molePerCubicmetre> ;
                      rdfs:label "Sol concentration"@en .


###  https://w3id.org/gelmat/WaterToSilicaRatio
gmat:WaterToSilicaRatio rdf:type owl:Class ;
                        rdfs:subClassOf gmat:MolarRatio ;
                        rdfs:comment "The molar ratio of water to silicon alkoxide precursor (r = [H2O]/[Si]) used in sol preparation. Controls degree of hydrolysis; r < 4 gives incomplete hydrolysis for TEOS; higher r values favour fully hydrolysed sols"@en ;
                        skos:definition "The molar ratio r = [H2O]/[Si] of water to silicon alkoxide precursor; governs the completeness of hydrolysis. Stoichiometric full hydrolysis of TEOS requires r = 4; r < 4 yields partially hydrolysed species; r >> 4 produces fully hydrolysed, more condensed networks"@en ;
                        rdfs:label "Water-to-silica ratio"@en ;
                        skos:altLabel "r-ratio"@en ,
                                      "H2O:Si ratio"@en .


###  https://w3id.org/gelmat/NetworkConnectivity
gmat:NetworkConnectivity rdf:type owl:Class ;
                         rdfs:subClassOf pmat:Feature ;
                         rdfs:comment "A structural descriptor of the aerogel solid network expressing the average number of siloxane bonds per node; related to cross-linking density and mechanical stiffness. Determined from solid-state NMR (Q2/Q3/Q4 species) or SAXS"@en ;
                         skos:definition "The average number of siloxane (or equivalent) bonds per network node, quantifying the degree of cross-linking. Determined from 29Si NMR Q-species ratios: Q2 (2 siloxane bonds), Q3 (3), Q4 (4, fully connected)"@en ;
                         rdfs:label "Network connectivity"@en ;
                         skos:altLabel "Cross-linking density"@en .


###  https://w3id.org/gelmat/FractalDimension
gmat:FractalDimension rdf:type owl:Class ;
                      rdfs:subClassOf om:Quantity ;
                      rdfs:comment "A dimensionless exponent describing the self-similar (power-law) scaling of an aerogel network with length scale, determined from small-angle scattering (SAXS/SANS). General parent for the mass fractal dimension (Dm, network mass scaling) and the surface fractal dimension (Ds, interface roughness scaling)"@en ;
                      skos:definition "A dimensionless exponent quantifying the fractal (self-similar, power-law) scaling of an aerogel network; specialised as mass fractal dimension (1-3) or surface fractal dimension (2-3)"@en ;
                      gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                      rdfs:label "Fractal dimension"@en .


###  https://w3id.org/gelmat/MassFractalDimension
gmat:MassFractalDimension rdf:type owl:Class ;
                          rdfs:subClassOf gmat:FractalDimension ;
                          rdfs:comment "The fractal dimension Dm describing the power-law scaling of network mass with length scale in the fractal (low-q) region of the scattering curve, I(q) ∝ q^(−Dm). Values 1.7-2.4 are typical for silica aerogels; lower values indicate more open, chain-like structures"@en ;
                          skos:definition "The mass fractal dimension (1 ≤ Dm ≤ 3) obtained from the slope of the fractal regime of a SAXS/SANS curve, describing how network mass scales with observation length"@en ;
                          gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                          skos:altLabel "Dm"@en ,
                                        "Mass fractal dimension"@en ;
                          rdfs:label "Mass fractal dimension"@en .


###  https://w3id.org/gelmat/SurfaceFractalDimension
gmat:SurfaceFractalDimension rdf:type owl:Class ;
                             rdfs:subClassOf gmat:FractalDimension ;
                             rdfs:comment "The fractal dimension Ds describing the roughness/self-similarity of the solid-pore interface, obtained from the Porod region of the scattering curve, I(q) ∝ q^(−(6−Ds)). Values 2 ≤ Ds < 3, where Ds = 2 denotes a smooth surface and values toward 3 denote an increasingly rough, space-filling interface"@en ;
                             skos:definition "The surface fractal dimension (2 ≤ Ds ≤ 3) obtained from the Porod region of a SAXS/SANS curve, quantifying the roughness of the solid-pore interface"@en ;
                             gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                             skos:altLabel "Ds"@en ;
                             rdfs:label "Surface fractal dimension"@en .


###  https://w3id.org/gelmat/PorodExponent
gmat:PorodExponent rdf:type owl:Class ;
                   rdfs:subClassOf om:Quantity ;
                   rdfs:comment "The power-law exponent P of the scattering intensity, I(q) ∝ q^(−P), in the high-q region. Directly read from the scattering slope: 1 ≤ P ≤ 3 indicates a mass fractal (P = Dm), while 3 < P ≤ 4 indicates a surface fractal (P = 6 − Ds), with P = 4 for a smooth (Porod) interface"@en ;
                   skos:definition "The dimensionless power-law exponent of small-angle scattering intensity versus q, from which the mass fractal (P = Dm) or surface fractal (P = 6 − Ds) dimension is derived"@en ;
                   gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                   skos:altLabel "Power-law exponent"@en ,
                                 "Scattering exponent"@en ;
                   rdfs:label "Porod exponent"@en .


###  https://w3id.org/gelmat/CorrelationLength
gmat:CorrelationLength rdf:type owl:Class ;
                       rdfs:subClassOf om:Length ;
                       rdfs:comment "The upper cutoff length ξ of fractal scaling in an aerogel network, corresponding to the characteristic cluster (blob) size above which the material appears homogeneous. Obtained from the crossover (knee) in a SAXS/SANS curve; typically a few to tens of nanometres"@en ;
                       skos:definition "The correlation length ξ marking the upper length-scale cutoff of fractal self-similarity in a gel network (the characteristic cluster/blob size), determined from the low-q crossover of a scattering curve"@en ;
                       gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
                       skos:altLabel "Fractal correlation length"@en ,
                                     "Cluster size"@en ;
                       rdfs:label "Correlation length"@en .


###  https://w3id.org/gelmat/SpringbackFailure
gmat:SpringbackFailure rdf:type owl:Class ;
                       rdfs:subClassOf gmat:AerogelDefect ;
                       rdfs:comment "Incomplete recovery of pore volume after capillary compression during ambient pressure drying; the gel does not fully spring back to its wet-gel dimensions due to insufficient surface silylation or network weakness"@en ;
                       skos:definition "An aerogel defect in which the gel network fails to recover its original pore volume after capillary compression during ambient pressure drying, due to insufficient hydrophobisation or network weakness, yielding higher density and lower surface area than expected"@en ;
                       rdfs:label "Springback failure"@en .


###  https://w3id.org/gelmat/Macroporosity
gmat:Macroporosity rdf:type owl:Class ;
                   rdfs:subClassOf gmat:AerogelDefect ;
                   rdfs:comment "Presence of unintended macropores (> 50 nm) in the aerogel network, causing loss of mesoporosity, reduced surface area, and lower thermal insulation performance. Arises from phase separation or syneresis during gelation"@en ;
                   skos:definition "An aerogel defect characterised by the presence of unintended pores larger than 50 nm in the otherwise mesoporous network, caused by phase separation or syneresis during gelation, leading to reduced surface area and impaired insulation performance"@en ;
                   rdfs:label "Macroporosity"@en .



###  https://w3id.org/gelmat/WashingCycle
gmat:WashingCycle rdf:type owl:Class ;
                  rdfs:subClassOf pmat:SamplePreparation ;
                  rdfs:comment "Individual iteration of solvent replacement during solvent exchange process"@en ;
                  skos:definition "A single iteration of solvent replacement within a solvent exchange procedure"@en ;
                  rdfs:label "Washing cycle"@en .


###  https://w3id.org/polymat/WaterFlux
pmat:WaterFlux rdf:type owl:Class ;
               rdfs:subClassOf pmat:MembranePerformanceForLiquids ;
               rdfs:comment "The rate at which water permeates a membrane"@en ;
               rdfs:label "Water flux"@en .


###  https://w3id.org/polymat/WaterPermeabilitySetup
pmat:WaterPermeabilitySetup rdf:type owl:Class ;
                            rdfs:subClassOf pmat:LiquidPermeationEquipment ;
                            rdfs:comment "Equipment to measure the permeability of water through a membrane"@en ;
                            rdfs:label "Water permeability setup"@en .


###  https://w3id.org/gelmat/WetGel
gmat:WetGel rdf:type owl:Class ;
            rdfs:subClassOf gmat:Gel ;
            rdfs:comment "A gel containing liquid within its porous network structure, formed after gelation and before drying. The liquid phase determines the specific type (hydrogel if water, alcogel if alcohol)."@en ;
            skos:definition "A gel whose pore network is filled with a liquid phase, existing after gelation and before drying"@en ;
            rdfs:label "Wet gel"@en .


###  https://w3id.org/gelmat/Xerogel
gmat:Xerogel rdf:type owl:Class ;
             rdfs:subClassOf gmat:Gel ;
             rdfs:comment "A dried gel with a collapsed or partially collapsed pore structure, formed when a wet gel is dried under ambient conditions causing capillary forces to shrink the network"@en ;
             skos:definition "A dried gel formed when a wet gel is dried under ambient conditions; capillary forces during liquid evaporation partially or fully collapse the pore network, resulting in a denser material than the corresponding aerogel"@en ;
             rdfs:label "Xerogel"@en .


###  https://w3id.org/polymat/ZetaPotentialSetup
pmat:ZetaPotentialSetup rdf:type owl:Class ;
                        rdfs:subClassOf pmat:ElectricTestingEquipment ;
                        rdfs:comment """Equipment to measure Zeta potential (electrokinetic potential) in colloidal dispersions
(https://en.wikipedia.org/wiki/Zeta_potential)"""@en ;
                        rdfs:label "Zeta potential setup"@en .


###  https://w3id.org/polymat/4PointResistanceSetup
<https://w3id.org/polymat/4PointResistanceSetup> rdf:type owl:Class ;
                                                 rdfs:subClassOf pmat:ElectricTestingEquipment ;
                                                 rdfs:comment """Equipment to measure the electrical impedance by four-terminal sensing (4T sensing, 4-wire sensing, or 4-point probes method) technique that uses separate pairs of current-carrying and voltage-sensing electrodes to make more accurate measurements than the simpler and more usual two-terminal (2T) sensing
(https://en.wikipedia.org/wiki/Four-terminal_sensing)"""@en ;
                                                 rdfs:label "4-Point resistance setup"@en .


#################################################################
#    Compositional and process quantities
#################################################################

###  https://w3id.org/gelmat/MassFraction
gmat:MassFraction rdf:type owl:Class ;
                  rdfs:subClassOf om:Quantity ;
                  rdfs:comment "The mass of a component divided by the total mass of the mixture or composite, expressed as a fraction or wt%. Covers fibre loading, solid content, silica content, and similar compositional quantities"@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
                  rdfs:label "Mass fraction"@en ;
                  skos:definition "A dimensionless quantity representing the ratio of the mass of a component to the total mass of the mixture, commonly expressed in weight percent"@en ;
                  skos:altLabel "Weight fraction"@en ,
                                "wt%"@en .


###  https://w3id.org/gelmat/HeatingRate
gmat:HeatingRate rdf:type owl:Class ;
                 rdfs:subClassOf om:Quantity ;
                 rdfs:comment "The rate of temperature change during a thermal process step (drying, pyrolysis, calcination, temperature ramping), typically reported in K/min or degC/min"@en ;
                 gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvinPerSecond-Time> ;
                 rdfs:label "Heating rate"@en ;
                 skos:definition "A quantity representing the change of temperature per unit time imposed during a controlled heating or cooling step"@en ;
                 skos:altLabel "Ramp rate"@en ,
                               "Temperature ramp rate"@en .


###  https://w3id.org/gelmat/PHValue
gmat:PHValue rdf:type owl:Class ;
             rdfs:subClassOf om:Quantity ;
             rdfs:comment "The pH of a solution or reaction medium as a dimensionless quantity (0-14). Preferred over the datatype shortcut gmat:hasPHValue when the value should participate in the om:Quantity/om:Measure pattern; a gmat:PHCondition process parameter carries its magnitude as a PHValue-style dimensionless om:Measure"@en ;
             gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> ;
             rdfs:label "pH value"@en ;
             skos:definition "A dimensionless quantity representing the negative decadic logarithm of the hydrogen ion activity of a solution"@en ;
             skos:altLabel "pH"@en .


#################################################################
#    Substance roles
#    Pattern: step gmat:usesSubstance substance ;
#             substance prov:hadRole [ a <RoleClass> ] .
#    pmat:Catalyst and pmat:Solvent (both under pmat:Role) are reused
#    for the catalyst and solvent functions.
#################################################################

###  https://w3id.org/gelmat/PrecursorRole
gmat:PrecursorRole rdf:type owl:Class ;
                   rdfs:subClassOf pmat:Role ;
                   rdfs:comment "The role of a substance that is chemically converted into the solid network of the gel (e.g. TEOS in a silica synthesis, resorcinol and formaldehyde in an RF synthesis)"@en ;
                   rdfs:label "Precursor role"@en ;
                   skos:definition "A role borne by a substance that serves as the network-forming reactant of a sol-gel synthesis step"@en .


###  https://w3id.org/gelmat/CrosslinkerRole
gmat:CrosslinkerRole rdf:type owl:Class ;
                     rdfs:subClassOf pmat:Role ;
                     rdfs:comment "The role of a substance that forms bonds between polymer chains or particles in a given step; distinct from the convenience substance class gmat:Crosslinker, which types substances by chemical nature"@en ;
                     rdfs:label "Crosslinker role"@en ;
                     skos:definition "A role borne by a substance that bridges polymer chains or colloidal particles into a network during a synthesis step"@en .


###  https://w3id.org/gelmat/SurfactantRole
gmat:SurfactantRole rdf:type owl:Class ;
                    rdfs:subClassOf pmat:Role ;
                    rdfs:comment "The role of a substance acting as a surface-active agent (emulsion stabiliser, pore templating agent) in a given step; distinct from the convenience substance class gmat:Surfactant"@en ;
                    rdfs:label "Surfactant role"@en ;
                    skos:definition "A role borne by a substance that lowers interfacial tension or templates porosity during a synthesis step"@en .


###  https://w3id.org/gelmat/SilylationAgentRole
gmat:SilylationAgentRole rdf:type owl:Class ;
                         rdfs:subClassOf pmat:Role ;
                         rdfs:comment "The role of a substance that silylates surface silanol groups during a surface modification step; distinct from the convenience substance class gmat:SilylationAgent"@en ;
                         rdfs:label "Silylation agent role"@en ;
                         skos:definition "A role borne by a substance that replaces surface silanol groups with alkylsilyl groups during surface modification"@en .


###  https://w3id.org/gelmat/ReinforcementRole
gmat:ReinforcementRole rdf:type owl:Class ;
                       rdfs:subClassOf pmat:Role ;
                       rdfs:comment "The role of a substance embedded as a reinforcing or filler phase in a composite (e.g. glass fibre, cellulose fibre, graphene oxide, carbon nanotubes)"@en ;
                       rdfs:label "Reinforcement role"@en ;
                       skos:definition "A role borne by a substance incorporated into a composite to improve its mechanical or functional properties"@en .


###  https://w3id.org/gelmat/DryingControlAdditiveRole
gmat:DryingControlAdditiveRole rdf:type owl:Class ;
                               rdfs:subClassOf pmat:Role ;
                               rdfs:comment "The role of a substance added to a sol to reduce capillary stress and prevent cracking during drying (DCCA function, e.g. glycerol, formamide, DMF); distinct from the convenience substance class gmat:DryingControlChemicalAdditive"@en ;
                               rdfs:label "Drying control additive role"@en ;
                               skos:definition "A role borne by a substance that moderates evaporation and capillary stress during drying of a gel"@en .


###  https://w3id.org/gelmat/SupercriticalFluidRole
gmat:SupercriticalFluidRole rdf:type owl:Class ;
                            rdfs:subClassOf pmat:Role ;
                            rdfs:comment "The role of a substance used in its supercritical state as the extraction medium of a supercritical drying step (typically CO2 or ethanol)"@en ;
                            rdfs:label "Supercritical fluid role"@en ;
                            skos:definition "A role borne by a substance that serves as the supercritical extraction medium in a supercritical drying step"@en .


###  https://w3id.org/gelmat/GellingAgentRole
gmat:GellingAgentRole rdf:type owl:Class ;
                      rdfs:subClassOf pmat:Role ;
                      rdfs:comment "The role of a substance that triggers or promotes gelation (e.g. a base added to induce condensation, a cation bath for alginate gelation)"@en ;
                      rdfs:label "Gelling agent role"@en ;
                      skos:definition "A role borne by a substance that induces or accelerates the sol-gel transition in a gelation step"@en .


#################################################################
#    Precursor hierarchy
#################################################################

###  https://w3id.org/gelmat/Precursor
gmat:Precursor rdf:type owl:Class ;
               rdfs:subClassOf obo:CHEBI_24431 ;
               rdfs:comment "A chemical entity that is chemically converted into the solid network of a gel during sol-gel synthesis. Grouped by material family: silica, metal oxide, organic, polymer, and biopolymer precursors. The function in a specific step is additionally stated through the role pattern (prov:hadRole some gmat:PrecursorRole)"@en ;
               rdfs:label "Precursor"@en ;
               skos:definition "A chemical entity that reacts to form the solid network of a gel in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/SilicaPrecursor
gmat:SilicaPrecursor rdf:type owl:Class ;
                     rdfs:subClassOf gmat:Precursor ;
                     rdfs:comment "A precursor that yields a silica (SiO2) or organosilica network, comprising silicon alkoxides (TEOS, TMOS, MTMS, ...) and silicates (sodium silicate / water glass)"@en ;
                     rdfs:label "Silica precursor"@en ;
                     skos:definition "A precursor whose hydrolysis and condensation yield a silica or organosilica network"@en .


###  https://w3id.org/gelmat/SilicatePrecursor
gmat:SilicatePrecursor rdf:type owl:Class ;
                       rdfs:subClassOf gmat:SilicaPrecursor ;
                       rdfs:comment "An inorganic silicate salt used as a low-cost silica source, typically requiring an ion exchange or acid neutralisation step to remove the alkali cations before or during gelation"@en ;
                       rdfs:label "Silicate precursor"@en ;
                       skos:definition "An inorganic silicate used as a silica source in the water-glass route to silica gels"@en .


###  https://w3id.org/gelmat/SodiumSilicate
gmat:SodiumSilicate rdf:type owl:Class ;
                    rdfs:subClassOf gmat:SilicatePrecursor ;
                    pmat:hasCASNr "1344-09-8" ;
                    skos:exactMatch obo:CHEBI_60720 ;
                    rdfs:comment "Aqueous sodium silicate (water glass, Na2O·nSiO2), the industrial low-cost silica precursor; requires ion exchange (gmat:IonExchange) or acid neutralisation to remove sodium ions before gelation"@en ;
                    rdfs:label "Sodium silicate"@en ;
                    skos:definition "The sodium salt of silicic acid (Na2O·nSiO2), used in aqueous solution as a low-cost silica precursor"@en ;
                    skos:altLabel "Water glass"@en ,
                                  "Waterglass"@en .


###  https://w3id.org/gelmat/TMOS
gmat:TMOS rdf:type owl:Class ;
          rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
          pmat:hasCASNr "681-84-5" ;
          pmat:hasIUPACName "tetramethyl orthosilicate" ;
          pmat:hasAcronym "TMOS" ;
          rdfs:comment "Tetramethoxysilane (TMOS, Si(OCH3)4), a fast-hydrolysing silica precursor; yields finer networks than TEOS but releases toxic methanol"@en ;
          rdfs:label "Tetramethoxysilane"@en ;
          skos:altLabel "TMOS"@en ,
                        "Tetramethyl orthosilicate"@en ;
          skos:definition "The silicon alkoxide Si(OCH3)4, a rapidly hydrolysing silica precursor for sol-gel processing"@en .


###  https://w3id.org/gelmat/MTES
gmat:MTES rdf:type owl:Class ;
          rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
          pmat:hasCASNr "2031-67-6" ;
          pmat:hasIUPACName "triethoxy(methyl)silane" ;
          pmat:hasAcronym "MTES" ;
          rdfs:comment "Methyltriethoxysilane (MTES, CH3Si(OC2H5)3), an organosilica precursor bearing one methyl group; used as co-precursor with TEOS to introduce hydrophobicity"@en ;
          rdfs:label "Methyltriethoxysilane"@en ;
          skos:altLabel "MTES"@en ;
          skos:definition "The silicon alkoxide CH3Si(OC2H5)3 with one non-hydrolysable methyl group, used to produce hydrophobic organosilica networks"@en .


###  https://w3id.org/gelmat/VTMS
gmat:VTMS rdf:type owl:Class ;
          rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
          pmat:hasCASNr "2768-02-7" ;
          pmat:hasIUPACName "ethenyl(trimethoxy)silane" ;
          pmat:hasAcronym "VTMS" ;
          rdfs:comment "Vinyltrimethoxysilane (VTMS, CH2=CHSi(OCH3)3), an organosilica precursor bearing a polymerisable vinyl group; used for vinyl-functional and double-network aerogels"@en ;
          rdfs:label "Vinyltrimethoxysilane"@en ;
          skos:altLabel "VTMS"@en ;
          skos:definition "The silicon alkoxide CH2=CHSi(OCH3)3 carrying a vinyl group, used as a functional silica co-precursor"@en .


###  https://w3id.org/gelmat/APTES
gmat:APTES rdf:type owl:Class ;
           rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
           pmat:hasCASNr "919-30-2" ;
           pmat:hasIUPACName "3-triethoxysilylpropan-1-amine" ;
           pmat:hasAcronym "APTES" ;
           rdfs:comment "(3-Aminopropyl)triethoxysilane (APTES, H2N(CH2)3Si(OC2H5)3), an amine-functional silica precursor and coupling agent; used for amine-modified aerogels (CO2 sorption) and for cross-linking with epoxies or isocyanates"@en ;
           rdfs:label "(3-Aminopropyl)triethoxysilane"@en ;
           skos:altLabel "APTES"@en ;
           skos:definition "The amine-functional silicon alkoxide H2N(CH2)3Si(OC2H5)3, used as a co-precursor and coupling agent in sol-gel processing"@en .


###  https://w3id.org/gelmat/GPTMS
gmat:GPTMS rdf:type owl:Class ;
           rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
           pmat:hasCASNr "2530-83-8" ;
           pmat:hasIUPACName "trimethoxy-[3-(oxiran-2-ylmethoxy)propyl]silane" ;
           pmat:hasAcronym "GPTMS" ;
           rdfs:comment "(3-Glycidyloxypropyl)trimethoxysilane (GPTMS), an epoxy-functional silica precursor and coupling agent for organic-inorganic hybrid aerogels"@en ;
           rdfs:label "(3-Glycidyloxypropyl)trimethoxysilane"@en ;
           skos:altLabel "GPTMS"@en ,
                         "GLYMO"@en ;
           skos:definition "The epoxy-functional silicon alkoxide used as a coupling agent and hybrid network precursor in sol-gel processing"@en .


###  https://w3id.org/gelmat/BTMSE
gmat:BTMSE rdf:type owl:Class ;
           rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
           pmat:hasCASNr "18406-41-2" ;
           pmat:hasIUPACName "1,2-bis(trimethoxysilyl)ethane" ;
           pmat:hasAcronym "BTMSE" ;
           rdfs:comment "1,2-Bis(trimethoxysilyl)ethane (BTMSE), a bridged bis-silane precursor yielding ethylene-bridged polysilsesquioxane networks with enhanced flexibility and strength"@en ;
           rdfs:label "1,2-Bis(trimethoxysilyl)ethane"@en ;
           skos:altLabel "BTMSE"@en ,
                         "BTME"@en ;
           skos:definition "A bridged silicon dialkoxide precursor, (CH3O)3Si-CH2CH2-Si(OCH3)3, that forms ethylene-bridged organosilica networks"@en .


###  https://w3id.org/gelmat/PEDS
gmat:PEDS rdf:type owl:Class ;
          rdfs:subClassOf gmat:SiliconAlkoxidePrecursor ;
          pmat:hasAcronym "PEDS" ;
          rdfs:comment "Polyethoxydisiloxane (PEDS), a pre-polymerised (partially hydrolysed and condensed) TEOS oligomer sold as an ethanolic solution; a common industrial silica precursor with reproducible reactivity"@en ;
          rdfs:label "Polyethoxydisiloxane"@en ;
          skos:altLabel "PEDS"@en ,
                        "Pre-polymerised TEOS"@en ;
          skos:definition "A partially hydrolysed and condensed oligomeric ethoxysiloxane used as a pre-polymerised silica precursor"@en .


###  https://w3id.org/gelmat/MetalOxidePrecursor
gmat:MetalOxidePrecursor rdf:type owl:Class ;
                         rdfs:subClassOf gmat:Precursor ;
                         rdfs:comment "A precursor that yields a non-silica metal oxide network (alumina, titania, zirconia, iron oxide, ...); comprises metal alkoxides as well as metal chlorides and nitrates used in epoxide-assisted routes"@en ;
                         rdfs:label "Metal oxide precursor"@en ;
                         skos:definition "A precursor whose hydrolysis and condensation (or epoxide-assisted gelation) yield a metal oxide network"@en .


###  https://w3id.org/gelmat/AluminiumSecButoxide
gmat:AluminiumSecButoxide rdf:type owl:Class ;
                          rdfs:subClassOf gmat:MetalAlkoxide ;
                          pmat:hasCASNr "2269-22-9" ;
                          rdfs:comment "Aluminium tri-sec-butoxide (Al(OsBu)3), the standard alkoxide precursor for alumina aerogels via the Yoldas route"@en ;
                          rdfs:label "Aluminium sec-butoxide"@en ;
                          skos:altLabel "Aluminium tri-sec-butoxide"@en ,
