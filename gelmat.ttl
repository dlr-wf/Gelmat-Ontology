gmat:PHAdjuster rdf:type owl:Class ;
                rdfs:subClassOf obo:CHEBI_24431 ;
                rdfs:comment "A substance used to control pH during gelation or processing, such as acids or bases"@en ;
                skos:definition "A substance added to control the pH of a mixture during gelation or processing"@en ;
                rdfs:label "pH adjuster"@en .


###  https://w3id.org/gelmat/PHCondition
gmat:PHCondition rdf:type owl:Class ;
                 rdfs:subClassOf gmat:ProcessParameter ;
                 rdfs:comment "The pH level maintained during a sol-gel process step (sol formation, gelation, aging). Acid conditions (pH 1-5) favour hydrolysis; base conditions (pH 7-10) favour condensation. pH is controlled by addition of acid or base catalysts. As a ProcessParameter this class is an om:Quantity, so the preferred value pattern is om:hasValue pointing to a dimensionless om:Measure (see gmat:PHValue); gmat:hasPHValue remains available as a datatype shortcut"@en ;
                 rdfs:label "pH condition"@en ;
                 skos:definition "A process parameter specifying the hydrogen ion concentration of the reaction medium, expressed on a scale of 0-14, that governs the relative rates of hydrolysis and condensation in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/ParticleSize
gmat:ParticleSize rdf:type owl:Class ;
                  rdfs:subClassOf om:Length ;
                  rdfs:comment "The diameter or dimension of the primary particles making up the aerogel framework"@en ;
                  gmat:hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
                  skos:definition "A quantity representing the characteristic dimension of the primary particles composing a material framework"@en ;
                  rdfs:label "Particle size"@en .


###  https://w3id.org/polymat/Permeability-Diffusion
pmat:Permeability-Diffusion rdf:type owl:Class ;
                            rdfs:subClassOf om:Quantity ;
                            rdfs:comment """Describes the penetration of a permeate (a fluid such as a liquid, gas, or vapor) through a solid (such as a membrane); it is directly proportional the materials' diffusion coefficient and inversly proportional to the concentration or pressure gradient of the permeate

P = V･d / (A･t･p) = D / p
P = permeability (diffusion)
V = Volume of the permeate [m³]
d = thickness of the membrane [m]
A = area of the membrane [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit of the permeability (diffusion) is m²/(s･atm); the proportional unit E-10･cm²/(s･Torr) is commonly called  Barrer."""@en ;
                            rdfs:label "Permeability (diffusion)"@en .


