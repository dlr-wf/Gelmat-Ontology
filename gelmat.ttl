gmat:Cryogel rdf:type owl:Class ;
             rdfs:subClassOf gmat:Gel ;
             rdfs:comment "A dried gel obtained by freeze drying (lyophilisation) of a wet gel; ice crystal growth typically leaves a more macroporous, often lamellar structure than supercritical drying"@en ;
             rdfs:label "Cryogel"@en ;
             skos:definition "A dried gel produced by freezing the pore liquid and removing it by sublimation (freeze drying)"@en .


###  https://w3id.org/gelmat/Ambigel
gmat:Ambigel rdf:type owl:Class ;
             rdfs:subClassOf gmat:Gel ;
             rdfs:comment "A dried gel obtained by ambient pressure (evaporative) drying under conditions that largely preserve the pore network (surface modification, low-surface-tension solvent); intermediate between xerogel and aerogel"@en ;
             rdfs:label "Ambigel"@en ;
             skos:definition "A dried gel produced by ambient pressure drying with measures that substantially preserve the mesoporous network"@en .


