###  https://w3id.org/gelmat/OrganicPrecursor
gmat:OrganicPrecursor rdf:type owl:Class ;
                      rdfs:subClassOf gmat:Precursor ;
                      rdfs:comment "A small organic molecule that polycondenses into an organic gel network (resorcinol-formaldehyde and related chemistries); the parent chemistry of organic and, after pyrolysis, carbon aerogels"@en ;
                      rdfs:label "Organic precursor"@en ;
                      skos:definition "An organic monomer that forms an organic polymer network by polycondensation in sol-gel synthesis"@en .


