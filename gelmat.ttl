###  https://w3id.org/polymat/HollowFibreModule
pmat:HollowFibreModule rdf:type owl:Class ;
                       rdfs:subClassOf pmat:Module ;
                       rdfs:comment """A bundle of hollow fibres packed in a pressure vessel, with the permeate passing either out of the fibers (bore-side feed) or into them (shell-side feed)
(https://www.sciencedirect.com/topics/engineering/hollow-fibre-module)"""@en ;
                       rdfs:label "Hollow fibre module"@en .


###  https://w3id.org/polymat/Homopolymer
pmat:Homopolymer rdf:type owl:Class ;
                 rdfs:subClassOf pmat:Polymer ;
                 rdfs:comment """A polymer derived from identical monomer units
(http://materialsmine.org/ns/Homopolymer)"""@en ;
                 rdfs:label "Homopolymer"@en .


###  https://w3id.org/polymat/HotPlate
pmat:HotPlate rdf:type owl:Class ;
              rdfs:subClassOf pmat:Instrument ;
              rdfs:comment "An electric instrument that creates a hot surface"@en ;
              rdfs:label "Hot plate"@en .


###  https://w3id.org/gelmat/HybridAerogel
gmat:HybridAerogel rdf:type owl:Class ;
                   rdfs:subClassOf gmat:Aerogel ;
                   rdfs:comment "An aerogel composed of both organic and inorganic components, combining properties of different material classes"@en ;
                   skos:definition "An aerogel composed of two or more chemically distinct network components, at least one of which is organic and at least one inorganic, covalently or physically integrated within the same porous framework"@en ;
                  rdfs:label "Hybrid aerogel"@en .




###  https://w3id.org/gelmat/Hydrolysis
gmat:Hydrolysis rdf:type owl:Class ;
                rdfs:subClassOf gmat:SolFormation ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gmat:usesSubstance ;
                                  owl:someValuesFrom gmat:Water
                                ] ;
                rdfs:comment "Reaction of a silicon alkoxide precursor with water to generate silanol groups (Si-OH). Rate depends on pH, water-to-alkoxide ratio, and solvent. Acid catalysis accelerates hydrolysis; base catalysis promotes condensation"@en ;
                rdfs:label "Hydrolysis"@en ;
                skos:definition "Nucleophilic substitution of alkoxy groups by hydroxyl groups in the presence of water, yielding silanols as sol-gel intermediates"@en .


###  https://w3id.org/gelmat/Condensation
gmat:Condensation rdf:type owl:Class ;
                  rdfs:subClassOf gmat:CreationProcess ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gmat:usesSubstance ;
                                    owl:someValuesFrom gmat:Silanol
                                  ] ;
                  rdfs:comment "Reaction between silanol groups (Si-OH + HO-Si -> Si-O-Si + H2O) or between silanol and alkoxy groups forming siloxane bonds that build the three-dimensional gel network"@en ;
                  rdfs:label "Condensation"@en ;
                  skos:definition "Formation of siloxane (Si-O-Si) network bonds by reaction of silanol intermediates, releasing water or alcohol as by-products"@en .


###  https://w3id.org/gelmat/SolGelTransition
gmat:SolGelTransition rdf:type owl:Class ;
                      rdfs:subClassOf gmat:CreationProcess ;
                      rdfs:comment "The gel point event at which the sol loses fluidity and transitions to a solid gel network due to percolation of the condensing silica network. Characterised by a sharp increase in viscosity and loss of flow. Placed under gmat:CreationProcess (not under gmat:Gelation, whose usesSubstance existentials would be wrongly inherited by an instantaneous event) so that it is visible to anything that enumerates synthesis steps; the containment in gelation is expressed by gmat:Gelation asserting BFO_0000051 (has part) some SolGelTransition"@en ;
                      skos:definition "The critical event (gel point) at which percolation of the condensing network spans the reaction volume, converting the flowable sol into a solid gel; marked by divergence of viscosity and loss of steady-state flow"@en ;
                      rdfs:label "Sol-gel transition"@en ;
                      skos:altLabel "Gel point"@en ,
                                    "Gelation point"@en .


###  https://w3id.org/gelmat/AcidCatalysis
gmat:AcidCatalysis rdf:type owl:Class ;
                   rdfs:subClassOf gmat:Gelation ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gmat:usesSubstance ;
                                     owl:someValuesFrom gmat:AcidCatalyst
                                   ] ;
                   rdfs:comment "Sol-gel gelation under acid-catalytic conditions (pH < 7). Promotes fast hydrolysis and slower condensation, yielding weakly branched, polymeric gel structures with smaller pores"@en ;                   owl:disjointWith gmat:BaseCatalysis ,
                                    gmat:TwoStepCatalysis ;
                   skos:definition "Gelation performed at pH below 7, where protonation of alkoxide leaving groups accelerates hydrolysis relative to condensation, yielding weakly branched, polymeric gel networks with small pores"@en ;

                   rdfs:label "Acid-catalysed gelation"@en ;
                   skos:altLabel "Acid catalysis"@en .


###  https://w3id.org/gelmat/BaseCatalysis
gmat:BaseCatalysis rdf:type owl:Class ;
                   rdfs:subClassOf gmat:Gelation ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gmat:usesSubstance ;
                                     owl:someValuesFrom gmat:Base
                                   ] ;
                   rdfs:comment "Sol-gel gelation under basic conditions (pH > 7). Promotes fast condensation and slower hydrolysis, yielding highly branched, colloidal cluster networks with larger pore sizes"@en ;
                   skos:definition "Gelation performed at pH above 7, where hydroxide ions catalyse condensation faster than hydrolysis, yielding highly branched, colloidal cluster-cluster aggregation networks with larger pore sizes"@en ;
                   rdfs:label "Base-catalysed gelation"@en ;
                   skos:altLabel "Base catalysis"@en .


###  https://w3id.org/gelmat/TwoStepCatalysis
gmat:TwoStepCatalysis rdf:type owl:Class ;
                      rdfs:subClassOf gmat:Gelation ;
                      rdfs:comment "Two-stage acid-then-base catalysis route: an acid pre-hydrolysis step produces partially hydrolysed monomers; subsequent base addition (typically ammonium hydroxide or ammonium fluoride) triggers rapid condensation and gelation. Common route for MTMS and TEOS aerogels"@en ;
                      skos:definition "A sol-gel route combining an acid pre-hydrolysis step with a subsequent base addition step that triggers rapid condensation and gelation; standard route for MTMS and BTMSE aerogel synthesis"@en ;
                      rdfs:label "Two-step acid-base catalysis"@en ;
                      skos:altLabel "Two-step catalysis"@en ,
                                    "Acid-base two-step"@en .


###  https://w3id.org/gelmat/SurfaceSilylation
gmat:SurfaceSilylation rdf:type owl:Class ;
                       rdfs:subClassOf gmat:SurfaceModification ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty gmat:hasSilylationAgent ;
                                         owl:someValuesFrom gmat:SilylationAgent
                                       ] ;
                       rdfs:comment "Chemical modification of wet gel surface Si-OH groups by reaction with a silylating agent (TMCS, HMDS) to replace surface hydroxyls with hydrophobic alkylsilyl groups. Essential pre-treatment before ambient pressure drying to prevent capillary collapse"@en ;
                       skos:definition "A surface modification step in which surface silanol groups (Si-OH) react with a chlorosilane or silazane reagent (e.g. TMCS, HMDS) to install hydrophobic trialkylsilyl groups, enabling ambient pressure drying"@en ;
                       rdfs:label "Surface silylation"@en ;
                       skos:altLabel "Hydrophobic surface modification"@en ,
                                     "TMCS treatment"@en .



###  https://w3id.org/gelmat/Hydrogel
gmat:Hydrogel rdf:type owl:Class ;
              rdfs:subClassOf gmat:WetGel ;
              rdfs:comment "A hydrogel is a gel in which the liquid phase consists mainly of water."@en ;
              skos:definition "A wet gel in which the liquid pore phase is predominantly water; the intermediate state of a silica sol-gel system before solvent exchange"@en ;
              rdfs:label "Hydrogel"@en .


###  https://w3id.org/gelmat/HydrophobicityTesting
gmat:HydrophobicityTesting rdf:type owl:Class ;
                           rdfs:subClassOf pmat:Analysis ;
                           rdfs:comment "Measurement of water contact angle or water uptake to determine surface hydrophobicity"@en ;
                           skos:definition "An analysis that determines the surface hydrophobicity of a material, typically by water contact angle or water uptake measurement"@en ;
                           rdfs:label "Hydrophobicity testing"@en .


