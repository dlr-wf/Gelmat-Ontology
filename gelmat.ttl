           rdfs:subClassOf pmat:Equipment ;
           rdfs:comment "Laboratory or industrial equipment designed for removing solvents or moisture from materials through controlled heating, vacuum, or other drying mechanisms"@en ;
           skos:definition "Equipment designed to remove solvent or moisture from a material by controlled heating, vacuum, sublimation, or supercritical extraction"@en ;
           rdfs:label "Dryer"@en .


###  https://w3id.org/polymat/Drying
pmat:Drying rdf:type owl:Class ;
            rdfs:subClassOf pmat:SamplePreparation ;
            rdfs:comment """A mass transfer process consisting of the removal of water or another solvent by evaporation from a solid, semi-solid or liquid
(https://en.wikipedia.org/wiki/Drying)"""@en ;
            skos:definition "The final step of aerogel synthesis in which the pore liquid is removed from the wet gel while preserving the porous network structure; route determines whether the product is an aerogel (structure preserved) or xerogel (structure collapsed)"@en ;
            rdfs:label "Drying"@en .
pmat:Drying gmat:hasStepOrder "5"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/DryingControlChemicalAdditive
gmat:DryingControlChemicalAdditive rdf:type owl:Class ;
                                   rdfs:subClassOf obo:CHEBI_24431 ;
                                   rdfs:comment "Chemical additives (DCCA) used to reduce capillary stress and prevent cracking during ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:DryingControlAdditiveRole]"@en ;
                                   skos:definition "A chemical additive incorporated into a sol to reduce capillary stress and prevent cracking during drying"@en ;
                                   rdfs:label "Drying control chemical additive"@en ;
                                   skos:altLabel "DCCA"@en .


