    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:comment xml:lang="en">Everything is part of itself. Any part of any part of a thing is itself part of that thing. Two distinct things cannot be part of each other.</rdfs:comment>
        <rdfs:comment xml:lang="en">Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/</rdfs:comment>
        <rdfs:comment xml:lang="en">Parthood requires the part and the whole to have compatible classes: only an occurrent can be part of an occurrent; only a process can be part of a process; only a continuant can be part of a continuant; only an independent continuant can be part of an independent continuant; only an immaterial entity can be part of an immaterial entity; only a specifically dependent continuant can be part of a specifically dependent continuant; only a generically dependent continuant can be part of a generically dependent continuant. (This list is not exhaustive.)

A continuant cannot be part of an occurrent: use &apos;participates in&apos;. An occurrent cannot be part of a continuant: use &apos;has participant&apos;. A material entity cannot be part of an immaterial entity: use &apos;has location&apos;. A specifically dependent continuant cannot be part of an independent continuant: use &apos;inheres in&apos;. An independent continuant cannot be part of a specifically dependent continuant: use &apos;bearer of&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">a core relation that holds between a part and its whole</rdfs:comment>
        <rdfs:comment xml:lang="en">my brain is part of my body (continuant parthood, two material entities)</rdfs:comment>
        <rdfs:comment xml:lang="en">my stomach cavity is part of my stomach (continuant parthood, immaterial entity is part of material entity)</rdfs:comment>
        <rdfs:comment xml:lang="en">this day is part of this year (occurrent parthood)</rdfs:comment>
        <rdfs:label xml:lang="en">part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000051 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000051">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Everything has itself as a part. Any part of any part of a thing is itself part of that thing. Two distinct things cannot have each other as a part.</rdfs:comment>
        <rdfs:comment xml:lang="en">Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/</rdfs:comment>
        <rdfs:comment xml:lang="en">Parthood requires the part and the whole to have compatible classes: only an occurrent have an occurrent as part; only a process can have a process as part; only a continuant can have a continuant as part; only an independent continuant can have an independent continuant as part; only a specifically dependent continuant can have a specifically dependent continuant as part; only a generically dependent continuant can have a generically dependent continuant as part. (This list is not exhaustive.)

A continuant cannot have an occurrent as part: use &apos;participates in&apos;. An occurrent cannot have a continuant as part: use &apos;has participant&apos;. An immaterial entity cannot have a material entity as part: use &apos;location of&apos;. An independent continuant cannot have a specifically dependent continuant as part: use &apos;bearer of&apos;. A specifically dependent continuant cannot have an independent continuant as part: use &apos;inheres in&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="en">a core relation that holds between a whole and its part</rdfs:comment>
        <rdfs:comment xml:lang="en">my body has part my brain (continuant parthood, two material entities)</rdfs:comment>
        <rdfs:comment xml:lang="en">my stomach has part my stomach cavity (continuant parthood, material entity has part immaterial entity)</rdfs:comment>
        <rdfs:comment xml:lang="en">this year has part this day (occurrent parthood)</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000052 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000052">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:comment xml:lang="en">a relation between a specifically dependent continuant (the characteristic) and any other entity (the bearer), in which the characteristic depends on the bearer for its existence</rdfs:comment>
        <rdfs:label xml:lang="en">characteristic of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000053 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000053">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:comment xml:lang="en">inverse of characteristic_of (http://purl.obolibrary.org/obo/RO_0000052)</rdfs:comment>
        <rdfs:label xml:lang="en">has characteristic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000056 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000056">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">a relation between a continuant and a process, in which the continuant is somehow involved in the process</rdfs:comment>
        <rdfs:label xml:lang="en">participates in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000057 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:comment xml:lang="en">a relation between a process and a continuant, in which the continuant is somehow involved in the process</rdfs:comment>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000081 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000081">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
        <rdfs:comment xml:lang="en">a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence</rdfs:comment>
        <rdfs:label xml:lang="en">role of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000087 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000087">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:comment xml:lang="en">a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence</rdfs:comment>
        <rdfs:label xml:lang="en">has role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001015 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001015">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
        <rdfs:comment xml:lang="en">a relation between two independent continuants, the location and the target, in which the target is entirely within the location</rdfs:comment>
        <rdfs:label xml:lang="en">location of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001018 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001018">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0001019"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:comment xml:lang="en">The relation between a physical content and its container. A material entity B is contained in a material entity A if B is located in some cavity of A.  
(inverse of http://purl.allotrope.org/ontologies/property#AFX_0001048)</rdfs:comment>
        <rdfs:label xml:lang="en">contained in</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001019 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001019">
        <rdfs:comment xml:lang="en">The relation between a container and its physical content. A material entity a contains a material entity b if b is located in some cavity of a.
(http://purl.allotrope.org/ontologies/property#AFX_0001048)</rdfs:comment>
        <rdfs:label xml:lang="en">contains</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0001025 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001025">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">a relation between two independent continuants, the target and the location, in which the target is entirely within the location</rdfs:comment>
        <rdfs:label xml:lang="en">located in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002233 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002233">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002352"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">p has input c iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.
(http://purl.obolibrary.org/obo/RO_0002233)

a relation between a process and an entity, where the entity is present at the beginning of the process
(http://semanticscience.org/resource/SIO_000230)</rdfs:comment>
        <rdfs:label xml:lang="en">has input</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002234 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002234">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
        <rdfs:comment xml:lang="en">p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.
(http://purl.obolibrary.org/obo/RO_0002234)

has output is a relation between an process and an entity, where the entity is present at the end of the process.
(http://semanticscience.org/resource/SIO_000229)</rdfs:comment>
        <rdfs:label xml:lang="en">has output</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002352 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002352">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
        <rdfs:comment xml:lang="en">c is input of p iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.
(inverse of http://purl.obolibrary.org/obo/RO_0002233)</rdfs:comment>
        <rdfs:label xml:lang="en">input of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002353 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002353">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
        <rdfs:comment xml:lang="en">c is output of p iff: c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p.
(inverse of http://purl.obolibrary.org/obo/RO_0002234)</rdfs:comment>
        <rdfs:label xml:lang="en">output of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002615 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002615">
        <rdfs:comment xml:lang="en">a relation between an entity and its model (an artifact), which purports to represent the entity.
(inverse of http://semanticscience.org/resource/SIO_000632)</rdfs:comment>
        <rdfs:label xml:lang="en">has model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0003301 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0003301">
        <rdfs:comment xml:lang="en">a relation between a biological, experimental, or computational artifact and an entity it is used to study, in virtue of its replicating or approximating features of the studied entity</rdfs:comment>
        <rdfs:label xml:lang="en">has role in modeling</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004017 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004017">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0004018"/>
        <rdfs:comment xml:lang="en">realizable B has basis in A, if  B could not exist without the existence of A.
inverse of &quot;is basis for realizable&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">realizable has basis in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0004018 -->


    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0004018">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment xml:lang="en">A is basis for realizable B, if  B could not exist without the existence of A.</rdfs:comment>
        <rdfs:label xml:lang="en">is basis for realizable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
        <rdfs:label xml:lang="en">has unit</rdfs:label>
        <rdfs:label xml:lang="ja">単位を持つ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue -->


    <owl:ObjectProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasValue">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
                    <rdf:Description rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Point"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">has value</rdfs:label>
        <rdfs:label xml:lang="ja">値を持つ</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#agent -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#agent">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#AgentInfluence"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">The prov:agent property references an prov:Agent which influenced a resource. This property applies to an prov:AgentInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple.</rdfs:comment>
        <rdfs:label>agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#entity -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#entity">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#EntityInfluence"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple.</rdfs:comment>
        <rdfs:comment>The prov:entity property references an prov:Entity which influenced a resource. This property applies to an prov:EntityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.</rdfs:comment>
        <rdfs:label>entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">prov:generated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions.</rdfs:comment>
        <rdfs:label>generated</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#hadRole -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#hadRole">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Influence"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Association"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#InstantaneousEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Role"/>
        <rdfs:comment xml:lang="en">prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end.</rdfs:comment>
        <rdfs:label>hadRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#hadUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#hadUsage">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Usage"/>
        <rdfs:label>hadUsage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedAssociation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedAssociation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Association"/>
        <rdfs:comment xml:lang="en">If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ].</rdfs:comment>
        <rdfs:label>qualifiedAssociation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedAttribution -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedAttribution">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Attribution"/>
        <rdfs:comment xml:lang="en">If this Entity prov:wasAttributedTo Agent :ag, then it can qualify how it was influenced using prov:qualifiedAttribution [ a prov:Attribution;  prov:agent :ag; :foo :bar ].</rdfs:comment>
        <rdfs:label>qualifiedAttribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#qualifiedUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#qualifiedUsage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Usage"/>
        <rdfs:comment xml:lang="en">If this Activity prov:used Entity :e, then it can qualify how it used it using prov:qualifiedUsage [ a prov:Usage; prov:entity :e; :foo :bar ].</rdfs:comment>
        <rdfs:label>qualifiedUsage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven .</rdfs:comment>
        <rdfs:comment xml:lang="en">Aerogel synthesis processes use various chemical substances such as precursors, solvents, and catalysts.</rdfs:comment>
        <rdfs:label>used</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity.</rdfs:comment>
        <rdfs:label>wasAssociatedWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Attribution is the ascribing of an entity to an agent.</rdfs:comment>
        <rdfs:label>wasAttributedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity.</rdfs:comment>
        <rdfs:comment xml:lang="en">The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable.</rdfs:comment>
        <rdfs:label>wasDerivedFrom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label>wasGeneratedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/generatesIntermediate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/generatesIntermediate">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Method"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Links a process step (creation process or sample preparation step such as solvent exchange) to the intermediate product it generates</rdfs:comment>
        <rdfs:label xml:lang="en">generates intermediate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasActivationEnergy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasActivationEnergy">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ActivationEnergy"/>
        <rdfs:comment xml:lang="en">Relates a substance or process (e.g. gelation kinetics) to an activation energy, expressed as a gmat:ActivationEnergy individual with an om:Measure value in kJ/mol</rdfs:comment>
        <rdfs:label xml:lang="en">has activation energy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasApplication -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasApplication">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Relates a material to an application it is intended for or demonstrated in (e.g. thermal insulation, adsorption, drug delivery)</rdfs:comment>
        <rdfs:label xml:lang="en">has application</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasAtmosphere -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasAtmosphere">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Relates a thermal treatment step (pyrolysis, calcination, sintering) to the gas atmosphere in which it is performed, e.g. nitrogen, argon, air, or carbon dioxide</rdfs:comment>
        <rdfs:label xml:lang="en">has atmosphere</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasBulkDensity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasBulkDensity">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/hasDensity"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/BulkDensity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its bulk (envelope) density, expressed as a gmat:BulkDensity individual with an om:Measure value in kg/m3</rdfs:comment>
        <rdfs:label xml:lang="en">has bulk density</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasCompressiveModulus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasCompressiveModulus">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/CompressiveModulus"/>
        <rdfs:comment xml:lang="en">Relates a substance to its compressive (Young&apos;s) modulus, expressed as a gmat:CompressiveModulus individual with om:Measure value in kPa or MPa</rdfs:comment>
        <rdfs:label xml:lang="en">has compressive modulus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasCompressiveStrength -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasCompressiveStrength">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/CompressiveStrength"/>
        <rdfs:comment xml:lang="en">Relates a substance to its maximum compressive strength, expressed as a gmat:CompressiveStrength individual with om:Measure value in kPa or MPa</rdfs:comment>
        <rdfs:label xml:lang="en">has compressive strength</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasContactAngle -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasContactAngle">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ContactAngle"/>
        <rdfs:comment xml:lang="en">Relates a substance to its water contact angle, expressed as a gmat:ContactAngle individual with om:Measure value in degrees</rdfs:comment>
        <rdfs:label xml:lang="en">has contact angle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasCorrelationLength -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasCorrelationLength">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/CorrelationLength"/>
        <rdfs:comment xml:lang="en">Relates a substance to the correlation length (ξ, fractal upper cutoff / cluster size) of its network, expressed as a gmat:CorrelationLength individual with om:Measure value in metres (nm scale)</rdfs:comment>
        <rdfs:label xml:lang="en">has correlation length</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasDefect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasDefect">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">Relates an aerogel material to a structural or quality defect (a persisting defect state) observed in it. Sub-property of obo:RO_0000053 (bearer of), consistent with the other characteristic-linking properties.</rdfs:comment>
        <rdfs:label xml:lang="en">has defect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasDensity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasDensity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Density"/>
        <rdfs:comment xml:lang="en">Relates a substance to its density, expressed as a gmat:Density individual with an om:Measure value in the canonical SI unit kg/m3 (g/cm3 = 1000 kg/m3 is a common lab convention)</rdfs:comment>
        <rdfs:label xml:lang="en">has density</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasFlexuralModulus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasFlexuralModulus">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/FlexuralModulus"/>
        <rdfs:comment xml:lang="en">Relates a substance to its flexural (bending) modulus, expressed as a gmat:FlexuralModulus individual with om:Measure value in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">has flexural modulus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasFlexuralStrength -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasFlexuralStrength">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/FlexuralStrength"/>
        <rdfs:comment xml:lang="en">Relates a substance to its flexural (bending) strength, expressed as a gmat:FlexuralStrength individual with om:Measure value in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">has flexural strength</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasFractalDimension -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasFractalDimension">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/FractalDimension"/>
        <rdfs:comment xml:lang="en">Relates a substance to a fractal dimension (mass or surface), expressed as a gmat:FractalDimension individual with a dimensionless om:Measure value. Use gmat:hasMassFractalDimension or gmat:hasSurfaceFractalDimension for the specific type</rdfs:comment>
        <rdfs:label xml:lang="en">has fractal dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasGelationRoute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasGelationRoute">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/AerogelSynthesis"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:comment xml:lang="en">Relates an aerogel synthesis to the mechanistic gelation pathway it follows (e.g. acid-catalysed sol-gel polymerisation, base-catalysed, two-step)</rdfs:comment>
        <rdfs:label xml:lang="en">has gelation route</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasGeometry -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasGeometry">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Geometry"/>
        <rdfs:comment xml:lang="en">Relates a material entity to a description of its shape or geometric configuration</rdfs:comment>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasHeatingRate -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasHeatingRate">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/HeatingRate"/>
        <rdfs:comment xml:lang="en">Relates a thermal process step (drying, pyrolysis, temperature ramping) to its heating rate, expressed as a gmat:HeatingRate individual with an om:Measure value in K/min</rdfs:comment>
        <rdfs:label xml:lang="en">has heating rate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasIntermediateProduct -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasIntermediateProduct">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/generatesIntermediate"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/SolFormation"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Silanol"/>
        <rdfs:comment xml:lang="en">Relates a sol formation step to the silanol intermediates generated during hydrolysis</rdfs:comment>
        <rdfs:label xml:lang="en">has intermediate product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasLinearShrinkage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasLinearShrinkage">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Shrinkage"/>
        <rdfs:comment xml:lang="en">Relates a substance to its linear shrinkage during drying, expressed as a gmat:Shrinkage individual with om:Measure value as a percentage</rdfs:comment>
        <rdfs:label xml:lang="en">has linear shrinkage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasMassFractalDimension -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasMassFractalDimension">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/hasFractalDimension"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/MassFractalDimension"/>
        <rdfs:comment xml:lang="en">Relates a substance to its mass fractal dimension (Dm), expressed as a gmat:MassFractalDimension individual with a dimensionless om:Measure value (1-3)</rdfs:comment>
        <rdfs:label xml:lang="en">has mass fractal dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasMassFraction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasMassFraction">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/MassFraction"/>
        <rdfs:comment xml:lang="en">Relates a substance (e.g. a composite aerogel or a sol) to a mass fraction such as fibre loading, solid content, or silica content, expressed as a gmat:MassFraction individual with a dimensionless om:Measure value (wt% or fraction)</rdfs:comment>
        <rdfs:label xml:lang="en">has mass fraction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasMatrix -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasMatrix">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/CompositeAerogel"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Relates a composite aerogel to the continuous matrix material (e.g. the silica aerogel phase of a fibre-reinforced composite)</rdfs:comment>
        <rdfs:label xml:lang="en">has matrix</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasMeanPoreSize -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasMeanPoreSize">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/MeanPoreSize"/>
        <rdfs:comment xml:lang="en">Relates a substance to its mean pore size (BJH), expressed as a gmat:MeanPoreSize individual with om:Measure value in nm</rdfs:comment>
        <rdfs:label xml:lang="en">has mean pore size</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPHCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPHCondition">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/PHCondition"/>
        <rdfs:comment xml:lang="en">Relates a sol-gel process step (sol formation, gelation, aging) to the pH condition maintained during that step</rdfs:comment>
        <rdfs:label xml:lang="en">has pH condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasParticleSize -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasParticleSize">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ParticleSize"/>
        <rdfs:comment xml:lang="en">Relates a substance to the characteristic size of its primary particles, expressed as a gmat:ParticleSize individual with an om:Measure value in nm</rdfs:comment>
        <rdfs:label xml:lang="en">has particle size</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPoissonRatio -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPoissonRatio">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/PoissonRatio"/>
        <rdfs:comment xml:lang="en">Relates a substance to its Poisson ratio, expressed as a gmat:PoissonRatio individual with a dimensionless om:Measure value</rdfs:comment>
        <rdfs:label xml:lang="en">has Poisson ratio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPoreSizeDistribution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPoreSizeDistribution">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/PoreSizeDistribution"/>
        <rdfs:comment xml:lang="en">Relates a substance to its pore size distribution, expressed as a gmat:PoreSizeDistribution individual</rdfs:comment>
        <rdfs:label xml:lang="en">has pore size distribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPoreVolume -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPoreVolume">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/PoreVolume"/>
        <rdfs:comment xml:lang="en">Relates a substance to its total pore volume, expressed as a gmat:PoreVolume individual with an om:Measure value (typically cm3/g)</rdfs:comment>
        <rdfs:label xml:lang="en">has pore volume</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPorodExponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPorodExponent">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/PorodExponent"/>
        <rdfs:comment xml:lang="en">Relates a substance to the power-law (Porod) exponent of its scattering curve, expressed as a gmat:PorodExponent individual with a dimensionless om:Measure value</rdfs:comment>
        <rdfs:label xml:lang="en">has Porod exponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPorosity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPorosity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Porosity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its porosity, expressed as a gmat:Porosity individual with om:Measure value as a fraction or percentage</rdfs:comment>
        <rdfs:label xml:lang="en">has porosity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPrecursor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPrecursor">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Links an aerogel or gel to its chemical precursor substance</rdfs:comment>
        <rdfs:label xml:lang="en">has precursor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasPressure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasPressure">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure"/>
        <rdfs:comment xml:lang="en">Relates a process step or substance to a pressure condition (e.g. autoclave pressure during supercritical drying, vacuum level), expressed as an om:Pressure individual with an om:Measure value in Pa or MPa. For process bearers, pmat:isParameterOf from the pressure to the process is the inverse-direction alternative</rdfs:comment>
        <rdfs:label xml:lang="en">has pressure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasRatioComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasRatioComponent">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/gelmat/MolarRatio"/>
                    <rdf:Description rdf:about="https://w3id.org/gelmat/VolumeRatio"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Links a volume or molar ratio to the chemical substances it describes the proportion between</rdfs:comment>
        <rdfs:label xml:lang="en">has ratio component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasReinforcement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasReinforcement">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/CompositeAerogel"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Relates a composite aerogel to the reinforcing or filler phase embedded in its matrix (e.g. glass fibre, cellulose fibre, graphene oxide)</rdfs:comment>
        <rdfs:label xml:lang="en">has reinforcement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSilylationAgent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSilylationAgent">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/SurfaceModification"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SilylationAgent"/>
        <rdfs:comment xml:lang="en">Relates a surface modification step to the silylating agent applied (e.g. TMCS, HMDS) to render the gel surface hydrophobic before ambient pressure drying</rdfs:comment>
        <rdfs:label xml:lang="en">has silylation agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSkeletalDensity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSkeletalDensity">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/hasDensity"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SkeletalDensity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its skeletal (helium pycnometry) density, expressed as a gmat:SkeletalDensity individual with an om:Measure value in kg/m3</rdfs:comment>
        <rdfs:label xml:lang="en">has skeletal density</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSolConcentration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSolConcentration">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SolConcentration"/>
        <rdfs:comment xml:lang="en">Relates a sol (or a synthesis described through it) to the precursor concentration in the sol, expressed as a gmat:SolConcentration individual with an om:Measure value (mol/L or wt%)</rdfs:comment>
        <rdfs:label xml:lang="en">has sol concentration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSpecificHeatCapacity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSpecificHeatCapacity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SpecificHeatCapacity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its specific heat capacity, expressed as a gmat:SpecificHeatCapacity individual with om:Measure value in J/(kg.K)</rdfs:comment>
        <rdfs:label xml:lang="en">has specific heat capacity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSurfaceArea -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSurfaceArea">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SurfaceArea"/>
        <rdfs:comment xml:lang="en">Relates a substance to its BET-determined specific surface area, expressed as a gmat:SurfaceArea individual with an om:Measure value in m2/g</rdfs:comment>
        <rdfs:label xml:lang="en">has surface area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasSurfaceFractalDimension -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasSurfaceFractalDimension">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/hasFractalDimension"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SurfaceFractalDimension"/>
        <rdfs:comment xml:lang="en">Relates a substance to its surface fractal dimension (Ds), expressed as a gmat:SurfaceFractalDimension individual with a dimensionless om:Measure value (2-3)</rdfs:comment>
        <rdfs:label xml:lang="en">has surface fractal dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasTensileStrength -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasTensileStrength">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/UltimateTensileStrength"/>
        <rdfs:comment xml:lang="en">Relates a substance to its ultimate tensile strength, expressed as a pmat:UltimateTensileStrength individual with om:Measure value in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">has tensile strength</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasThermalConductivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasThermalConductivity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ThermalConductivity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its thermal conductivity, expressed as a gmat:ThermalConductivity individual with om:Measure value in W/(m.K)</rdfs:comment>
        <rdfs:label xml:lang="en">has thermal conductivity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasThermalDiffusivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasThermalDiffusivity">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ThermalDiffusivity"/>
        <rdfs:comment xml:lang="en">Relates a substance to its thermal diffusivity, expressed as a gmat:ThermalDiffusivity individual with om:Measure value in m^2/s</rdfs:comment>
        <rdfs:label xml:lang="en">has thermal diffusivity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasThermalExpansionCoefficient -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasThermalExpansionCoefficient">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/ThermalExpansionCoefficient"/>
        <rdfs:comment xml:lang="en">Relates a substance to its linear coefficient of thermal expansion, expressed as a gmat:ThermalExpansionCoefficient individual with om:Measure value in K^-1</rdfs:comment>
        <rdfs:label xml:lang="en">has thermal expansion coefficient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasTransmittance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasTransmittance">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Transmittance"/>
        <rdfs:comment xml:lang="en">Relates a substance to its optical transmittance, expressed as a gmat:Transmittance individual with om:Measure value as percentage (0-100)</rdfs:comment>
        <rdfs:label xml:lang="en">has transmittance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/hasYoungsModulus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/hasYoungsModulus">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/YoungsModulus"/>
        <rdfs:comment xml:lang="en">Relates a substance to its Young&apos;s (elastic) modulus, expressed as a gmat:YoungsModulus individual with om:Measure value in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">has Young&apos;s modulus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/isAerogelProductOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/isAerogelProductOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/wasProducedBy"/>
        <owl:inverseOf rdf:resource="https://w3id.org/gelmat/producesAerogel"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:label xml:lang="en">is aerogel product of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/measuredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/measuredBy">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Relates a measured quantity to the characterisation method (analysis) that produced it, e.g. a surface area value measuredBy a BET analysis. Dedicated shortcut for the common query pattern; prov:wasGeneratedBy remains available for full provenance chains</rdfs:comment>
        <rdfs:label xml:lang="en">measured by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/producesAerogel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/producesAerogel">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:comment xml:lang="en">Relates a drying process to the aerogel material that results from it (covers supercritical, ambient pressure, freeze, and vacuum drying routes)</rdfs:comment>
        <rdfs:label xml:lang="en">producesAerogel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/realisedAs -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/realisedAs">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:comment xml:lang="en">Relates a mechanistic GelationPathway (a Feature) to the Gelation process that realises it. For example, a TwoStepAcidBaseCatalysisPathway is realisedAs a TwoStepCatalysis gelation process</rdfs:comment>
        <rdfs:label xml:lang="en">realised as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/realizesProtocol -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/realizesProtocol">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Procedure"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SynthesisProtocol"/>
        <rdfs:comment xml:lang="en">Links a concrete executed procedure (an occurrent) to the SynthesisProtocol (plan specification / recipe) it carries out. Separates the executed run from the reusable recipe it follows. Domain is pmat:Procedure rather than BFO process (BFO_0000015) to stay compatible with Polymat&apos;s BFO_0000015-to-prov:Activity mapping.</rdfs:comment>
        <rdfs:label xml:lang="en">realizes protocol</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/requiresEquipment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/requiresEquipment">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/polymat/Method"/>
                    <rdf:Description rdf:about="https://w3id.org/polymat/Procedure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Device"/>
        <rdfs:comment xml:lang="en">Relates a laboratory method or procedure to equipment that is necessary to perform that method</rdfs:comment>
        <rdfs:label xml:lang="en">requiresEquipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/transformsGel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/transformsGel">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:comment xml:lang="en">Relates a sample preparation process (like solvent exchange) to the gel material it transforms</rdfs:comment>
        <rdfs:label xml:lang="en">transformsGel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/usesCrosslinker -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/usesCrosslinker">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/Crosslinker"/>
        <rdfs:comment xml:lang="en">Relates gelation process to crosslinking agents used to form network structure</rdfs:comment>
        <rdfs:label xml:lang="en">usesCrosslinker</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/usesSubstance -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/usesSubstance">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Method"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">Relates a process (creation/synthesis step or sample preparation step such as solvent exchange or drying) to chemical substances used as reactants, catalysts, solvents, or exchange media</rdfs:comment>
        <rdfs:label xml:lang="en">usesSubstance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/usesSupercriticalFluid -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/usesSupercriticalFluid">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/SupercriticalDrying"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/SupercriticalFluid"/>
        <rdfs:comment xml:lang="en">Relates supercritical drying process to the supercritical fluid used (typically CO2)</rdfs:comment>
        <rdfs:label xml:lang="en">usesSupercriticalFluid</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/gelmat/wasProducedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/gelmat/wasProducedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:range rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">Relates a substance to the creation process that produced it</rdfs:comment>
        <rdfs:label xml:lang="en">wasProducedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/polymat/isParameterOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/polymat/isParameterOf">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:comment xml:lang="en">Relates a quantity or process feature (temperature, duration, pH) to the process it characterises. Preferred over obo:RO_0000052 when the bearer is a process rather than a material entity. Range is BFO occurrent (BFO_0000003) rather than BFO process (BFO_0000015) because process steps are pmat:Method (under pmat:Procedure, a prov:Entity) while BFO_0000015 maps to prov:Activity, which PROV-O declares disjoint from prov:Entity — a BFO_0000015 range would make every class with an isParameterOf existential unsatisfiable</rdfs:comment>
        <rdfs:label xml:lang="en">is parameter of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/polymat/usesOperatingSystem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/polymat/usesOperatingSystem">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/OperatingSystem"/>
        <rdfs:comment xml:lang="en">uses the low-level software which handles the interface to peripheral hardware, schedules tasks, allocates storage, and presents a default interface to the user when no application program is running
(http://purl.obolibrary.org/obo/NCIT_C47908)</rdfs:comment>
        <rdfs:label xml:lang="en">uses operating system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/polymat/usesRuntimeEnvironment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/polymat/usesRuntimeEnvironment">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:range rdf:resource="https://w3id.org/polymat/RuntimeEnvironment"/>
        <rdfs:comment xml:lang="en">uses a sub-system that exists both in the computer where a program is created, as well as in the computers where the program is intended to be run. 
(https://en.wikipedia.org/wiki/Runtime_system)</rdfs:comment>
        <rdfs:label xml:lang="en">uses runtime environment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue -->


    <owl:DatatypeProperty rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue">
        <rdfs:domain rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:comment xml:lang="en">A numerical value is the size of a particular quantity expressed numerically.
(https://www.oed.com/search/dictionary/?scope=Entries&amp;q=numerical+value)</rdfs:comment>
        <rdfs:label xml:lang="en">has numerical value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasAgingTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasAgingTime">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Aging"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">DEPRECATED: unit-less float shortcut. Model the aging duration as a gmat:Duration (om:Time) instance linked to the gmat:Aging process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. The duration of the aging step after gelation, typically measured in hours</rdfs:comment>
        <rdfs:label xml:lang="en">has aging time</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasExchangeCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasExchangeCount">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/SolventExchange"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of individual solvent exchange (washing) cycles performed to replace the pore liquid</rdfs:comment>
        <rdfs:label xml:lang="en">has exchange count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasFractalDimensionValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasFractalDimensionValue">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/FractalDimension"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The numeric value of the mass fractal dimension of an aerogel network, dimensionless. Typical range for silica aerogels: 1.7-2.4 (from SAXS/SANS)</rdfs:comment>
        <rdfs:label xml:lang="en">has fractal dimension value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasGelTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasGelTime">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">DEPRECATED: domain error (gel time is a process property, not a material property). Use gmat:hasGelationTimeValue on gmat:Gelation instead. The time duration for sol-gel transition, measured in minutes from when catalysts are mixed until the gel network forms</rdfs:comment>
        <rdfs:label xml:lang="en">has gel time</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasGelationTimeValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasGelationTimeValue">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">DEPRECATED: unit-less float shortcut. Model the gel time as a gmat:GelationTime (om:Time) instance linked to the gmat:Gelation process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. Observed gel time from initiation of gelation (e.g. mixing of catalyst) to the gel point, typically in minutes</rdfs:comment>
        <rdfs:label xml:lang="en">has gelation time value</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasMolarRatio -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasMolarRatio">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/AerogelSynthesis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">DEPRECATED: machine-unreadable string representation. Use gmat:MolarRatio class with gmat:hasRatioComponent and gmat:WaterToSilicaRatio instead. The molar ratio of reactants in the synthesis (e.g., &apos;TEOS:H2O:Catalyst = 1:4:0.01&apos;)</rdfs:comment>
        <rdfs:label xml:lang="en">has molar ratio</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasNetworkConnectivityValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasNetworkConnectivityValue">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/NetworkConnectivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">Average number of siloxane bonds per network node, as determined by solid-state 29Si NMR (Q2/Q3/Q4 species ratios). Higher values indicate more cross-linked, stiffer networks</rdfs:comment>
        <rdfs:label xml:lang="en">has network connectivity value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasPHValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasPHValue">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/PHCondition"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">14.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The numeric pH value maintained during a sol-gel process step (typically 1.5-3 for acid catalysis, 7.5-10 for base catalysis). Range restricted to 0.0-14.0</rdfs:comment>
        <rdfs:label xml:lang="en">has pH value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/gelmat/hasRatioString -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/gelmat/hasRatioString">
        <rdfs:domain rdf:resource="https://w3id.org/gelmat/RatioValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The display/legacy string representation of a molar or volume ratio between components (e.g. &apos;1:10&apos;, &apos;1:10:4:4&apos;, or &apos;59.75&apos;). For numeric querying, single-valued ratios additionally carry om:hasNumericalValue (xsd:double) with om:hasUnit om:one, using the convention that a two-part ratio a:b has numerical value a/b. Multi-component ratios (e.g. &apos;1:10:4:4&apos;) have no single numerical value and are represented by this string only.</rdfs:comment>
        <rdfs:label xml:lang="en">has ratio string</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasAcronym -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasAcronym">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An acronym is used to represent long complex compounds</rdfs:comment>
        <rdfs:label xml:lang="en">has acronym</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasCASNr -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasCASNr">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/polymat/hasID"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/polymat/Monomer"/>
                    <rdf:Description rdf:about="https://w3id.org/polymat/Polymer"/>
                    <rdf:Description rdf:about="https://w3id.org/polymat/Substance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Chemical Abstract Service (CAS) number is a unique identifier assigned to every chemical substance to provide a standardised way of referencing and identifying it</rdfs:comment>
        <rdfs:label xml:lang="en">has CAS nr</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasID -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasID">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An Identifier (ID) is one or more characters used to identify, name, or characterize the nature, properties, or contents of a thing.
(http://purl.obolibrary.org/obo/NCIT_C25364)</rdfs:comment>
        <rdfs:label xml:lang="en">has ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasIUPACName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasIUPACName">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/polymat/Monomer"/>
                    <rdf:Description rdf:about="https://w3id.org/polymat/Polymer"/>
                    <rdf:Description rdf:about="https://w3id.org/polymat/Substance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">IUPAC name is a name of a chemical compound according to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature</rdfs:comment>
        <rdfs:label xml:lang="en">has IUPAC name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasOrderNumber -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasOrderNumber">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/polymat/hasID"/>
        <rdfs:domain rdf:resource="https://w3id.org/polymat/ExperimentRequestSubmission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An order number is a reference number assigned to an experiment when it is submitted for processing.</rdfs:comment>
        <rdfs:label xml:lang="en">has order number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasPath -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasPath">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/DigitalData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A path represents the location or address of a file or directory within the file system hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="en">has path</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasProductID -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasProductID">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/polymat/hasID"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A product ID is a permanent, unique identifier assigned to a product by its producer.
(https://ode.rsl.wustl.edu/mars/pagehelp/Content/Frequently_Asked_Questions/Product_ID.htm?Highlight=Product%20ID)</rdfs:comment>
        <rdfs:label xml:lang="en">has product ID</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasRequestSubmissionType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasRequestSubmissionType">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/ExperimentRequestSubmission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A request submission type is an experiment submission type description, e.g. synthesis, fabrication, analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">has request submission type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/hasVersion -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/hasVersion">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A version is a specific release of a software system, application, library or any other piece of software</rdfs:comment>
        <rdfs:label xml:lang="en">has version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/submissionEndedAt -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/submissionEndedAt">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/ExperimentRequestSubmission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">end time and date of a given experiment submission</rdfs:comment>
        <rdfs:label xml:lang="en">submission ended at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/polymat/submissionStartedAt -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/polymat/submissionStartedAt">
        <rdfs:domain rdf:resource="https://w3id.org/polymat/ExperimentRequestSubmission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">start time and date of a given experiment submission</rdfs:comment>
        <rdfs:label xml:lang="en">submission started at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>008-BFO</dc:identifier>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity</skos:definition>
        <skos:example xml:lang="en">A human being; a tennis ball; a cave; a region of space; someone&apos;s temperature</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <dc:identifier>077-BFO</dc:identifier>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region</skos:definition>
        <skos:example xml:lang="en">As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <dc:identifier>017-BFO</dc:identifier>
        <rdfs:label xml:lang="en">Independent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c</skos:definition>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000006 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <dc:identifier>035-BFO</dc:identifier>
        <rdfs:label xml:lang="en">spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time</skos:definition>
        <skos:example xml:lang="en">As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <dc:identifier>083-BFO</dc:identifier>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:altLabel xml:lang="en">event</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant</skos:definition>
        <skos:example xml:lang="en">An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <dc:identifier>058-BFO</dc:identifier>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type</skos:definition>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000019 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000019"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <dc:identifier>050-BFO</dc:identifier>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c</skos:definition>
        <skos:example xml:lang="en">(with multiple bearers) John&apos;s love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates</skos:example>
        <skos:example xml:lang="en">(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <dc:identifier>061-BFO</dc:identifier>
        <rdfs:label xml:lang="en">Role</rdfs:label>
        <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
        <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <dc:identifier>074-BFO</dc:identifier>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a generically dependent continuant =Def b is a continuant &amp; there is some time t such that there is some independent continuant c &amp; b s-depends_on c at t</skos:definition>
        <skos:example xml:lang="en">A symphony; a score of a film; a patent; a plan; a procedure; a software algorithm</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <dc:identifier>019-BFO</dc:identifier>
        <rdfs:label xml:lang="en">Material entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part</skos:definition>
        <skos:example xml:lang="en">A human being; the undetached arm of a human being; an aggregate of human beings</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000141 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <dc:identifier>028-BFO</dc:identifier>
        <rdfs:label xml:lang="en">Immaterial entity</rdfs:label>
        <skos:definition xml:lang="en">b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part</skos:definition>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface, site</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_24431 -->


    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_24431">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances.</rdfs:comment>
        <rdfs:label xml:lang="en">Chemical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">A measure of the concentration of a chemical species, in particular, of a solute in a solution, in terms of amount of substance per unit volume of solution
(https://en.wikipedia.org/wiki/Molar_concentration)</rdfs:comment>
        <rdfs:label xml:lang="en">Amount of substance concentration</rdfs:label>
        <skos:altLabel xml:lang="en">Amount concentration</skos:altLabel>
        <skos:altLabel xml:lang="en">Molar concentration</skos:altLabel>
        <skos:altLabel xml:lang="en">Molarity</skos:altLabel>
        <skos:altLabel xml:lang="en">Substance concentration</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Stress"/>
        <rdfs:comment xml:lang="en">Stress acting to compress an object, i.e. the force per unit area directed towards the material. Declared locally (subclass of om:Stress) so that gmat:CompressiveStrength remains under om:Quantity even when the OM-2 import is not resolved</rdfs:comment>
        <rdfs:label xml:lang="en">Compressive stress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Length -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Length">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval.</rdfs:comment>
        <rdfs:label xml:lang="en">Length</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Measure -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure">
        <rdfs:comment xml:lang="en">A measure combines a number to a unit of measure. For example, &quot;3 m&quot; is a measure.</rdfs:comment>
        <rdfs:label xml:lang="en">measure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">the ratio of tensile stress to tensile strain of a material
(http://purl.allotrope.org/ontologies/quality#AFQ_0000341)</rdfs:comment>
        <rdfs:label xml:lang="en">Modulus of elasticity</rdfs:label>
        <skos:altLabel xml:lang="en">Young’s modulus</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Permeability-EarthScience -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Permeability-EarthScience">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Permeability-Diffusion"/>
        <rdfs:comment xml:lang="en">The permeability multiplied by the permeating fluids&apos; viscosity, it is commonly used for porous solids such as rocks

k = eta･V･d / (A･t･p) = eta･nu･d/p = eta･D/p

k = permeability (earth science)
V = Volume of the permeate [m³]
nu = velocity of the permeate [m/s]
eta = dynamic viscosoty of the permeate [Pa･s]
d = thickness of the rock [m]
A = area of the rock [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit of the permeability (earth science) is m², commonly called Darcy</rdfs:comment>
        <rdfs:label xml:lang="en">Permeability (earth science)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Point -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Point">
        <rdfs:comment xml:lang="en">A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature.</rdfs:comment>
        <rdfs:label xml:lang="en">point</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Pressure is the force applied perpendicular to the surface of an object per unit area. In sol-gel processing it covers autoclave and supercritical drying pressures, vacuum levels, and gas pressures. Declared locally so the class is available without resolving the OM-2 import</rdfs:comment>
        <rdfs:label xml:lang="en">Pressure</rdfs:label>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, a molecule, or a food product). Quantities are classified according to similarity in their (implicit) metrological aspect, e.g. the length of my table and the length of my chair are both classified as length.
</rdfs:comment>
        <rdfs:label xml:lang="en">Quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Specific heat capacity is the amount of heat required to raise the temperature of a unit mass of substance by one kelvin. Declared locally so that gmat:SpecificHeatCapacity remains under om:Quantity even when the OM-2 import is not resolved</rdfs:comment>
        <rdfs:label xml:lang="en">Specific heat capacity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Stress -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Stress">
        <owl:equivalentClass rdf:resource="https://w3id.org/polymat/Stress"/>
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Stress is the internal force per unit area within a material that arises from externally applied forces. Declared locally so that gmat:FlexuralStrength and om:CompressiveStress remain under om:Quantity even when the OM-2 import is not resolved</rdfs:comment>
        <rdfs:label xml:lang="en">Stress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Temperature is the extent to which an object is hot</rdfs:comment>
        <rdfs:label xml:lang="en">Temperature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Thermal conductivity is the property of a material to conduct heat. Declared locally so that gmat:ThermalConductivity remains under om:Quantity even when the OM-2 import is not resolved</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal conductivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Thermal diffusivity is the thermal conductivity divided by density and specific heat capacity at constant pressure. Declared locally so that gmat:ThermalDiffusivity remains under om:Quantity even when the OM-2 import is not resolved</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal diffusivity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">The smallest dimension of a flat object, usually a mean value of several measurements</rdfs:comment>
        <rdfs:label xml:lang="en">Thickness</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Time -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Time">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Time is a base quantity in the International System of Units and other systems of units. It is measured by numbers of repetitions of cyclical events.</rdfs:comment>
        <rdfs:label xml:lang="en">Time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Unit -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit">
        <rdfs:comment xml:lang="en">A unit of measure is a definite magnitude of a quantity, defined and adopted by convention or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called &quot;metre&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">unit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontology-of-units-of-measure.org/resource/om-2/Volume -->


    <owl:Class rdf:about="http://www.ontology-of-units-of-measure.org/resource/om-2/Volume">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Volume is a measure of how much three-dimensional space any phenomenon occupies. It is a derived quantity in the International System of Units

Volume is length to the power 3</rdfs:comment>
        <rdfs:label xml:lang="en">Volume</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">something that occurs over a period of time and acts upon or with entities. It may include consuming, processing, transforming, modifying, relocating, using, or generating entities</rdfs:comment>
        <rdfs:label xml:lang="en">Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:comment xml:lang="en">something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent&apos;s activity</rdfs:comment>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#AgentInfluence -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#AgentInfluence">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Influence"/>
        <rdfs:comment xml:lang="en">the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other</rdfs:comment>
        <rdfs:label xml:lang="en">Agent influence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Association -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Association">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#AgentInfluence"/>
        <rdfs:comment xml:lang="en">an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity</rdfs:comment>
        <rdfs:label xml:lang="en">Association</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Attribution -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Attribution">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#AgentInfluence"/>
        <rdfs:comment xml:lang="en">the ascribing of an entity to an agent</rdfs:comment>
        <rdfs:label xml:lang="en">Attribution</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:comment xml:lang="en">a physical, digital, conceptual, or other kind of thing with some fixed aspects
(http://www.w3.org/ns/prov#Entity)</rdfs:comment>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#EntityInfluence -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#EntityInfluence">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Influence"/>
        <rdfs:comment xml:lang="en">the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other</rdfs:comment>
        <rdfs:label xml:lang="en">Entity influence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Influence -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Influence">
        <rdfs:comment xml:lang="en">the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation</rdfs:comment>
        <rdfs:label xml:lang="en">Influence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#InstantaneousEvent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#InstantaneousEvent">
        <rdfs:comment xml:lang="en">marks a transition in the world. Instantaneous events include generation, usage, or invalidation of entities, as well as starting or ending of activities</rdfs:comment>
        <rdfs:label xml:lang="en">Instantaneous event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Person -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Person">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Person agents are people.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Role -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Role">
        <rdfs:comment xml:lang="en">the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end</rdfs:comment>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Usage -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Usage">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#EntityInfluence"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#InstantaneousEvent"/>
        <rdfs:comment xml:lang="en">the beginning of utilizing an entity by an activity</rdfs:comment>
        <rdfs:label xml:lang="en">Usage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/APDAerogelSynthesis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/APDAerogelSynthesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelSynthesis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/AmbientPressureDrying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/SurfaceModification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An aerogel synthesis route using ambient pressure drying (APD). Requires a surface modification step (typically silylation with TMCS or HMDS) between solvent exchange and drying to prevent capillary collapse during the drying step</rdfs:comment>
        <rdfs:label xml:lang="en">Ambient pressure drying aerogel synthesis</rdfs:label>
        <skos:altLabel xml:lang="en">APD synthesis</skos:altLabel>
        <skos:definition xml:lang="en">An aerogel synthesis route in which the wet gel is dried at ambient pressure after mandatory surface silylation; avoids high-pressure equipment of supercritical drying by preventing capillary collapse through hydrophobic surface modification</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/APTES -->


    <owl:Class rdf:about="https://w3id.org/gelmat/APTES">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Accupyc -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Accupyc">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">A gas pycnometer device for measuring skeletal densities of solid materials using helium displacement.</rdfs:comment>
        <rdfs:label xml:lang="en">Accupyc</rdfs:label>
        <skos:definition xml:lang="en">A gas displacement pycnometer instrument used to measure the skeletal density of solid materials by helium displacement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AceticAcid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AceticAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Acetone -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Acetone">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A volatile organic solvent (CH3COCH3) commonly used in solvent exchange for aerogel synthesis due to low surface tension and miscibility with alcohols</rdfs:comment>
        <rdfs:label xml:lang="en">Acetone</rdfs:label>
        <skos:definition xml:lang="en">The ketone solvent propan-2-one (CH3COCH3), used in solvent exchange during aerogel synthesis owing to its miscibility and volatility</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Acid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Acid">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid). Acids serve as catalysts in many sol-gel processes for aerogel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Acid</rdfs:label>
        <skos:definition xml:lang="en">A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AcidCatalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AcidCatalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/BaseCatalysis"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/TwoStepCatalysis"/>
        <rdfs:comment xml:lang="en">Sol-gel gelation under acid-catalytic conditions (pH &lt; 7). Promotes fast hydrolysis and slower condensation, yielding weakly branched, polymeric gel structures with smaller pores</rdfs:comment>
        <rdfs:label xml:lang="en">Acid-catalysed gelation</rdfs:label>
        <skos:altLabel xml:lang="en">Acid catalysis</skos:altLabel>
        <skos:definition xml:lang="en">Gelation performed at pH below 7, where protonation of alkoxide leaving groups accelerates hydrolysis relative to condensation, yielding weakly branched, polymeric gel networks with small pores</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AcidCatalysisPathway -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AcidCatalysisPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/realisedAs"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/AcidCatalysis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Acid Catalysis Pathway</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway realised through acid catalysis: pre-hydrolysis at low pH followed by slow condensation, producing weakly branched polymeric network gels with small, homogeneous pores.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AcidCatalyst -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AcidCatalyst">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Acid"/>
        <rdfs:comment xml:lang="en">A Bronsted or Lewis acid used specifically as a catalyst in sol-gel hydrolysis and condensation reactions (e.g. HCl, HNO3, acetic acid, oxalic acid). Convenience class typed by chemical nature; the primary way to state that a substance functions as a catalyst in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a pmat:Catalyst]</rdfs:comment>
        <rdfs:label xml:lang="en">Acid catalyst</rdfs:label>
        <skos:altLabel xml:lang="en">Acid catalytic agent</skos:altLabel>
        <skos:definition xml:lang="en">An acid employed as a catalyst; in sol-gel processing, promotes hydrolysis of alkoxide precursors under acidic conditions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AcousticInsulation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AcousticInsulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a material to attenuate sound transmission, exploiting the low sound velocity in aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Acoustic insulation</rdfs:label>
        <skos:definition xml:lang="en">The application of a material as a barrier against sound transmission</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Activation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Activation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">Physical (CO2, steam) or chemical (KOH, ZnCl2) activation of carbon aerogels at high temperature to develop microporosity and increase surface area</rdfs:comment>
        <rdfs:label xml:lang="en">Activation</rdfs:label>
        <skos:definition xml:lang="en">A thermal treatment in which a reactive agent etches microporosity into a carbon material to increase its surface area</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ActivationEnergy -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ActivationEnergy">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The minimum energy required to initiate a chemical reaction; used in Arrhenius analysis of gelation kinetics. Typically expressed in kJ/mol</rdfs:comment>
        <rdfs:label xml:lang="en">Activation energy</rdfs:label>
        <skos:altLabel xml:lang="en">Ea</skos:altLabel>
        <skos:definition xml:lang="en">A quantity representing the minimum energy required to initiate a chemical reaction, obtained in this domain from Arrhenius analysis of gelation kinetics</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerMole"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Adsorption -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Adsorption">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a material as sorbent - oil and organic solvent uptake, CO2 capture, water treatment, gas storage</rdfs:comment>
        <rdfs:label xml:lang="en">Adsorption</rdfs:label>
        <skos:altLabel xml:lang="en">Sorption</skos:altLabel>
        <skos:definition xml:lang="en">The application of a material as a sorbent for liquids, gases, or dissolved species</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Aerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Aerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/hasDensity"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Density"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/hasSurfaceArea"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/SurfaceArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/wasProducedBy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Drying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Alcogel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Hydrogel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Xerogel"/>
        <rdfs:comment xml:lang="en">An aerogel is a porous solid material obtained by replacing the liquid phase of a gel with a gas, typically through supercritical drying, while largely retaining the gel’s original network structure.</rdfs:comment>
        <rdfs:label xml:lang="en">Aerogel</rdfs:label>
        <skos:closeMatch rdf:resource="http://emmo.info/emmo#EMMO_4207e895"/>
        <skos:closeMatch rdf:resource="https://w3id.org/pmd/co/Material"/>
        <skos:definition xml:lang="en">A porous solid material derived from a gel in which the liquid component has been replaced by a gas without significant collapse of the solid network structure, yielding extremely low density, high porosity, and high specific surface area</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AerogelDefect -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AerogelDefect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">A structural or quality defect borne by an aerogel — a persisting deviation from the intended structure or quality that arises during synthesis or processing. Subclasses denote the defect state (a specifically dependent continuant inhering in the material), not the formation event; the event that produces a defect should be modelled as a process if needed.</rdfs:comment>
        <rdfs:label xml:lang="en">Aerogel defect</rdfs:label>
        <skos:definition xml:lang="en">A specifically dependent continuant feature of an aerogel material that constitutes a deviation from the intended structure, composition, or quality of the material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AerogelSynthesis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AerogelSynthesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Gelation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/SolFormation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Drying"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Monomer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/polymat/Substance"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#hadRole"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Catalyst"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/polymat/Substance"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#hadRole"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Solvent"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The complete process of synthesizing aerogels from precursor materials through sol-gel chemistry followed by a drying step. Only sol formation, gelation, and drying are asserted as required parts (owl:someValuesFrom); aging, solvent exchange, and surface modification are common but optional steps that many published syntheses omit, so they carry no existential restriction here — asserting them would make every extracted synthesis without such a step inconsistent under OWL reasoning</rdfs:comment>
        <rdfs:label xml:lang="en">Aerogel synthesis</rdfs:label>
        <skos:definition xml:lang="en">The complete multi-step process of producing an aerogel from precursor substances, comprising at minimum sol formation, gelation, and a drying step that preserves pore structure; aging, solvent exchange, and surface modification are frequent optional steps</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Aging -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Aging">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">Post-gelation maturation process where the gel network strengthens through continued condensation reactions and Ostwald ripening. Typically performed by keeping the wet gel immersed in solvent at elevated temperature</rdfs:comment>
        <rdfs:label xml:lang="en">Aging</rdfs:label>
        <skos:definition xml:lang="en">Post-gelation maturation in which the wet gel is kept immersed in solvent at elevated temperature to strengthen the network via continued condensation reactions, Ostwald ripening, and syneresis, reducing later shrinkage during drying</skos:definition>
        <hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">3</hasStepOrder>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Air -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Air">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gas"/>
        <rdfs:comment xml:lang="en">Ambient air, the oxidising atmosphere of calcination and of ambient pressure drying</rdfs:comment>
        <rdfs:label xml:lang="en">Air</rdfs:label>
        <skos:definition xml:lang="en">The ambient gas mixture of nitrogen and oxygen, used as oxidising process atmosphere</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Alcogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Alcogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/WetGel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Hydrogel"/>
        <rdfs:comment xml:lang="en">An alcogel is a gel in which the liquid phase consists mainly of an alcohol or alcohol-rich solvent mixture.</rdfs:comment>
        <rdfs:label xml:lang="en">Alcogel</rdfs:label>
        <skos:definition xml:lang="en">A wet gel in which the liquid pore phase consists primarily of an alcohol or alcohol-rich solvent mixture, formed after solvent exchange from the initial aqueous sol or directly from alkoxide precursors</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Alcohol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Alcohol">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">Any organic compound containing one or more hydroxyl groups bound to saturated carbon; commonly used as solvent or reagent</rdfs:comment>
        <rdfs:label xml:lang="en">Alcohol</rdfs:label>
        <skos:definition xml:lang="en">An organic compound bearing one or more hydroxyl groups bound to saturated carbon atoms</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Alginate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Alginate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AlkoxideSolution -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AlkoxideSolution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A solution containing metal alkoxide precursor dissolved in organic solvent, prepared as an intermediate in sol-gel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Alkoxide solution</rdfs:label>
        <skos:definition xml:lang="en">A solution of a metal or silicon alkoxide precursor in an organic solvent, prepared as an intermediate in sol-gel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AluminaAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AluminaAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalOxideAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with an Al2O3 network, typically from aluminium sec-butoxide (Yoldas route) or AlCl3/epoxide routes; valued for high-temperature stability</rdfs:comment>
        <rdfs:label xml:lang="en">Alumina aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">Al2O3 aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A metal oxide aerogel whose solid framework consists of aluminium oxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AluminiumSecButoxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AluminiumSecButoxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalAlkoxide"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AmbientPressureDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AmbientPressureDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:comment xml:lang="en">Drying method performed at atmospheric pressure, typically requiring surface modification to prevent capillary collapse</rdfs:comment>
        <rdfs:label xml:lang="en">Ambient pressure drying</rdfs:label>
        <skos:altLabel xml:lang="en">APD</skos:altLabel>
        <skos:altLabel xml:lang="en">Evaporative drying</skos:altLabel>
        <skos:definition xml:lang="en">A drying method performed at atmospheric pressure in which capillary collapse is prevented by prior surface silylation of the gel, allowing the hydrophobic network to spring back after compression and recover its pore volume</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Ambigel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Ambigel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:comment xml:lang="en">A dried gel obtained by ambient pressure (evaporative) drying under conditions that largely preserve the pore network (surface modification, low-surface-tension solvent); intermediate between xerogel and aerogel</rdfs:comment>
        <rdfs:label xml:lang="en">Ambigel</rdfs:label>
        <skos:definition xml:lang="en">A dried gel produced by ambient pressure drying with measures that substantially preserve the mesoporous network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AmmoniumCompound -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AmmoniumCompound">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A compound containing the ammonium cation (NH4+); includes salts and aqueous ammonia species used in catalysis and pH control</rdfs:comment>
        <rdfs:label xml:lang="en">Ammonium Compound</rdfs:label>
        <skos:definition xml:lang="en">A chemical compound containing the ammonium cation (NH4+)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AmmoniumFluoride -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AmmoniumFluoride">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/FluorideSalt"/>
        <rdfs:comment xml:lang="en">NH4F, a water-soluble fluoride salt used as an additive or etchant; can influence hydrolysis/condensation kinetics in silica sol–gel systems</rdfs:comment>
        <rdfs:label xml:lang="en">Ammonium fluoride</rdfs:label>
        <skos:definition xml:lang="en">The water-soluble fluoride salt NH4F, used as an additive that modifies condensation kinetics in silica sol-gel systems</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/AmmoniumHydroxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/AmmoniumHydroxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AmmoniumCompound"/>
        <rdfs:comment xml:lang="en">Aqueous ammonia solution (NH3·H2O) commonly referred to as ammonium hydroxide; provides basic conditions and acts as a base catalyst in sol–gel reactions</rdfs:comment>
        <rdfs:label xml:lang="en">Ammonium Hydroxide</rdfs:label>
        <skos:definition xml:lang="en">An aqueous solution of ammonia that provides basic conditions and acts as a base catalyst in sol-gel reactions</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51302"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Application -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Application">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:comment xml:lang="en">An intended or demonstrated use of a material. Modelled as a BFO realizable entity borne by the material and linked from it with gmat:hasApplication</rdfs:comment>
        <rdfs:label xml:lang="en">Application</rdfs:label>
        <skos:definition xml:lang="en">A realizable entity representing an intended or demonstrated field of use of a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Argon -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Argon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gas"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ArrheniusConstant -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ArrheniusConstant">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The pre-exponential factor (A) in the Arrhenius equation k = A·exp(−Ea/RT), representing the frequency of molecular collisions with correct orientation. Units match the rate constant (e.g., s⁻¹ for first-order reactions)</rdfs:comment>
        <rdfs:label xml:lang="en">Arrhenius pre-exponential factor</rdfs:label>
        <skos:altLabel xml:lang="en">Arrhenius constant</skos:altLabel>
        <skos:altLabel xml:lang="en">Frequency factor</skos:altLabel>
        <skos:definition xml:lang="en">A quantity representing the pre-exponential factor A in the Arrhenius equation, reflecting the frequency of correctly oriented molecular collisions</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalSecond-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BETAnalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BETAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PorosityMeasurement"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/BJHAnalysis"/>
        <rdfs:comment xml:lang="en">Brunauer-Emmett-Teller analysis for determining specific surface area from gas adsorption isotherms</rdfs:comment>
        <rdfs:label xml:lang="en">BET analysis</rdfs:label>
        <skos:definition xml:lang="en">A porosity measurement in which specific surface area is determined from a gas adsorption isotherm using the Brunauer-Emmett-Teller model</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BJHAnalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BJHAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PorosityMeasurement"/>
        <rdfs:comment xml:lang="en">Barrett-Joyner-Halenda analysis for determining pore size distribution from gas desorption isotherms</rdfs:comment>
        <rdfs:label xml:lang="en">BJH analysis</rdfs:label>
        <skos:definition xml:lang="en">A porosity measurement in which pore size distribution is determined from a gas desorption isotherm using the Barrett-Joyner-Halenda model</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BTMSE -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BTMSE">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Base -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Base">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A Bronsted base capable of accepting a proton. Bases serve as catalysts for condensation reactions in sol-gel processing (e.g. ammonium hydroxide, ammonium fluoride, sodium hydroxide)</rdfs:comment>
        <rdfs:label xml:lang="en">Base</rdfs:label>
        <skos:definition xml:lang="en">A chemical entity capable of accepting a proton (Bronsted base) or donating an electron pair (Lewis base)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BaseCatalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BaseCatalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Base"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Sol-gel gelation under basic conditions (pH &gt; 7). Promotes fast condensation and slower hydrolysis, yielding highly branched, colloidal cluster networks with larger pore sizes</rdfs:comment>
        <rdfs:label xml:lang="en">Base-catalysed gelation</rdfs:label>
        <skos:altLabel xml:lang="en">Base catalysis</skos:altLabel>
        <skos:definition xml:lang="en">Gelation performed at pH above 7, where hydroxide ions catalyse condensation faster than hydrolysis, yielding highly branched, colloidal cluster-cluster aggregation networks with larger pore sizes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BaseCatalysisPathway -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BaseCatalysisPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/realisedAs"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/BaseCatalysis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Base Catalysis Pathway</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway realised through base catalysis: fast condensation relative to hydrolysis at high pH, producing highly branched colloidal aggregation networks with larger pore sizes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BaseCatalyst -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BaseCatalyst">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Base"/>
        <rdfs:comment xml:lang="en">A class of chemical substances that provide basic conditions or catalyze base-mediated reactions (e.g., deprotonation, nucleophilic activation) in a process. Convenience class typed by chemical nature; the primary way to state that a substance functions as a catalyst in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a pmat:Catalyst]</rdfs:comment>
        <rdfs:label xml:lang="en">Base Catalyst</rdfs:label>
        <skos:definition xml:lang="en">A base employed as a catalyst; in sol-gel processing, promotes condensation reactions under basic conditions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Beads -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Beads">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Geometry"/>
        <rdfs:comment xml:lang="en">Small spherical or granule-shaped material geometry, often produced by dropping sol into a bath or dispersion.</rdfs:comment>
        <rdfs:label xml:lang="en">Beads</rdfs:label>
        <skos:definition xml:lang="en">A sample geometry consisting of small spherical or granular pieces, often produced by dropping a sol into a bath or dispersion</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BioAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BioAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel derived from biological materials such as cellulose, chitosan, alginate, or proteins</rdfs:comment>
        <rdfs:label xml:lang="en">Biopolymer aerogel</rdfs:label>
        <skos:definition xml:lang="en">A polymer aerogel derived from biopolymers such as cellulose, chitosan, alginate, or proteins</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BiopolymerPrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BiopolymerPrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Precursor"/>
        <rdfs:comment xml:lang="en">A natural polymer (polysaccharide or protein) that forms a bio-aerogel network by physical or ionic gelation: cellulose, nanocellulose, chitosan, alginate, pectin, gelatin, starch</rdfs:comment>
        <rdfs:label xml:lang="en">Biopolymer precursor</rdfs:label>
        <skos:definition xml:lang="en">A natural polymer used as the network-forming precursor of a bio-aerogel</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BulkDensity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BulkDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Density"/>
        <rdfs:comment xml:lang="en">The mass of a porous body divided by its envelope (geometric) volume, including the pore space. The most commonly reported density of aerogels, typically 1-500 kg/m3 (0.001-0.5 g/cm3) for silica aerogels; determined geometrically or by envelope (powder displacement) pycnometry</rdfs:comment>
        <rdfs:label xml:lang="en">Bulk density</rdfs:label>
        <skos:altLabel xml:lang="en">Apparent density</skos:altLabel>
        <skos:altLabel xml:lang="en">Envelope density</skos:altLabel>
        <skos:definition xml:lang="en">The density of a porous material computed over its envelope volume, i.e. including both the solid skeleton and the gas-filled pore space</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/BulkDensityMeasurement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/BulkDensityMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Determination of bulk (envelope) density (gmat:BulkDensity), usually geometrically from mass and dimensions of a regular monolith, or by envelope (powder displacement) pycnometry (e.g. GeoPyc)</rdfs:comment>
        <rdfs:label xml:lang="en">Bulk density measurement</rdfs:label>
        <skos:altLabel xml:lang="en">Envelope density measurement</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that determines the envelope density of a sample from its mass and envelope volume</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CO2SupplySystem -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CO2SupplySystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">System for storing and delivering CO2 for supercritical drying processes</rdfs:comment>
        <rdfs:label xml:lang="en">CO2 supply system</rdfs:label>
        <skos:definition xml:lang="en">Equipment that stores and delivers carbon dioxide to a supercritical drying process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Calcination -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Calcination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">Thermal treatment in air or oxygen to remove organic residues, dehydroxylate, or crystallise metal oxide networks (e.g. amorphous titania to anatase)</rdfs:comment>
        <rdfs:label xml:lang="en">Calcination</rdfs:label>
        <skos:definition xml:lang="en">A thermal treatment in oxidising atmosphere that removes organics or induces crystallisation in oxide materials</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CarbonAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CarbonAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/OrganicAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with a purely carbonaceous framework, produced by pyrolysis of an organic precursor aerogel (e.g. resorcinol-formaldehyde) above 700 °C in inert atmosphere. The pyrolysis destroys all organic bonds, leaving an electrically conductive elemental carbon network. Not subclassed under OrganicAerogel — carbon aerogels contain no C-H bonds</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">Activated carbon aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A pyrolysed aerogel whose solid framework consists of elemental (sp² or sp³ hybridised) carbon, distinct from organic aerogels which retain organic polymer backbones</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CarbonDioxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CarbonDioxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gas"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CarbonFibre -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CarbonFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
        <rdfs:comment xml:lang="en">Carbon fibres used as high-temperature-stable, electrically conductive reinforcement in aerogel composites</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon fibre</rdfs:label>
        <skos:altLabel xml:lang="en">Carbon fiber</skos:altLabel>
        <skos:definition xml:lang="en">A carbon fibre used as reinforcement in aerogel composites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CarbonNanotube -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CarbonNanotube">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Casting -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Casting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Pouring the sol into a mould (gmat:Mold) where gelation takes place, defining the geometry (monolith, slab) of the resulting gel</rdfs:comment>
        <rdfs:label xml:lang="en">Casting</rdfs:label>
        <skos:altLabel xml:lang="en">Molding</skos:altLabel>
        <skos:altLabel xml:lang="en">Moulding</skos:altLabel>
        <skos:definition xml:lang="en">A sample preparation step in which a sol is poured into a mould that defines the shape of the gel formed in it</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CatalystSolution -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CatalystSolution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A solution containing catalysts and solvents prepared for mixing with precursor solution to initiate sol-gel reactions</rdfs:comment>
        <rdfs:label xml:lang="en">Catalyst solution</rdfs:label>
        <skos:definition xml:lang="en">A solution of a catalyst in a solvent, prepared for addition to a precursor solution to initiate or accelerate sol-gel reactions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CatalystSupport -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CatalystSupport">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a high-surface-area material as carrier for catalytically active phases</rdfs:comment>
        <rdfs:label xml:lang="en">Catalyst support</rdfs:label>
        <skos:definition xml:lang="en">The application of a material as a carrier for catalytically active species</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Cellulose -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Cellulose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CelluloseFibre -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CelluloseFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
        <rdfs:comment xml:lang="en">Cellulosic fibres (pulp, cotton, regenerated cellulose) used as bio-based reinforcement in aerogel composites</rdfs:comment>
        <rdfs:label xml:lang="en">Cellulose fibre</rdfs:label>
        <skos:altLabel xml:lang="en">Cellulose fiber</skos:altLabel>
        <skos:definition xml:lang="en">A cellulosic fibre used as bio-based reinforcement in aerogel composites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ChainGrowthPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ChainGrowthPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PolymerSynthesis"/>
        <rdfs:comment xml:lang="en">A reaction in which the growth of a polymer chain proceeds exclusively by reaction between a monomer and the reactive site on the polymer chain with regeneration of the reactive site at the end of each growth step
(http://purl.obolibrary.org/obo/MOP_0000634)</rdfs:comment>
        <rdfs:label xml:lang="en">Chain growth polymerisation</rdfs:label>
        <skos:definition xml:lang="en">A polymer synthesis in which chain growth proceeds exclusively by reaction between monomer and a reactive site on the growing chain, with regeneration of the reactive site at each step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Chitosan -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Chitosan">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CitricAcid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CitricAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Clay -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Clay">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
        <rdfs:comment xml:lang="en">Layered clay minerals (montmorillonite, sepiolite, laponite) used as inorganic filler and fire-retardant reinforcement in (bio)polymer aerogel composites</rdfs:comment>
        <rdfs:label xml:lang="en">Clay</rdfs:label>
        <skos:definition xml:lang="en">A layered silicate mineral used as filler and reinforcement in aerogel composites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CoefficientOfDetermination -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CoefficientOfDetermination">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The coefficient of determination (R²) of a regression fit, quantifying the goodness of fit of a model to experimental data (e.g. an Arrhenius fit of gelation kinetics). Dimensionless, 0-1</rdfs:comment>
        <rdfs:label xml:lang="en">Coefficient of determination</rdfs:label>
        <skos:altLabel xml:lang="en">R-squared</skos:altLabel>
        <skos:altLabel xml:lang="en">R²</skos:altLabel>
        <skos:definition xml:lang="en">A dimensionless statistical quantity (0 ≤ R² ≤ 1) expressing the proportion of variance in observed data explained by a fitted model</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CompositeAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CompositeAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:comment xml:lang="en">An aerogel containing reinforcing materials or fillers embedded within the aerogel matrix, such as fiber-reinforced aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Composite aerogel</rdfs:label>
        <skos:definition xml:lang="en">An aerogel containing reinforcing materials or fillers embedded within the aerogel matrix</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CompressionTesting -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CompressionTesting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of mechanical strength and stress-strain behavior under compressive loads</rdfs:comment>
        <rdfs:label xml:lang="en">Compression testing</rdfs:label>
        <skos:definition xml:lang="en">An analysis that measures the stress-strain behaviour and strength of a material under compressive load</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CompressiveModulus -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CompressiveModulus">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity"/>
        <rdfs:comment xml:lang="en">The ratio of compressive stress to compressive strain in the elastic region of the stress-strain curve, expressed in kPa or MPa. For aerogels this reflects network stiffness and cross-linking density</rdfs:comment>
        <rdfs:label xml:lang="en">Compressive modulus</rdfs:label>
        <skos:altLabel xml:lang="en">Young&apos;s modulus (compression)</skos:altLabel>
        <skos:definition xml:lang="en">The elastic modulus measured under uniaxial compression, equal to the slope of the linear region of the compressive stress-strain curve</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CompressiveStrength -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CompressiveStrength">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress"/>
        <rdfs:comment xml:lang="en">The maximum compressive stress a material can sustain before fracture, yielding, or excessive deformation. A critical mechanical property for structural and load-bearing aerogel applications</rdfs:comment>
        <rdfs:label xml:lang="en">Compressive strength</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the maximum compressive stress a material can withstand before failure; expressed as an om:Measure with unit kPa or MPa.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Condensation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Condensation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Silanol"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reaction between silanol groups (Si-OH + HO-Si -&gt; Si-O-Si + H2O) or between silanol and alkoxy groups forming siloxane bonds that build the three-dimensional gel network</rdfs:comment>
        <rdfs:label xml:lang="en">Condensation</rdfs:label>
        <skos:definition xml:lang="en">Formation of siloxane (Si-O-Si) network bonds by reaction of silanol intermediates, releasing water or alcohol as by-products</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ContactAngle -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ContactAngle">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The angle at which a liquid-vapor interface meets a solid surface, quantifying wettability. Key metric for hydrophobic aerogels (contact angle &gt; 90 degrees) and superhydrophobic aerogels (contact angle &gt; 150 degrees)</rdfs:comment>
        <rdfs:label xml:lang="en">Contact angle</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the angle between a liquid droplet interface and a solid surface, used to quantify hydrophobicity; expressed as an om:Measure with unit degrees. Values above 90° indicate hydrophobic surfaces.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/radian"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Cooling -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Cooling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Controlled reduction of temperature after a thermal step or to induce thermal gelation (e.g. gelatin); the descending counterpart of temperature ramping</rdfs:comment>
        <rdfs:label xml:lang="en">Cooling</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which the temperature of a sample is lowered in a controlled manner</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CoolingSystem -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CoolingSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment for controlled cooling during processing</rdfs:comment>
        <rdfs:label xml:lang="en">Cooling system</rdfs:label>
        <skos:definition xml:lang="en">Equipment that provides controlled cooling during processing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CorrelationLength -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CorrelationLength">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">The upper cutoff length ξ of fractal scaling in an aerogel network, corresponding to the characteristic cluster (blob) size above which the material appears homogeneous. Obtained from the crossover (knee) in a SAXS/SANS curve; typically a few to tens of nanometres</rdfs:comment>
        <rdfs:label xml:lang="en">Correlation length</rdfs:label>
        <skos:altLabel xml:lang="en">Cluster size</skos:altLabel>
        <skos:altLabel xml:lang="en">Fractal correlation length</skos:altLabel>
        <skos:definition xml:lang="en">The correlation length ξ marking the upper length-scale cutoff of fractal self-similarity in a gel network (the characteristic cluster/blob size), determined from the low-q crossover of a scattering curve</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/metre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Cracking -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Cracking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">The defect state of one or more cracks being present in the aerogel structure. Typically results from capillary stress or rapid pressure/temperature changes during drying — but this class denotes the persisting crack feature, not the crack-formation event.</rdfs:comment>
        <rdfs:label xml:lang="en">Crack</rdfs:label>
        <skos:altLabel xml:lang="en">Cracking</skos:altLabel>
        <skos:definition xml:lang="en">An aerogel defect consisting of one or more fracture discontinuities in the solid network of the material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CreationProcess -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CreationProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Method"/>
        <rdfs:comment xml:lang="en">An action of bringing something into existence</rdfs:comment>
        <rdfs:label xml:lang="en">Creation process</rdfs:label>
        <skos:closeMatch rdf:resource="http://emmo.info/emmo#EMMO_43e99ae1"/>
        <skos:closeMatch rdf:resource="https://w3id.org/pmd/co/Process"/>
        <skos:definition xml:lang="en">A method by which a material entity is brought into existence, comprising the constituent steps of a synthesis workflow</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Crosslinker -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Crosslinker">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A chemical agent that forms bonds between polymer chains to create network structures. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:CrosslinkerRole]</rdfs:comment>
        <rdfs:label xml:lang="en">Crosslinker</rdfs:label>
        <skos:definition xml:lang="en">A chemical agent that forms covalent or physical bonds between polymer chains, producing a three-dimensional network structure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/CrosslinkerRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/CrosslinkerRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance that forms bonds between polymer chains or particles in a given step; distinct from the convenience substance class gmat:Crosslinker, which types substances by chemical nature</rdfs:comment>
        <rdfs:label xml:lang="en">Crosslinker role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that bridges polymer chains or colloidal particles into a network during a synthesis step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Cryogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Cryogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:comment xml:lang="en">A dried gel obtained by freeze drying (lyophilisation) of a wet gel; ice crystal growth typically leaves a more macroporous, often lamellar structure than supercritical drying</rdfs:comment>
        <rdfs:label xml:lang="en">Cryogel</rdfs:label>
        <skos:definition xml:lang="en">A dried gel produced by freezing the pore liquid and removing it by sublimation (freeze drying)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Curing -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Curing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">Moderate-temperature treatment that completes cross-linking or imidisation of a polymer network (e.g. thermal imidisation of poly(amic acid), post-curing of RF gels)</rdfs:comment>
        <rdfs:label xml:lang="en">Curing</rdfs:label>
        <skos:definition xml:lang="en">A thermal treatment that completes the cross-linking reactions of a polymer or hybrid network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DeionizedWater -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DeionizedWater">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Water"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Density -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Density">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The mass per unit volume of a material. Canonical unit: kg/m3 (SI); the lab convention g/cm3 (= 1000 kg/m3) is also common. Bulk density is typically 1-500 kg/m3 (0.001-0.5 g/cm3); skeletal density (determined by He pycnometry) is typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica</rdfs:comment>
        <rdfs:label xml:lang="en">Density</rdfs:label>
        <skos:definition xml:lang="en">The ratio of the mass of a material to its volume; for aerogels the bulk density captures the contribution of both the solid skeleton and the gas-filled pore space</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Depressurization -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Depressurization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Pressurization"/>
        <rdfs:comment xml:lang="en">Controlled reduction of pressure during supercritical drying to return to ambient conditions, performed slowly to avoid re-condensation of supercritical fluid</rdfs:comment>
        <rdfs:label xml:lang="en">Depressurization</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which pressure is reduced in a controlled manner, in supercritical drying performed slowly to avoid re-condensation of the fluid</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Derivation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Derivation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Influence"/>
        <rdfs:comment xml:lang="en">A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity</rdfs:comment>
        <rdfs:label xml:lang="en">Derivation</rdfs:label>
        <skos:definition xml:lang="en">A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Diamine -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Diamine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerPrecursor"/>
        <rdfs:comment xml:lang="en">An aromatic or aliphatic diamine (e.g. ODA, DMBZ) that reacts with dianhydrides to form the poly(amic acid) intermediate of polyimide aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Diamine</rdfs:label>
        <skos:definition xml:lang="en">A diamine monomer that condenses with dianhydrides to form polyimide networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Dianhydride -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Dianhydride">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerPrecursor"/>
        <rdfs:comment xml:lang="en">An aromatic tetracarboxylic dianhydride (e.g. PMDA, BPDA) that reacts with diamines to form the poly(amic acid) intermediate of polyimide aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Dianhydride</rdfs:label>
        <skos:definition xml:lang="en">A dianhydride monomer that condenses with diamines to form polyimide networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DifferentialScanningCalorimetry -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DifferentialScanningCalorimetry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Dimethylformamide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Dimethylformamide">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DissolutionParticipation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DissolutionParticipation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:comment xml:lang="en">A gelation pathway mechanism involving significant dissolution and reprecipitation processes</rdfs:comment>
        <rdfs:label xml:lang="en">Dissolution-participation</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway in which dissolution and reprecipitation of solid species contribute significantly to network formation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DogBone -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DogBone">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Geometry"/>
        <rdfs:comment xml:lang="en">A specimen geometry with wider ends and a narrower central region (gauge length), typically used for tensile testing to ensure failure occurs in the gauge section.</rdfs:comment>
        <rdfs:label xml:lang="en">Dog Bone</rdfs:label>
        <skos:definition xml:lang="en">A sample geometry with wider ends and a narrower central gauge region, used in tensile testing to localise failure in the gauge length</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DrugDelivery -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DrugDelivery">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a (typically bio-)aerogel as carrier for controlled release of pharmaceutical compounds</rdfs:comment>
        <rdfs:label xml:lang="en">Drug delivery</rdfs:label>
        <skos:definition xml:lang="en">The application of a material as a carrier for the controlled release of active pharmaceutical ingredients</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Dryer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Dryer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Laboratory or industrial equipment designed for removing solvents or moisture from materials through controlled heating, vacuum, or other drying mechanisms</rdfs:comment>
        <rdfs:label xml:lang="en">Dryer</rdfs:label>
        <skos:definition xml:lang="en">Equipment designed to remove solvent or moisture from a material by controlled heating, vacuum, sublimation, or supercritical extraction</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DryingControlAdditiveRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DryingControlAdditiveRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance added to a sol to reduce capillary stress and prevent cracking during drying (DCCA function, e.g. glycerol, formamide, DMF); distinct from the convenience substance class gmat:DryingControlChemicalAdditive</rdfs:comment>
        <rdfs:label xml:lang="en">Drying control additive role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that moderates evaporation and capillary stress during drying of a gel</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/DryingControlChemicalAdditive -->


    <owl:Class rdf:about="https://w3id.org/gelmat/DryingControlChemicalAdditive">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">Chemical additives (DCCA) used to reduce capillary stress and prevent cracking during ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:DryingControlAdditiveRole]</rdfs:comment>
        <rdfs:label xml:lang="en">Drying control chemical additive</rdfs:label>
        <skos:altLabel xml:lang="en">DCCA</skos:altLabel>
        <skos:definition xml:lang="en">A chemical additive incorporated into a sol to reduce capillary stress and prevent cracking during drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Duration -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Duration">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Time"/>
        <rdfs:comment xml:lang="en">A quantity representing the length of time over which a process or event occurs, typically expressed in seconds, minutes, or hours</rdfs:comment>
        <rdfs:label xml:lang="en">Duration</rdfs:label>
        <skos:definition xml:lang="en">A quantity representing the length of time over which a process or event extends</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/EDXAnalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/EDXAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Electrode -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Electrode">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a (typically carbon or metal oxide) aerogel as electrode material in supercapacitors, batteries, fuel cells, or capacitive deionisation</rdfs:comment>
        <rdfs:label xml:lang="en">Electrode</rdfs:label>
        <skos:definition xml:lang="en">The application of a material as an electrode in an electrochemical device</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Ethanol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Ethanol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Alcohol"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/Methanol"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ExchangeRatio -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ExchangeRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">Volume ratio of fresh solvent to gel volume during solvent exchange cycles</rdfs:comment>
        <rdfs:label xml:lang="en">Exchange ratio</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the volume ratio of fresh solvent to gel during a solvent exchange cycle</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FTIRSpectroscopy -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FTIRSpectroscopy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FlexuralModulus -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FlexuralModulus">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity"/>
        <rdfs:comment xml:lang="en">The ratio of stress to strain in flexural (bending) deformation, measured by three- or four-point bending, expressed in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">Flexural modulus</rdfs:label>
        <skos:altLabel xml:lang="en">Bending modulus</skos:altLabel>
        <skos:definition xml:lang="en">The elastic modulus measured under bending load, equal to the slope of the linear region of the flexural stress-strain curve</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FlexuralStrength -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FlexuralStrength">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Stress"/>
        <rdfs:comment xml:lang="en">The maximum stress at the outer fibre of a specimen at the point of failure under bending load, expressed in Pa</rdfs:comment>
        <rdfs:label xml:lang="en">Flexural strength</rdfs:label>
        <skos:altLabel xml:lang="en">Bending strength</skos:altLabel>
        <skos:altLabel xml:lang="en">Modulus of rupture</skos:altLabel>
        <skos:definition xml:lang="en">The maximum bending stress a material can sustain before rupture, determined by three- or four-point flexural testing</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FluorideAdditive -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FluorideAdditive">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A class of fluoride-containing substances added in small amounts to modify reaction pathways, surface chemistry, or microstructure during processing</rdfs:comment>
        <rdfs:label xml:lang="en">Fluoride additive</rdfs:label>
        <skos:definition xml:lang="en">A fluoride-containing substance added in small amounts to modify hydrolysis-condensation kinetics, surface chemistry, or microstructure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FluorideSalt -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FluorideSalt">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">An ionic compound containing fluoride anions (F−) paired with a metal or ammonium cation; used for etching, complexation, or catalytic effects</rdfs:comment>
        <rdfs:label xml:lang="en">Fluoride Salt</rdfs:label>
        <skos:definition xml:lang="en">An ionic compound of the fluoride anion with a metal or ammonium cation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ForceCell -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ForceCell">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">A sensor designed to convert mechanical force to electric signal.</rdfs:comment>
        <rdfs:label xml:lang="en">Load Cell</rdfs:label>
        <skos:definition xml:lang="en">An instrument that converts mechanical force into an electrical signal for quantitative force measurement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Formaldehyde -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Formaldehyde">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Formamide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Formamide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/DryingControlChemicalAdditive"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FractalDimension -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FractalDimension">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">A dimensionless exponent describing the self-similar (power-law) scaling of an aerogel network with length scale, determined from small-angle scattering (SAXS/SANS). General parent for the mass fractal dimension (Dm, network mass scaling) and the surface fractal dimension (Ds, interface roughness scaling)</rdfs:comment>
        <rdfs:label xml:lang="en">Fractal dimension</rdfs:label>
        <skos:definition xml:lang="en">A dimensionless exponent quantifying the fractal (self-similar, power-law) scaling of an aerogel network; specialised as mass fractal dimension (1-3) or surface fractal dimension (2-3)</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FreezeCasting -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FreezeCasting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Directional or bulk freezing of a suspension or gel so that growing ice crystals template an aligned macroporous architecture, subsequently revealed by freeze drying</rdfs:comment>
        <rdfs:label xml:lang="en">Freeze casting</rdfs:label>
        <skos:altLabel xml:lang="en">Directional freezing</skos:altLabel>
        <skos:altLabel xml:lang="en">Ice templating</skos:altLabel>
        <skos:definition xml:lang="en">A sample preparation step in which controlled freezing templates the pore structure of a material via ice crystal growth</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FreezeDryer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FreezeDryer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Dryer"/>
        <rdfs:comment xml:lang="en">Equipment that removes liquid from a frozen material by sublimation under reduced pressure (lyophilisation). Used in aerogel production via the freeze-drying route to obtain cryogels</rdfs:comment>
        <rdfs:label xml:lang="en">Freeze Dryer</rdfs:label>
        <skos:definition xml:lang="en">A dryer that removes frozen solvent from a material by sublimation under reduced pressure (lyophilisation)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/FreezeDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/FreezeDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:comment xml:lang="en">Drying method where the solvent is frozen and then sublimated under vacuum, producing cryogels with distinct morphology</rdfs:comment>
        <rdfs:label xml:lang="en">Freeze drying</rdfs:label>
        <skos:altLabel xml:lang="en">Lyophilization</skos:altLabel>
        <skos:definition xml:lang="en">A drying method in which the pore solvent is frozen and removed by sublimation under reduced pressure, yielding cryogels</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Furfural -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Furfural">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GPTMS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GPTMS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Gas -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Gas">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A substance in the gaseous state used in processing or characterisation: pyrolysis and calcination atmospheres (N2, Ar, air), sorption adsorbates (N2, CO2), and drying media</rdfs:comment>
        <rdfs:label xml:lang="en">Gas</rdfs:label>
        <skos:definition xml:lang="en">A chemical entity in the gaseous aggregation state, used as process atmosphere, adsorbate, or drying medium</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Gel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Gel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A gel is a soft material entity consisting of a continuous solid network permeated by a liquid phase, exhibiting both solid-like and liquid-like properties</rdfs:comment>
        <rdfs:label xml:lang="en">Gel</rdfs:label>
        <skos:definition xml:lang="en">A nonfluid colloidal or polymer network that is expanded throughout its whole volume by a fluid, exhibiting both solid-like and liquid-like properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Gelatin -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Gelatin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Gelation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Gelation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/SolGelTransition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Monomer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/polymat/Substance"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#hadRole"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Catalyst"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The sol-gel transition process where a liquid colloidal solution transforms into a solid gel network through hydrolysis and condensation reactions</rdfs:comment>
        <rdfs:label xml:lang="en">Gelation</rdfs:label>
        <skos:definition xml:lang="en">The sol-gel process stage in which condensation reactions cause the growing network to span the entire reaction volume, producing a solid gel at the gel point (SolGelTransition); the sol irreversibly loses fluidity</skos:definition>
        <hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">2</hasStepOrder>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GelationPathway -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GelationPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">The mechanistic route by which a sol transforms into a gel network. A GelationPathway describes the mechanism, not the process itself — it is a feature of the gelation, not an instance of it</rdfs:comment>
        <rdfs:label xml:lang="en">Gelation pathway</rdfs:label>
        <skos:altLabel xml:lang="en">Gelation mechanism</skos:altLabel>
        <skos:definition xml:lang="en">The mechanistic route by which a sol transforms into a gel network; describes the mechanism of a gelation, not the process itself</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GelationTime -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GelationTime">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Time"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/polymat/isParameterOf"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Gelation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event. A key kinetic parameter sensitive to catalyst concentration, pH, temperature, and water-to-precursor ratio</rdfs:comment>
        <rdfs:label xml:lang="en">Gelation time</rdfs:label>
        <skos:altLabel xml:lang="en">Gel time</skos:altLabel>
        <skos:definition xml:lang="en">The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event; a key kinetic parameter controlled by catalyst type, concentration, pH, temperature, and water-to-precursor ratio</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GellingAgentRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GellingAgentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance that triggers or promotes gelation (e.g. a base added to induce condensation, a cation bath for alginate gelation)</rdfs:comment>
        <rdfs:label xml:lang="en">Gelling agent role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that induces or accelerates the sol-gel transition in a gelation step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Geometry -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Geometry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">The shape, size, and physical configuration of a material entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Geometry</rdfs:label>
        <skos:definition xml:lang="en">A feature representing the shape and physical configuration of a material entity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Geopyc -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Geopyc">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Device for measuring envelope density of materials.</rdfs:comment>
        <rdfs:label xml:lang="en">Geopyc</rdfs:label>
        <skos:definition xml:lang="en">An instrument that measures the envelope density of a material by quasi-fluid displacement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GlassFibre -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GlassFibre">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
        <rdfs:comment xml:lang="en">Glass fibres (loose, mat, or felt), the most common reinforcement of commercial silica aerogel insulation composites</rdfs:comment>
        <rdfs:label xml:lang="en">Glass fibre</rdfs:label>
        <skos:altLabel xml:lang="en">Glass fiber</skos:altLabel>
        <skos:definition xml:lang="en">A fibrous glass reinforcement used in aerogel composites and blankets</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Glycerol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Glycerol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/DryingControlChemicalAdditive"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GrapheneOxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GrapheneOxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Reinforcement"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/GuardedHotPlate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/GuardedHotPlate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalConductivityTesting"/>
        <rdfs:comment xml:lang="en">Steady-state absolute thermal conductivity measurement between a guarded hot plate and cold plates (ISO 8302); the primary reference method for insulation materials</rdfs:comment>
        <rdfs:label xml:lang="en">Guarded hot plate method</rdfs:label>
        <skos:definition xml:lang="en">A steady-state thermal conductivity measurement in which a guarded hot plate imposes a known heat flux across a slab specimen</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HeatFlowMeter -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HeatFlowMeter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Device for measuring thermal conductivity of the material.</rdfs:comment>
        <rdfs:label xml:lang="en">Heat Flow Meter</rdfs:label>
        <skos:definition xml:lang="en">An instrument that measures the thermal conductivity of a material from the heat flux through a specimen under a temperature gradient</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HeatFlowMeterMethod -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HeatFlowMeterMethod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalConductivityTesting"/>
        <rdfs:comment xml:lang="en">Steady-state comparative thermal conductivity measurement using calibrated heat flux transducers (ISO 8301); faster than the guarded hot plate; instrument class gmat:HeatFlowMeter</rdfs:comment>
        <rdfs:label xml:lang="en">Heat flow meter method</rdfs:label>
        <skos:definition xml:lang="en">A steady-state thermal conductivity measurement in which the heat flux through a slab specimen is recorded by calibrated flux transducers</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HeatingBath -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HeatingBath">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Temperature-controlled liquid bath for uniform heating of samples</rdfs:comment>
        <rdfs:label xml:lang="en">Heating bath</rdfs:label>
        <skos:altLabel xml:lang="en">Oil bath</skos:altLabel>
        <skos:altLabel xml:lang="en">Water bath</skos:altLabel>
        <skos:definition xml:lang="en">An instrument consisting of a temperature-controlled liquid bath used for uniform heating of samples</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HeatingRate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HeatingRate">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The rate of temperature change during a thermal process step (drying, pyrolysis, calcination, temperature ramping), typically reported in K/min or degC/min</rdfs:comment>
        <rdfs:label xml:lang="en">Heating rate</rdfs:label>
        <skos:altLabel xml:lang="en">Ramp rate</skos:altLabel>
        <skos:altLabel xml:lang="en">Temperature ramp rate</skos:altLabel>
        <skos:definition xml:lang="en">A quantity representing the change of temperature per unit time imposed during a controlled heating or cooling step</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kelvinPerSecond-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HeliumPycnometry -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HeliumPycnometry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SkeletalDensityMeasurement"/>
        <rdfs:comment xml:lang="en">Gas displacement pycnometry with helium; the standard realisation of skeletal density measurement (gmat:SkeletalDensity), performed e.g. on an Accupyc instrument</rdfs:comment>
        <rdfs:label xml:lang="en">Helium pycnometry</rdfs:label>
        <skos:altLabel xml:lang="en">Gas pycnometry</skos:altLabel>
        <skos:definition xml:lang="en">A skeletal density measurement that determines the skeletal volume of a sample by helium gas displacement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Heptane -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Heptane">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Hexamethyldisilazane -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Hexamethyldisilazane">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SilylationAgent"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Hexane -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Hexane">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HighTemperatureSupercriticalDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HighTemperatureSupercriticalDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SupercriticalDrying"/>
        <rdfs:comment xml:lang="en">Supercritical drying directly from the organic pore solvent (ethanol or methanol, Tc ~240-243 degC) in an autoclave, without exchange to CO2; the original Kistler-type HOT route, distinguished from low-temperature scCO2 drying</rdfs:comment>
        <rdfs:label xml:lang="en">High-temperature supercritical drying</rdfs:label>
        <skos:altLabel xml:lang="en">HOT supercritical drying</skos:altLabel>
        <skos:altLabel xml:lang="en">Supercritical ethanol drying</skos:altLabel>
        <skos:definition xml:lang="en">A supercritical drying method in which the organic pore solvent itself is brought above its critical point, as opposed to exchange against supercritical CO2</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HybridAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HybridAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:comment xml:lang="en">An aerogel composed of both organic and inorganic components, combining properties of different material classes</rdfs:comment>
        <rdfs:label xml:lang="en">Hybrid aerogel</rdfs:label>
        <skos:definition xml:lang="en">An aerogel composed of two or more chemically distinct network components, at least one of which is organic and at least one inorganic, covalently or physically integrated within the same porous framework</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HydrofluoricAcid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HydrofluoricAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Hydrogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Hydrogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/WetGel"/>
        <rdfs:comment xml:lang="en">A hydrogel is a gel in which the liquid phase consists mainly of water.</rdfs:comment>
        <rdfs:label xml:lang="en">Hydrogel</rdfs:label>
        <skos:definition xml:lang="en">A wet gel in which the liquid pore phase is predominantly water; the intermediate state of a silica sol-gel system before solvent exchange</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Hydrolysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Hydrolysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SolFormation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/usesSubstance"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Water"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Reaction of a silicon alkoxide precursor with water to generate silanol groups (Si-OH). Rate depends on pH, water-to-alkoxide ratio, and solvent. Acid catalysis accelerates hydrolysis; base catalysis promotes condensation</rdfs:comment>
        <rdfs:label xml:lang="en">Hydrolysis</rdfs:label>
        <skos:definition xml:lang="en">Nucleophilic substitution of alkoxy groups by hydroxyl groups in the presence of water, yielding silanols as sol-gel intermediates</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/HydrophobicityTesting -->


    <owl:Class rdf:about="https://w3id.org/gelmat/HydrophobicityTesting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of water contact angle or water uptake to determine surface hydrophobicity</rdfs:comment>
        <rdfs:label xml:lang="en">Hydrophobicity testing</rdfs:label>
        <skos:definition xml:lang="en">An analysis that determines the surface hydrophobicity of a material, typically by water contact angle or water uptake measurement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Impregnation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Impregnation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Infiltrating a porous host (fibre mat, foam) with a sol, or a finished aerogel with a functional phase; the standard route to aerogel blankets and composites (see also pmat:Coating)</rdfs:comment>
        <rdfs:label xml:lang="en">Impregnation</rdfs:label>
        <skos:altLabel xml:lang="en">Infiltration</skos:altLabel>
        <skos:definition xml:lang="en">A sample preparation step in which a liquid phase is infiltrated into a porous host material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/IncompleteDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/IncompleteDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">The defect state of residual solvent or moisture remaining in the aerogel pores after the drying step. Denotes the persisting residual-liquid feature of the material, not the (incomplete) drying process itself.</rdfs:comment>
        <rdfs:label xml:lang="en">Residual solvent</rdfs:label>
        <skos:altLabel xml:lang="en">Incomplete drying</skos:altLabel>
        <skos:definition xml:lang="en">An aerogel defect consisting of residual solvent or moisture remaining in the pore network of the material after drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/InorganicAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/InorganicAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/OrganicAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with an inorganic backbone (e.g. SiO₂, TiO₂, Al₂O₃), typically synthesised from metal alkoxide precursors through sol-gel processing</rdfs:comment>
        <rdfs:label xml:lang="en">Inorganic aerogel</rdfs:label>
        <skos:definition xml:lang="en">An aerogel whose solid framework consists entirely of inorganic components such as metal oxides, silica, or zero-valent metals, containing no covalently bonded organic groups in the network backbone</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/IonExchange -->


    <owl:Class rdf:about="https://w3id.org/gelmat/IonExchange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Passing a sodium silicate (water glass) solution through a cation exchange resin to replace Na+ with H+, yielding silicic acid sol; the essential desalination step of the water-glass route</rdfs:comment>
        <rdfs:label xml:lang="en">Ion exchange</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which ions in a solution are replaced by contact with an ion exchange resin, notably the removal of sodium from water glass</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/IronOxideAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/IronOxideAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalOxideAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with an iron oxide (Fe2O3/Fe3O4) network, typically from FeCl3/epoxide routes; studied for magnetism, catalysis, and energetic composites</rdfs:comment>
        <rdfs:label xml:lang="en">Iron oxide aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">Fe2O3 aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A metal oxide aerogel whose solid framework consists of iron oxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Isocyanate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Isocyanate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerPrecursor"/>
        <rdfs:comment xml:lang="en">A di- or polyisocyanate (e.g. MDI, TDI, Desmodur types) that reacts with polyols to form polyurethane aerogels, or with water/amines to form polyurea aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Isocyanate</rdfs:label>
        <skos:definition xml:lang="en">An isocyanate monomer that forms polyurethane or polyurea networks in polymer aerogel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Isopropanol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Isopropanol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Alcohol"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/LaserFlash -->


    <owl:Class rdf:about="https://w3id.org/gelmat/LaserFlash">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalConductivityTesting"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Lignin -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Lignin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MTES -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MTES">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MTMS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MTMS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Macroporosity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Macroporosity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">Presence of unintended macropores (&gt; 50 nm) in the aerogel network, causing loss of mesoporosity, reduced surface area, and lower thermal insulation performance. Arises from phase separation or syneresis during gelation</rdfs:comment>
        <rdfs:label xml:lang="en">Macroporosity</rdfs:label>
        <skos:definition xml:lang="en">An aerogel defect characterised by the presence of unintended pores larger than 50 nm in the otherwise mesoporous network, caused by phase separation or syneresis during gelation, leading to reduced surface area and impaired insulation performance</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MagneticStirrer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MagneticStirrer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Equipment that creates a rotating magnetic field to spin a stir bar for mixing solutions</rdfs:comment>
        <rdfs:label xml:lang="en">Magnetic stirrer</rdfs:label>
        <skos:definition xml:lang="en">An instrument that mixes a solution by rotating a magnetic stir bar through a rotating magnetic field</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MassFractalDimension -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MassFractalDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/FractalDimension"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/SurfaceFractalDimension"/>
        <rdfs:comment xml:lang="en">The fractal dimension Dm describing the power-law scaling of network mass with length scale in the fractal (low-q) region of the scattering curve, I(q) ∝ q^(−Dm). Values 1.7-2.4 are typical for silica aerogels; lower values indicate more open, chain-like structures</rdfs:comment>
        <rdfs:label xml:lang="en">Mass fractal dimension</rdfs:label>
        <skos:altLabel xml:lang="en">Dm</skos:altLabel>
        <skos:altLabel xml:lang="en">Mass fractal dimension</skos:altLabel>
        <skos:definition xml:lang="en">The mass fractal dimension (1 ≤ Dm ≤ 3) obtained from the slope of the fractal regime of a SAXS/SANS curve, describing how network mass scales with observation length</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MassFraction -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MassFraction">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The mass of a component divided by the total mass of the mixture or composite, expressed as a fraction or wt%. Covers fibre loading, solid content, silica content, and similar compositional quantities</rdfs:comment>
        <rdfs:label xml:lang="en">Mass fraction</rdfs:label>
        <skos:altLabel xml:lang="en">Weight fraction</skos:altLabel>
        <skos:altLabel xml:lang="en">wt%</skos:altLabel>
        <skos:definition xml:lang="en">A dimensionless quantity representing the ratio of the mass of a component to the total mass of the mixture, commonly expressed in weight percent</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MeanPoreSize -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MeanPoreSize">
        <owl:equivalentClass rdf:resource="https://w3id.org/polymat/MeanPoreDiameter"/>
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">The average pore diameter of a porous material, typically determined from BJH analysis of desorption isotherms or from small-angle scattering; expressed in nanometres. Aerogels predominantly exhibit mesopores (2-50 nm). Equivalent to pmat:MeanPoreDiameter, which Polymat declares independently for membrane materials</rdfs:comment>
        <rdfs:label xml:lang="en">Mean pore size</rdfs:label>
        <skos:altLabel xml:lang="en">Average pore diameter</skos:altLabel>
        <skos:definition xml:lang="en">The average equivalent spherical diameter of the pore space distribution in a porous material, expressed in nanometres and typically determined by BJH desorption analysis</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/metre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Melamine -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Melamine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MercuryIntrusionPorosimetry -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MercuryIntrusionPorosimetry">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PorosityMeasurement"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MetalAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MetalAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/InorganicAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel in which the solid framework is composed of zero-valent metals (e.g., Au, Pt, Ag)</rdfs:comment>
        <rdfs:label xml:lang="en">Metal aerogel</rdfs:label>
        <skos:definition xml:lang="en">An inorganic aerogel whose solid framework consists of zero-valent metal</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MetalAlkoxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MetalAlkoxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalOxidePrecursor"/>
        <rdfs:comment xml:lang="en">A metal compound with alkoxide ligands (M-OR), used as precursors in sol-gel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Metal alkoxide</rdfs:label>
        <skos:definition xml:lang="en">A compound of a metal with alkoxide ligands (M(OR)n), used as a hydrolysable precursor in sol-gel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MetalOxideAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MetalOxideAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/InorganicAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel composed of metal oxide materials such as titanium dioxide (TiO₂), alumina (Al₂O₃), or zirconia (ZrO₂)</rdfs:comment>
        <rdfs:label xml:lang="en">Metal oxide aerogel</rdfs:label>
        <skos:definition xml:lang="en">An inorganic aerogel whose solid framework consists of one or more metal oxides</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MetalOxidePrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MetalOxidePrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Precursor"/>
        <rdfs:comment xml:lang="en">A precursor that yields a non-silica metal oxide network (alumina, titania, zirconia, iron oxide, ...); comprises metal alkoxides as well as metal chlorides and nitrates used in epoxide-assisted routes</rdfs:comment>
        <rdfs:label xml:lang="en">Metal oxide precursor</rdfs:label>
        <skos:definition xml:lang="en">A precursor whose hydrolysis and condensation (or epoxide-assisted gelation) yield a metal oxide network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Methanol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Methanol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Alcohol"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MicrowaveDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MicrowaveDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:comment xml:lang="en">Drying by volumetric microwave heating of the pore liquid; a fast evaporative route reported for silica and bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Microwave drying</rdfs:label>
        <skos:definition xml:lang="en">A drying method in which the pore liquid is removed by volumetric microwave heating</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Mixing -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Mixing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Process of combining two or more substances with mechanical agitation to create a homogeneous solution or suspension</rdfs:comment>
        <rdfs:label xml:lang="en">Mixing</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which two or more substances are combined under mechanical agitation to yield a homogeneous solution or suspension</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ModulePerformance -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ModulePerformance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">The ability to process large amounts of feed stream (high permeability) while maintaining high selectivity for the desired substance. Further advantageous properties of a membrane module are fouling resistance, hight mechanical stability and low manufacturing costs
(https://en.wikipedia.org/wiki/Membrane_technology)</rdfs:comment>
        <rdfs:label xml:lang="en">Module performance</rdfs:label>
        <skos:definition xml:lang="en">An analysis that assesses the throughput and selectivity of a separation module</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/MolarRatio -->


    <owl:Class rdf:about="https://w3id.org/gelmat/MolarRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">The ratio of moles between two or more substances in a reaction or mixture. Used to describe stoichiometric proportions of reagents (e.g., H2O/MTMS = 59.75).</rdfs:comment>
        <rdfs:label xml:lang="en">Molar Ratio</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the ratio of amounts of substance (moles) between two or more substances in a reaction or mixture</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Mold -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Mold">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Apparatus"/>
        <rdfs:comment xml:lang="en">A container or form that gives shape to liquid or semi-solid material during gelation, curing, or solidification processes</rdfs:comment>
        <rdfs:label xml:lang="en">Mold</rdfs:label>
        <skos:definition xml:lang="en">An apparatus consisting of a container or form that imparts shape to a liquid or semi-solid material during gelation, curing, or solidification</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Monolith -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Monolith">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Geometry"/>
        <rdfs:comment xml:lang="en">A material geometry consisting of a single, continuous, bulk piece (often cylindrical or rectangular) as opposed to powders, beads, or films.</rdfs:comment>
        <rdfs:label xml:lang="en">Monolith</rdfs:label>
        <skos:definition xml:lang="en">A sample geometry consisting of a single continuous bulk piece, as opposed to powders, beads, or films</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Nanocellulose -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Nanocellulose">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Cellulose"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/NetworkConnectivity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/NetworkConnectivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">A structural descriptor of the aerogel solid network expressing the average number of siloxane bonds per node; related to cross-linking density and mechanical stiffness. Determined from solid-state NMR (Q2/Q3/Q4 species) or SAXS</rdfs:comment>
        <rdfs:label xml:lang="en">Network connectivity</rdfs:label>
        <skos:altLabel xml:lang="en">Cross-linking density</skos:altLabel>
        <skos:definition xml:lang="en">The average number of siloxane (or equivalent) bonds per network node, quantifying the degree of cross-linking. Determined from 29Si NMR Q-species ratios: Q2 (2 siloxane bonds), Q3 (3), Q4 (4, fully connected)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/NitricAcid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/NitricAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Nitrogen -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Nitrogen">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gas"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/NonuniformStructure -->


    <owl:Class rdf:about="https://w3id.org/gelmat/NonuniformStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">Spatial inhomogeneity in aerogel structure, density, or properties, typically caused by non-uniform gelation or drying</rdfs:comment>
        <rdfs:label xml:lang="en">Non-uniform structure</rdfs:label>
        <skos:definition xml:lang="en">An aerogel defect consisting of spatial inhomogeneity in the structure, density, or properties of the material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Opacity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Opacity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">Loss of optical transparency in aerogel, typically caused by large pores, density inhomogeneities, or structural defects</rdfs:comment>
        <rdfs:label xml:lang="en">Opacity</rdfs:label>
        <skos:definition xml:lang="en">An aerogel defect consisting of reduced or absent optical transparency of the material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OpticalTransmittanceMeasurement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OpticalTransmittanceMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of light transmission through aerogel at various wavelengths</rdfs:comment>
        <rdfs:label xml:lang="en">Optical transmittance measurement</rdfs:label>
        <skos:definition xml:lang="en">An analysis that measures the fraction of incident light transmitted through a material at given wavelengths</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OrganicAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OrganicAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:comment xml:lang="en">An aerogel in which the solid framework is composed of organic macromolecules (polymers, biopolymers) rather than inorganic networks or elemental carbon</rdfs:comment>
        <rdfs:label xml:lang="en">Organic aerogel</rdfs:label>
        <skos:definition xml:lang="en">An aerogel whose solid framework consists of an organic polymer network (e.g. resorcinol-formaldehyde, polyimide, cellulose). Distinguished from carbon aerogels by retention of organic functional groups and from inorganic aerogels by the absence of metal oxide or silica frameworks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OrganicPrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OrganicPrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Precursor"/>
        <rdfs:comment xml:lang="en">A small organic molecule that polycondenses into an organic gel network (resorcinol-formaldehyde and related chemistries); the parent chemistry of organic and, after pyrolysis, carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Organic precursor</rdfs:label>
        <skos:definition xml:lang="en">An organic monomer that forms an organic polymer network by polycondensation in sol-gel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OrganosilicaAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OrganosilicaAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/HybridAerogel"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/SilicaAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel derived from organosilica precursors (e.g. MTMS, BTMSE) in which organic groups are covalently bonded within the silica network, imparting hydrophobicity and flexibility compared to pure silica aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Organosilica aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">Hybrid silica aerogel</skos:altLabel>
        <skos:altLabel xml:lang="en">Methylsilica aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A hybrid aerogel in which organic functional groups are incorporated into the inorganic silica backbone via covalent Si–C bonds</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OrganosiliconCompound -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OrganosiliconCompound">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">Any compound containing silicon–carbon bonds; includes silanes, siloxanes, and silicon alkoxides used as precursors in sol–gel chemistry</rdfs:comment>
        <rdfs:label xml:lang="en">Organosilicon Compound</rdfs:label>
        <skos:definition xml:lang="en">A chemical compound containing at least one silicon-carbon bond</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Oven -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Oven">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Dryer"/>
        <rdfs:comment xml:lang="en">A thermally insulated chamber used for drying, heating, or thermal treatment of materials at controlled temperatures. In aerogel processing, ovens are used for ambient pressure drying and post-treatment heat curing</rdfs:comment>
        <rdfs:label xml:lang="en">Oven</rdfs:label>
        <skos:definition xml:lang="en">A dryer consisting of a thermally insulated chamber for drying, heating, or thermal treatment at controlled temperature</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OverheadStirrer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OverheadStirrer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Mechanical stirring equipment mounted above container for mixing viscous solutions or gels</rdfs:comment>
        <rdfs:label xml:lang="en">Overhead stirrer</rdfs:label>
        <skos:definition xml:lang="en">An instrument with a motor-driven impeller mounted above the vessel, used for mixing viscous solutions or gels</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/OxalicAcid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/OxalicAcid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AcidCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PEDS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PEDS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PHAdjuster -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PHAdjuster">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A substance used to control pH during gelation or processing, such as acids or bases</rdfs:comment>
        <rdfs:label xml:lang="en">pH adjuster</rdfs:label>
        <skos:definition xml:lang="en">A substance added to control the pH of a mixture during gelation or processing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PHCondition -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PHCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">The pH level maintained during a sol-gel process step (sol formation, gelation, aging). Acid conditions (pH 1-5) favour hydrolysis; base conditions (pH 7-10) favour condensation. pH is controlled by addition of acid or base catalysts. As a ProcessParameter this class is an om:Quantity, so the preferred value pattern is om:hasValue pointing to a dimensionless om:Measure (see gmat:PHValue); gmat:hasPHValue remains available as a datatype shortcut</rdfs:comment>
        <rdfs:label xml:lang="en">pH condition</rdfs:label>
        <skos:definition xml:lang="en">A process parameter specifying the hydrogen ion concentration of the reaction medium, expressed on a scale of 0-14, that governs the relative rates of hydrolysis and condensation in sol-gel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PHValue -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PHValue">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The pH of a solution or reaction medium as a dimensionless quantity (0-14). Preferred over the datatype shortcut gmat:hasPHValue when the value should participate in the om:Quantity/om:Measure pattern; a gmat:PHCondition process parameter carries its magnitude as a PHValue-style dimensionless om:Measure</rdfs:comment>
        <rdfs:label xml:lang="en">pH value</rdfs:label>
        <skos:altLabel xml:lang="en">pH</skos:altLabel>
        <skos:definition xml:lang="en">A dimensionless quantity representing the negative decadic logarithm of the hydrogen ion activity of a solution</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ParticleSize -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ParticleSize">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">The diameter or dimension of the primary particles making up the aerogel framework</rdfs:comment>
        <rdfs:label xml:lang="en">Particle size</rdfs:label>
        <skos:definition xml:lang="en">A quantity representing the characteristic dimension of the primary particles composing a material framework</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/metre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Pectin -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Pectin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PhaseSeparation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PhaseSeparation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:comment xml:lang="en">A gelation mechanism driven by the separation of phases within the sol</rdfs:comment>
        <rdfs:label xml:lang="en">Phase separation</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway in which network formation is driven by separation of the sol into distinct phases</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Phenol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Phenol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PhenolicAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PhenolicAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicAerogel"/>
        <rdfs:comment xml:lang="en">An organic aerogel derived from phenolic resin precursors</rdfs:comment>
        <rdfs:label xml:lang="en">Phenolic aerogel</rdfs:label>
        <skos:definition xml:lang="en">An organic aerogel derived from phenolic resin precursors such as resorcinol-formaldehyde</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PoissonRatio -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PoissonRatio">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The negative ratio of transverse strain to axial strain under uniaxial load; a dimensionless elastic constant. Reported for aerogels to characterise their compressible, low-Poisson network (often 0.1-0.2)</rdfs:comment>
        <rdfs:label xml:lang="en">Poisson ratio</rdfs:label>
        <skos:altLabel xml:lang="en">Poisson&apos;s ratio</skos:altLabel>
        <skos:definition xml:lang="en">The dimensionless ratio of transverse contraction strain to longitudinal extension strain in the direction of an applied uniaxial load</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PolyimideAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PolyimideAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerAerogel"/>
        <rdfs:comment xml:lang="en">An organic aerogel based on polyimide polymer chains</rdfs:comment>
        <rdfs:label xml:lang="en">Polyimide aerogel</rdfs:label>
        <skos:definition xml:lang="en">A polymer aerogel whose network is formed from polyimide chains</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PolymerAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PolymerAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Aerogel"/>
        <rdfs:comment xml:lang="en">An aerogel composed of organic polymer networks, such as resorcinol-formaldehyde, polyurethane, or polyimide aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Polymer aerogel</rdfs:label>
        <skos:definition xml:lang="en">An aerogel whose solid network is composed of organic polymer chains</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PolymerPrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PolymerPrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Precursor"/>
        <rdfs:comment xml:lang="en">A monomer or oligomer that forms a synthetic polymer aerogel network by step-growth chemistry: dianhydrides and diamines (polyimide), isocyanates and polyols (polyurethane/polyurea)</rdfs:comment>
        <rdfs:label xml:lang="en">Polymer precursor</rdfs:label>
        <skos:definition xml:lang="en">A monomer or oligomer that forms a synthetic polymer network in polymer aerogel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Polyol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Polyol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerPrecursor"/>
        <rdfs:comment xml:lang="en">A polyfunctional alcohol that reacts with isocyanates to form the polyurethane network of polyurethane aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Polyol</rdfs:label>
        <skos:definition xml:lang="en">A polyfunctional alcohol monomer that forms polyurethane networks with isocyanates</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PolyurethaneAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PolyurethaneAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/PolymerAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel based on a polyurethane polymer network formed by the reaction of polyisocyanates with polyols</rdfs:comment>
        <rdfs:label xml:lang="en">Polyurethane aerogel</rdfs:label>
        <skos:definition xml:lang="en">A polymer aerogel whose network is formed by the reaction of polyisocyanates with polyols</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PoreSizeDistribution -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PoreSizeDistribution">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">A statistical description of the range and frequency of pore sizes within a porous material, typically determined by BJH analysis or mercury intrusion porosimetry. Aerogels predominantly feature mesopores (2-50 nm)</rdfs:comment>
        <rdfs:label xml:lang="en">Pore size distribution</rdfs:label>
        <skos:definition xml:lang="en">A material property describing the statistical distribution of pore sizes within a porous material, typically characterised by BJH analysis of N₂ adsorption isotherms.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/metre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PoreVolume -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PoreVolume">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The volume of open pores per unit mass of a porous material, as reported in the literature from N2 physisorption (total pore volume at p/p0 ~ 0.99) or mercury intrusion; conventionally given in cm3/g (= 0.001 m3/kg). A specific (mass-normalised) volume, hence placed directly under om:Quantity rather than om:Volume, with canonical unit m3/kg</rdfs:comment>
        <rdfs:label xml:lang="en">Pore volume</rdfs:label>
        <skos:altLabel xml:lang="en">Specific pore volume</skos:altLabel>
        <skos:altLabel xml:lang="en">Total pore volume</skos:altLabel>
        <skos:definition xml:lang="en">A quantity representing the total volume of open pores per unit mass of a porous material</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetrePerKilogram"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PorodExponent -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PorodExponent">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The power-law exponent P of the scattering intensity, I(q) ∝ q^(−P), in the high-q region. Directly read from the scattering slope: 1 ≤ P ≤ 3 indicates a mass fractal (P = Dm), while 3 &lt; P ≤ 4 indicates a surface fractal (P = 6 − Ds), with P = 4 for a smooth (Porod) interface</rdfs:comment>
        <rdfs:label xml:lang="en">Porod exponent</rdfs:label>
        <skos:altLabel xml:lang="en">Power-law exponent</skos:altLabel>
        <skos:altLabel xml:lang="en">Scattering exponent</skos:altLabel>
        <skos:definition xml:lang="en">The dimensionless power-law exponent of small-angle scattering intensity versus q, from which the mass fractal (P = Dm) or surface fractal (P = 6 − Ds) dimension is derived</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Porosity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Porosity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The ratio of void volume to total volume in a porous material, expressed as a fraction or percentage. Aerogels typically exhibit porosity &gt; 90%, which directly impacts their thermal, acoustic, and mechanical properties</rdfs:comment>
        <rdfs:label xml:lang="en">Porosity</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the fraction of void space in a material relative to its total volume; expressed as an om:Measure with unit fraction (0–1) or percent.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PorosityMeasurement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PorosityMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of pore volume, pore size distribution, and surface area, typically using BET or BJH methods</rdfs:comment>
        <rdfs:label xml:lang="en">Porosity measurement</rdfs:label>
        <skos:definition xml:lang="en">An analysis that determines pore volume, pore size distribution, or related textural properties of a porous material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Precursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Precursor">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A chemical entity that is chemically converted into the solid network of a gel during sol-gel synthesis. Grouped by material family: silica, metal oxide, organic, polymer, and biopolymer precursors. The function in a specific step is additionally stated through the role pattern (prov:hadRole some gmat:PrecursorRole)</rdfs:comment>
        <rdfs:label xml:lang="en">Precursor</rdfs:label>
        <skos:definition xml:lang="en">A chemical entity that reacts to form the solid network of a gel in sol-gel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PrecursorRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PrecursorRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance that is chemically converted into the solid network of the gel (e.g. TEOS in a silica synthesis, resorcinol and formaldehyde in an RF synthesis)</rdfs:comment>
        <rdfs:label xml:lang="en">Precursor role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that serves as the network-forming reactant of a sol-gel synthesis step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PressurePlate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PressurePlate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">A device to apply and distribute a precise, uniform compressive load.</rdfs:comment>
        <rdfs:label xml:lang="en">Pressure Plate</rdfs:label>
        <skos:definition xml:lang="en">An instrument that applies and distributes a precise, uniform compressive load to a specimen</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PressureProfile -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PressureProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">Pressure conditions including set points, ramp rates, and hold times during a process</rdfs:comment>
        <rdfs:label xml:lang="en">Pressure profile</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the pressure conditions of a process, including set points, ramp rates, and hold times</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/PressureVessel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/PressureVessel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Container designed to hold gases or liquids at pressure different from ambient</rdfs:comment>
        <rdfs:label xml:lang="en">Pressure vessel</rdfs:label>
        <skos:definition xml:lang="en">Equipment consisting of a container designed to hold gases or liquids at a pressure substantially different from ambient</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Pressurization -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Pressurization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Controlled increase of pressure during supercritical drying to bring the drying fluid above its critical point, typically performed at controlled ramp rate</rdfs:comment>
        <rdfs:label xml:lang="en">Pressurization</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which pressure is increased in a controlled manner, in supercritical drying bringing the drying fluid above its critical point</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ProcessParameter -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ProcessParameter">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">A quality (in the BFO sense) that characterises the material inputs or setup of a synthesis process — e.g. a molar or volume ratio of reagents, a pH condition, or a stirring rate. Modelled as a quality that inheres in an independent continuant (typically the reacting mixture / sol), carrying its numeric magnitude via an om:Measure. Achieved, per-run values (not plan prescriptions). Also a subclass of om:Quantity (itself under pmat:Feature), so that process parameters can carry values via om:hasValue and satisfy the pmat:Feature domain of pmat:isParameterOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Process parameter</rdfs:label>
        <skos:definition xml:lang="en">A quality inhering in an independent continuant that characterises the material inputs or setup of a synthesis process, recording an achieved per-run value</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Pycnometer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Pycnometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">Device for measuring volume and density of materials, typically using helium displacement</rdfs:comment>
        <rdfs:label xml:lang="en">Pycnometer</rdfs:label>
        <skos:altLabel xml:lang="en">Helium pycnometer</skos:altLabel>
        <skos:definition xml:lang="en">An instrument that measures the volume and density of a material, typically by gas displacement</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Pyrolysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Pyrolysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">Thermal decomposition of an organic aerogel in inert atmosphere (N2, Ar), typically 600-1100 degC, converting it into a carbon aerogel</rdfs:comment>
        <rdfs:label xml:lang="en">Pyrolysis</rdfs:label>
        <skos:altLabel xml:lang="en">Carbonisation</skos:altLabel>
        <skos:altLabel xml:lang="en">Carbonization</skos:altLabel>
        <skos:definition xml:lang="en">A thermal treatment in inert atmosphere that decomposes an organic network into carbon; the route from organic to carbon aerogels</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/RamanSpectroscopy -->


    <owl:Class rdf:about="https://w3id.org/gelmat/RamanSpectroscopy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Raman scattering spectroscopy; for carbon aerogels the D/G band ratio quantifies graphitisation, for oxides it identifies phases</rdfs:comment>
        <rdfs:label xml:lang="en">Raman spectroscopy</rdfs:label>
        <skos:definition xml:lang="en">An analysis that records inelastic (Raman) light scattering to characterise molecular and lattice vibrations</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/RatioValue -->


    <owl:Class rdf:about="https://w3id.org/gelmat/RatioValue">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:comment xml:lang="en">A value node representing the numerical proportion between substances in a ratio; a dimensionless om:Measure pointed to by a ProcessParameter quality, not a quality itself. Single-valued ratios carry om:hasNumericalValue (xsd:double, unit om:one; two-part ratio a:b = a/b) for numeric querying, alongside the display string in gmat:hasRatioString. Multi-component ratios (e.g. &apos;1:10:4:4&apos;) are represented by the string only.</rdfs:comment>
        <rdfs:label xml:lang="en">Ratio Value</rdfs:label>
        <skos:definition xml:lang="en">A dimensionless measure holding the numerical proportion between substances in a ratio, referenced by a process parameter quality</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/RawData -->


    <owl:Class rdf:about="https://w3id.org/gelmat/RawData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Original, unprocessed data collected directly from experiment</rdfs:comment>
        <rdfs:label xml:lang="en">Raw data</rdfs:label>
        <skos:definition xml:lang="en">Original, unprocessed data collected directly from an experiment</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Reinforcement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Reinforcement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A material embedded in an aerogel matrix as a reinforcing or functional filler phase - fibres, nanocarbons, clays. Linked from a gmat:CompositeAerogel with gmat:hasReinforcement; the function in a synthesis step is stated with prov:hadRole some gmat:ReinforcementRole</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforcement</rdfs:label>
        <skos:definition xml:lang="en">A substance incorporated into a composite aerogel as reinforcing or functional filler phase</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ReinforcementRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ReinforcementRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance embedded as a reinforcing or filler phase in a composite (e.g. glass fibre, cellulose fibre, graphene oxide, carbon nanotubes)</rdfs:comment>
        <rdfs:label xml:lang="en">Reinforcement role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance incorporated into a composite to improve its mechanical or functional properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Resorcinol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Resorcinol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SANS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SANS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SAXS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SAXS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Shrinkage -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Shrinkage">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The relative dimensional change (linear or volumetric) of a gel during the drying process, expressed as a fraction or percentage. High shrinkage indicates capillary-force-driven pore collapse, common in ambient pressure drying</rdfs:comment>
        <rdfs:label xml:lang="en">Shrinkage</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the linear dimensional change of a gel or aerogel during processing (drying, aging) relative to the original gel dimension; expressed as an om:Measure with unit percent.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Silanol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Silanol">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A silicon hydroxide species (Si-OH) formed as an intermediate during hydrolysis of silicon alkoxide precursors. Silanols undergo condensation to form siloxane (Si-O-Si) bonds and build the gel network</rdfs:comment>
        <rdfs:label xml:lang="en">Silanol</rdfs:label>
        <skos:definition xml:lang="en">An intermediate species containing a silicon-bound hydroxyl group (Si-OH), the key reactive monomer formed by hydrolysis of silicon alkoxides in sol-gel processing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SilicaAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SilicaAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/InorganicAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with a pure silicon dioxide (SiO₂) backbone, typically produced from tetraethoxysilane (TEOS) or tetramethylorthosilicate (TMOS) via the sol-gel process followed by supercritical drying</rdfs:comment>
        <rdfs:label xml:lang="en">Silica aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">SiO₂ aerogel</skos:altLabel>
        <skos:closeMatch rdf:resource="http://emmo.info/emmo#EMMO_4207e895"/>
        <skos:definition xml:lang="en">An inorganic aerogel in which the solid network consists predominantly of amorphous SiO₂, giving low density (0.003–0.35 g/cm³), high surface area (&gt; 500 m²/g), and low thermal conductivity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SilicaPrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SilicaPrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Precursor"/>
        <rdfs:comment xml:lang="en">A precursor that yields a silica (SiO2) or organosilica network, comprising silicon alkoxides (TEOS, TMOS, MTMS, ...) and silicates (sodium silicate / water glass)</rdfs:comment>
        <rdfs:label xml:lang="en">Silica precursor</rdfs:label>
        <skos:definition xml:lang="en">A precursor whose hydrolysis and condensation yield a silica or organosilica network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SilicatePrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SilicatePrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SilicaPrecursor"/>
        <rdfs:comment xml:lang="en">An inorganic silicate salt used as a low-cost silica source, typically requiring an ion exchange or acid neutralisation step to remove the alkali cations before or during gelation</rdfs:comment>
        <rdfs:label xml:lang="en">Silicate precursor</rdfs:label>
        <skos:definition xml:lang="en">An inorganic silicate used as a silica source in the water-glass route to silica gels</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SiliconAlkoxidePrecursor -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SiliconAlkoxidePrecursor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganosiliconCompound"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SilicaPrecursor"/>
        <rdfs:comment xml:lang="en">A subclass of organosilicon compounds with silicon bound to alkoxy groups (Si–OR); commonly employed as sol–gel precursors for silica networks</rdfs:comment>
        <rdfs:label xml:lang="en">Silicon alkoxide precursor</rdfs:label>
        <skos:definition xml:lang="en">A silicon compound bearing hydrolysable alkoxy groups (Si-OR), employed as a sol-gel precursor for silica or organosilica networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SilylationAgent -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SilylationAgent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A reactive organosilicon compound used to replace silanol surface groups with alkylsilyl groups, rendering the gel surface hydrophobic. Applied during surface modification before ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SilylationAgentRole]</rdfs:comment>
        <rdfs:label xml:lang="en">Silylation agent</rdfs:label>
        <skos:altLabel xml:lang="en">Silylating agent</skos:altLabel>
        <skos:definition xml:lang="en">A reactive organosilicon compound that replaces surface silanol groups with alkylsilyl groups, rendering a gel surface hydrophobic</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SilylationAgentRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SilylationAgentRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance that silylates surface silanol groups during a surface modification step; distinct from the convenience substance class gmat:SilylationAgent</rdfs:comment>
        <rdfs:label xml:lang="en">Silylation agent role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that replaces surface silanol groups with alkylsilyl groups during surface modification</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Sintering -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Sintering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">High-temperature densification of a porous network by viscous flow or diffusion below the melting point; used deliberately for densification or as an unwanted effect limiting the service temperature of aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Sintering</rdfs:label>
        <skos:definition xml:lang="en">A thermal treatment that densifies a porous solid by particle coalescence below the melting point</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SkeletalDensity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SkeletalDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Density"/>
        <rdfs:comment xml:lang="en">The mass of a porous body divided by the volume of its solid skeleton only, excluding open pore space; determined by helium pycnometry (gmat:SkeletalDensityMeasurement). Typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Skeletal density</rdfs:label>
        <skos:altLabel xml:lang="en">True density</skos:altLabel>
        <skos:definition xml:lang="en">The density of the solid skeleton of a porous material, computed over the skeletal volume that excludes open pores; measured by gas displacement (helium) pycnometry</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SkeletalDensityMeasurement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SkeletalDensityMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of true density of solid material in aerogel, typically using helium pycnometry</rdfs:comment>
        <rdfs:label xml:lang="en">Skeletal density measurement</rdfs:label>
        <skos:definition xml:lang="en">An analysis that determines the density of the solid skeleton of a porous material, typically by helium pycnometry</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Slabs -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Slabs">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Geometry"/>
        <rdfs:comment xml:lang="en">A flat, thick piece of material, typically rectangular in shape, often used for thermal conductivity measurements.</rdfs:comment>
        <rdfs:label xml:lang="en">Slab</rdfs:label>
        <skos:definition xml:lang="en">A sample geometry consisting of a flat, thick, typically rectangular piece, often used for thermal conductivity measurements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SodiumCarbonate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SodiumCarbonate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BaseCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SodiumHydroxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SodiumHydroxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BaseCatalyst"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SodiumSilicate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SodiumSilicate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SilicatePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Sol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Sol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A colloidal suspension of solid particles in a liquid, formed during the initial stage of sol-gel synthesis before gelation occurs</rdfs:comment>
        <rdfs:label xml:lang="en">Sol</rdfs:label>
        <skos:definition xml:lang="en">A colloidal suspension of solid particles dispersed in a liquid, constituting the initial stage of sol-gel synthesis prior to gelation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolConcentration -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolConcentration">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration"/>
        <rdfs:comment xml:lang="en">The molar or mass concentration of the precursor monomer in the sol (mol/L or wt%). Controls the density and pore volume of the final aerogel</rdfs:comment>
        <rdfs:label xml:lang="en">Sol concentration</rdfs:label>
        <skos:definition xml:lang="en">The molar or mass concentration of the precursor monomer in the starting sol, governing the density of the resulting aerogel; higher concentrations yield denser, stronger, less porous aerogels</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/molePerCubicmetre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolFormation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolFormation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Condensation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/Hydrolysis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Process of creating a colloidal suspension (sol) by mixing precursors, solvents, and catalysts before gelation. Comprises hydrolysis of alkoxide groups and condensation of silanol intermediates</rdfs:comment>
        <rdfs:label xml:lang="en">Sol formation</rdfs:label>
        <skos:definition xml:lang="en">The first stage of sol-gel synthesis in which precursor molecules undergo hydrolysis and initial condensation to form a stable colloidal suspension (sol) of nanoscale particles or oligomers in a solvent</skos:definition>
        <hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">1</hasStepOrder>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolGelPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolGelPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:comment xml:lang="en">A gelation pathway involving the polymerization of precursors via sol-gel chemistry</rdfs:comment>
        <rdfs:label xml:lang="en">Sol-gel polymerisation</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway in which the network forms by polymerisation of precursors via hydrolysis and condensation reactions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolGelTransition -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolGelTransition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">The gel point event at which the sol loses fluidity and transitions to a solid gel network due to percolation of the condensing silica network. Characterised by a sharp increase in viscosity and loss of flow. Placed under gmat:CreationProcess (not under gmat:Gelation, whose usesSubstance existentials would be wrongly inherited by an instantaneous event) so that it is visible to anything that enumerates synthesis steps; the containment in gelation is expressed by gmat:Gelation asserting BFO_0000051 (has part) some SolGelTransition</rdfs:comment>
        <rdfs:label xml:lang="en">Sol-gel transition</rdfs:label>
        <skos:altLabel xml:lang="en">Gel point</skos:altLabel>
        <skos:altLabel xml:lang="en">Gelation point</skos:altLabel>
        <skos:definition xml:lang="en">The critical event (gel point) at which percolation of the condensing network spans the reaction volume, converting the flowable sol into a solid gel; marked by divergence of viscosity and loss of steady-state flow</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolidStateNMR -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolidStateNMR">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Solid-state NMR spectroscopy (29Si, 13C, 27Al); 29Si Q/T-species ratios quantify network connectivity (gmat:NetworkConnectivity) and condensation degree; performed on a pmat:NMRSpectrometer</rdfs:comment>
        <rdfs:label xml:lang="en">Solid-state NMR spectroscopy</rdfs:label>
        <skos:altLabel xml:lang="en">ssNMR</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that records nuclear magnetic resonance spectra of solid samples, typically under magic-angle spinning</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SolventExchange -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SolventExchange">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/transformsGel"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/WetGel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Process of systematically replacing pore liquid in wet gel structures (hydrogels or alcogels) with a more volatile or supercritical-compatible solvent through multiple washing cycles</rdfs:comment>
        <rdfs:label xml:lang="en">Solvent exchange</rdfs:label>
        <skos:definition xml:lang="en">A sample preparation step in which the pore liquid of a wet gel is progressively replaced by a target solvent (e.g. ethanol, acetone, or liquid CO2) to remove water and residual reactants before drying</skos:definition>
        <hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">4</hasStepOrder>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Sonication -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Sonication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Application of ultrasound to disperse particles (fibres, GO, CNT) in a sol, accelerate hydrolysis, or degas a mixture</rdfs:comment>
        <rdfs:label xml:lang="en">Sonication</rdfs:label>
        <skos:altLabel xml:lang="en">Ultrasonication</skos:altLabel>
        <skos:definition xml:lang="en">A sample preparation step in which ultrasound is applied to disperse, mix, or degas a liquid system</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SpecificHeatCapacity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SpecificHeatCapacity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity"/>
        <rdfs:comment xml:lang="en">The amount of heat energy required to raise the temperature of a unit mass of material by one degree, typically expressed in J/(kg*K). Relevant for aerogel thermal energy storage applications</rdfs:comment>
        <rdfs:label xml:lang="en">Specific heat capacity</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the heat energy required to raise the temperature of a unit mass of material by one kelvin; expressed as an om:Measure with unit J/(kg·K).</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerKelvinKilogram"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SpecificSurfaceAreaMeasurement -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SpecificSurfaceAreaMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of specific surface area of porous materials, typically performed using gas adsorption methods such as BET (Brunauer-Emmett-Teller) analysis</rdfs:comment>
        <rdfs:label xml:lang="en">Specific surface area measurement</rdfs:label>
        <skos:definition xml:lang="en">An analysis that determines the specific surface area of a porous material, typically by gas physisorption</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SpringbackFailure -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SpringbackFailure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">Incomplete recovery of pore volume after capillary compression during ambient pressure drying; the gel does not fully spring back to its wet-gel dimensions due to insufficient surface silylation or network weakness</rdfs:comment>
        <rdfs:label xml:lang="en">Springback failure</rdfs:label>
        <skos:definition xml:lang="en">An aerogel defect in which the gel network fails to recover its original pore volume after capillary compression during ambient pressure drying, due to insufficient hydrophobisation or network weakness, yielding higher density and lower surface area than expected</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Starch -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Starch">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/BiopolymerPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Stirring -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Stirring">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Mixing"/>
        <rdfs:comment xml:lang="en">Mechanical agitation of a solution or sol at a controlled stirring rate (gmat:StirringRate) using magnetic or overhead stirrers</rdfs:comment>
        <rdfs:label xml:lang="en">Stirring</rdfs:label>
        <skos:definition xml:lang="en">A mixing step performed by mechanical agitation at a controlled stirring rate</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/StirringRate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/StirringRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">Rotation speed of stirring mechanism during mixing, typically measured in RPM</rdfs:comment>
        <rdfs:label xml:lang="en">Stirring rate</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the rotation speed of the stirring mechanism during mixing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/StockSolution -->


    <owl:Class rdf:about="https://w3id.org/gelmat/StockSolution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A concentrated solution prepared in advance and stored for repeated use in synthesis procedures to ensure consistency across multiple experiments</rdfs:comment>
        <rdfs:label xml:lang="en">Stock solution</rdfs:label>
        <skos:definition xml:lang="en">A concentrated solution of defined composition prepared in advance and stored for repeated use in synthesis procedures</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/StructuralCollapse -->


    <owl:Class rdf:about="https://w3id.org/gelmat/StructuralCollapse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/AerogelDefect"/>
        <rdfs:comment xml:lang="en">The defect state of a collapsed or densified aerogel network, typically caused by capillary forces during improper drying. Denotes the persisting collapsed-structure feature of the material, not the collapse event.</rdfs:comment>
        <rdfs:label xml:lang="en">Collapsed structure</rdfs:label>
        <skos:altLabel xml:lang="en">Structural collapse</skos:altLabel>
        <skos:definition xml:lang="en">An aerogel defect consisting of a collapsed or densified region of the solid network in which the original porous structure is lost</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalCO2 -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalCO2">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SupercriticalFluid"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/SupercriticalEthanol"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalDryer -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalDryer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Dryer"/>
        <rdfs:comment xml:lang="en">Specialized equipment for supercritical drying that heats and pressurizes fluid (typically CO2) above its critical point to extract solvents from gel materials</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical dryer</rdfs:label>
        <skos:altLabel xml:lang="en">Autoclave</skos:altLabel>
        <skos:definition xml:lang="en">A dryer that heats and pressurises a fluid above its critical point to extract pore solvent from a gel without capillary stress</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:comment xml:lang="en">Drying method using supercritical fluid (typically CO2) to remove solvent from porous materials while preserving the nanoscale structure by avoiding capillary forces</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical drying</rdfs:label>
        <skos:definition xml:lang="en">A drying method in which the pore liquid is brought above its critical temperature and pressure before venting to gas phase, eliminating the liquid-vapour interface and thus capillary stress, preserving the aerogel network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalEthanol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalEthanol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SupercriticalFluid"/>
        <rdfs:comment xml:lang="en">Ethanol in supercritical state (above 241°C and 61.4 bar), alternative to CO2 for aerogel drying</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical ethanol</rdfs:label>
        <skos:definition xml:lang="en">Ethanol in the supercritical state, used as a high-temperature alternative drying medium in supercritical drying of gels</skos:definition>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16236"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalFluid -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalFluid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A substance at temperature and pressure above its critical point, exhibiting properties between gas and liquid phases</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical fluid</rdfs:label>
        <skos:definition xml:lang="en">A substance held at a temperature and pressure above its critical point, exhibiting properties intermediate between those of a gas and a liquid</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SupercriticalFluidRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SupercriticalFluidRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance used in its supercritical state as the extraction medium of a supercritical drying step (typically CO2 or ethanol)</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical fluid role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that serves as the supercritical extraction medium in a supercritical drying step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SurfaceArea -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SurfaceArea">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The specific surface area (BET) of a porous material in m2/g, measured by N2 physisorption and analysis of the adsorption isotherm using the Brunauer-Emmett-Teller model. Aerogels typically exhibit 200-1000 m2/g</rdfs:comment>
        <rdfs:label xml:lang="en">Surface area</rdfs:label>
        <skos:altLabel xml:lang="en">BET surface area</skos:altLabel>
        <skos:altLabel xml:lang="en">Specific surface area</skos:altLabel>
        <skos:definition xml:lang="en">The total internal and external surface area of a porous material per unit mass, determined by BET N2 physisorption; the primary indicator of aerogel texture and catalytic or adsorption capacity</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerGram"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SurfaceFractalDimension -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SurfaceFractalDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/FractalDimension"/>
        <rdfs:comment xml:lang="en">The fractal dimension Ds describing the roughness/self-similarity of the solid-pore interface, obtained from the Porod region of the scattering curve, I(q) ∝ q^(−(6−Ds)). Values 2 ≤ Ds &lt; 3, where Ds = 2 denotes a smooth surface and values toward 3 denote an increasingly rough, space-filling interface</rdfs:comment>
        <rdfs:label xml:lang="en">Surface fractal dimension</rdfs:label>
        <skos:altLabel xml:lang="en">Ds</skos:altLabel>
        <skos:definition xml:lang="en">The surface fractal dimension (2 ≤ Ds ≤ 3) obtained from the Porod region of a SAXS/SANS curve, quantifying the roughness of the solid-pore interface</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SurfaceModification -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SurfaceModification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Chemical treatment to alter aerogel surface properties, such as hydrophobization or functionalization</rdfs:comment>
        <rdfs:label xml:lang="en">Surface modification</rdfs:label>
        <skos:definition xml:lang="en">Chemical treatment of the internal pore surfaces of a wet gel to alter surface chemistry, typically to introduce hydrophobic groups that prevent capillary collapse during ambient pressure drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SurfaceSilylation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SurfaceSilylation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SurfaceModification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/hasSilylationAgent"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/SilylationAgent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Chemical modification of wet gel surface Si-OH groups by reaction with a silylating agent (TMCS, HMDS) to replace surface hydroxyls with hydrophobic alkylsilyl groups. Essential pre-treatment before ambient pressure drying to prevent capillary collapse</rdfs:comment>
        <rdfs:label xml:lang="en">Surface silylation</rdfs:label>
        <skos:altLabel xml:lang="en">Hydrophobic surface modification</skos:altLabel>
        <skos:altLabel xml:lang="en">TMCS treatment</skos:altLabel>
        <skos:definition xml:lang="en">A surface modification step in which surface silanol groups (Si-OH) react with a chlorosilane or silazane reagent (e.g. TMCS, HMDS) to install hydrophobic trialkylsilyl groups, enabling ambient pressure drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Surfactant -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Surfactant">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">A surface-active agent used to stabilize emulsions or modify interfacial properties in synthesis. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SurfactantRole]</rdfs:comment>
        <rdfs:label xml:lang="en">Surfactant</rdfs:label>
        <skos:definition xml:lang="en">A surface-active agent that lowers interfacial tension, used to stabilise emulsions or modify interfacial properties during synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SurfactantRole -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SurfactantRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The role of a substance acting as a surface-active agent (emulsion stabiliser, pore templating agent) in a given step; distinct from the convenience substance class gmat:Surfactant</rdfs:comment>
        <rdfs:label xml:lang="en">Surfactant role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance that lowers interfacial tension or templates porosity during a synthesis step</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SynthesisProtocol -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SynthesisProtocol">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:comment xml:lang="en">A plan specification (recipe/protocol) that prescribes how a sol-gel synthesis is to be carried out. As a generically dependent continuant it is the reusable, copyable information artifact that a concrete synthesis process (an occurrent) realises. Distinguishes the recipe from any individual run of it.</rdfs:comment>
        <rdfs:label xml:lang="en">Synthesis protocol</rdfs:label>
        <skos:definition xml:lang="en">A generically dependent continuant that is an information artifact prescribing the ordered activities, materials, and conditions for carrying out a sol-gel synthesis; realised by one or more concrete synthesis processes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/SyringePump -->


    <owl:Class rdf:about="https://w3id.org/gelmat/SyringePump">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Pump"/>
        <owl:disjointWith rdf:resource="https://w3id.org/gelmat/VacuumPump"/>
        <rdfs:comment xml:lang="en">A precision fluid delivery device that uses a motor-driven plunger to dispense exact volumes at controlled flow rates. Used in aerogel synthesis for controlled addition of reagents or for supercritical fluid delivery</rdfs:comment>
        <rdfs:label xml:lang="en">Syringe Pump</rdfs:label>
        <skos:definition xml:lang="en">A pump that dispenses precise fluid volumes at controlled flow rates by means of a motor-driven plunger</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TEMImaging -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TEMImaging">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TMOS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TMOS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Tannin -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Tannin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/OrganicPrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TapDensity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TapDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Density"/>
        <rdfs:comment xml:lang="en">The bulk density of a powder or granulate after mechanical tapping of the container until no further volume change occurs; relevant for aerogel powders, beads, and granulates</rdfs:comment>
        <rdfs:label xml:lang="en">Tap density</rdfs:label>
        <skos:definition xml:lang="en">The density of a powder or granular material measured after tapping the container to a constant volume</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TemperatureProfile -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TemperatureProfile">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">Temperature conditions including set points, ramp rates, and hold times during a process. Use this class only for temperature programmes (ramps, multi-segment profiles); a single constant temperature value should be modelled as an om:Temperature instance linked to the process with pmat:isParameterOf</rdfs:comment>
        <rdfs:label xml:lang="en">Temperature profile</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the temperature conditions of a process, including set points, ramp rates, and hold times</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TemperatureRamping -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TemperatureRamping">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalTreatment"/>
        <rdfs:comment xml:lang="en">Controlled heating or cooling process during synthesis or drying</rdfs:comment>
        <rdfs:label xml:lang="en">Temperature ramping</rdfs:label>
        <skos:definition xml:lang="en">A creation process step in which temperature is increased or decreased at a controlled rate during synthesis or drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TensileClamps -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TensileClamps">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">A tool specialized to securely hold a specimen while a pulling (tensile) force is applied.</rdfs:comment>
        <rdfs:label xml:lang="en">Tensile Clamps</rdfs:label>
        <skos:definition xml:lang="en">An instrument that securely grips a specimen while a tensile force is applied</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Tetraethoxysilane -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Tetraethoxysilane">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Monomer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/polymat/Monomer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalConductivity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalConductivity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity"/>
        <rdfs:comment xml:lang="en">The property of a material to conduct heat, defined as the rate of heat flow through a unit thickness per unit area per unit temperature difference. For aerogels, low thermal conductivity is a key performance metric, with values typically in the range 0.012-0.025 W/(m*K)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal conductivity</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the rate of heat transfer through a material; expressed as an om:Measure with unit W/(m·K). Lower values indicate better thermal insulation.</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/wattPerMetreKelvin"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalConductivityTesting -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalConductivityTesting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Measurement of heat transfer properties through aerogel material</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal conductivity testing</rdfs:label>
        <skos:definition xml:lang="en">An analysis that measures the heat transport properties of a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalDiffusivity -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalDiffusivity">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity"/>
        <rdfs:comment xml:lang="en">The rate at which heat diffuses through a material, equal to thermal conductivity divided by the product of density and specific heat capacity, expressed in m^2/s. Very low for aerogels, reflecting their insulating behaviour</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal diffusivity</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the rate of thermal diffusion through a material (thermal conductivity / (density × specific heat capacity)); expressed as an om:Measure with unit m²/s</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerSecond-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalExpansionCoefficient -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalExpansionCoefficient">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The fractional change in length (linear) per unit change in temperature at constant pressure, expressed in K^-1. OM-2 defines no dedicated class, so this quantity is placed directly under om:Quantity with a reciprocal-kelvin canonical unit</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal expansion coefficient</rdfs:label>
        <skos:altLabel xml:lang="en">CTE</skos:altLabel>
        <skos:altLabel xml:lang="en">Coefficient of thermal expansion</skos:altLabel>
        <skos:altLabel xml:lang="en">Linear thermal expansion coefficient</skos:altLabel>
        <skos:definition xml:lang="en">A material property quantity representing the linear coefficient of thermal expansion, i.e. the relative change in a material&apos;s length per unit temperature change at constant pressure; expressed as an om:Measure with unit K⁻¹</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalKelvin"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalInsulation -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalInsulation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Application"/>
        <rdfs:comment xml:lang="en">Use of a material to suppress heat transfer - building insulation, industrial piping, aerospace thermal protection; the dominant aerogel application</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal insulation</rdfs:label>
        <skos:definition xml:lang="en">The application of a material as a barrier against heat transfer</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermalTreatment -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermalTreatment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">A high-temperature post-treatment of a dried gel or aerogel - pyrolysis/carbonisation, calcination, curing, sintering. Characterised by a temperature (om:Temperature or gmat:TemperatureProfile), a gmat:Duration, a gmat:HeatingRate, and a gas atmosphere (gmat:hasAtmosphere)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal treatment</rdfs:label>
        <skos:altLabel xml:lang="en">Heat treatment</skos:altLabel>
        <skos:definition xml:lang="en">A creation process step in which a material is held at elevated temperature under a controlled atmosphere to transform its composition or structure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ThermogravimetricAnalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ThermogravimetricAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TitaniaAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TitaniaAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalOxideAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with a TiO2 network, typically from titanium isopropoxide; studied for photocatalysis</rdfs:comment>
        <rdfs:label xml:lang="en">Titania aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">TiO2 aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A metal oxide aerogel whose solid framework consists of titanium dioxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TitaniumIsopropoxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TitaniumIsopropoxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalAlkoxide"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TransientHotWire -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TransientHotWire">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ThermalConductivityTesting"/>
        <rdfs:comment xml:lang="en">Transient thermal conductivity measurement from the temperature rise of a line heat source embedded in the sample; includes the related transient plane source (Hot Disk) variant</rdfs:comment>
        <rdfs:label xml:lang="en">Transient hot wire method</rdfs:label>
        <skos:altLabel xml:lang="en">Hot wire method</skos:altLabel>
        <skos:altLabel xml:lang="en">Transient plane source</skos:altLabel>
        <skos:definition xml:lang="en">A transient thermal conductivity measurement based on the temperature response of an embedded line or plane heat source</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Transmittance -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Transmittance">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The fraction of incident electromagnetic radiation that passes through a material at a given wavelength. Transparent silica aerogels can exhibit &gt; 90% transmittance in the visible range</rdfs:comment>
        <rdfs:label xml:lang="en">Transmittance</rdfs:label>
        <skos:definition xml:lang="en">A material property quantity representing the fraction of incident light transmitted through a material at a specified wavelength; expressed as an om:Measure with unit percent or dimensionless (0–1).</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/one"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Triflex -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Triflex">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">A device for physisorption measurements, including pore size distribution and specific surface area analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">Triflex</rdfs:label>
        <skos:definition xml:lang="en">A physisorption analysis instrument used for specific surface area and pore size distribution measurements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Trimethylchlorosilane -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Trimethylchlorosilane">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SilylationAgent"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TwoStepCatalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TwoStepCatalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gelation"/>
        <rdfs:comment xml:lang="en">Two-stage acid-then-base catalysis route: an acid pre-hydrolysis step produces partially hydrolysed monomers; subsequent base addition (typically ammonium hydroxide or ammonium fluoride) triggers rapid condensation and gelation. Common route for MTMS and TEOS aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Two-step acid-base catalysis</rdfs:label>
        <skos:altLabel xml:lang="en">Acid-base two-step</skos:altLabel>
        <skos:altLabel xml:lang="en">Two-step catalysis</skos:altLabel>
        <skos:definition xml:lang="en">A sol-gel route combining an acid pre-hydrolysis step with a subsequent base addition step that triggers rapid condensation and gelation; standard route for MTMS and BTMSE aerogel synthesis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/TwoStepCatalysisPathway -->


    <owl:Class rdf:about="https://w3id.org/gelmat/TwoStepCatalysisPathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/GelationPathway"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/gelmat/realisedAs"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/gelmat/TwoStepCatalysis"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Two-Step Catalysis Pathway</rdfs:label>
        <skos:definition xml:lang="en">A gelation pathway combining an acid pre-hydrolysis step with a subsequent base addition step; the standard pathway for MTMS and BTMSE-based aerogel synthesis.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Urea -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Urea">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/VTMS -->


    <owl:Class rdf:about="https://w3id.org/gelmat/VTMS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/SiliconAlkoxidePrecursor"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/VacuumDrying -->


    <owl:Class rdf:about="https://w3id.org/gelmat/VacuumDrying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Drying"/>
        <rdfs:comment xml:lang="en">Drying method performed under reduced pressure to lower solvent boiling point and facilitate removal</rdfs:comment>
        <rdfs:label xml:lang="en">Vacuum drying</rdfs:label>
        <skos:definition xml:lang="en">A drying method performed under reduced pressure to lower the solvent boiling point and facilitate solvent removal</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/VacuumPump -->


    <owl:Class rdf:about="https://w3id.org/gelmat/VacuumPump">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Pump"/>
        <rdfs:comment xml:lang="en">Device for removing gas molecules from a sealed volume to create partial vacuum</rdfs:comment>
        <rdfs:label xml:lang="en">Vacuum pump</rdfs:label>
        <skos:definition xml:lang="en">A pump that removes gas molecules from a sealed volume to create a partial vacuum</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/VolumeRatio -->


    <owl:Class rdf:about="https://w3id.org/gelmat/VolumeRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">The ratio of volumes between two or more substances in a mixture or solution. Used to describe the proportions of reagents by volume (e.g., MTMS:MeOH = 1:10).</rdfs:comment>
        <rdfs:label xml:lang="en">Volume Ratio</rdfs:label>
        <skos:definition xml:lang="en">A process parameter representing the ratio of volumes between two or more substances in a mixture or solution</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/VolumetricFlowRate -->


    <owl:Class rdf:about="https://w3id.org/gelmat/VolumetricFlowRate">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Rate at which a volume of fluid flows through a system, typically measured in ml/h or L/min. Used to characterize pump speeds and fluid delivery rates in synthesis processes.</rdfs:comment>
        <rdfs:label xml:lang="en">Volumetric Flow Rate</rdfs:label>
        <skos:definition xml:lang="en">A quantity representing the volume of fluid passing through a system per unit time</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetrePerSecond-Time"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/WashingCycle -->


    <owl:Class rdf:about="https://w3id.org/gelmat/WashingCycle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Individual iteration of solvent replacement during solvent exchange process</rdfs:comment>
        <rdfs:label xml:lang="en">Washing cycle</rdfs:label>
        <skos:definition xml:lang="en">A single iteration of solvent replacement within a solvent exchange procedure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Water -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Water">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:comment xml:lang="en">Water (H2O), used as a reactant in hydrolysis reactions during sol-gel synthesis and as the liquid phase in hydrogels</rdfs:comment>
        <rdfs:label xml:lang="en">Water</rdfs:label>
        <skos:definition xml:lang="en">The chemical substance H2O, serving as a reactant in hydrolysis reactions and as the pore liquid in hydrogels</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/WaterToSilicaRatio -->


    <owl:Class rdf:about="https://w3id.org/gelmat/WaterToSilicaRatio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MolarRatio"/>
        <rdfs:comment xml:lang="en">The molar ratio of water to silicon alkoxide precursor (r = [H2O]/[Si]) used in sol preparation. Controls degree of hydrolysis; r &lt; 4 gives incomplete hydrolysis for TEOS; higher r values favour fully hydrolysed sols</rdfs:comment>
        <rdfs:label xml:lang="en">Water-to-silica ratio</rdfs:label>
        <skos:altLabel xml:lang="en">H2O:Si ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">r-ratio</skos:altLabel>
        <skos:definition xml:lang="en">The molar ratio r = [H2O]/[Si] of water to silicon alkoxide precursor; governs the completeness of hydrolysis. Stoichiometric full hydrolysis of TEOS requires r = 4; r &lt; 4 yields partially hydrolysed species; r &gt;&gt; 4 produces fully hydrolysed, more condensed networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/WetGel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/WetGel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:comment xml:lang="en">A gel containing liquid within its porous network structure, formed after gelation and before drying. The liquid phase determines the specific type (hydrogel if water, alcogel if alcohol).</rdfs:comment>
        <rdfs:label xml:lang="en">Wet gel</rdfs:label>
        <skos:definition xml:lang="en">A gel whose pore network is filled with a liquid phase, existing after gelation and before drying</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/XPSAnalysis -->


    <owl:Class rdf:about="https://w3id.org/gelmat/XPSAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/XRayDiffraction -->


    <owl:Class rdf:about="https://w3id.org/gelmat/XRayDiffraction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/Xerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/Xerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/Gel"/>
        <rdfs:comment xml:lang="en">A dried gel with a collapsed or partially collapsed pore structure, formed when a wet gel is dried under ambient conditions causing capillary forces to shrink the network</rdfs:comment>
        <rdfs:label xml:lang="en">Xerogel</rdfs:label>
        <skos:definition xml:lang="en">A dried gel formed when a wet gel is dried under ambient conditions; capillary forces during liquid evaporation partially or fully collapse the pore network, resulting in a denser material than the corresponding aerogel</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/YoungsModulus -->


    <owl:Class rdf:about="https://w3id.org/gelmat/YoungsModulus">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity"/>
        <rdfs:comment xml:lang="en">The ratio of tensile (or uniaxial) stress to axial strain in the linear-elastic region of the stress-strain curve, expressed in Pa. Characterises the intrinsic stiffness of the aerogel solid network; typically 10^4-10^7 Pa for silica aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Young&apos;s modulus</rdfs:label>
        <skos:altLabel xml:lang="en">Elastic modulus</skos:altLabel>
        <skos:altLabel xml:lang="en">Modulus of elasticity</skos:altLabel>
        <skos:definition xml:lang="en">The elastic modulus relating uniaxial stress to axial strain in the linear-elastic regime; equal to the slope of the initial linear portion of the stress-strain curve</skos:definition>
        <hasCanonicalUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/pascal"/>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ZirconiaAerogel -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ZirconiaAerogel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalOxideAerogel"/>
        <rdfs:comment xml:lang="en">An aerogel with a ZrO2 network, typically from zirconium n-propoxide or ZrOCl2/epoxide routes; used in catalysis and high-temperature insulation</rdfs:comment>
        <rdfs:label xml:lang="en">Zirconia aerogel</rdfs:label>
        <skos:altLabel xml:lang="en">ZrO2 aerogel</skos:altLabel>
        <skos:definition xml:lang="en">A metal oxide aerogel whose solid framework consists of zirconium dioxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/gelmat/ZirconiumPropoxide -->


    <owl:Class rdf:about="https://w3id.org/gelmat/ZirconiumPropoxide">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/MetalAlkoxide"/>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ATRPPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/ATRPPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/RadicalPolymerisation"/>
        <rdfs:comment xml:lang="en">A living polymerisation process where the chain initiation and chain propagation steps are atom transfer radical addition reactions. Often the atom transfer involves a radical halogen atom and the reaction is catalysed by a transition metal species
(http://purl.obolibrary.org/obo/MOP_0000684)</rdfs:comment>
        <rdfs:label xml:lang="en">Atom transfer radical polymerisation</rdfs:label>
        <skos:altLabel xml:lang="en">ATRP polymerisation</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Analysis -->


    <owl:Class rdf:about="https://w3id.org/polymat/Analysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Method"/>
        <rdfs:comment xml:lang="en">An act of determining the physical properties or chemical composition of an object</rdfs:comment>
        <rdfs:label xml:lang="en">Analysis</rdfs:label>
        <skos:closeMatch rdf:resource="http://emmo.info/emmo#EMMO_46fdcb50"/>
        <skos:closeMatch rdf:resource="https://w3id.org/pmd/co/MeasurementProcess"/>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/AnionicPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/AnionicPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ChainGrowthPolymerisation"/>
        <rdfs:comment xml:lang="en">An ionic polymerisation in which the active centers are anionic
(http://purl.obolibrary.org/obo/MOP_0000636)</rdfs:comment>
        <rdfs:label xml:lang="en">Anionic polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/AnnotatedData -->


    <owl:Class rdf:about="https://w3id.org/polymat/AnnotatedData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Experimental data with additional information or labels assigned to them</rdfs:comment>
        <rdfs:label xml:lang="en">Annotated data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Apparatus -->


    <owl:Class rdf:about="https://w3id.org/polymat/Apparatus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Device"/>
        <rdfs:comment xml:lang="en">A thing designed to carry out a particular task or activity during experiment (e.g. containing a chemical reaction, measuring liquids), not plugged into an electrical source, not a machine</rdfs:comment>
        <rdfs:label xml:lang="en">Apparatus</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Arithmetic -->


    <owl:Class rdf:about="https://w3id.org/polymat/Arithmetic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Calculation"/>
        <rdfs:comment xml:lang="en">Calculations involving the traditional operations on numbers (addition, subtraction, multiplication, division, exponentiation, extraction of roots).</rdfs:comment>
        <rdfs:label xml:lang="en">Arithmetic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/AtomicForceMicroscope -->


    <owl:Class rdf:about="https://w3id.org/polymat/AtomicForceMicroscope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Microscope"/>
        <rdfs:comment xml:lang="en">A microscope which uses a sharp spike tip mounted on the end of a cantilever to scan the surface of the specimen; an image of the surface is obtained by mechanically moving the probe in a raster scan of the specimen, line by line, and recording the force experienced by the tip as a function of position; a feedback loop is used to maintain a fixed relationship between the tip and surface during scanning
(http://purl.obolibrary.org/obo/CHMO_0000954)</rdfs:comment>
        <rdfs:comment xml:lang="en">A scanning probe microscope that has nanometer resolution. It consists of a microscale cantilever, a laser, an array of photodiodes and a detection system
(http://purl.obolibrary.org/obo/NCIT_C78804)</rdfs:comment>
        <rdfs:label xml:lang="en">Atomic force microscope</rdfs:label>
        <skos:altLabel xml:lang="en">AFM</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Author -->


    <owl:Class rdf:about="https://w3id.org/polymat/Author">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The originator or creator of a work</rdfs:comment>
        <rdfs:label xml:lang="en">Author</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/BlockCopolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/BlockCopolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Copolymer"/>
        <rdfs:comment xml:lang="en">A polymer which is composed of two or more blocks of homopolymers in a linear sequence.
(http://purl.obolibrary.org/obo/CHEBI_53511)</rdfs:comment>
        <rdfs:label xml:lang="en">Block copolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/BoilingPoint -->


    <owl:Class rdf:about="https://w3id.org/polymat/BoilingPoint">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature"/>
        <rdfs:comment xml:lang="en">The temperature at which a liquid experiences a phase transition or aggregation state change into the gas phase</rdfs:comment>
        <rdfs:label xml:lang="en">Boiling point</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Building -->


    <owl:Class rdf:about="https://w3id.org/polymat/Building">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PhysicalLocation"/>
        <rdfs:comment xml:lang="en">An enclosed construction with walls and roof</rdfs:comment>
        <rdfs:label xml:lang="en">Building</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Calculation -->


    <owl:Class rdf:about="https://w3id.org/polymat/Calculation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">The process of finding an amount or number using mathematics.</rdfs:comment>
        <rdfs:label xml:lang="en">Calculation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Catalyst -->


    <owl:Class rdf:about="https://w3id.org/polymat/Catalyst">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A substance that increases the rate of a chemical reaction without itself undergoing any permanent chemical change</rdfs:comment>
        <rdfs:label xml:lang="en">Catalyst</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CationicPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/CationicPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ChainGrowthPolymerisation"/>
        <rdfs:comment xml:lang="en">An ionic polymerisation in which the active centers are cationic
(http://purl.obolibrary.org/obo/MOP_0000638)</rdfs:comment>
        <rdfs:label xml:lang="en">Cationic polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CharacteristicPeakValueOfEDXSpectrum -->


    <owl:Class rdf:about="https://w3id.org/polymat/CharacteristicPeakValueOfEDXSpectrum">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Peak value in an EDX spectrum that is unique for a chemical substance</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic peak value of EDX spectrum</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CharacteristicPeakValueOfFTIRSpectrum -->


    <owl:Class rdf:about="https://w3id.org/polymat/CharacteristicPeakValueOfFTIRSpectrum">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Peak value in an FTIR spectrum that is unique for a chemical substance</rdfs:comment>
        <rdfs:label xml:lang="en">Characteristic peak value of FTIR spectrum</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ChemicalAnalysis -->


    <owl:Class rdf:about="https://w3id.org/polymat/ChemicalAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">The process of identifying, separating and quantifying the components of a sample to understand its nature and composition.
(https://www.studysmarter.co.uk/explanations/chemistry/chemical-analysis/e)</rdfs:comment>
        <rdfs:label xml:lang="en">Chemical analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Clerk -->


    <owl:Class rdf:about="https://w3id.org/polymat/Clerk">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A person who serves clients performing laboratory duties</rdfs:comment>
        <rdfs:label xml:lang="en">Clerk</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Client -->


    <owl:Class rdf:about="https://w3id.org/polymat/Client">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A person who receives or buys laboratory service</rdfs:comment>
        <rdfs:label xml:lang="en">Client</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Coating -->


    <owl:Class rdf:about="https://w3id.org/polymat/Coating">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Applying a covering to the surface of an object (usually referred to as the substrate)</rdfs:comment>
        <rdfs:label xml:lang="en">Coating</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ComputationalModel -->


    <owl:Class rdf:about="https://w3id.org/polymat/ComputationalModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Procedure"/>
        <rdfs:comment xml:lang="en">The use of computers to simulate and study a complex system or a procedure</rdfs:comment>
        <rdfs:label xml:lang="en">Computational model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Computer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Computer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Device"/>
        <rdfs:comment xml:lang="en">An electronic device used to process information that can be stored in the form of numbers or a continuous signal</rdfs:comment>
        <rdfs:label xml:lang="en">Computer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CoordinationPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/CoordinationPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ChainGrowthPolymerisation"/>
        <rdfs:comment xml:lang="en">A form of polymerisation that is catalyzed by transition metal salts and complexes
(https://en.wikipedia.org/wiki/Coordination_polymerization)</rdfs:comment>
        <rdfs:label xml:lang="en">Coordination polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Copolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Copolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polymer"/>
        <rdfs:comment xml:lang="en">A polymer composed of macromolecules that are derived from two or more species of monomer
(http://purl.obolibrary.org/obo/CHEBI_60804)
(http://purl.obolibrary.org/obo/CHEBI_53310)</rdfs:comment>
        <rdfs:label xml:lang="en">Copolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CouplingReactionPolycondensation -->


    <owl:Class rdf:about="https://w3id.org/polymat/CouplingReactionPolycondensation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polycondensation"/>
        <rdfs:comment xml:lang="en">A polycondensation enabled by coupling reactions, formation of new carbon-carbon bonds catalysed by metal complexes</rdfs:comment>
        <rdfs:label xml:lang="en">Coupling reaction polycondensation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/CrystallizationTemperature -->


    <owl:Class rdf:about="https://w3id.org/polymat/CrystallizationTemperature">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature"/>
        <rdfs:comment xml:lang="en">A factor which influences the formation of a crystal (highly ordered structure of atoms, ions, or molecules) from a liquid o more rarely directly from gas
(https://en.wikipedia.org/wiki/Crystallization)</rdfs:comment>
        <rdfs:label xml:lang="en">Crystallization temperature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DataFormat -->


    <owl:Class rdf:about="https://w3id.org/polymat/DataFormat">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">The definition of the structure of data within a database or file system that gives the information its meaning
(https://c3.ai/glossary/features/data-format/)</rdfs:comment>
        <rdfs:label xml:lang="en">Data format</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DataRepository -->


    <owl:Class rdf:about="https://w3id.org/polymat/DataRepository">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DigitalLocation"/>
        <rdfs:comment xml:lang="en">A space or location where data is stored</rdfs:comment>
        <rdfs:label xml:lang="en">Data repository</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DataType -->


    <owl:Class rdf:about="https://w3id.org/polymat/DataType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Feature"/>
        <rdfs:comment xml:lang="en">specific category of data</rdfs:comment>
        <rdfs:label xml:lang="en">Data type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Device -->


    <owl:Class rdf:about="https://w3id.org/polymat/Device">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">A physical thing made to fulfill a specific purpose</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DifferentialScanningCalorimeter -->


    <owl:Class rdf:about="https://w3id.org/polymat/DifferentialScanningCalorimeter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/ThermodynamicTestEquipment"/>
        <rdfs:comment xml:lang="en">A piece of equipment that is used to measure the heat of chemical reactions or physical changes for both a sample and a reference
(http://purl.obolibrary.org/obo/CHMO_0002200)</rdfs:comment>
        <rdfs:label xml:lang="en">Differential scanning calorimeter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DiffusionCoefficient -->


    <owl:Class rdf:about="https://w3id.org/polymat/DiffusionCoefficient">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The proportionality constant between the molar flux of dissolved species (number of moles per unit time per unit area) due to diffusion and the negative value of the gradient in the concentration of the species
(https://en.wikipedia.org/wiki/Mass_diffusivity)</rdfs:comment>
        <rdfs:label xml:lang="en">Diffusion coefficient</rdfs:label>
        <skos:altLabel xml:lang="en">Diffusivity</skos:altLabel>
        <skos:altLabel xml:lang="en">Mass diffusivity</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DigitalData -->


    <owl:Class rdf:about="https://w3id.org/polymat/DigitalData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data that exist in digital environments, e.g. digital files</rdfs:comment>
        <rdfs:label xml:lang="en">Digital data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/DigitalLocation -->


    <owl:Class rdf:about="https://w3id.org/polymat/DigitalLocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Location"/>
        <rdfs:comment xml:lang="en">An electronic location used for communication between computer systems</rdfs:comment>
        <rdfs:label xml:lang="en">Digital location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Dissolving -->


    <owl:Class rdf:about="https://w3id.org/polymat/Dissolving">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Adding the object into a liquid and creating a homogeneous mixture (liquid in liquid = diluting, solid in liquid = dissolving)</rdfs:comment>
        <rdfs:label xml:lang="en">Dissolving</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Document -->


    <owl:Class rdf:about="https://w3id.org/polymat/Document">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Object"/>
        <rdfs:comment xml:lang="en">Records providing information or evidence of a process, an event or a subject that serves as an authority or for reference</rdfs:comment>
        <rdfs:label xml:lang="en">Document</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Downsizing -->


    <owl:Class rdf:about="https://w3id.org/polymat/Downsizing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">Reducing in volume and weight</rdfs:comment>
        <rdfs:label xml:lang="en">Downsizing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Drying -->


    <owl:Class rdf:about="https://w3id.org/polymat/Drying">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/SamplePreparation"/>
        <rdfs:comment xml:lang="en">A mass transfer process consisting of the removal of water or another solvent by evaporation from a solid, semi-solid or liquid
(https://en.wikipedia.org/wiki/Drying)</rdfs:comment>
        <rdfs:label xml:lang="en">Drying</rdfs:label>
        <skos:definition xml:lang="en">The final step of aerogel synthesis in which the pore liquid is removed from the wet gel while preserving the porous network structure; route determines whether the product is an aerogel (structure preserved) or xerogel (structure collapsed)</skos:definition>
        <hasStepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger">5</hasStepOrder>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ELN -->


    <owl:Class rdf:about="https://w3id.org/polymat/ELN">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A computer software developed to replace paper laboratory notebooks to help document experiments</rdfs:comment>
        <rdfs:label xml:lang="en">ELN</rdfs:label>
        <rdfs:label xml:lang="en">Electronic Laboratory Notebook</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ELNRecords -->


    <owl:Class rdf:about="https://w3id.org/polymat/ELNRecords">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">Digital and organised documentation of laboratory activities and data within an Electronic Laboratory Notebook (ELN) system</rdfs:comment>
        <rdfs:label xml:lang="en">ELN records</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Elastomer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Elastomer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Plastic"/>
        <rdfs:comment xml:lang="en">A polymer that displays rubber-like elasticity
(https://goldbook.iupac.org/terms/view/ET07547)</rdfs:comment>
        <rdfs:label xml:lang="en">Elastomer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ElectricTestingEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/ElectricTestingEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment that applies a voltage or current to a sample for analysis</rdfs:comment>
        <rdfs:label xml:lang="en">Electric testing equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/EnvelopeProduction -->


    <owl:Class rdf:about="https://w3id.org/polymat/EnvelopeProduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">Preparation of an envelope (pocket), two membrane sheets separated by a highly porous support
(https://en.wikipedia.org/wiki/Membrane_technology)</rdfs:comment>
        <rdfs:label xml:lang="en">Envelope production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Equipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/Equipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Device"/>
        <owl:disjointWith rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A set of instruments and other elements (e.g. tools) designed to perform a certain activity, powered by electricity, in a stand-alone setup</rdfs:comment>
        <rdfs:label xml:lang="en">Equipment</rdfs:label>
        <skos:closeMatch rdf:resource="http://emmo.info/emmo#EMMO_429db5b5"/>
        <skos:closeMatch rdf:resource="https://w3id.org/pmd/co/MeasurementDevice"/>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ErlenmeyerFlask -->


    <owl:Class rdf:about="https://w3id.org/polymat/ErlenmeyerFlask">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Apparatus"/>
        <rdfs:comment xml:lang="en">A type of laboratory flask (with a flat bottom, a conical body, and a cylindrical neck) used to contain liquids and for liquid handling processes</rdfs:comment>
        <rdfs:label xml:lang="en">Erlenmeyer flask</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Experiment -->


    <owl:Class rdf:about="https://w3id.org/polymat/Experiment">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">A process in which hypothesis is tested in a controllable environment or a collection of quantitative data that describes a property of an entity or event.</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ExperimentRequestSubmission -->


    <owl:Class rdf:about="https://w3id.org/polymat/ExperimentRequestSubmission">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">A process of requesting for an experiment to be performed.</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment request submission</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FOSSSoftware -->


    <owl:Class rdf:about="https://w3id.org/polymat/FOSSSoftware">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A computer software considered both free software and open-source software</rdfs:comment>
        <rdfs:label xml:lang="en">FOSS software</rdfs:label>
        <rdfs:label xml:lang="en">Free and open-source software</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FTIRSpectrometer -->


    <owl:Class rdf:about="https://w3id.org/polymat/FTIRSpectrometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Spectrometer"/>
        <rdfs:comment xml:lang="en">Equipment consisting of an infrared laser, an interferometer and a detector, which is used to measure spectra in the infrared range; the spectrometer measures the amount of infrared radiation not absorbed by the sample, and the application of a Fourier transform converts the resulting time domain digital signal into a frequency domain digital signal
(http://purl.obolibrary.org/obo/CHMO_0001823)</rdfs:comment>
        <rdfs:label xml:lang="en">Fourier-transformed infrared spectrometer</rdfs:label>
        <skos:altLabel xml:lang="en">FTIR spectrometer</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Feature -->


    <owl:Class rdf:about="https://w3id.org/polymat/Feature">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <rdfs:comment xml:lang="en">A distinctive attribute or aspect of something,</rdfs:comment>
        <rdfs:label xml:lang="en">Feature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Feed -->


    <owl:Class rdf:about="https://w3id.org/polymat/Feed">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The substance that is directed into the membrane for filtration</rdfs:comment>
        <rdfs:label xml:lang="en">Feed</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Fitting -->


    <owl:Class rdf:about="https://w3id.org/polymat/Fitting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Calculation"/>
        <rdfs:comment xml:lang="en">A process of choosing value for parameters in a mathematical function to best describe a set of data.</rdfs:comment>
        <rdfs:label xml:lang="en">Fitting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatSheetEnvelopeModule -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatSheetEnvelopeModule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Module"/>
        <rdfs:comment xml:lang="en">Assembly of envelopes (pockets), each containing two membrane sheets separated by a highly porous support; in a module several such envelopes are wound around a tube to create a tangential flow geometry and to reduce membrane fouling
(https://en.wikipedia.org/wiki/Membrane_technology)</rdfs:comment>
        <rdfs:label xml:lang="en">Flat sheet envelope module</rdfs:label>
        <skos:altLabel xml:lang="en">Flat sheet spiralwound module</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatSheetMembraneCasting -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatSheetMembraneCasting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembraneFabrication"/>
        <rdfs:comment xml:lang="en">Manual or machine preparation of a membrane by extending a polymer solution over a planar support followed by solvent evaporation or coagulation in a nonsolvent
(https://www.sciencedirect.com/topics/engineering/flat-sheet-membrane)</rdfs:comment>
        <rdfs:label xml:lang="en">Flat sheet membrane casting</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatSheetMembraneCoating -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatSheetMembraneCoating">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembraneFabrication"/>
        <rdfs:comment xml:lang="en">Adding a layer which delivers the desired membrane property (e.g., high selectivity)
(https://liqtech.com/ceramic-membranes-dpf/silicon-carbide-ceramic-membrane/what-does-the-membrane-coating-do/)</rdfs:comment>
        <rdfs:label xml:lang="en">Flat sheet membrane coating</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatSheetSpiralwoundModule -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatSheetSpiralwoundModule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Module"/>
        <rdfs:comment xml:lang="en">flat sheet spiral wound module = Flat sheet envelope module – assembly of envelopes (pockets), each containing two membrane sheets separated by a highly porous support. In a module several such envelopes are wound around a tube to create a tangential flow geometry and to reduce membrane fouling
(https://en.wikipedia.org/wiki/Membrane_technology)</rdfs:comment>
        <rdfs:label xml:lang="en">Flat sheet spiralwound module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatsheetMembraneCastingMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatsheetMembraneCastingMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">A machine to create flatsheet membranes by blade-casting a solution onto a, usually nonwoven, substrate</rdfs:comment>
        <rdfs:label xml:lang="en">Flatsheet membrane casting machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/FlatsheetMembraneCoatingMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/FlatsheetMembraneCoatingMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">A machine to coat an additional layer onto a flatsheet membrane by blade-casting a solution onto it</rdfs:comment>
        <rdfs:label xml:lang="en">Flatsheet membrane coating machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GasPermeationEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/GasPermeationEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure properties of the permeation of gases through membranes</rdfs:comment>
        <rdfs:label xml:lang="en">Gas permeation equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GasPermeationPressureIncreaseMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/GasPermeationPressureIncreaseMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/GasPermeationEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure gas permeation properties in membranes in dependence of the pressure of the feed gas</rdfs:comment>
        <rdfs:label xml:lang="en">Gas permeation pressure increase machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GasPermeationTimeLagMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/GasPermeationTimeLagMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/GasPermeationEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure gas permeation properties in membranes in dependence of time at constant feed gas pressure</rdfs:comment>
        <rdfs:label xml:lang="en">Gas permeation time lag machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GenericDevice -->


    <owl:Class rdf:about="https://w3id.org/polymat/GenericDevice">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Device"/>
        <rdfs:comment xml:lang="en">A concrete device identified by its function or type, without needing to specify a unique identifier or detailed characteristics (e.g., any thermometer used to measure temperature)</rdfs:comment>
        <rdfs:label xml:lang="en">Generic device</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GeoLocation -->


    <owl:Class rdf:about="https://w3id.org/polymat/GeoLocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PhysicalLocation"/>
        <rdfs:comment xml:lang="en">Geographic coordinates of something</rdfs:comment>
        <rdfs:label xml:lang="en">GeoLocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GlassTransitionTemperature -->


    <owl:Class rdf:about="https://w3id.org/polymat/GlassTransitionTemperature">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature"/>
        <rdfs:comment xml:lang="en">The gradual and reversible transition in amorphous materials (or in amorphous regions within semicrystalline materials) from a hard and relatively brittle glassy state into a viscous or rubbery state as the temperature is increased
(https://en.wikipedia.org/wiki/Glass_transition)</rdfs:comment>
        <rdfs:label xml:lang="en">Glass transition temperature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GradientCopolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/GradientCopolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Copolymer"/>
        <rdfs:comment xml:lang="en">A copolymer with a gradual change in monomer composition along the polymer chain from predominantly one species to predominantly the other, unlike with block copolymers, which have an abrupt change in composition
(https://en.wikipedia.org/wiki/Gradient_copolymer)</rdfs:comment>
        <rdfs:label xml:lang="en">Gradient copolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/GraftCopolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/GraftCopolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Copolymer"/>
        <rdfs:comment xml:lang="en">A special type of branched copolymer wherein the side chains are structurally distinct from the main chain
(https://en.wikipedia.org/wiki/Copolymer)</rdfs:comment>
        <rdfs:label xml:lang="en">Graft copolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/HollowFiberMembraneSpinning -->


    <owl:Class rdf:about="https://w3id.org/polymat/HollowFiberMembraneSpinning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembraneFabrication"/>
        <rdfs:comment xml:lang="en">Production of hollow fiber membranes by extrusion of polymer melt or solution through a spinneret 
(https://en.wikipedia.org/wiki/Hollow_fiber_membrane)</rdfs:comment>
        <rdfs:label xml:lang="en">Hollow fiber membrane spinning</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/HollowFibreMembraneSpinningEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/HollowFibreMembraneSpinningEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">A machine to create hollow fibre membranes by extruding a solution through one or multiple nozzles into a precipitation bath</rdfs:comment>
        <rdfs:label xml:lang="en">Hollow fibre membrane spinning equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/HollowFibreModule -->


    <owl:Class rdf:about="https://w3id.org/polymat/HollowFibreModule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Module"/>
        <rdfs:comment xml:lang="en">A bundle of hollow fibres packed in a pressure vessel, with the permeate passing either out of the fibers (bore-side feed) or into them (shell-side feed)
(https://www.sciencedirect.com/topics/engineering/hollow-fibre-module)</rdfs:comment>
        <rdfs:label xml:lang="en">Hollow fibre module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Homopolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Homopolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polymer"/>
        <rdfs:comment xml:lang="en">A polymer derived from identical monomer units
(http://materialsmine.org/ns/Homopolymer)</rdfs:comment>
        <rdfs:label xml:lang="en">Homopolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/HotPlate -->


    <owl:Class rdf:about="https://w3id.org/polymat/HotPlate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">An electric instrument that creates a hot surface</rdfs:comment>
        <rdfs:label xml:lang="en">Hot plate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ImageData -->


    <owl:Class rdf:about="https://w3id.org/polymat/ImageData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data produced by scanning a surface with an optical or electronic device; visual information in the form of pictures, graphics or photographs</rdfs:comment>
        <rdfs:label xml:lang="en">Image data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ImagingAFM -->


    <owl:Class rdf:about="https://w3id.org/polymat/ImagingAFM">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembraneMorphology"/>
        <rdfs:comment xml:lang="en">Scanning a surface with an atomic force microscope for obtaining the morphology and mechanical properties of a sample</rdfs:comment>
        <rdfs:label xml:lang="en">Imaging AFM</rdfs:label>
        <rdfs:label xml:lang="en">Imaging Atomic Force Microscopy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ImagingSEM -->


    <owl:Class rdf:about="https://w3id.org/polymat/ImagingSEM">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembraneMorphology"/>
        <rdfs:comment xml:lang="en">Obtaining the surface morphology and, in special cases, the chemical composition of a sample with a scanning electron microscope.</rdfs:comment>
        <rdfs:label xml:lang="en">Imaging SEM</rdfs:label>
        <rdfs:label xml:lang="en">Imaging Scanning Electron Microscopy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Inhibitor -->


    <owl:Class rdf:about="https://w3id.org/polymat/Inhibitor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A substance that decreases the rate of a chemical reaction without itself undergoing any permanent chemical change</rdfs:comment>
        <rdfs:label xml:lang="en">Inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/InhouseSoftware -->


    <owl:Class rdf:about="https://w3id.org/polymat/InhouseSoftware">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A computer software developed in-house with a given organisation by itself, often for internal use only</rdfs:comment>
        <rdfs:label xml:lang="en">Inhouse software</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Initiator -->


    <owl:Class rdf:about="https://w3id.org/polymat/Initiator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A substance that creates reactive species</rdfs:comment>
        <rdfs:label xml:lang="en">Initiator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/InputData -->


    <owl:Class rdf:about="https://w3id.org/polymat/InputData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data provided as input to a laboratory process, experiment, measurement or device to produce desired outcomes</rdfs:comment>
        <rdfs:label xml:lang="en">Input data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Instrument -->


    <owl:Class rdf:about="https://w3id.org/polymat/Instrument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Device"/>
        <rdfs:comment xml:lang="en">A device used to perform measurements or manipulate variables to monitor or control values of certain parameters, usually powered by electricity</rdfs:comment>
        <rdfs:label xml:lang="en">Instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Laboratory -->


    <owl:Class rdf:about="https://w3id.org/polymat/Laboratory">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PhysicalLocation"/>
        <rdfs:comment xml:lang="en">A place (a building, part of a building or other place) equipped for doing experiments (e.g. chemistry laboratory) or scientific tests (e.g. computer laboratory)</rdfs:comment>
        <rdfs:label xml:lang="en">Laboratory</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/LaboratoryNotebook -->


    <owl:Class rdf:about="https://w3id.org/polymat/LaboratoryNotebook">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">Complete records of laboratory research or experiment</rdfs:comment>
        <rdfs:label xml:lang="en">Laboratory Notebook</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Linux -->


    <owl:Class rdf:about="https://w3id.org/polymat/Linux">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/OperatingSystem"/>
        <rdfs:comment xml:lang="en">Family of Unix-like operating systems that use the Linux kernel and are open source
(https://www.wikidata.org/wiki/Q388)</rdfs:comment>
        <rdfs:label xml:lang="en">Linux</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/LiquidPermeationEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/LiquidPermeationEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure properties of the permeation of liquids through membranes</rdfs:comment>
        <rdfs:label xml:lang="en">Liquid permeation equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Location -->


    <owl:Class rdf:about="https://w3id.org/polymat/Location">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:comment xml:lang="en">A particular place where something happens or is situated (or exists)</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MacOS -->


    <owl:Class rdf:about="https://w3id.org/polymat/MacOS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/OperatingSystem"/>
        <rdfs:comment xml:lang="en">Operating system for Apple computers
(https://www.wikidata.org/wiki/Q14116)</rdfs:comment>
        <rdfs:label xml:lang="en">Mac OS</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Maintainer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Maintainer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A person who is trained to keep a given device in good condition or develop procedures to be performed using the device</rdfs:comment>
        <rdfs:label xml:lang="en">Maintainer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MassConcentration -->


    <owl:Class rdf:about="https://w3id.org/polymat/MassConcentration">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The mass of a solute per unit volume of a mixture
(http://purl.obolibrary.org/obo/NCIT_C179798)</rdfs:comment>
        <rdfs:label xml:lang="en">Mass concentration</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MeanDomainSize -->


    <owl:Class rdf:about="https://w3id.org/polymat/MeanDomainSize">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">Characteristic length of a locally defined, homogeneous volume in a material, a mean value of several measurements</rdfs:comment>
        <rdfs:label xml:lang="en">Mean domain size</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MeanPoreDiameter -->


    <owl:Class rdf:about="https://w3id.org/polymat/MeanPoreDiameter">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Length"/>
        <rdfs:comment xml:lang="en">Characteristic length of a locally defined hole in a membrane, a mean value of several measurements</rdfs:comment>
        <rdfs:label xml:lang="en">Mean pore diameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MechanicalTestingEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/MechanicalTestingEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure mechanical properties of a sample</rdfs:comment>
        <rdfs:label xml:lang="en">Mechanical testing equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MeltingTemperature -->


    <owl:Class rdf:about="https://w3id.org/polymat/MeltingTemperature">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature"/>
        <rdfs:comment xml:lang="en">The temperature at which a material changes from the solid phase to the liquid phase</rdfs:comment>
        <rdfs:label xml:lang="en">Melting temperature</rdfs:label>
        <skos:altLabel xml:lang="en">Melting point</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembraneChamber -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembraneChamber">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Apparatus"/>
        <rdfs:comment xml:lang="en">A chamber enclosing a membrane and directing the feed fluid to the membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane chamber</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembraneEnvelopeWeldingMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembraneEnvelopeWeldingMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment that connects different layers on the outside edge of a membrane envelope, i.e. membrane layers, spacer layers, cover layers, etc, by welding.</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane envelope welding machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembraneFabrication -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembraneFabrication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">Techniques for membrane preparation, e.g. casting, extrusion, interfacial polymerisation
(https://link.springer.com/chapter/10.1007/978-3-319-01095-3_4)</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane fabrication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembraneMorphology -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembraneMorphology">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">The shape as well as the external and internal structure of a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane morphology</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembranePerformanceForGases -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembranePerformanceForGases">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Filtration properties for a sustance in gases of a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane performance for gases</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MembranePerformanceForLiquids -->


    <owl:Class rdf:about="https://w3id.org/polymat/MembranePerformanceForLiquids">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">Filtration properties for substances in liquids of a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Membrane performance for liquids</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Metadata -->


    <owl:Class rdf:about="https://w3id.org/polymat/Metadata">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data that provides information about other data, e.g. describes characterististics or attributes of experimental data (such as the data source, units of measurements, data quality indicators)</rdfs:comment>
        <rdfs:label xml:lang="en">Metadata</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Method -->


    <owl:Class rdf:about="https://w3id.org/polymat/Method">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Procedure"/>
        <rdfs:comment xml:lang="en">A systematic procedure for accomplishing something (the-how)</rdfs:comment>
        <rdfs:label xml:lang="en">Method</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Microscope -->


    <owl:Class rdf:about="https://w3id.org/polymat/Microscope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">A piece of equipment which is used to generate an image of the surface of a specimen, whether by focusing reflected light onto where it can be collected or by scanning a given area of the surface
(http://purl.obolibrary.org/obo/CHMO_0000953)</rdfs:comment>
        <rdfs:comment xml:lang="en">An optical equipment that uses a combination of lenses to produce magnified images of very small objects
(http://purl.obolibrary.org/obo/NCIT_C50069)</rdfs:comment>
        <rdfs:comment xml:lang="en">Equipment which magnifies the view on objects under increased resolution
(http://purl.obolibrary.org/obo/OBI_0400169)</rdfs:comment>
        <rdfs:label xml:lang="en">Microscope</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MicrosoftWindows -->


    <owl:Class rdf:about="https://w3id.org/polymat/MicrosoftWindows">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/OperatingSystem"/>
        <rdfs:comment xml:lang="en">Family of computer operating systems developed by Microsoft
(https://www.wikidata.org/wiki/Q1406)</rdfs:comment>
        <rdfs:label xml:lang="en">Microsoft Windows</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Modelling -->


    <owl:Class rdf:about="https://w3id.org/polymat/Modelling">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Calculation"/>
        <rdfs:comment xml:lang="en">The activity of using mathematical models to predict certain values of parameters or make calculations.</rdfs:comment>
        <rdfs:label xml:lang="en">Modelling</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Module -->


    <owl:Class rdf:about="https://w3id.org/polymat/Module">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">Several membranes arranged sequentially in a container</rdfs:comment>
        <rdfs:label xml:lang="en">Module</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ModuleFabrication -->


    <owl:Class rdf:about="https://w3id.org/polymat/ModuleFabrication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">Arranging membranes into a unit with housing, feed inlet, concentrate outlet, and permeate outlet
(https://www.sciencedirect.com/topics/engineering/membrane-module)</rdfs:comment>
        <rdfs:label xml:lang="en">Module fabrication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ModuleQualityTestingEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/ModuleQualityTestingEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment that measures the performance of a membrane module in order to judge its quality</rdfs:comment>
        <rdfs:label xml:lang="en">Module quality testing equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MolarPermeability-Diffusion -->


    <owl:Class rdf:about="https://w3id.org/polymat/MolarPermeability-Diffusion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Permeability-Diffusion"/>
        <rdfs:comment xml:lang="en">The permeability multiplied by density and divided by molar mass of the permeating fluid

P* = V･d･rho / (A･t･p･M) = D･rho / (p･M)

P* = molar permeability (diffusion)
V = Volume of the permeate [m³]
rho = density of the permeate [kg/m³]
M = molar mass of the permeate [kg/mol]
d = thickness of the membrane [m]
A = area of the membrane [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit is mol/(m･s･atm)</rdfs:comment>
        <rdfs:label xml:lang="en">Molar permeability (diffusion)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MolecularWeightCutOff -->


    <owl:Class rdf:about="https://w3id.org/polymat/MolecularWeightCutOff">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForLiquids"/>
        <rdfs:comment xml:lang="en">Molecular weight cut-off (MWCO) - the molecular weight of the molecule that is 90% retained by the membrane
(https://en.wikipedia.org/wiki/Molecular_weight_cut-off)</rdfs:comment>
        <rdfs:label xml:lang="en">Molecular weight cut off</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/MolecularWeightCutOffSetup -->


    <owl:Class rdf:about="https://w3id.org/polymat/MolecularWeightCutOffSetup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/LiquidPermeationEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure the maximum size of a molecule that is permeating in a solution through a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Molecular weight cut off setup</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Monomer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Monomer">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">A chemical subunit, i.e. the molecule of a chemical substance, that can undergo polymerisation by bonding to other subunits and form a polymer
(http://purl.obolibrary.org/obo/NCIT_C63845)</rdfs:comment>
        <rdfs:label xml:lang="en">Monomer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/NMRSpectrometer -->


    <owl:Class rdf:about="https://w3id.org/polymat/NMRSpectrometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Spectrometer"/>
        <rdfs:comment xml:lang="en">A piece of equipment used to conduct nuclear magnetic resonance experiments consisting of a magnet housing a sample space surrounded by two coils which act to transmit radio frequency radiation to the sample and to detect the response of the sample
(http://purl.obolibrary.org/obo/CHMO_0001807)</rdfs:comment>
        <rdfs:comment xml:lang="en">Equipment used to analyze the molecular structure of a material by observing and measuring the interaction of nuclear spins when placed in a powerful magnetic field
(https://www.jeol.com/products/science/nmr.php)</rdfs:comment>
        <rdfs:label xml:lang="en">Nuclear magnetic resonance spectrometer</rdfs:label>
        <skos:altLabel xml:lang="en">NMR spectrometer</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/NominalMeasure -->


    <owl:Class rdf:about="https://w3id.org/polymat/NominalMeasure">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Measure"/>
        <rdfs:comment xml:lang="en">Combines a number to a unit of a result of an nominal value (theoretical or designated value used as a reference point) of a given quantity</rdfs:comment>
        <rdfs:label xml:lang="en">Nominal measure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/NumericData -->


    <owl:Class rdf:about="https://w3id.org/polymat/NumericData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data consisting of numerical values representing measurements or quantities</rdfs:comment>
        <rdfs:label xml:lang="en">Numeric data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Object -->


    <owl:Class rdf:about="https://w3id.org/polymat/Object">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:comment xml:lang="en">A thing to which a specific action is directed but not a person</rdfs:comment>
        <rdfs:label xml:lang="en">Object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ObservedParameter -->


    <owl:Class rdf:about="https://w3id.org/polymat/ObservedParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">Actual measurement or manifestation of a parameter - as a variable of a laboratory process or its elements, reflecting its value or characteristic as recorded or noted during the laboratory process</rdfs:comment>
        <rdfs:label xml:lang="en">Observed parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/OperatingSystem -->


    <owl:Class rdf:about="https://w3id.org/polymat/OperatingSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A software system that manages computer hardware and software resources and provides a platform for running applications</rdfs:comment>
        <rdfs:label xml:lang="en">Operating system</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/OpticalMicroscope -->


    <owl:Class rdf:about="https://w3id.org/polymat/OpticalMicroscope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Microscope"/>
        <rdfs:comment xml:lang="en">A  type of microscope that commonly uses visible light and a system of lenses to generate magnified images of small objects or structures
(https://en.wikipedia.org/wiki/Optical_microscope)</rdfs:comment>
        <rdfs:comment xml:lang="en">A microscope (device to magnify small objects) in which objects are lit directly by white light.
(http://purl.obolibrary.org/obo/NCIT_C28265)</rdfs:comment>
        <rdfs:comment xml:lang="en">A piece of equipment, consisting of an eyepiece, an objective lens, object turret, stage, and light source, which collects electromagnetic radiation in the visible range
(http://purl.obolibrary.org/obo/CHMO_0000947)</rdfs:comment>
        <rdfs:label xml:lang="en">Optical microscope</rdfs:label>
        <skos:altLabel xml:lang="en">Light microscope</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/OutputData -->


    <owl:Class rdf:about="https://w3id.org/polymat/OutputData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data generated by a device or produced as a result of a laboratory process, experiment, measurement, data analysis and other data tranformations</rdfs:comment>
        <rdfs:label xml:lang="en">Output data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Permeability-Diffusion -->


    <owl:Class rdf:about="https://w3id.org/polymat/Permeability-Diffusion">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">Describes the penetration of a permeate (a fluid such as a liquid, gas, or vapor) through a solid (such as a membrane); it is directly proportional the materials&apos; diffusion coefficient and inversly proportional to the concentration or pressure gradient of the permeate

P = V･d / (A･t･p) = D / p
P = permeability (diffusion)
V = Volume of the permeate [m³]
d = thickness of the membrane [m]
A = area of the membrane [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit of the permeability (diffusion) is m²/(s･atm); the proportional unit E-10･cm²/(s･Torr) is commonly called  Barrer.</rdfs:comment>
        <rdfs:label xml:lang="en">Permeability (diffusion)</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Permeate -->


    <owl:Class rdf:about="https://w3id.org/polymat/Permeate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The substance that passes through or penetrated the membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Permeate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Person -->


    <owl:Class rdf:about="https://w3id.org/polymat/Person">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <rdfs:comment xml:lang="en">An individual human being</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PersonalLocalHardDrive -->


    <owl:Class rdf:about="https://w3id.org/polymat/PersonalLocalHardDrive">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataRepository"/>
        <rdfs:comment xml:lang="en">A physical storage device directly connected to a personal computer that is used to store/manage digital data</rdfs:comment>
        <rdfs:label xml:lang="en">Personal local hard drive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PersonalServerDrive -->


    <owl:Class rdf:about="https://w3id.org/polymat/PersonalServerDrive">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataRepository"/>
        <rdfs:comment xml:lang="en">A storage device connected to a dedicated server that is used to host/manage digital data</rdfs:comment>
        <rdfs:label xml:lang="en">Personal server drive</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PhysicalData -->


    <owl:Class rdf:about="https://w3id.org/polymat/PhysicalData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data in the form of physical objects, e.g. paper files</rdfs:comment>
        <rdfs:label xml:lang="en">Physical data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PhysicalLocation -->


    <owl:Class rdf:about="https://w3id.org/polymat/PhysicalLocation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Location"/>
        <rdfs:comment xml:lang="en">A physical structure (e.g. building) or space (e.g. room) or place (e.g. geographical location)</rdfs:comment>
        <rdfs:label xml:lang="en">Physical location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Plastic -->


    <owl:Class rdf:about="https://w3id.org/polymat/Plastic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polymer"/>
        <rdfs:comment xml:lang="en">A synthetic or semi-synthetic material that use polymers as a main ingredient;  due to plasticity, it can be molded, extruded or pressed into solid objects of various shapes.
(https://en.wikipedia.org/wiki/Plastic)</rdfs:comment>
        <rdfs:label xml:lang="en">Plastic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Polyaddition -->


    <owl:Class rdf:about="https://w3id.org/polymat/Polyaddition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PolymerSynthesis"/>
        <rdfs:comment xml:lang="en">An all-degree polymerisation that proceeds by addition reactions
(http://purl.obolibrary.org/obo/MOP_0000643)

A polymerisation in which the growth of polymer chains proceeds by addition reactions between molecules of all degrees of polymerisation
(http://purl.obolibrary.org/obo/REX_0000266)</rdfs:comment>
        <rdfs:label xml:lang="en">Polyaddition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Polycondensation -->


    <owl:Class rdf:about="https://w3id.org/polymat/Polycondensation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PolymerSynthesis"/>
        <rdfs:comment xml:lang="en">An all-degree polymerisation that proceeds by condensation reactions
(http://purl.obolibrary.org/obo/MOP_0000644)

Polymerization by a repeated condensation process
(http://purl.obolibrary.org/obo/REX_0000252)

Formation of a polymer by chemical condensation with the elimination of small molecules, e.g. water
(https://www.dictionary.com/browse/polycondensation)</rdfs:comment>
        <rdfs:label xml:lang="en">Polycondensation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Polymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Polymer">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">A material made of long, macromolecular chains of repeating molecular units</rdfs:comment>
        <rdfs:comment xml:lang="en">A mixture, which is composed of macromolecules of different kinds and which may be differentiated by composition, length, degree of branching etc.
(http://purl.obolibrary.org/obo/CHEBI_60027)</rdfs:comment>
        <rdfs:comment xml:lang="en">A molecule composed of a connected set of monomeric residues
(http://semanticscience.org/resource/SIO_000314)</rdfs:comment>
        <rdfs:comment xml:lang="en">A substance or material consisting of very large molecules, or macromolecules, composed of many repeating subunits
(http://purl.obolibrary.org/obo/PROCO_0000054)</rdfs:comment>
        <rdfs:label xml:lang="en">Polymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PolymerBlend -->


    <owl:Class rdf:about="https://w3id.org/polymat/PolymerBlend">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polymer"/>
        <rdfs:comment xml:lang="en">A macroscopically homogeneous mixture of two or more polymers (homopolymers or copolymers) that have been blended together to create a new material with different physical properties
(https://www.mdpi.com/journal/materials/special_issues/polymer_blend)</rdfs:comment>
        <rdfs:label xml:lang="en">Polymer blend</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PolymerSynthesis -->


    <owl:Class rdf:about="https://w3id.org/polymat/PolymerSynthesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/CreationProcess"/>
        <rdfs:comment xml:lang="en">A chemical reaction in which monomers are joined together by covalent bonding to form polymer structures
(https://www.sigmaaldrich.com/DE/en/applications/materials-science-and-engineering/polymer-synthesis)</rdfs:comment>
        <rdfs:label xml:lang="en">Polymer synthesis</rdfs:label>
        <skos:altLabel xml:lang="en">Polymerisation</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/PressureIncrease -->


    <owl:Class rdf:about="https://w3id.org/polymat/PressureIncrease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForGases"/>
        <rdfs:comment xml:lang="en">Measuring the time until reaching a  certain permeate pressure during a gas permeability measurement on a membrane. For a single experiment, the feed pressure is set at the beginning and decreases over time due to permeatation.
(https://doi.org/10.3390/membranes9020022)</rdfs:comment>
        <rdfs:label xml:lang="en">Pressure increase</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Procedure -->


    <owl:Class rdf:about="https://w3id.org/polymat/Procedure">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">An executed procedure consisting of a set of activities carried out as the accepted way of doing something. This class denotes the occurrent that unfolds in time, not the recipe/plan that prescribes it — for the latter, see gmat:SynthesisProtocol. Axioms deliberately match Polymat 1.1.0 (BFO occurrent + prov:Entity) so that resolving the owl:imports of Polymat does not introduce conflicting redeclarations. Note: Procedure is placed under BFO occurrent (BFO_0000003) rather than BFO process (BFO_0000015) because Polymat maps BFO_0000015 to prov:Activity, which PROV-O declares disjoint from prov:Entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Procedure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ProcessedData -->


    <owl:Class rdf:about="https://w3id.org/polymat/ProcessedData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data derived from raw data through various transformations, calculations, filtering or other operations</rdfs:comment>
        <rdfs:label xml:lang="en">Processed data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Product -->


    <owl:Class rdf:about="https://w3id.org/polymat/Product">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A substance that results from a chemical reaction</rdfs:comment>
        <rdfs:label xml:lang="en">Product</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ProprietarySoftware -->


    <owl:Class rdf:about="https://w3id.org/polymat/ProprietarySoftware">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A (closed-source) computer software that is considered a property of its creators or owners and is distributed under licences that restrict access to its source code</rdfs:comment>
        <rdfs:label xml:lang="en">Proprietary software</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Protocol -->


    <owl:Class rdf:about="https://w3id.org/polymat/Protocol">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">An official or formal record of an experiment, procedure or process</rdfs:comment>
        <rdfs:label xml:lang="en">Protocol</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Publication -->


    <owl:Class rdf:about="https://w3id.org/polymat/Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">A book (or a part of it), report or a similar format that is published</rdfs:comment>
        <rdfs:label xml:lang="en">Publication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Pump -->


    <owl:Class rdf:about="https://w3id.org/polymat/Pump">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">An electric instrument that builds pressure to move a fluid</rdfs:comment>
        <rdfs:label xml:lang="en">Pump</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/RAFTPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/RAFTPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/RadicalPolymerisation"/>
        <rdfs:comment xml:lang="en">A type of living polymerisation involving a conventional radical polymerisation which is mediated by a RAFT agent (a thiocarbonylthio compound); this affords control over the generated molecular weight and polydispersity
(https://en.wikipedia.org/wiki/Reversible_addition%E2%88%92fragmentation_chain-transfer_polymerization)</rdfs:comment>
        <rdfs:label xml:lang="en">Reversible addition-fragmentation chain-transfer polymerisation</rdfs:label>
        <skos:altLabel xml:lang="en">RAFT polymerisation</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/RadicalPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/RadicalPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ChainGrowthPolymerisation"/>
        <rdfs:comment xml:lang="en">A chain polymerisation in which the active centers are radicals
(http://purl.obolibrary.org/obo/MOP_0000639)</rdfs:comment>
        <rdfs:label xml:lang="en">Radical polymerisation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/RandomCopolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/RandomCopolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Copolymer"/>
        <rdfs:comment xml:lang="en">A copolymer consisting of macromolecules in which the probability of finding a given monomeric unit at any given site in the chain is independent of the nature of the adjacent units
(https://goldbook.iupac.org/terms/view/R05126)</rdfs:comment>
        <rdfs:label xml:lang="en">Random copolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Reactant -->


    <owl:Class rdf:about="https://w3id.org/polymat/Reactant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A substance that is consumed in a chemical reaction</rdfs:comment>
        <rdfs:label xml:lang="en">Reactant</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Recipe -->


    <owl:Class rdf:about="https://w3id.org/polymat/Recipe">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">A specification of ingredients, proportions and methods necessary to produce an expected product</rdfs:comment>
        <rdfs:label xml:lang="en">Recipe</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Request -->


    <owl:Class rdf:about="https://w3id.org/polymat/Request">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Document"/>
        <rdfs:comment xml:lang="en">A document providing information about procedure (e.g. laboratory test) being requested for</rdfs:comment>
        <rdfs:label xml:lang="en">Request</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Result -->


    <owl:Class rdf:about="https://w3id.org/polymat/Result">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">The outcome or findings obtained from conducting an experiment, representing data, measurements, observations or conclusions from the laboratory procedure</rdfs:comment>
        <rdfs:label xml:lang="en">Result</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Retentate -->


    <owl:Class rdf:about="https://w3id.org/polymat/Retentate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">The substance that is retained by and not passing through a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Retentate</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Retention -->


    <owl:Class rdf:about="https://w3id.org/polymat/Retention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForLiquids"/>
        <rdfs:comment xml:lang="en">Withholding a substance by a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Retention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/RetentionTestSetup -->


    <owl:Class rdf:about="https://w3id.org/polymat/RetentionTestSetup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/LiquidPermeationEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure the retention of a certain molecule when permeating in a solution through a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Retention test setup</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Role -->


    <owl:Class rdf:about="https://w3id.org/polymat/Role">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Role"/>
        <rdfs:comment xml:lang="en">A purpose that something has or a function that something plays in a particular situation, under certain conditions, within a given process etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Room -->


    <owl:Class rdf:about="https://w3id.org/polymat/Room">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/PhysicalLocation"/>
        <rdfs:comment xml:lang="en">A portion of space inside of a building separated by walls or partitions from other parts</rdfs:comment>
        <rdfs:label xml:lang="en">Room</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/RuntimeEnvironment -->


    <owl:Class rdf:about="https://w3id.org/polymat/RuntimeEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Software"/>
        <rdfs:comment xml:lang="en">A piece of software that is designed to run other software</rdfs:comment>
        <rdfs:label xml:lang="en">Runtime environment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/SRMPPolymerisation -->


    <owl:Class rdf:about="https://w3id.org/polymat/SRMPPolymerisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/RadicalPolymerisation"/>
        <rdfs:comment xml:lang="en">A radical polymerisation method used to synthesize polymers with narrow molecular weight distributions and reactive end groups on each polymer chain; astabilized radical (e.g., TEMPO) is applied to control the molecular weight
(https://de.wikipedia.org/wiki/Stable_Free_Radical_Polymerization) (https://en.wikipedia.org/wiki/Radical_polymerization)</rdfs:comment>
        <rdfs:label xml:lang="en">Stable radical-mediated polymerisation</rdfs:label>
        <skos:altLabel xml:lang="en">SRMP polymerisation</skos:altLabel>
        <skos:altLabel xml:lang="en">Stable-free-radical-mediated  (SFRP) polymerisation</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Sample -->


    <owl:Class rdf:about="https://w3id.org/polymat/Sample">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">A small subset or portion of an object used to represent the whole of it</rdfs:comment>
        <rdfs:label xml:lang="en">Sample</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/SamplePreparation -->


    <owl:Class rdf:about="https://w3id.org/polymat/SamplePreparation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Method"/>
        <rdfs:comment xml:lang="en">An action of creating a sample or getting it ready for some procedure</rdfs:comment>
        <rdfs:label xml:lang="en">Sample preparation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ScanningElectronMicroscope -->


    <owl:Class rdf:about="https://w3id.org/polymat/ScanningElectronMicroscope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Microscope"/>
        <rdfs:comment xml:lang="en">A piece of equipment which is used to produce an enlarged image of a specimen by scanning a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage of 50–150 kV across the specimen under vacuum and measuring the interaction of the electrons with the specimen
(http://purl.obolibrary.org/obo/CHMO_0000941)</rdfs:comment>
        <rdfs:comment xml:lang="en">An electron microscope that scans the surface of a sample with a beam of electrons and detects the interaction of the electrons with the atoms on the surface to produce a topographical image of the sample
(http://purl.obolibrary.org/obo/NCIT_C78814)</rdfs:comment>
        <rdfs:label xml:lang="en">Scanning electron microscope</rdfs:label>
        <skos:altLabel xml:lang="en">SEM</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/SecondaryElectronDetector -->


    <owl:Class rdf:about="https://w3id.org/polymat/SecondaryElectronDetector">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">An instrument that absorbs and amplifies secondary electrons in an electron microscope</rdfs:comment>
        <rdfs:label xml:lang="en">Secondary electron detector</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/SecureData -->


    <owl:Class rdf:about="https://w3id.org/polymat/SecureData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/DataType"/>
        <rdfs:comment xml:lang="en">Data with sensitive or confidential content that needs to be protected from unauthorised access, loss, or alteration</rdfs:comment>
        <rdfs:label xml:lang="en">Secure data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Selectivity -->


    <owl:Class rdf:about="https://w3id.org/polymat/Selectivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForGases"/>
        <rdfs:comment xml:lang="en">The ratio of permeability of the relevant substances for a membrane, for example, in a binary gas separation it is the permeability ratio of two gases.
(https://en.wikipedia.org/wiki/Membrane_gas_separation#:~:text=The%20selectivity%20of%20a%20membrane,two%20gases%20in%20binary%20separation)</rdfs:comment>
        <rdfs:label xml:lang="en">Selectivity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Software -->


    <owl:Class rdf:about="https://w3id.org/polymat/Software">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Object"/>
        <rdfs:comment xml:lang="en">A set of instructions, data or programs used by a computer</rdfs:comment>
        <rdfs:label xml:lang="en">Software</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Solubility -->


    <owl:Class rdf:about="https://w3id.org/polymat/Solubility">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The ability of a substance, the solute, to form a solution with another substance, the solvent
(https://en.wikipedia.org/wiki/Solubility)</rdfs:comment>
        <rdfs:label xml:lang="en">Solubility</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Solute -->


    <owl:Class rdf:about="https://w3id.org/polymat/Solute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A solid or liquid that is dissolved homogeneously in a liquid</rdfs:comment>
        <rdfs:label xml:lang="en">Solute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Solvent -->


    <owl:Class rdf:about="https://w3id.org/polymat/Solvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A liquid (including water and ionic liquids) that is able to dissolve a solid or another liquid</rdfs:comment>
        <rdfs:label xml:lang="en">Solvent</rdfs:label>
        <skos:altLabel xml:lang="en">Organic solvent</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Specimen -->


    <owl:Class rdf:about="https://w3id.org/polymat/Specimen">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Substance"/>
        <rdfs:comment xml:lang="en">An individual object taken for study or analysis, representing a class of objects</rdfs:comment>
        <rdfs:label xml:lang="en">Specimen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Spectrometer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Spectrometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">A piece of equipment used to measure a spectrum
(http://purl.obolibrary.org/obo/CHMO_0001234)</rdfs:comment>
        <rdfs:comment xml:lang="en">A type of analytical equipment used to measure certain physical properties such as energy, mass and wavelength via the dispersion of radiant energy or particles into a spectrum
(http://purl.obolibrary.org/obo/NCIT_C62336)</rdfs:comment>
        <rdfs:comment xml:lang="en">Scientific equipment used to separate and measure spectral components of a physical phenomenon; the primary application is the determination of chemical composition
(https://en.wikipedia.org/wiki/Spectrometer)</rdfs:comment>
        <rdfs:label xml:lang="en">Spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Stress -->


    <owl:Class rdf:about="https://w3id.org/polymat/Stress">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">A measure of the forces acting on an object during deformation
(https://en.wikipedia.org/wiki/Stress_(mechanics))

Equivalent to om:Stress, which Gelmat declares locally as the parent of om:CompressiveStress and gmat:FlexuralStrength; the equivalence keeps the Polymat and OM stress hierarchies merged under one concept</rdfs:comment>
        <rdfs:label xml:lang="en">Stress</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Substance -->


    <owl:Class rdf:about="https://w3id.org/polymat/Substance">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">A physical material with particular properties</rdfs:comment>
        <rdfs:label xml:lang="en">Substance</rdfs:label>
        <skos:altLabel xml:lang="en">Compound</skos:altLabel>
        <skos:altLabel xml:lang="en">Matter</skos:altLabel>
        <skos:exactMatch rdf:resource="https://w3id.org/pmd/co/Material"/>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/TargetConcentration -->


    <owl:Class rdf:about="https://w3id.org/polymat/TargetConcentration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/gelmat/ProcessParameter"/>
        <rdfs:comment xml:lang="en">A designed or nominal concentration for a reagent in a synthesis, as distinct from the achieved concentration. Deviations arise from weighing or volumetric uncertainties</rdfs:comment>
        <rdfs:label xml:lang="en">Target concentration</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/TensileTest -->


    <owl:Class rdf:about="https://w3id.org/polymat/TensileTest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Analysis"/>
        <rdfs:comment xml:lang="en">A standardized materials science and engineering method in which a solid sample is subjected to a controlled tension until failure; properties that are directly measured via a tensile test are ultimate tensile strength, breaking strength, maximum elongation, and reduction in area; from these measurements the following properties can also be determined: Young&apos;s modulus (modulus of elasticity), Poisson&apos;s ratio, yield strength, and strain-hardening characteristics
(https://en.wikipedia.org/wiki/Tensile_testing)</rdfs:comment>
        <rdfs:label xml:lang="en">Tensile test</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/TensileTestMachine -->


    <owl:Class rdf:about="https://w3id.org/polymat/TensileTestMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MechanicalTestingEquipment"/>
        <rdfs:comment xml:lang="en">Equipment for carrying out standardized tensile tests on a solid sample to determine its mechanical properties
(https://en.wikipedia.org/wiki/Tensile_testing#Equipment)</rdfs:comment>
        <rdfs:label xml:lang="en">Universal testing machine</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Terpolymer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Terpolymer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Polymer"/>
        <rdfs:comment xml:lang="en">A polymer that results from copolymerization of three discrete monomers
(https://www.merriam-webster.com/dictionary/terpolymer)</rdfs:comment>
        <rdfs:label xml:lang="en">Terpolymer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ThermodynamicTestEquipment -->


    <owl:Class rdf:about="https://w3id.org/polymat/ThermodynamicTestEquipment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Equipment"/>
        <rdfs:comment xml:lang="en">Equipment for measurement of physical parameters (e.g., temperature, heat energy) in thermodynamic systems (isolated, closed, or open)
(https://en.wikipedia.org/wiki/Thermodynamic_instruments) (https://en.wikipedia.org/wiki/Thermodynamic_system)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermodynamic test equipment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ThermogravimetricAnalyzer -->


    <owl:Class rdf:about="https://w3id.org/polymat/ThermogravimetricAnalyzer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/ThermodynamicTestEquipment"/>
        <rdfs:comment xml:lang="en">A piece of equipment, consisting of a quartz or alumina chamber, a balance, a sample pan and a heating mechanism, which is used to record the mass of a sample as a function of increasing temperature
(http://purl.obolibrary.org/obo/CHMO_0002121)</rdfs:comment>
        <rdfs:comment xml:lang="en">Equipment for thermogravimetric analysis (TGA) in which the mass of a sample is measured over time as the temperature changes; it provides information about physical phenomena, such as phase transitions, absorption, adsorption and desorption; as well as chemical phenomena including chemisorption, thermal decomposition, and solid-gas reactions (e.g., oxidation or reduction)
(https://en.wikipedia.org/wiki/Thermogravimetric_analysis)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermogravimetric analyzer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Thermometer -->


    <owl:Class rdf:about="https://w3id.org/polymat/Thermometer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Instrument"/>
        <rdfs:comment xml:lang="en">An instrument that records and displays the temperature</rdfs:comment>
        <rdfs:label xml:lang="en">Thermometer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Thermoplastic -->


    <owl:Class rdf:about="https://w3id.org/polymat/Thermoplastic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Plastic"/>
        <rdfs:comment xml:lang="en">A plastic that can be deformed by heating in a certain temperature range (thermoplastic); this process is reversible and can be repeated as often as desired by cooling and reheating, as long as no thermal decomposition of the material occurs 
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermoplastic</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/Thermoset -->


    <owl:Class rdf:about="https://w3id.org/polymat/Thermoset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Plastic"/>
        <rdfs:comment xml:lang="en">A plastic that retains its state and shape after curing, the process is irreversible due to cross-linked polymer chains
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)</rdfs:comment>
        <rdfs:label xml:lang="en">Thermoset</rdfs:label>
        <skos:altLabel xml:lang="en">Duromer</skos:altLabel>
        <skos:altLabel xml:lang="en">Duroplast</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/TimeLag -->


    <owl:Class rdf:about="https://w3id.org/polymat/TimeLag">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForGases"/>
        <rdfs:comment xml:lang="en">A method commonly used to characterize gas separation membranes. It allows the determination of diffusion, permeability, and solubility coefficients from a single dynamic gas permeation experiment; for this experiment, a homogeneous membrane is exposed to a step increase in pressure at one side of the membrane (feed side) and the feed pressure remains constant, while the other side (permeate side) of the membrane remains under vacuum; the diffusion and permeability coefficients are then determined from the resulting permeate pressure-time curve; the solubility coefficient is the permeability coefficient divided by the diffusion coefficient
(https://doi.org/10.1016/j.memsci.2020.118715)</rdfs:comment>
        <rdfs:label xml:lang="en">Time lag</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/TransmissionElectronMicroscope -->


    <owl:Class rdf:about="https://w3id.org/polymat/TransmissionElectronMicroscope">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Microscope"/>
        <rdfs:comment xml:lang="en">A piece of equipment which is used to produce an enlarged image of an electron transparent specimen using a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage of 50–150 kV under vacuum; the energies and intensities of the transmitted electrons are measured
(http://purl.obolibrary.org/obo/CHMO_0001099)</rdfs:comment>
        <rdfs:comment xml:lang="en">A type of microscope that uses magnetic lenses to transmit a beam of electrons through a thin sample; the electrons are then focused on a fluorescent screen or another detector to form an enlarged image
(https://www.photonics.com/EDU/transmission_electron_microscope_TEM/d7604)</rdfs:comment>
        <rdfs:comment xml:lang="en">An electron microscope that transmits a beam of electrons through a finely sliced section of a specimen and creates an image of the sample based on its effect on the phase of the electrons that pass through
(http://purl.obolibrary.org/obo/NCIT_C78813)</rdfs:comment>
        <rdfs:label xml:lang="en">Transmission electron microscope</rdfs:label>
        <skos:altLabel xml:lang="en">TEM</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/UltimateTensileStrength -->


    <owl:Class rdf:about="https://w3id.org/polymat/UltimateTensileStrength">
        <rdfs:subClassOf rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity"/>
        <rdfs:comment xml:lang="en">The maximum stress that a material can withstand while being stretched before breaking
(https://en.wikipedia.org/wiki/Ultimate_tensile_strength)</rdfs:comment>
        <rdfs:label xml:lang="en">Ultimate tensile strength</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/User -->


    <owl:Class rdf:about="https://w3id.org/polymat/User">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/Role"/>
        <rdfs:comment xml:lang="en">A person who is trained to use a specific device</rdfs:comment>
        <rdfs:label xml:lang="en">User</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/WaterFlux -->


    <owl:Class rdf:about="https://w3id.org/polymat/WaterFlux">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/MembranePerformanceForLiquids"/>
        <rdfs:comment xml:lang="en">The rate at which water permeates a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Water flux</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/WaterPermeabilitySetup -->


    <owl:Class rdf:about="https://w3id.org/polymat/WaterPermeabilitySetup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/LiquidPermeationEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure the permeability of water through a membrane</rdfs:comment>
        <rdfs:label xml:lang="en">Water permeability setup</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/ZetaPotentialSetup -->


    <owl:Class rdf:about="https://w3id.org/polymat/ZetaPotentialSetup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/ElectricTestingEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure Zeta potential (electrokinetic potential) in colloidal dispersions
(https://en.wikipedia.org/wiki/Zeta_potential)</rdfs:comment>
        <rdfs:label xml:lang="en">Zeta potential setup</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/polymat/4PointResistanceSetup -->


    <owl:Class rdf:about="https://w3id.org/polymat/4PointResistanceSetup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/polymat/ElectricTestingEquipment"/>
        <rdfs:comment xml:lang="en">Equipment to measure the electrical impedance by four-terminal sensing (4T sensing, 4-wire sensing, or 4-point probes method) technique that uses separate pairs of current-carrying and voltage-sensing electrodes to make more accurate measurements than the simpler and more usual two-terminal (2T) sensing
(https://en.wikipedia.org/wiki/Four-terminal_sensing)</rdfs:comment>
        <rdfs:label xml:lang="en">4-Point resistance setup</rdfs:label>
    </owl:Class>
    


