<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/gelmat/"
     xml:base="https://w3id.org/gelmat/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:gelmat="https://w3id.org/gelmat/"
     xmlns:polymat="https://w3id.org/polymat/"
     xmlns:ontology="http://omv.ontoware.org/2005/05/ontology#">
    <owl:Ontology rdf:about="https://w3id.org/gelmat/">
        <owl:versionIRI rdf:resource="https://w3id.org/gelmat/1.1.0"/>
        <owl:imports rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2"/>
        <owl:imports rdf:resource="https://w3id.org/polymat/"/>
        <ontology:designedForOntologyTask>knowledge representation in sol-gel materials synthesis, characterisation, and material properties</ontology:designedForOntologyTask>
        <ontology:usedOntologyEngineeringTool>https://www.isibang.ac.in/ns/mod/index.html#Protege</ontology:usedOntologyEngineeringTool>
        <terms:abstract>Gelmat is an ontology for sol-gel materials. It extends the Polymat domain ontology with classes for sol-gel synthesis processes, gel characterisation methods, drying routes, laboratory equipment, process parameters, and material properties. It enables semantic description and formal documentation of sol-gel and aerogel research workflows, covering silica, organosilica, organic, carbon, and composite sol-gel derived materials.</terms:abstract>
        <terms:author>Antoni Dudij, Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany</terms:author>
        <terms:author>Barbara Milow (https://orcid.org/0000-0002-6350-7728), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany</terms:author>
        <terms:author>Prakul Pandit (https://orcid.org/0000-0002-1343-3046), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany</terms:author>
        <terms:bibliographicCitation>Pandit, P., Dudij, A., &amp; Milow, B. (2026). Gelmat: An Ontology for Sol-Gel Materials (Version 1.1.0) [Data set]. Zenodo. https://doi.org/10.5281/zenodo.22915205</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-12</terms:created>
        <terms:license rdf:resource="https://spdx.org/licenses/CC-BY-NC-4.0.html"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-14</terms:modified>
        <terms:title>Gelmat: An Ontology for Sol-Gel Materials</terms:title>
        <vann:preferredNamespacePrefix>gmat</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/gelmat/</vann:preferredNamespaceUri>
        <rdfs:comment>Gelmat is an ontology for sol-gel materials. It extends the Polymat ontology (Dembska, Held, Schindler; DLR/Hereon) with classes for sol-gel synthesis routes, gel types, surface modification, drying methods, characterisation methods, process parameters, and material properties. Covers all major sol-gel derived material classes including silica, organosilica, organic, carbon, and composite aerogels.</rdfs:comment>
        <rdfs:label>Gelmat</rdfs:label>
        <owl:versionInfo>1.1.0</owl:versionInfo>
    </owl:Ontology>
    


