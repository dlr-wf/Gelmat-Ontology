    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/gelmat/APTES">
        <rdfs:comment xml:lang="en">(3-Aminopropyl)triethoxysilane (APTES, H2N(CH2)3Si(OC2H5)3), an amine-functional silica precursor and coupling agent; used for amine-modified aerogels (CO2 sorption) and for cross-linking with epoxies or isocyanates</rdfs:comment>
        <rdfs:label xml:lang="en">(3-Aminopropyl)triethoxysilane</rdfs:label>
        <skos:altLabel xml:lang="en">APTES</skos:altLabel>
        <skos:definition xml:lang="en">The amine-functional silicon alkoxide H2N(CH2)3Si(OC2H5)3, used as a co-precursor and coupling agent in sol-gel processing</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/AceticAcid">
        <rdfs:comment xml:lang="en">Acetic acid (CH3COOH), a weak carboxylic acid used as mild hydrolysis catalyst and chelating modifier in sol-gel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Acetic acid</rdfs:label>
        <skos:definition xml:lang="en">The carboxylic acid CH3COOH, used as a weak acid catalyst and chelating modifier in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15366"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Alginate">
        <rdfs:comment xml:lang="en">Alginate (usually sodium alginate from brown algae), ionically gelled with divalent cations (Ca2+) to form alginate bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Alginate</rdfs:label>
        <skos:altLabel xml:lang="en">Sodium alginate</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17548"/>
        <skos:definition xml:lang="en">The algal polysaccharide of mannuronic and guluronic acid units, ionically gelled to form bio-aerogels</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/AluminiumSecButoxide">
        <rdfs:comment xml:lang="en">Aluminium tri-sec-butoxide (Al(OsBu)3), the standard alkoxide precursor for alumina aerogels via the Yoldas route</rdfs:comment>
        <rdfs:label xml:lang="en">Aluminium sec-butoxide</rdfs:label>
        <skos:altLabel xml:lang="en">ASB</skos:altLabel>
        <skos:altLabel xml:lang="en">Aluminium tri-sec-butoxide</skos:altLabel>
        <skos:definition xml:lang="en">The aluminium alkoxide Al(OC4H9)3 (sec-butoxide ligands), used as a precursor for alumina gels</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Argon">
        <rdfs:comment xml:lang="en">Argon gas, an inert noble gas atmosphere for pyrolysis and other high-temperature treatments</rdfs:comment>
        <rdfs:label xml:lang="en">Argon</rdfs:label>
        <skos:altLabel xml:lang="en">Ar</skos:altLabel>
        <skos:definition xml:lang="en">The noble gas Ar, used as inert process atmosphere</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_49475"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/BTMSE">
        <rdfs:comment xml:lang="en">1,2-Bis(trimethoxysilyl)ethane (BTMSE), a bridged bis-silane precursor yielding ethylene-bridged polysilsesquioxane networks with enhanced flexibility and strength</rdfs:comment>
        <rdfs:label xml:lang="en">1,2-Bis(trimethoxysilyl)ethane</rdfs:label>
        <skos:altLabel xml:lang="en">BTME</skos:altLabel>
        <skos:altLabel xml:lang="en">BTMSE</skos:altLabel>
        <skos:definition xml:lang="en">A bridged silicon dialkoxide precursor, (CH3O)3Si-CH2CH2-Si(OCH3)3, that forms ethylene-bridged organosilica networks</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/CarbonDioxide">
        <rdfs:comment xml:lang="en">Carbon dioxide gas (CO2), used as physical activation agent for carbon aerogels and as sorption adsorbate; its supercritical state is modelled separately as gmat:SupercriticalCO2</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon dioxide</rdfs:label>
        <skos:altLabel xml:lang="en">CO2</skos:altLabel>
        <skos:definition xml:lang="en">The gas CO2; in the supercritical state (see gmat:SupercriticalCO2) the standard aerogel drying medium</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16526"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/CarbonNanotube">
        <rdfs:comment xml:lang="en">Single- or multi-walled carbon nanotubes used as conductive reinforcement in aerogel composites and as network formers of CNT aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Carbon nanotube</rdfs:label>
        <skos:altLabel xml:lang="en">CNT</skos:altLabel>
        <skos:definition xml:lang="en">A tubular carbon nanostructure used as conductive reinforcement or network former in aerogels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50594"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Cellulose">
        <rdfs:comment xml:lang="en">Cellulose, the beta-1,4-glucan biopolymer; dissolved-and-regenerated or used as nanocellulose to form cellulose bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Cellulose</rdfs:label>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18246"/>
        <skos:definition xml:lang="en">The polysaccharide (C6H10O5)n of beta-1,4-linked glucose units, used as a bio-aerogel precursor</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Chitosan">
        <rdfs:comment xml:lang="en">Chitosan, the deacetylated derivative of chitin; an amino-polysaccharide gelled by pH change or cross-linkers to form chitosan bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Chitosan</rdfs:label>
        <skos:definition xml:lang="en">The amino-polysaccharide obtained by deacetylation of chitin, used as a bio-aerogel precursor</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16261"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/CitricAcid">
        <rdfs:comment xml:lang="en">Citric acid, a tricarboxylic acid used as mild catalyst and chelating agent in sol-gel and bio-aerogel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Citric acid</rdfs:label>
        <skos:definition xml:lang="en">The tricarboxylic acid C6H8O7, used as a weak acid catalyst and chelating agent in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30769"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/DeionizedWater">
        <rdfs:comment xml:lang="en">Purified water with ions removed, used in aerogel synthesis to control reaction conditions and avoid contamination</rdfs:comment>
        <rdfs:label xml:lang="en">Deionized water</rdfs:label>
        <skos:definition xml:lang="en">Water from which dissolved ions have been removed, used to control reaction conditions and avoid ionic contamination</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/DifferentialScanningCalorimetry">
        <rdfs:comment xml:lang="en">Measurement of heat flow to or from a sample relative to a reference during a temperature programme; yields specific heat capacity, glass transitions, and phase change enthalpies; performed on a pmat:DifferentialScanningCalorimeter</rdfs:comment>
        <rdfs:label xml:lang="en">Differential scanning calorimetry</rdfs:label>
        <skos:altLabel xml:lang="en">DSC</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that measures differential heat flow between a sample and a reference as a function of temperature</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Dimethylformamide">
        <rdfs:comment xml:lang="en">N,N-Dimethylformamide (DMF), a polar aprotic solvent for polyimide and polyurethane aerogel synthesis, and a drying control chemical additive (DCCA) in silica sol-gel processing</rdfs:comment>
        <rdfs:label xml:lang="en">Dimethylformamide</rdfs:label>
        <skos:altLabel xml:lang="en">DMF</skos:altLabel>
        <skos:altLabel xml:lang="en">N,N-Dimethylformamide</skos:altLabel>
        <skos:definition xml:lang="en">The polar aprotic solvent HCON(CH3)2, used as reaction solvent for polymer aerogels and as a DCCA in silica sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17741"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/EDXAnalysis">
        <rdfs:comment xml:lang="en">Energy-dispersive X-ray spectroscopy performed in an electron microscope, mapping elemental composition of aerogel samples</rdfs:comment>
        <rdfs:label xml:lang="en">EDX analysis</rdfs:label>
        <skos:altLabel xml:lang="en">EDS</skos:altLabel>
        <skos:altLabel xml:lang="en">Energy-dispersive X-ray spectroscopy</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that determines elemental composition from characteristic X-rays excited by an electron beam</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Ethanol">
        <rdfs:comment xml:lang="en">A primary aliphatic alcohol (C2H5OH), volatile and miscible with water; widely used as a laboratory solvent and processing medium</rdfs:comment>
        <rdfs:label xml:lang="en">Ethanol</rdfs:label>
        <skos:definition xml:lang="en">The primary aliphatic alcohol C2H5OH, used as a solvent, reactant, and pore liquid in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16236"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/FTIRSpectroscopy">
        <rdfs:comment xml:lang="en">Fourier-transform infrared spectroscopy, used to verify siloxane network formation, silylation (Si-CH3 bands), and residual organics; performed on a pmat:FTIRSpectrometer (the device class already present in Polymat)</rdfs:comment>
        <rdfs:label xml:lang="en">FTIR spectroscopy</rdfs:label>
        <skos:altLabel xml:lang="en">FTIR</skos:altLabel>
        <skos:altLabel xml:lang="en">Infrared spectroscopy</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that records the infrared absorption spectrum of a sample by Fourier-transform interferometry</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Formaldehyde">
        <rdfs:comment xml:lang="en">Formaldehyde (HCHO, usually as aqueous formalin), the cross-linking aldehyde of resorcinol-formaldehyde, phenol-formaldehyde, and melamine-formaldehyde aerogel chemistries</rdfs:comment>
        <rdfs:label xml:lang="en">Formaldehyde</rdfs:label>
        <skos:definition xml:lang="en">The aldehyde HCHO, used as the condensation partner in phenolic and amino resin aerogel syntheses</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16842"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Formamide">
        <rdfs:comment xml:lang="en">Formamide (HCONH2), the classic drying control chemical additive (DCCA) that narrows the pore size distribution and reduces cracking during drying</rdfs:comment>
        <rdfs:label xml:lang="en">Formamide</rdfs:label>
        <skos:definition xml:lang="en">The amide HCONH2, used as a drying control chemical additive in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16397"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Furfural">
        <rdfs:comment xml:lang="en">Furfural, a biomass-derived aldehyde used in phenol-furfural and tannin-furfural organic and carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Furfural</rdfs:label>
        <skos:definition xml:lang="en">The furan aldehyde used as a bio-based condensation partner in organic aerogel syntheses</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_34768"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/GPTMS">
        <rdfs:comment xml:lang="en">(3-Glycidyloxypropyl)trimethoxysilane (GPTMS), an epoxy-functional silica precursor and coupling agent for organic-inorganic hybrid aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">(3-Glycidyloxypropyl)trimethoxysilane</rdfs:label>
        <skos:altLabel xml:lang="en">GLYMO</skos:altLabel>
        <skos:altLabel xml:lang="en">GPTMS</skos:altLabel>
        <skos:definition xml:lang="en">The epoxy-functional silicon alkoxide used as a coupling agent and hybrid network precursor in sol-gel processing</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Gelatin">
        <rdfs:comment xml:lang="en">Gelatin, the protein derived from collagen, thermally gelled to form protein-based bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Gelatin</rdfs:label>
        <skos:definition xml:lang="en">The collagen-derived protein used as a thermally gelling bio-aerogel precursor</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_5291"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Glycerol">
        <rdfs:comment xml:lang="en">Glycerol (glycerine), a triol used as drying control chemical additive (DCCA) and plasticiser in sol-gel and bio-aerogel processing</rdfs:comment>
        <rdfs:label xml:lang="en">Glycerol</rdfs:label>
        <skos:altLabel xml:lang="en">Glycerine</skos:altLabel>
        <skos:definition xml:lang="en">The triol C3H8O3, used as a drying control chemical additive and plasticiser</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17754"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/GrapheneOxide">
        <rdfs:comment xml:lang="en">Graphene oxide (GO) sheets, used as reinforcement and functional filler, and as the precursor of reduced-graphene-oxide (rGO) aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Graphene oxide</rdfs:label>
        <skos:altLabel xml:lang="en">GO</skos:altLabel>
        <skos:definition xml:lang="en">Oxidised graphene sheets used as filler, reinforcement, or network former in carbon-based aerogels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_132889"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Heptane">
        <rdfs:comment xml:lang="en">n-Heptane, a low-surface-tension alkane used as exchange solvent before ambient pressure drying, analogous to n-hexane but less volatile</rdfs:comment>
        <rdfs:label xml:lang="en">n-Heptane</rdfs:label>
        <skos:altLabel xml:lang="en">Heptane</skos:altLabel>
        <skos:definition xml:lang="en">The alkane C7H16, used as a low-surface-tension exchange solvent prior to ambient pressure drying</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_43098"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Hexamethyldisilazane">
        <rdfs:comment xml:lang="en">Hexamethyldisilazane (HMDS, CAS 999-97-3): a milder silylating agent than TMCS that reacts with silanol groups producing trimethylsilyl-protected surfaces and ammonia as by-product</rdfs:comment>
        <rdfs:comment xml:lang="en">PubChem CID 68519 (hexamethyldisilazane, CAS 999-97-3)</rdfs:comment>
        <rdfs:label xml:lang="en">Hexamethyldisilazane</rdfs:label>
        <skos:altLabel xml:lang="en">Bis(trimethylsilyl)amine</skos:altLabel>
        <skos:altLabel xml:lang="en">HMDS</skos:altLabel>
        <skos:closeMatch rdf:resource="https://pubchem.ncbi.nlm.nih.gov/compound/68519"/>
        <skos:definition xml:lang="en">A mild silylating agent (CAS 999-97-3) that reacts with surface silanol groups to install trimethylsilyl groups with ammonia as by-product; preferred over TMCS where HCl by-product is undesirable</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Hexane">
        <rdfs:comment xml:lang="en">n-Hexane, a low-surface-tension alkane used as the final exchange solvent before ambient pressure drying of silylated gels</rdfs:comment>
        <rdfs:label xml:lang="en">n-Hexane</rdfs:label>
        <skos:altLabel xml:lang="en">Hexane</skos:altLabel>
        <skos:definition xml:lang="en">The alkane C6H14, used as a low-surface-tension exchange solvent prior to ambient pressure drying</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29021"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/HydrofluoricAcid">
        <rdfs:comment xml:lang="en">Hydrofluoric acid (HF), a fluoride catalyst that strongly accelerates condensation of silica sols; acts mechanistically like a nucleophilic (base-type) catalyst despite being an acid</rdfs:comment>
        <rdfs:label xml:lang="en">Hydrofluoric acid</rdfs:label>
        <skos:altLabel xml:lang="en">HF</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29228"/>
        <skos:definition xml:lang="en">The aqueous acid HF, used as a fluoride-mediated condensation catalyst in silica sol-gel processing</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Isopropanol">
        <rdfs:comment xml:lang="en">Isopropanol (2-propanol, IPA), a common solvent-exchange medium and pore liquid in aerogel processing</rdfs:comment>
        <rdfs:label xml:lang="en">Isopropanol</rdfs:label>
        <skos:altLabel xml:lang="en">2-Propanol</skos:altLabel>
        <skos:altLabel xml:lang="en">IPA</skos:altLabel>
        <skos:altLabel xml:lang="en">Isopropyl alcohol</skos:altLabel>
        <skos:definition xml:lang="en">The secondary alcohol (CH3)2CHOH, used as a solvent and exchange medium in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17824"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/LaserFlash">
        <rdfs:comment xml:lang="en">Laser flash analysis: a light pulse heats one face of a disc specimen and the rear-face temperature transient yields thermal diffusivity, from which conductivity is computed with density and heat capacity</rdfs:comment>
        <rdfs:label xml:lang="en">Laser flash analysis</rdfs:label>
        <skos:altLabel xml:lang="en">LFA</skos:altLabel>
        <skos:definition xml:lang="en">A transient method that determines thermal diffusivity from the rear-face temperature response to a light pulse</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Lignin">
        <rdfs:comment xml:lang="en">Lignin, the aromatic biopolymer by-product of pulping, used as a bio-based phenolic precursor (usually blended with resorcinol or phenol) for organic and carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Lignin</rdfs:label>
        <skos:definition xml:lang="en">The aromatic plant biopolymer used as a bio-based phenolic precursor in organic aerogel syntheses</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_6457"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/MTES">
        <rdfs:comment xml:lang="en">Methyltriethoxysilane (MTES, CH3Si(OC2H5)3), an organosilica precursor bearing one methyl group; used as co-precursor with TEOS to introduce hydrophobicity</rdfs:comment>
        <rdfs:label xml:lang="en">Methyltriethoxysilane</rdfs:label>
        <skos:altLabel xml:lang="en">MTES</skos:altLabel>
        <skos:definition xml:lang="en">The silicon alkoxide CH3Si(OC2H5)3 with one non-hydrolysable methyl group, used to produce hydrophobic organosilica networks</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/MTMS">
        <rdfs:comment xml:lang="en">Trimethoxymethylsilane (MTMS, CAS 1185-55-3): an organosilica precursor bearing one methyl group, used to produce hydrophobic methylsilica (organosilica) aerogels via the sol-gel route</rdfs:comment>
        <rdfs:label xml:lang="en">Trimethoxymethylsilane</rdfs:label>
        <skos:altLabel xml:lang="en">MTMS</skos:altLabel>
        <skos:altLabel xml:lang="en">Methyltrimethoxysilane</skos:altLabel>
        <skos:definition xml:lang="en">A silicon alkoxide precursor with one Si–CH₃ group and three Si–OCH₃ groups, yielding aerogel networks with pendant methyl groups that confer hydrophobicity</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Melamine">
        <rdfs:comment xml:lang="en">Melamine, the triamine monomer of melamine-formaldehyde (MF) aerogels and a nitrogen source for N-doped carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Melamine</rdfs:label>
        <skos:definition xml:lang="en">The triazine triamine used with formaldehyde as the precursor pair of MF aerogels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27915"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/MercuryIntrusionPorosimetry">
        <rdfs:comment xml:lang="en">Determination of macro- and mesopore size distribution by pressurised mercury intrusion; note that compressible aerogels are often crushed rather than intruded, so results need careful interpretation</rdfs:comment>
        <rdfs:label xml:lang="en">Mercury intrusion porosimetry</rdfs:label>
        <skos:altLabel xml:lang="en">MIP</skos:altLabel>
        <skos:definition xml:lang="en">A porosity measurement in which mercury is forced into the pores of a material under increasing pressure to determine pore volume and size distribution</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Methanol">
        <rdfs:comment xml:lang="en">The simplest alcohol (CH3OH), commonly used as a solvent and reactant in sol-gel chemistry. Methanol can serve as a pore liquid in alcogels and as a solvent exchange medium prior to supercritical drying</rdfs:comment>
        <rdfs:label xml:lang="en">Methanol</rdfs:label>
        <skos:definition xml:lang="en">The simplest alcohol, CH3OH, used as a solvent, reactant, and pore liquid in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17790"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Nanocellulose">
        <rdfs:comment xml:lang="en">Nanoscale cellulose - cellulose nanofibrils (CNF) or cellulose nanocrystals (CNC) - used as precursor and as reinforcement in bio-based and composite aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Nanocellulose</rdfs:label>
        <skos:altLabel xml:lang="en">CNC</skos:altLabel>
        <skos:altLabel xml:lang="en">CNF</skos:altLabel>
        <skos:altLabel xml:lang="en">Cellulose nanocrystal</skos:altLabel>
        <skos:altLabel xml:lang="en">Cellulose nanofibril</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_133349"/>
        <skos:definition xml:lang="en">Cellulose in nanofibrillar or nanocrystalline form, used as network former or reinforcement in aerogels</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/NitricAcid">
        <rdfs:comment xml:lang="en">Nitric acid (HNO3), a strong mineral acid used as hydrolysis catalyst in silica and metal oxide sol-gel synthesis</rdfs:comment>
        <rdfs:label xml:lang="en">Nitric acid</rdfs:label>
        <skos:definition xml:lang="en">The strong mineral acid HNO3, used as an acid catalyst in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_48107"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Nitrogen">
        <rdfs:comment xml:lang="en">Nitrogen gas (N2), the standard inert pyrolysis and calcination atmosphere and the standard adsorbate of BET/BJH physisorption at 77 K</rdfs:comment>
        <rdfs:label xml:lang="en">Nitrogen</rdfs:label>
        <skos:altLabel xml:lang="en">N2</skos:altLabel>
        <skos:definition xml:lang="en">The diatomic gas N2, used as inert process atmosphere and physisorption adsorbate</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17997"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/OxalicAcid">
        <rdfs:comment xml:lang="en">Oxalic acid ((COOH)2), a dicarboxylic acid used as mild hydrolysis catalyst, particularly in MTMS-based and two-step syntheses</rdfs:comment>
        <rdfs:label xml:lang="en">Oxalic acid</rdfs:label>
        <skos:definition xml:lang="en">The dicarboxylic acid (COOH)2, used as a weak acid catalyst in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16995"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/PEDS">
        <rdfs:comment xml:lang="en">Polyethoxydisiloxane (PEDS), a pre-polymerised (partially hydrolysed and condensed) TEOS oligomer sold as an ethanolic solution; a common industrial silica precursor with reproducible reactivity</rdfs:comment>
        <rdfs:label xml:lang="en">Polyethoxydisiloxane</rdfs:label>
        <skos:altLabel xml:lang="en">PEDS</skos:altLabel>
        <skos:altLabel xml:lang="en">Pre-polymerised TEOS</skos:altLabel>
        <skos:definition xml:lang="en">A partially hydrolysed and condensed oligomeric ethoxysiloxane used as a pre-polymerised silica precursor</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Pectin">
        <rdfs:comment xml:lang="en">Pectin, the galacturonic-acid-rich plant polysaccharide, gelled ionically or by acid to form pectin bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Pectin</rdfs:label>
        <skos:definition xml:lang="en">The plant polysaccharide rich in galacturonic acid, used as a bio-aerogel precursor</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17309"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Phenol">
        <rdfs:comment xml:lang="en">Phenol (C6H5OH), used with formaldehyde in phenol-formaldehyde (PF) organic and carbon aerogels as a lower-cost alternative to resorcinol</rdfs:comment>
        <rdfs:label xml:lang="en">Phenol</rdfs:label>
        <skos:definition xml:lang="en">The aromatic alcohol C6H5OH, used with formaldehyde as the precursor pair of PF aerogels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_15882"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Resorcinol">
        <rdfs:comment xml:lang="en">Resorcinol (1,3-dihydroxybenzene), the standard phenolic monomer of resorcinol-formaldehyde (RF) organic and carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Resorcinol</rdfs:label>
        <skos:definition xml:lang="en">The phenolic compound benzene-1,3-diol, used with formaldehyde as the precursor pair of RF aerogels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27810"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SANS">
        <rdfs:comment xml:lang="en">Small-angle neutron scattering; complements SAXS with contrast-variation capability for multi-phase and hydrogenous aerogel systems</rdfs:comment>
        <rdfs:label xml:lang="en">Small-angle neutron scattering</rdfs:label>
        <skos:altLabel xml:lang="en">SANS</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that measures elastic neutron scattering at small angles to characterise nanostructure of a material</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SAXS">
        <rdfs:comment xml:lang="en">Small-angle X-ray scattering; yields fractal dimensions (gmat:MassFractalDimension, gmat:SurfaceFractalDimension), Porod exponent, correlation length, and primary particle size of aerogel networks</rdfs:comment>
        <rdfs:label xml:lang="en">Small-angle X-ray scattering</rdfs:label>
        <skos:altLabel xml:lang="en">SAXS</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that measures elastic X-ray scattering at small angles to characterise nanostructure (fractal scaling, particle and cluster sizes) of a material</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SodiumCarbonate">
        <rdfs:comment xml:lang="en">Sodium carbonate (Na2CO3), a mild base used as the classic catalyst of resorcinol-formaldehyde aerogel synthesis (the R/C ratio refers to it)</rdfs:comment>
        <rdfs:label xml:lang="en">Sodium carbonate</rdfs:label>
        <skos:altLabel xml:lang="en">Soda ash</skos:altLabel>
        <skos:definition xml:lang="en">The mild base Na2CO3, used as the standard catalyst in RF organic aerogel synthesis</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_29377"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SodiumHydroxide">
        <rdfs:comment xml:lang="en">Sodium hydroxide (NaOH), a strong base used as condensation catalyst and for pH adjustment, e.g. in water-glass silica routes and chitosan gelation</rdfs:comment>
        <rdfs:label xml:lang="en">Sodium hydroxide</rdfs:label>
        <skos:altLabel xml:lang="en">Caustic soda</skos:altLabel>
        <skos:definition xml:lang="en">The strong base NaOH, used as a base catalyst and pH adjuster in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_32145"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SodiumSilicate">
        <rdfs:comment xml:lang="en">Aqueous sodium silicate (water glass, Na2O·nSiO2), the industrial low-cost silica precursor; requires ion exchange (gmat:IonExchange) or acid neutralisation to remove sodium ions before gelation</rdfs:comment>
        <rdfs:label xml:lang="en">Sodium silicate</rdfs:label>
        <skos:altLabel xml:lang="en">Water glass</skos:altLabel>
        <skos:altLabel xml:lang="en">Waterglass</skos:altLabel>
        <skos:definition xml:lang="en">The sodium salt of silicic acid (Na2O·nSiO2), used in aqueous solution as a low-cost silica precursor</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60720"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Starch">
        <rdfs:comment xml:lang="en">Starch, the amylose/amylopectin polysaccharide, gelatinised and retrograded to form starch bio-aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Starch</rdfs:label>
        <skos:definition xml:lang="en">The plant storage polysaccharide of amylose and amylopectin, used as a bio-aerogel precursor</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28017"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/SupercriticalCO2">
        <rdfs:comment xml:lang="en">Carbon dioxide in supercritical state (above 31.1°C and 72.9 bar), commonly used for aerogel drying. The plain gas is modelled separately as gmat:CarbonDioxide; this class denotes the supercritical state of that substance</rdfs:comment>
        <rdfs:label xml:lang="en">Supercritical CO2</rdfs:label>
        <skos:definition xml:lang="en">Carbon dioxide in the supercritical state, used as a low-surface-tension drying medium in supercritical drying of gels</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16526"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/TEMImaging">
        <rdfs:comment xml:lang="en">Transmission electron microscopy imaging of the primary particle and pore network structure; performed on a pmat:TransmissionElectronMicroscope</rdfs:comment>
        <rdfs:label xml:lang="en">TEM imaging</rdfs:label>
        <skos:altLabel xml:lang="en">Transmission electron microscopy</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that images the nanostructure of a thin specimen by transmission of an electron beam</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/TMOS">
        <rdfs:comment xml:lang="en">Tetramethoxysilane (TMOS, Si(OCH3)4), a fast-hydrolysing silica precursor; yields finer networks than TEOS but releases toxic methanol</rdfs:comment>
        <rdfs:label xml:lang="en">Tetramethoxysilane</rdfs:label>
        <skos:altLabel xml:lang="en">TMOS</skos:altLabel>
        <skos:altLabel xml:lang="en">Tetramethyl orthosilicate</skos:altLabel>
        <skos:definition xml:lang="en">The silicon alkoxide Si(OCH3)4, a rapidly hydrolysing silica precursor for sol-gel processing</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Tannin">
        <rdfs:comment xml:lang="en">Condensed or hydrolysable plant tannins, bio-based polyphenols used with formaldehyde or furfural as low-cost precursors of tannin-based organic and carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Tannin</rdfs:label>
        <skos:definition xml:lang="en">A plant-derived polyphenol used as a bio-based phenolic precursor in organic aerogel syntheses</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_26848"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Tetraethoxysilane">
        <rdfs:comment xml:lang="en">Tetraethoxysilane (TEOS, Si(OC2H5)4) is a silicon alkoxide used as a silica precursor in hydrolysis–condensation (sol–gel) processes</rdfs:comment>
        <rdfs:label xml:lang="en">Tetraethoxysilane</rdfs:label>
        <skos:definition xml:lang="en">The silicon alkoxide Si(OC2H5)4 (TEOS), a widely used silica precursor that undergoes hydrolysis and condensation in sol-gel processing</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/ThermogravimetricAnalysis">
        <rdfs:comment xml:lang="en">Measurement of sample mass as a function of temperature, used for thermal stability, organic content, and decomposition behaviour of aerogels; performed on a pmat:ThermogravimetricAnalyzer</rdfs:comment>
        <rdfs:label xml:lang="en">Thermogravimetric analysis</rdfs:label>
        <skos:altLabel xml:lang="en">TGA</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that records the mass of a sample as a function of temperature or time under a controlled atmosphere</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/TitaniumIsopropoxide">
        <rdfs:comment xml:lang="en">Titanium(IV) isopropoxide (TTIP, Ti(OiPr)4), the standard alkoxide precursor for titania aerogels; hydrolyses very rapidly and usually requires chelating agents or acid moderation</rdfs:comment>
        <rdfs:label xml:lang="en">Titanium isopropoxide</rdfs:label>
        <skos:altLabel xml:lang="en">TTIP</skos:altLabel>
        <skos:altLabel xml:lang="en">Titanium(IV) isopropoxide</skos:altLabel>
        <skos:definition xml:lang="en">The titanium alkoxide Ti(OC3H7)4, used as a precursor for titania gels</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Trimethylchlorosilane">
        <rdfs:comment xml:lang="en">PubChem CID 11636 (trimethylchlorosilane, CAS 75-77-4)</rdfs:comment>
        <rdfs:comment xml:lang="en">Trimethylchlorosilane (TMCS, CAS 75-77-4): a reactive chlorosilane that reacts with surface silanol groups to introduce hydrophobic trimethylsilyl groups, enabling ambient pressure drying</rdfs:comment>
        <rdfs:label xml:lang="en">Trimethylchlorosilane</rdfs:label>
        <skos:altLabel xml:lang="en">Chlorotrimethylsilane</skos:altLabel>
        <skos:altLabel xml:lang="en">TMCS</skos:altLabel>
        <skos:closeMatch rdf:resource="https://pubchem.ncbi.nlm.nih.gov/compound/11636"/>
        <skos:definition xml:lang="en">A chlorosilane silylating agent that converts hydrophilic surface silanols to hydrophobic trimethylsilyl groups, enabling ambient pressure drying without pore collapse</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/Urea">
        <rdfs:comment xml:lang="en">Urea (CO(NH2)2), used for in-situ base generation (thermal hydrolysis to ammonia) in one-pot MTMS/TMOS syntheses and as nitrogen source for N-doped carbon aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Urea</rdfs:label>
        <skos:definition xml:lang="en">The diamide CO(NH2)2, used for in-situ base generation and as a co-monomer in sol-gel processing</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHEBI_16199"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/VTMS">
        <rdfs:comment xml:lang="en">Vinyltrimethoxysilane (VTMS, CH2=CHSi(OCH3)3), an organosilica precursor bearing a polymerisable vinyl group; used for vinyl-functional and double-network aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Vinyltrimethoxysilane</rdfs:label>
        <skos:altLabel xml:lang="en">VTMS</skos:altLabel>
        <skos:definition xml:lang="en">The silicon alkoxide CH2=CHSi(OCH3)3 carrying a vinyl group, used as a functional silica co-precursor</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/XPSAnalysis">
        <rdfs:comment xml:lang="en">X-ray photoelectron spectroscopy, quantifying surface elemental composition and oxidation states, e.g. of doped carbon or hybrid aerogel surfaces</rdfs:comment>
        <rdfs:label xml:lang="en">XPS analysis</rdfs:label>
        <skos:altLabel xml:lang="en">X-ray photoelectron spectroscopy</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that measures the kinetic energy of X-ray-excited photoelectrons to determine surface composition and chemical states</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/XRayDiffraction">
        <rdfs:comment xml:lang="en">Wide-angle X-ray diffraction, used to establish the amorphous or crystalline state of aerogels and the phase of metal oxide aerogels (e.g. anatase vs rutile titania)</rdfs:comment>
        <rdfs:label xml:lang="en">X-ray diffraction</rdfs:label>
        <skos:altLabel xml:lang="en">XRD</skos:altLabel>
        <skos:definition xml:lang="en">An analysis that measures Bragg diffraction of X-rays to identify crystalline phases and crystallite sizes</skos:definition>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gelmat/ZirconiumPropoxide">
        <rdfs:comment xml:lang="en">Zirconium(IV) n-propoxide (Zr(OnPr)4, typically supplied in n-propanol), the standard alkoxide precursor for zirconia aerogels</rdfs:comment>
        <rdfs:label xml:lang="en">Zirconium n-propoxide</rdfs:label>
        <skos:altLabel xml:lang="en">Zirconium(IV) propoxide</skos:altLabel>
        <skos:definition xml:lang="en">The zirconium alkoxide Zr(OC3H7)4, used as a precursor for zirconia gels</skos:definition>
    </rdf:Description>
    


