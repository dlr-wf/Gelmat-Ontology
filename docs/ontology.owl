    <!-- https://w3id.org/gelmat/hasCanonicalUnit -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/gelmat/hasCanonicalUnit">
        <rdfs:label xml:lang="en">has canonical unit</rdfs:label>
        <skos:definition xml:lang="en">Links a quantity class to the canonical (recommended) OM-2 unit of measure in which instances of that quantity are conventionally expressed. Machine-readable counterpart to the unit named in the class definition.</skos:definition>
        <rdfs:range rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/Unit"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/gelmat/hasStepOrder -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/gelmat/hasStepOrder">
        <rdfs:label xml:lang="en">has step order</rdfs:label>
        <skos:definition xml:lang="en">An integer indicating the canonical execution order of a sub-process within a synthesis workflow (1 = first step). Used to provide SPARQL-queryable ordering of BFO parthood sub-steps that are otherwise unordered.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:AnnotationProperty>
    


