###  https://w3id.org/polymat/Spectrometer
<https://w3id.org/polymat/Spectrometer> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
                                        rdfs:comment """A piece of equipment used to measure a spectrum
(http://purl.obolibrary.org/obo/CHMO_0001234)"""@en ,
                                                     """A type of analytical equipment used to measure certain physical properties such as energy, mass and wavelength via the dispersion of radiant energy or particles into a spectrum
(http://purl.obolibrary.org/obo/NCIT_C62336)"""@en ,
                                                     """Scientific equipment used to separate and measure spectral components of a physical phenomenon; the primary application is the determination of chemical composition
(https://en.wikipedia.org/wiki/Spectrometer)"""@en ;
                                        rdfs:label "Spectrometer"@en .


###  https://w3id.org/polymat/Stress
<https://w3id.org/polymat/Stress> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                  rdfs:comment """A measure of the forces acting on an object during deformation
(https://en.wikipedia.org/wiki/Stress_(mechanics))

Equivalent to om:Stress, which Gelmat declares locally as the parent of om:CompressiveStress and gmat:FlexuralStrength; the equivalence keeps the Polymat and OM stress hierarchies merged under one concept"""@en ;
                                  rdfs:label "Stress"@en .


###  https://w3id.org/polymat/Substance
<https://w3id.org/polymat/Substance> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                     rdfs:comment "A physical material with particular properties"@en ;
                                     rdfs:label "Substance"@en ;
                                     <http://www.w3.org/2004/02/skos/core#altLabel> "Compound"@en ,
                                                                                    "Matter"@en ;
                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/pmd/co/Material> .


###  https://w3id.org/polymat/TargetConcentration
<https://w3id.org/polymat/TargetConcentration> rdf:type owl:Class ;
                                               rdfs:subClassOf :ProcessParameter ;
                                               rdfs:comment "A designed or nominal concentration for a reagent in a synthesis, as distinct from the achieved concentration. Deviations arise from weighing or volumetric uncertainties"@en ;
                                               rdfs:label "Target concentration"@en .


###  https://w3id.org/polymat/TensileTest
<https://w3id.org/polymat/TensileTest> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                                       rdfs:comment """A standardized materials science and engineering method in which a solid sample is subjected to a controlled tension until failure; properties that are directly measured via a tensile test are ultimate tensile strength, breaking strength, maximum elongation, and reduction in area; from these measurements the following properties can also be determined: Young's modulus (modulus of elasticity), Poisson's ratio, yield strength, and strain-hardening characteristics
(https://en.wikipedia.org/wiki/Tensile_testing)"""@en ;
                                       rdfs:label "Tensile test"@en .


###  https://w3id.org/polymat/TensileTestMachine
<https://w3id.org/polymat/TensileTestMachine> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/polymat/MechanicalTestingEquipment> ;
                                              rdfs:comment """Equipment for carrying out standardized tensile tests on a solid sample to determine its mechanical properties
(https://en.wikipedia.org/wiki/Tensile_testing#Equipment)"""@en ;
                                              rdfs:label "Universal testing machine"@en .


###  https://w3id.org/polymat/Terpolymer
<https://w3id.org/polymat/Terpolymer> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/polymat/Polymer> ;
                                      rdfs:comment """A polymer that results from copolymerization of three discrete monomers
(https://www.merriam-webster.com/dictionary/terpolymer)"""@en ;
                                      rdfs:label "Terpolymer"@en .


###  https://w3id.org/polymat/ThermodynamicTestEquipment
<https://w3id.org/polymat/ThermodynamicTestEquipment> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
                                                      rdfs:comment """Equipment for measurement of physical parameters (e.g., temperature, heat energy) in thermodynamic systems (isolated, closed, or open)
(https://en.wikipedia.org/wiki/Thermodynamic_instruments) (https://en.wikipedia.org/wiki/Thermodynamic_system)"""@en ;
                                                      rdfs:label "Thermodynamic test equipment"@en .


###  https://w3id.org/polymat/ThermogravimetricAnalyzer
<https://w3id.org/polymat/ThermogravimetricAnalyzer> rdf:type owl:Class ;
                                                     rdfs:subClassOf <https://w3id.org/polymat/ThermodynamicTestEquipment> ;
                                                     rdfs:comment """A piece of equipment, consisting of a quartz or alumina chamber, a balance, a sample pan and a heating mechanism, which is used to record the mass of a sample as a function of increasing temperature
(http://purl.obolibrary.org/obo/CHMO_0002121)"""@en ,
                                                                  """Equipment for thermogravimetric analysis (TGA) in which the mass of a sample is measured over time as the temperature changes; it provides information about physical phenomena, such as phase transitions, absorption, adsorption and desorption; as well as chemical phenomena including chemisorption, thermal decomposition, and solid-gas reactions (e.g., oxidation or reduction)
(https://en.wikipedia.org/wiki/Thermogravimetric_analysis)"""@en ;
                                                     rdfs:label "Thermogravimetric analyzer"@en .


###  https://w3id.org/polymat/Thermometer
<https://w3id.org/polymat/Thermometer> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
                                       rdfs:comment "An instrument that records and displays the temperature"@en ;
                                       rdfs:label "Thermometer"@en .


###  https://w3id.org/polymat/Thermoplastic
<https://w3id.org/polymat/Thermoplastic> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/polymat/Plastic> ;
                                         rdfs:comment """A plastic that can be deformed by heating in a certain temperature range (thermoplastic); this process is reversible and can be repeated as often as desired by cooling and reheating, as long as no thermal decomposition of the material occurs 
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)"""@en ;
                                         rdfs:label "Thermoplastic"@en .


###  https://w3id.org/polymat/Thermoset
<https://w3id.org/polymat/Thermoset> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/polymat/Plastic> ;
                                     rdfs:comment """A plastic that retains its state and shape after curing, the process is irreversible due to cross-linked polymer chains
(https://thermoplasticcomposites.de/en/2023/01/23/the-world-of-plastics/)"""@en ;
                                     rdfs:label "Thermoset"@en ;
                                     <http://www.w3.org/2004/02/skos/core#altLabel> "Duromer"@en ,
                                                                                    "Duroplast"@en .


###  https://w3id.org/polymat/TimeLag
<https://w3id.org/polymat/TimeLag> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/polymat/MembranePerformanceForGases> ;
                                   rdfs:comment """A method commonly used to characterize gas separation membranes. It allows the determination of diffusion, permeability, and solubility coefficients from a single dynamic gas permeation experiment; for this experiment, a homogeneous membrane is exposed to a step increase in pressure at one side of the membrane (feed side) and the feed pressure remains constant, while the other side (permeate side) of the membrane remains under vacuum; the diffusion and permeability coefficients are then determined from the resulting permeate pressure-time curve; the solubility coefficient is the permeability coefficient divided by the diffusion coefficient
(https://doi.org/10.1016/j.memsci.2020.118715)"""@en ;
                                   rdfs:label "Time lag"@en .


###  https://w3id.org/polymat/TransmissionElectronMicroscope
<https://w3id.org/polymat/TransmissionElectronMicroscope> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/polymat/Microscope> ;
                                                          rdfs:comment """A piece of equipment which is used to produce an enlarged image of an electron transparent specimen using a finely focused (<10 nm diameter) electron beam with an acceleration voltage of 50–150 kV under vacuum; the energies and intensities of the transmitted electrons are measured
(http://purl.obolibrary.org/obo/CHMO_0001099)"""@en ,
                                                                       """A type of microscope that uses magnetic lenses to transmit a beam of electrons through a thin sample; the electrons are then focused on a fluorescent screen or another detector to form an enlarged image
(https://www.photonics.com/EDU/transmission_electron_microscope_TEM/d7604)"""@en ,
                                                                       """An electron microscope that transmits a beam of electrons through a finely sliced section of a specimen and creates an image of the sample based on its effect on the phase of the electrons that pass through
(http://purl.obolibrary.org/obo/NCIT_C78813)"""@en ;
                                                          rdfs:label "Transmission electron microscope"@en ;
                                                          <http://www.w3.org/2004/02/skos/core#altLabel> "TEM"@en .


###  https://w3id.org/polymat/UltimateTensileStrength
<https://w3id.org/polymat/UltimateTensileStrength> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                   rdfs:comment """The maximum stress that a material can withstand while being stretched before breaking
(https://en.wikipedia.org/wiki/Ultimate_tensile_strength)"""@en ;
                                                   rdfs:label "Ultimate tensile strength"@en .


###  https://w3id.org/polymat/User
<https://w3id.org/polymat/User> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                                rdfs:comment "A person who is trained to use a specific device"@en ;
                                rdfs:label "User"@en .


###  https://w3id.org/polymat/WaterFlux
<https://w3id.org/polymat/WaterFlux> rdf:type owl:Class ;
                                     rdfs:subClassOf <https://w3id.org/polymat/MembranePerformanceForLiquids> ;
                                     rdfs:comment "The rate at which water permeates a membrane"@en ;
                                     rdfs:label "Water flux"@en .


###  https://w3id.org/polymat/WaterPermeabilitySetup
<https://w3id.org/polymat/WaterPermeabilitySetup> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/polymat/LiquidPermeationEquipment> ;
                                                  rdfs:comment "Equipment to measure the permeability of water through a membrane"@en ;
                                                  rdfs:label "Water permeability setup"@en .


###  https://w3id.org/polymat/ZetaPotentialSetup
<https://w3id.org/polymat/ZetaPotentialSetup> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/polymat/ElectricTestingEquipment> ;
                                              rdfs:comment """Equipment to measure Zeta potential (electrokinetic potential) in colloidal dispersions
(https://en.wikipedia.org/wiki/Zeta_potential)"""@en ;
                                              rdfs:label "Zeta potential setup"@en .


###  https://w3id.org/polymat/4PointResistanceSetup
<https://w3id.org/polymat/4PointResistanceSetup> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/polymat/ElectricTestingEquipment> ;
                                                 rdfs:comment """Equipment to measure the electrical impedance by four-terminal sensing (4T sensing, 4-wire sensing, or 4-point probes method) technique that uses separate pairs of current-carrying and voltage-sensing electrodes to make more accurate measurements than the simpler and more usual two-terminal (2T) sensing
(https://en.wikipedia.org/wiki/Four-terminal_sensing)"""@en ;
                                                 rdfs:label "4-Point resistance setup"@en .


