                            rdfs:label "has surface fractal dimension"@en .


###  https://w3id.org/gelmat/hasTensileStrength
:hasTensileStrength rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                    rdfs:domain <https://w3id.org/polymat/Substance> ;
                    rdfs:range <https://w3id.org/polymat/UltimateTensileStrength> ;
                    rdfs:comment "Relates a substance to its ultimate tensile strength, expressed as a pmat:UltimateTensileStrength individual with om:Measure value in Pa"@en ;
                    rdfs:label "has tensile strength"@en .


###  https://w3id.org/gelmat/hasThermalConductivity
:hasThermalConductivity rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                        rdfs:domain <https://w3id.org/polymat/Substance> ;
                        rdfs:range :ThermalConductivity ;
                        rdfs:comment "Relates a substance to its thermal conductivity, expressed as a gmat:ThermalConductivity individual with om:Measure value in W/(m.K)"@en ;
                        rdfs:label "has thermal conductivity"@en .


###  https://w3id.org/gelmat/hasThermalDiffusivity
:hasThermalDiffusivity rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                       rdfs:domain <https://w3id.org/polymat/Substance> ;
                       rdfs:range :ThermalDiffusivity ;
                       rdfs:comment "Relates a substance to its thermal diffusivity, expressed as a gmat:ThermalDiffusivity individual with om:Measure value in m^2/s"@en ;
                       rdfs:label "has thermal diffusivity"@en .


###  https://w3id.org/gelmat/hasThermalExpansionCoefficient
:hasThermalExpansionCoefficient rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                                rdfs:domain <https://w3id.org/polymat/Substance> ;
                                rdfs:range :ThermalExpansionCoefficient ;
                                rdfs:comment "Relates a substance to its linear coefficient of thermal expansion, expressed as a gmat:ThermalExpansionCoefficient individual with om:Measure value in K^-1"@en ;
                                rdfs:label "has thermal expansion coefficient"@en .


###  https://w3id.org/gelmat/hasTransmittance
:hasTransmittance rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                  rdfs:domain <https://w3id.org/polymat/Substance> ;
                  rdfs:range :Transmittance ;
                  rdfs:comment "Relates a substance to its optical transmittance, expressed as a gmat:Transmittance individual with om:Measure value as percentage (0-100)"@en ;
                  rdfs:label "has transmittance"@en .


###  https://w3id.org/gelmat/hasYoungsModulus
:hasYoungsModulus rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000053> ;
                  rdfs:domain <https://w3id.org/polymat/Substance> ;
                  rdfs:range :YoungsModulus ;
                  rdfs:comment "Relates a substance to its Young's (elastic) modulus, expressed as a gmat:YoungsModulus individual with om:Measure value in Pa"@en ;
                  rdfs:label "has Young's modulus"@en .


###  https://w3id.org/gelmat/isAerogelProductOf
:isAerogelProductOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :wasProducedBy ;
                    owl:inverseOf :producesAerogel ;
                    rdfs:domain :Aerogel ;
                    rdfs:range <https://w3id.org/polymat/Drying> ;
                    rdfs:label "is aerogel product of"@en .


###  https://w3id.org/gelmat/measuredBy
:measuredBy rdf:type owl:ObjectProperty ;
            rdfs:domain <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
            rdfs:range <https://w3id.org/polymat/Analysis> ;
            rdfs:comment "Relates a measured quantity to the characterisation method (analysis) that produced it, e.g. a surface area value measuredBy a BET analysis. Dedicated shortcut for the common query pattern; prov:wasGeneratedBy remains available for full provenance chains"@en ;
            rdfs:label "measured by"@en .


###  https://w3id.org/gelmat/producesAerogel
:producesAerogel rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
                 rdfs:domain <https://w3id.org/polymat/Drying> ;
                 rdfs:range :Aerogel ;
                 rdfs:comment "Relates a drying process to the aerogel material that results from it (covers supercritical, ambient pressure, freeze, and vacuum drying routes)"@en ;
                 rdfs:label "producesAerogel"@en .


###  https://w3id.org/gelmat/realisedAs
:realisedAs rdf:type owl:ObjectProperty ;
            rdfs:domain :GelationPathway ;
            rdfs:range :Gelation ;
            rdfs:comment "Relates a mechanistic GelationPathway (a Feature) to the Gelation process that realises it. For example, a TwoStepAcidBaseCatalysisPathway is realisedAs a TwoStepCatalysis gelation process"@en ;
            rdfs:label "realised as"@en .


###  https://w3id.org/gelmat/realizesProtocol
:realizesProtocol rdf:type owl:ObjectProperty ;
                  rdfs:domain <https://w3id.org/polymat/Procedure> ;
                  rdfs:range :SynthesisProtocol ;
                  rdfs:comment "Links a concrete executed procedure (an occurrent) to the SynthesisProtocol (plan specification / recipe) it carries out. Separates the executed run from the reusable recipe it follows. Domain is pmat:Procedure rather than BFO process (BFO_0000015) to stay compatible with Polymat's BFO_0000015-to-prov:Activity mapping."@en ;
                  rdfs:label "realizes protocol"@en .


###  https://w3id.org/gelmat/requiresEquipment
:requiresEquipment rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( <https://w3id.org/polymat/Method>
                                               <https://w3id.org/polymat/Procedure>
                                             )
                               ] ;
                   rdfs:range <https://w3id.org/polymat/Device> ;
                   rdfs:comment "Relates a laboratory method or procedure to equipment that is necessary to perform that method"@en ;
                   rdfs:label "requiresEquipment"@en .


###  https://w3id.org/gelmat/transformsGel
:transformsGel rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
               rdfs:domain <https://w3id.org/polymat/SamplePreparation> ;
               rdfs:range :Gel ;
               rdfs:comment "Relates a sample preparation process (like solvent exchange) to the gel material it transforms"@en ;
               rdfs:label "transformsGel"@en .


###  https://w3id.org/gelmat/usesCrosslinker
:usesCrosslinker rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :usesSubstance ;
                 rdfs:domain :Gelation ;
                 rdfs:range :Crosslinker ;
                 rdfs:comment "Relates gelation process to crosslinking agents used to form network structure"@en ;
                 rdfs:label "usesCrosslinker"@en .


###  https://w3id.org/gelmat/usesSubstance
:usesSubstance rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000057> ;
               rdfs:domain <https://w3id.org/polymat/Method> ;
               rdfs:range <https://w3id.org/polymat/Substance> ;
               rdfs:comment "Relates a process (creation/synthesis step or sample preparation step such as solvent exchange or drying) to chemical substances used as reactants, catalysts, solvents, or exchange media"@en ;
               rdfs:label "usesSubstance"@en .


###  https://w3id.org/gelmat/usesSupercriticalFluid
:usesSupercriticalFluid rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :usesSubstance ;
                        rdfs:domain :SupercriticalDrying ;
                        rdfs:range :SupercriticalFluid ;
                        rdfs:comment "Relates supercritical drying process to the supercritical fluid used (typically CO2)"@en ;
                        rdfs:label "usesSupercriticalFluid"@en .


###  https://w3id.org/gelmat/wasProducedBy
:wasProducedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0000056> ;
               rdfs:domain <https://w3id.org/polymat/Substance> ;
               rdfs:range :CreationProcess ;
               rdfs:comment "Relates a substance to the creation process that produced it"@en ;
               rdfs:label "wasProducedBy"@en .


###  https://w3id.org/polymat/isParameterOf
<https://w3id.org/polymat/isParameterOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://w3id.org/polymat/Feature> ;
                                         rdfs:range <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                         rdfs:comment "Relates a quantity or process feature (temperature, duration, pH) to the process it characterises. Preferred over obo:RO_0000052 when the bearer is a process rather than a material entity. Range is BFO occurrent (BFO_0000003) rather than BFO process (BFO_0000015) because process steps are pmat:Method (under pmat:Procedure, a prov:Entity) while BFO_0000015 maps to prov:Activity, which PROV-O declares disjoint from prov:Entity — a BFO_0000015 range would make every class with an isParameterOf existential unsatisfiable"@en ;
                                         rdfs:label "is parameter of"@en .


###  https://w3id.org/polymat/usesOperatingSystem
<https://w3id.org/polymat/usesOperatingSystem> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://w3id.org/polymat/Software> ;
                                               rdfs:range <https://w3id.org/polymat/OperatingSystem> ;
                                               rdfs:comment """uses the low-level software which handles the interface to peripheral hardware, schedules tasks, allocates storage, and presents a default interface to the user when no application program is running
(http://purl.obolibrary.org/obo/NCIT_C47908)"""@en ;
                                               rdfs:label "uses operating system"@en .


###  https://w3id.org/polymat/usesRuntimeEnvironment
<https://w3id.org/polymat/usesRuntimeEnvironment> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <https://w3id.org/polymat/Software> ;
                                                  rdfs:range <https://w3id.org/polymat/RuntimeEnvironment> ;
                                                  rdfs:comment """uses a sub-system that exists both in the computer where a program is created, as well as in the computers where the program is intended to be run. 
(https://en.wikipedia.org/wiki/Runtime_system)"""@en ;
                                                  rdfs:label "uses runtime environment"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue
<http://www.ontology-of-units-of-measure.org/resource/om-2/hasNumericalValue> rdf:type owl:DatatypeProperty ;
                                                                              rdfs:domain <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
                                                                              rdfs:comment """A numerical value is the size of a particular quantity expressed numerically.
(https://www.oed.com/search/dictionary/?scope=Entries&q=numerical+value)"""@en ;
                                                                              rdfs:label "has numerical value"@en .


###  https://w3id.org/gelmat/hasAgingTime
:hasAgingTime rdf:type owl:DatatypeProperty ;
              rdfs:domain :Aging ;
              rdfs:range xsd:float ;
              rdfs:comment "DEPRECATED: unit-less float shortcut. Model the aging duration as a gmat:Duration (om:Time) instance linked to the gmat:Aging process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. The duration of the aging step after gelation, typically measured in hours"@en ;
              rdfs:label "has aging time"@en ;
              owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/gelmat/hasExchangeCount
:hasExchangeCount rdf:type owl:DatatypeProperty ;
                  rdfs:domain :SolventExchange ;
                  rdfs:range xsd:integer ;
                  rdfs:comment "Number of individual solvent exchange (washing) cycles performed to replace the pore liquid"@en ;
                  rdfs:label "has exchange count"@en .


###  https://w3id.org/gelmat/hasFractalDimensionValue
:hasFractalDimensionValue rdf:type owl:DatatypeProperty ;
                          rdfs:domain :FractalDimension ;
                          rdfs:range [ rdf:type rdfs:Datatype ;
                                       owl:onDatatype xsd:float ;
                                       owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                              ]
                                                              [ xsd:maxInclusive "3.0"^^xsd:float
                                                              ]
                                                            )
                                     ] ;
                          rdfs:comment "The numeric value of the mass fractal dimension of an aerogel network, dimensionless. Typical range for silica aerogels: 1.7-2.4 (from SAXS/SANS)"@en ;
                          rdfs:label "has fractal dimension value"@en .


###  https://w3id.org/gelmat/hasGelTime
:hasGelTime rdf:type owl:DatatypeProperty ;
            rdfs:domain :Gel ;
            rdfs:range xsd:float ;
            rdfs:comment "DEPRECATED: domain error (gel time is a process property, not a material property). Use gmat:hasGelationTimeValue on gmat:Gelation instead. The time duration for sol-gel transition, measured in minutes from when catalysts are mixed until the gel network forms"@en ;
            rdfs:label "has gel time"@en ;
            owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/gelmat/hasGelationTimeValue
:hasGelationTimeValue rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Gelation ;
                      rdfs:range xsd:float ;
                      rdfs:comment "DEPRECATED: unit-less float shortcut. Model the gel time as a gmat:GelationTime (om:Time) instance linked to the gmat:Gelation process with pmat:isParameterOf, carrying an om:Measure (om:hasNumericalValue + om:hasUnit) via om:hasValue. Observed gel time from initiation of gelation (e.g. mixing of catalyst) to the gel point, typically in minutes"@en ;
                      rdfs:label "has gelation time value"@en ;
                      owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/gelmat/hasMolarRatio
:hasMolarRatio rdf:type owl:DatatypeProperty ;
               rdfs:domain :AerogelSynthesis ;
               rdfs:range xsd:string ;
               rdfs:comment "DEPRECATED: machine-unreadable string representation. Use gmat:MolarRatio class with gmat:hasRatioComponent and gmat:WaterToSilicaRatio instead. The molar ratio of reactants in the synthesis (e.g., 'TEOS:H2O:Catalyst = 1:4:0.01')"@en ;
               rdfs:label "has molar ratio"@en ;
               owl:deprecated "true"^^xsd:boolean .


###  https://w3id.org/gelmat/hasNetworkConnectivityValue
:hasNetworkConnectivityValue rdf:type owl:DatatypeProperty ;
                             rdfs:domain :NetworkConnectivity ;
                             rdfs:range xsd:float ;
                             rdfs:comment "Average number of siloxane bonds per network node, as determined by solid-state 29Si NMR (Q2/Q3/Q4 species ratios). Higher values indicate more cross-linked, stiffer networks"@en ;
                             rdfs:label "has network connectivity value"@en .


###  https://w3id.org/gelmat/hasPHValue
:hasPHValue rdf:type owl:DatatypeProperty ;
            rdfs:domain :PHCondition ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:onDatatype xsd:float ;
                         owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float
                                                ]
                                                [ xsd:maxInclusive "14.0"^^xsd:float
                                                ]
                                              )
                       ] ;
            rdfs:comment "The numeric pH value maintained during a sol-gel process step (typically 1.5-3 for acid catalysis, 7.5-10 for base catalysis). Range restricted to 0.0-14.0"@en ;
            rdfs:label "has pH value"@en .


###  https://w3id.org/gelmat/hasRatioString
:hasRatioString rdf:type owl:DatatypeProperty ;
                rdfs:domain :RatioValue ;
                rdfs:range xsd:string ;
                rdfs:comment "The display/legacy string representation of a molar or volume ratio between components (e.g. '1:10', '1:10:4:4', or '59.75'). For numeric querying, single-valued ratios additionally carry om:hasNumericalValue (xsd:double) with om:hasUnit om:one, using the convention that a two-part ratio a:b has numerical value a/b. Multi-component ratios (e.g. '1:10:4:4') have no single numerical value and are represented by this string only."@en ;
                rdfs:label "has ratio string"@en .


###  https://w3id.org/polymat/hasAcronym
<https://w3id.org/polymat/hasAcronym> rdf:type owl:DatatypeProperty ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "An acronym is used to represent long complex compounds"@en ;
                                      rdfs:label "has acronym"@en .


###  https://w3id.org/polymat/hasCASNr
<https://w3id.org/polymat/hasCASNr> rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf <https://w3id.org/polymat/hasID> ;
                                    rdfs:domain [ rdf:type owl:Class ;
                                                  owl:unionOf ( <https://w3id.org/polymat/Monomer>
                                                                <https://w3id.org/polymat/Polymer>
                                                                <https://w3id.org/polymat/Substance>
                                                              )
                                                ] ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Chemical Abstract Service (CAS) number is a unique identifier assigned to every chemical substance to provide a standardised way of referencing and identifying it"@en ;
                                    rdfs:label "has CAS nr"@en .


###  https://w3id.org/polymat/hasID
<https://w3id.org/polymat/hasID> rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment """An Identifier (ID) is one or more characters used to identify, name, or characterize the nature, properties, or contents of a thing.
(http://purl.obolibrary.org/obo/NCIT_C25364)"""@en ;
                                 rdfs:label "has ID"@en .


###  https://w3id.org/polymat/hasIUPACName
<https://w3id.org/polymat/hasIUPACName> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( <https://w3id.org/polymat/Monomer>
                                                                    <https://w3id.org/polymat/Polymer>
                                                                    <https://w3id.org/polymat/Substance>
                                                                  )
                                                    ] ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "IUPAC name is a name of a chemical compound according to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature"@en ;
                                        rdfs:label "has IUPAC name"@en .


###  https://w3id.org/polymat/hasOrderNumber
<https://w3id.org/polymat/hasOrderNumber> rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf <https://w3id.org/polymat/hasID> ;
                                          rdfs:domain <https://w3id.org/polymat/ExperimentRequestSubmission> ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "An order number is a reference number assigned to an experiment when it is submitted for processing."@en ;
                                          rdfs:label "has order number"@en .


###  https://w3id.org/polymat/hasPath
<https://w3id.org/polymat/hasPath> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <https://w3id.org/polymat/DigitalData> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "A path represents the location or address of a file or directory within the file system hierarchy."@en ;
                                   rdfs:label "has path"@en .


###  https://w3id.org/polymat/hasProductID
<https://w3id.org/polymat/hasProductID> rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf <https://w3id.org/polymat/hasID> ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment """A product ID is a permanent, unique identifier assigned to a product by its producer.
(https://ode.rsl.wustl.edu/mars/pagehelp/Content/Frequently_Asked_Questions/Product_ID.htm?Highlight=Product%20ID)"""@en ;
                                        rdfs:label "has product ID"@en .


###  https://w3id.org/polymat/hasRequestSubmissionType
<https://w3id.org/polymat/hasRequestSubmissionType> rdf:type owl:DatatypeProperty ;
                                                    rdfs:domain <https://w3id.org/polymat/ExperimentRequestSubmission> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "A request submission type is an experiment submission type description, e.g. synthesis, fabrication, analysis."@en ;
                                                    rdfs:label "has request submission type"@en .


###  https://w3id.org/polymat/hasVersion
<https://w3id.org/polymat/hasVersion> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <https://w3id.org/polymat/Software> ;
                                      rdfs:range xsd:string ;
                                      rdfs:comment "A version is a specific release of a software system, application, library or any other piece of software"@en ;
                                      rdfs:label "has version"@en .


###  https://w3id.org/polymat/submissionEndedAt
<https://w3id.org/polymat/submissionEndedAt> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://w3id.org/polymat/ExperimentRequestSubmission> ;
                                             rdfs:range xsd:dateTime ;
                                             rdfs:comment "end time and date of a given experiment submission"@en ;
                                             rdfs:label "submission ended at"@en .


###  https://w3id.org/polymat/submissionStartedAt
<https://w3id.org/polymat/submissionStartedAt> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://w3id.org/polymat/ExperimentRequestSubmission> ;
                                               rdfs:range xsd:dateTime ;
                                               rdfs:comment "start time and date of a given experiment submission"@en ;
                                               rdfs:label "submission started at"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000002
<http://purl.obolibrary.org/obo/BFO_0000002> rdf:type owl:Class ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "008-BFO" ;
                                             rdfs:label "continuant"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .


###  http://purl.obolibrary.org/obo/BFO_0000003
<http://purl.obolibrary.org/obo/BFO_0000003> rdf:type owl:Class ;
                                             <http://purl.org/dc/elements/1.1/identifier> "077-BFO" ;
                                             rdfs:label "occurrent"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .


###  http://purl.obolibrary.org/obo/BFO_0000004
<http://purl.obolibrary.org/obo/BFO_0000004> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "017-BFO" ;
                                             rdfs:label "Independent continuant"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .


###  http://purl.obolibrary.org/obo/BFO_0000006
<http://purl.obolibrary.org/obo/BFO_0000006> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "035-BFO" ;
                                             rdfs:label "spatial region"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
<http://purl.obolibrary.org/obo/BFO_0000015> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ,
                                                             <http://www.w3.org/ns/prov#Activity> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "083-BFO" ;
                                             rdfs:label "process"@en ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> "event"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
<http://purl.obolibrary.org/obo/BFO_0000017> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "058-BFO" ;
                                             rdfs:label "realizable entity"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
<http://purl.obolibrary.org/obo/BFO_0000019> rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/BFO_0000020
<http://purl.obolibrary.org/obo/BFO_0000020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "050-BFO" ;
                                             rdfs:label "specifically dependent continuant"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en ,
                                                                                           "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .


###  http://purl.obolibrary.org/obo/BFO_0000023
<http://purl.obolibrary.org/obo/BFO_0000023> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "061-BFO" ;
                                             rdfs:label "Role"@en ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> "externally-grounded realizable entity"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en .


###  http://purl.obolibrary.org/obo/BFO_0000031
<http://purl.obolibrary.org/obo/BFO_0000031> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "074-BFO" ;
                                             rdfs:label "generically dependent continuant"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "b is a generically dependent continuant =Def b is a continuant & there is some time t such that there is some independent continuant c & b s-depends_on c at t"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "A symphony; a score of a film; a patent; a plan; a procedure; a software algorithm"@en .


###  http://purl.obolibrary.org/obo/BFO_0000040
<http://purl.obolibrary.org/obo/BFO_0000040> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ,
                                                             <http://www.w3.org/ns/prov#Entity> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "019-BFO" ;
                                             rdfs:label "Material entity"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "A human being; the undetached arm of a human being; an aggregate of human beings"@en .


###  http://purl.obolibrary.org/obo/BFO_0000141
<http://purl.obolibrary.org/obo/BFO_0000141> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             <http://purl.org/dc/elements/1.1/identifier> "028-BFO" ;
                                             rdfs:label "Immaterial entity"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en ;
                                             <http://www.w3.org/2004/02/skos/core#example> "As for fiat point, fiat line, fiat surface, site"@en .


###  http://purl.obolibrary.org/obo/CHEBI_24431
<http://purl.obolibrary.org/obo/CHEBI_24431> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
                                             rdfs:comment "A chemical entity is a physical entity of interest in chemistry including molecular entities, parts thereof, and chemical substances."@en ;
                                             rdfs:label "Chemical entity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration
<http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration> rdf:type owl:Class ;
                                                                                           rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                                           rdfs:comment """A measure of the concentration of a chemical species, in particular, of a solute in a solution, in terms of amount of substance per unit volume of solution
(https://en.wikipedia.org/wiki/Molar_concentration)"""@en ;
                                                                                           rdfs:label "Amount of substance concentration"@en ;
                                                                                           <http://www.w3.org/2004/02/skos/core#altLabel> "Amount concentration"@en ,
                                                                                                                                          "Molar concentration"@en ,
                                                                                                                                          "Molarity"@en ,
                                                                                                                                          "Substance concentration"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress
<http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress> rdf:type owl:Class ;
                                                                              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Stress> ;
                                                                              rdfs:comment "Stress acting to compress an object, i.e. the force per unit area directed towards the material. Declared locally (subclass of om:Stress) so that gmat:CompressiveStrength remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                                                                              rdfs:label "Compressive stress"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Length
<http://www.ontology-of-units-of-measure.org/resource/om-2/Length> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                   rdfs:comment "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval."@en ;
                                                                   rdfs:label "Length"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Measure
<http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> rdf:type owl:Class ;
                                                                    rdfs:comment "A measure combines a number to a unit of measure. For example, \"3 m\" is a measure."@en ;
                                                                    rdfs:label "measure"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity
<http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                                rdfs:comment """the ratio of tensile stress to tensile strain of a material
(http://purl.allotrope.org/ontologies/quality#AFQ_0000341)"""@en ;
                                                                                rdfs:label "Modulus of elasticity"@en ;
                                                                                <http://www.w3.org/2004/02/skos/core#altLabel> "Young’s modulus"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Permeability-EarthScience
<http://www.ontology-of-units-of-measure.org/resource/om-2/Permeability-EarthScience> rdf:type owl:Class ;
                                                                                      rdfs:subClassOf <https://w3id.org/polymat/Permeability-Diffusion> ;
                                                                                      rdfs:comment """The permeability multiplied by the permeating fluids' viscosity, it is commonly used for porous solids such as rocks

k = eta･V･d / (A･t･p) = eta･nu･d/p = eta･D/p

k = permeability (earth science)
V = Volume of the permeate [m³]
nu = velocity of the permeate [m/s]
eta = dynamic viscosoty of the permeate [Pa･s]
d = thickness of the rock [m]
A = area of the rock [m²]
t = time of diffusion [s]
p = pressure difference [atm]
D = Diffusion coefficient = diffusivity [m²/s]

The SI unit of the permeability (earth science) is m², commonly called Darcy"""@en ;
                                                                                      rdfs:label "Permeability (earth science)"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Point
<http://www.ontology-of-units-of-measure.org/resource/om-2/Point> rdf:type owl:Class ;
                                                                  rdfs:comment "A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature."@en ;
                                                                  rdfs:label "point"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure
<http://www.ontology-of-units-of-measure.org/resource/om-2/Pressure> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                     rdfs:comment "Pressure is the force applied perpendicular to the surface of an object per unit area. In sol-gel processing it covers autoclave and supercritical drying pressures, vacuum levels, and gas pressures. Declared locally so the class is available without resolving the OM-2 import"@en ;
                                                                     rdfs:label "Pressure"@en ;
                                                                     :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity
<http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> rdf:type owl:Class ;
                                                                     rdfs:subClassOf <https://w3id.org/polymat/Feature> ;
                                                                     rdfs:comment """A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, a molecule, or a food product). Quantities are classified according to similarity in their (implicit) metrological aspect, e.g. the length of my table and the length of my chair are both classified as length.
"""@en ;
                                                                     rdfs:label "Quantity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity
<http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity> rdf:type owl:Class ;
                                                                                 rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                                 rdfs:comment "Specific heat capacity is the amount of heat required to raise the temperature of a unit mass of substance by one kelvin. Declared locally so that gmat:SpecificHeatCapacity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                                                                                 rdfs:label "Specific heat capacity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Stress
<http://www.ontology-of-units-of-measure.org/resource/om-2/Stress> rdf:type owl:Class ;
                                                                   owl:equivalentClass <https://w3id.org/polymat/Stress> ;
                                                                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                   rdfs:comment "Stress is the internal force per unit area within a material that arises from externally applied forces. Declared locally so that gmat:FlexuralStrength and om:CompressiveStress remain under om:Quantity even when the OM-2 import is not resolved"@en ;
                                                                   rdfs:label "Stress"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature
<http://www.ontology-of-units-of-measure.org/resource/om-2/Temperature> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                        rdfs:comment "Temperature is the extent to which an object is hot"@en ;
                                                                        rdfs:label "Temperature"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity
<http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                                rdfs:comment "Thermal conductivity is the property of a material to conduct heat. Declared locally so that gmat:ThermalConductivity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                                                                                rdfs:label "Thermal conductivity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity
<http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity> rdf:type owl:Class ;
                                                                               rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                               rdfs:comment "Thermal diffusivity is the thermal conductivity divided by density and specific heat capacity at constant pressure. Declared locally so that gmat:ThermalDiffusivity remains under om:Quantity even when the OM-2 import is not resolved"@en ;
                                                                               rdfs:label "Thermal diffusivity"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness
<http://www.ontology-of-units-of-measure.org/resource/om-2/Thickness> rdf:type owl:Class ;
                                                                      rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Length> ;
                                                                      rdfs:comment "The smallest dimension of a flat object, usually a mean value of several measurements"@en ;
                                                                      rdfs:label "Thickness"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Time
<http://www.ontology-of-units-of-measure.org/resource/om-2/Time> rdf:type owl:Class ;
                                                                 rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                 rdfs:comment "Time is a base quantity in the International System of Units and other systems of units. It is measured by numbers of repetitions of cyclical events."@en ;
                                                                 rdfs:label "Time"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Unit
<http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> rdf:type owl:Class ;
                                                                 rdfs:comment "A unit of measure is a definite magnitude of a quantity, defined and adopted by convention or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"."@en ;
                                                                 rdfs:label "unit"@en .


###  http://www.ontology-of-units-of-measure.org/resource/om-2/Volume
<http://www.ontology-of-units-of-measure.org/resource/om-2/Volume> rdf:type owl:Class ;
                                                                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                                                                   rdfs:comment """Volume is a measure of how much three-dimensional space any phenomenon occupies. It is a derived quantity in the International System of Units

Volume is length to the power 3"""@en ;
                                                                   rdfs:label "Volume"@en .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class ;
                                     owl:disjointWith <http://www.w3.org/ns/prov#Entity> ;
                                     rdfs:comment "something that occurs over a period of time and acts upon or with entities. It may include consuming, processing, transforming, modifying, relocating, using, or generating entities"@en ;
                                     rdfs:label "Activity"@en .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  owl:disjointWith <http://www.w3.org/ns/prov#InstantaneousEvent> ;
                                  rdfs:comment "something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity"@en ;
                                  rdfs:label "Agent"@en .


###  http://www.w3.org/ns/prov#AgentInfluence
<http://www.w3.org/ns/prov#AgentInfluence> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/ns/prov#Influence> ;
                                           rdfs:comment "the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other"@en ;
                                           rdfs:label "Agent influence"@en .


###  http://www.w3.org/ns/prov#Association
<http://www.w3.org/ns/prov#Association> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.w3.org/ns/prov#AgentInfluence> ;
                                        rdfs:comment "an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity"@en ;
                                        rdfs:label "Association"@en .


###  http://www.w3.org/ns/prov#Attribution
<http://www.w3.org/ns/prov#Attribution> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://www.w3.org/ns/prov#AgentInfluence> ;
                                        rdfs:comment "the ascribing of an entity to an agent"@en ;
                                        rdfs:label "Attribution"@en .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class ;
                                   owl:disjointWith <http://www.w3.org/ns/prov#InstantaneousEvent> ;
                                   rdfs:comment """a physical, digital, conceptual, or other kind of thing with some fixed aspects
(http://www.w3.org/ns/prov#Entity)"""@en ;
                                   rdfs:label "Entity"@en .


###  http://www.w3.org/ns/prov#EntityInfluence
<http://www.w3.org/ns/prov#EntityInfluence> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.w3.org/ns/prov#Influence> ;
                                            rdfs:comment "the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other"@en ;
                                            rdfs:label "Entity influence"@en .


###  http://www.w3.org/ns/prov#Influence
<http://www.w3.org/ns/prov#Influence> rdf:type owl:Class ;
                                      rdfs:comment "the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation"@en ;
                                      rdfs:label "Influence"@en .


###  http://www.w3.org/ns/prov#InstantaneousEvent
<http://www.w3.org/ns/prov#InstantaneousEvent> rdf:type owl:Class ;
                                               rdfs:comment "marks a transition in the world. Instantaneous events include generation, usage, or invalidation of entities, as well as starting or ending of activities"@en ;
                                               rdfs:label "Instantaneous event"@en .


###  http://www.w3.org/ns/prov#Person
<http://www.w3.org/ns/prov#Person> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
                                   rdfs:comment "Person agents are people."@en ;
                                   rdfs:label "Person"@en .


###  http://www.w3.org/ns/prov#Role
<http://www.w3.org/ns/prov#Role> rdf:type owl:Class ;
                                 rdfs:comment "the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end"@en ;
                                 rdfs:label "Role"@en .


###  http://www.w3.org/ns/prov#Usage
<http://www.w3.org/ns/prov#Usage> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://www.w3.org/ns/prov#EntityInfluence> ,
                                                  <http://www.w3.org/ns/prov#InstantaneousEvent> ;
                                  rdfs:comment "the beginning of utilizing an entity by an activity"@en ;
                                  rdfs:label "Usage"@en .


###  https://w3id.org/gelmat/APDAerogelSynthesis
:APDAerogelSynthesis rdf:type owl:Class ;
                     rdfs:subClassOf :AerogelSynthesis ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                       owl:someValuesFrom :AmbientPressureDrying
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                       owl:someValuesFrom :SurfaceModification
                                     ] ;
                     rdfs:comment "An aerogel synthesis route using ambient pressure drying (APD). Requires a surface modification step (typically silylation with TMCS or HMDS) between solvent exchange and drying to prevent capillary collapse during the drying step"@en ;
                     rdfs:label "Ambient pressure drying aerogel synthesis"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "APD synthesis"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An aerogel synthesis route in which the wet gel is dried at ambient pressure after mandatory surface silylation; avoids high-pressure equipment of supercritical drying by preventing capillary collapse through hydrophobic surface modification"@en .


###  https://w3id.org/gelmat/APTES
:APTES rdf:type owl:Class ;
       rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/Accupyc
:Accupyc rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
         rdfs:comment "A gas pycnometer device for measuring skeletal densities of solid materials using helium displacement."@en ;
         rdfs:label "Accupyc"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A gas displacement pycnometer instrument used to measure the skeletal density of solid materials by helium displacement"@en .


###  https://w3id.org/gelmat/AceticAcid
:AceticAcid rdf:type owl:Class ;
            rdfs:subClassOf :AcidCatalyst .


###  https://w3id.org/gelmat/Acetone
:Acetone rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
         rdfs:comment "A volatile organic solvent (CH3COCH3) commonly used in solvent exchange for aerogel synthesis due to low surface tension and miscibility with alcohols"@en ;
         rdfs:label "Acetone"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The ketone solvent propan-2-one (CH3COCH3), used in solvent exchange during aerogel synthesis owing to its miscibility and volatility"@en .


###  https://w3id.org/gelmat/Acid
:Acid rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
      rdfs:comment "A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid). Acids serve as catalysts in many sol-gel processes for aerogel synthesis"@en ;
      rdfs:label "Acid"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A chemical entity capable of donating a proton (Bronsted acid) or accepting an electron pair (Lewis acid)"@en .


###  https://w3id.org/gelmat/AcidCatalysis
:AcidCatalysis rdf:type owl:Class ;
               rdfs:subClassOf :Gelation ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :usesSubstance ;
                                 owl:someValuesFrom :AcidCatalyst
                               ] ;
               owl:disjointWith :BaseCatalysis ,
                                :TwoStepCatalysis ;
               rdfs:comment "Sol-gel gelation under acid-catalytic conditions (pH < 7). Promotes fast hydrolysis and slower condensation, yielding weakly branched, polymeric gel structures with smaller pores"@en ;
               rdfs:label "Acid-catalysed gelation"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Acid catalysis"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Gelation performed at pH below 7, where protonation of alkoxide leaving groups accelerates hydrolysis relative to condensation, yielding weakly branched, polymeric gel networks with small pores"@en .


###  https://w3id.org/gelmat/AcidCatalysisPathway
:AcidCatalysisPathway rdf:type owl:Class ;
                      rdfs:subClassOf :GelationPathway ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :realisedAs ;
                                        owl:someValuesFrom :AcidCatalysis
                                      ] ;
                      rdfs:label "Acid Catalysis Pathway"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway realised through acid catalysis: pre-hydrolysis at low pH followed by slow condensation, producing weakly branched polymeric network gels with small, homogeneous pores."@en .


###  https://w3id.org/gelmat/AcidCatalyst
:AcidCatalyst rdf:type owl:Class ;
              rdfs:subClassOf :Acid ;
              rdfs:comment "A Bronsted or Lewis acid used specifically as a catalyst in sol-gel hydrolysis and condensation reactions (e.g. HCl, HNO3, acetic acid, oxalic acid). Convenience class typed by chemical nature; the primary way to state that a substance functions as a catalyst in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a pmat:Catalyst]"@en ;
              rdfs:label "Acid catalyst"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Acid catalytic agent"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "An acid employed as a catalyst; in sol-gel processing, promotes hydrolysis of alkoxide precursors under acidic conditions"@en .


###  https://w3id.org/gelmat/AcousticInsulation
:AcousticInsulation rdf:type owl:Class ;
                    rdfs:subClassOf :Application ;
                    rdfs:comment "Use of a material to attenuate sound transmission, exploiting the low sound velocity in aerogels"@en ;
                    rdfs:label "Acoustic insulation"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The application of a material as a barrier against sound transmission"@en .


###  https://w3id.org/gelmat/Activation
:Activation rdf:type owl:Class ;
            rdfs:subClassOf :ThermalTreatment ;
            rdfs:comment "Physical (CO2, steam) or chemical (KOH, ZnCl2) activation of carbon aerogels at high temperature to develop microporosity and increase surface area"@en ;
            rdfs:label "Activation"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A thermal treatment in which a reactive agent etches microporosity into a carbon material to increase its surface area"@en .


###  https://w3id.org/gelmat/ActivationEnergy
:ActivationEnergy rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                  rdfs:comment "The minimum energy required to initiate a chemical reaction; used in Arrhenius analysis of gelation kinetics. Typically expressed in kJ/mol"@en ;
                  rdfs:label "Activation energy"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Ea"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the minimum energy required to initiate a chemical reaction, obtained in this domain from Arrhenius analysis of gelation kinetics"@en ;
                  :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerMole> .


###  https://w3id.org/gelmat/Adsorption
:Adsorption rdf:type owl:Class ;
            rdfs:subClassOf :Application ;
            rdfs:comment "Use of a material as sorbent - oil and organic solvent uptake, CO2 capture, water treatment, gas storage"@en ;
            rdfs:label "Adsorption"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Sorption"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The application of a material as a sorbent for liquids, gases, or dissolved species"@en .


###  https://w3id.org/gelmat/Aerogel
:Aerogel rdf:type owl:Class ;
         rdfs:subClassOf :Gel ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasDensity ;
                           owl:someValuesFrom :Density
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasSurfaceArea ;
                           owl:someValuesFrom :SurfaceArea
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :wasProducedBy ;
                           owl:someValuesFrom <https://w3id.org/polymat/Drying>
                         ] ;
         owl:disjointWith :Alcogel ,
                          :Hydrogel ,
                          :Xerogel ;
         rdfs:comment "An aerogel is a porous solid material obtained by replacing the liquid phase of a gel with a gas, typically through supercritical drying, while largely retaining the gel’s original network structure."@en ;
         rdfs:label "Aerogel"@en ;
         <http://www.w3.org/2004/02/skos/core#closeMatch> <http://emmo.info/emmo#EMMO_4207e895> ,
                                                          <https://w3id.org/pmd/co/Material> ;
         <http://www.w3.org/2004/02/skos/core#definition> "A porous solid material derived from a gel in which the liquid component has been replaced by a gas without significant collapse of the solid network structure, yielding extremely low density, high porosity, and high specific surface area"@en .


###  https://w3id.org/gelmat/AerogelDefect
:AerogelDefect rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Feature> ;
               rdfs:comment "A structural or quality defect borne by an aerogel — a persisting deviation from the intended structure or quality that arises during synthesis or processing. Subclasses denote the defect state (a specifically dependent continuant inhering in the material), not the formation event; the event that produces a defect should be modelled as a process if needed."@en ;
               rdfs:label "Aerogel defect"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A specifically dependent continuant feature of an aerogel material that constitutes a deviation from the intended structure, composition, or quality of the material"@en .


###  https://w3id.org/gelmat/AerogelSynthesis
:AerogelSynthesis rdf:type owl:Class ;
                  rdfs:subClassOf :CreationProcess ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                    owl:someValuesFrom :Gelation
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                    owl:someValuesFrom :SolFormation
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                    owl:someValuesFrom <https://w3id.org/polymat/Drying>
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :usesSubstance ;
                                    owl:someValuesFrom <https://w3id.org/polymat/Monomer>
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :usesSubstance ;
                                    owl:someValuesFrom [ owl:intersectionOf ( <https://w3id.org/polymat/Substance>
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/prov#hadRole> ;
                                                                                owl:someValuesFrom <https://w3id.org/polymat/Catalyst>
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ]
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :usesSubstance ;
                                    owl:someValuesFrom [ owl:intersectionOf ( <https://w3id.org/polymat/Substance>
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://www.w3.org/ns/prov#hadRole> ;
                                                                                owl:someValuesFrom <https://w3id.org/polymat/Solvent>
                                                                              ]
                                                                            ) ;
                                                         rdf:type owl:Class
                                                       ]
                                  ] ;
                  rdfs:comment "The complete process of synthesizing aerogels from precursor materials through sol-gel chemistry followed by a drying step. Only sol formation, gelation, and drying are asserted as required parts (owl:someValuesFrom); aging, solvent exchange, and surface modification are common but optional steps that many published syntheses omit, so they carry no existential restriction here — asserting them would make every extracted synthesis without such a step inconsistent under OWL reasoning"@en ;
                  rdfs:label "Aerogel synthesis"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The complete multi-step process of producing an aerogel from precursor substances, comprising at minimum sol formation, gelation, and a drying step that preserves pore structure; aging, solvent exchange, and surface modification are frequent optional steps"@en .


###  https://w3id.org/gelmat/Aging
:Aging rdf:type owl:Class ;
       rdfs:subClassOf :CreationProcess ;
       rdfs:comment "Post-gelation maturation process where the gel network strengthens through continued condensation reactions and Ostwald ripening. Typically performed by keeping the wet gel immersed in solvent at elevated temperature"@en ;
       rdfs:label "Aging"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "Post-gelation maturation in which the wet gel is kept immersed in solvent at elevated temperature to strengthen the network via continued condensation reactions, Ostwald ripening, and syneresis, reducing later shrinkage during drying"@en ;
       :hasStepOrder "3"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/Air
:Air rdf:type owl:Class ;
     rdfs:subClassOf :Gas ;
     rdfs:comment "Ambient air, the oxidising atmosphere of calcination and of ambient pressure drying"@en ;
     rdfs:label "Air"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "The ambient gas mixture of nitrogen and oxygen, used as oxidising process atmosphere"@en .


###  https://w3id.org/gelmat/Alcogel
:Alcogel rdf:type owl:Class ;
         rdfs:subClassOf :WetGel ;
         owl:disjointWith :Hydrogel ;
         rdfs:comment "An alcogel is a gel in which the liquid phase consists mainly of an alcohol or alcohol-rich solvent mixture."@en ;
         rdfs:label "Alcogel"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A wet gel in which the liquid pore phase consists primarily of an alcohol or alcohol-rich solvent mixture, formed after solvent exchange from the initial aqueous sol or directly from alkoxide precursors"@en .


###  https://w3id.org/gelmat/Alcohol
:Alcohol rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
         rdfs:comment "Any organic compound containing one or more hydroxyl groups bound to saturated carbon; commonly used as solvent or reagent"@en ;
         rdfs:label "Alcohol"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An organic compound bearing one or more hydroxyl groups bound to saturated carbon atoms"@en .


###  https://w3id.org/gelmat/Alginate
:Alginate rdf:type owl:Class ;
          rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/AlkoxideSolution
:AlkoxideSolution rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
                  rdfs:comment "A solution containing metal alkoxide precursor dissolved in organic solvent, prepared as an intermediate in sol-gel synthesis"@en ;
                  rdfs:label "Alkoxide solution"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A solution of a metal or silicon alkoxide precursor in an organic solvent, prepared as an intermediate in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/AluminaAerogel
:AluminaAerogel rdf:type owl:Class ;
                rdfs:subClassOf :MetalOxideAerogel ;
                rdfs:comment "An aerogel with an Al2O3 network, typically from aluminium sec-butoxide (Yoldas route) or AlCl3/epoxide routes; valued for high-temperature stability"@en ;
                rdfs:label "Alumina aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Al2O3 aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A metal oxide aerogel whose solid framework consists of aluminium oxide"@en .


###  https://w3id.org/gelmat/AluminiumSecButoxide
:AluminiumSecButoxide rdf:type owl:Class ;
                      rdfs:subClassOf :MetalAlkoxide .


###  https://w3id.org/gelmat/AmbientPressureDrying
:AmbientPressureDrying rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/polymat/Drying> ;
                       rdfs:comment "Drying method performed at atmospheric pressure, typically requiring surface modification to prevent capillary collapse"@en ;
                       rdfs:label "Ambient pressure drying"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "APD"@en ,
                                                                      "Evaporative drying"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A drying method performed at atmospheric pressure in which capillary collapse is prevented by prior surface silylation of the gel, allowing the hydrophobic network to spring back after compression and recover its pore volume"@en .


###  https://w3id.org/gelmat/Ambigel
:Ambigel rdf:type owl:Class ;
         rdfs:subClassOf :Gel ;
         rdfs:comment "A dried gel obtained by ambient pressure (evaporative) drying under conditions that largely preserve the pore network (surface modification, low-surface-tension solvent); intermediate between xerogel and aerogel"@en ;
         rdfs:label "Ambigel"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A dried gel produced by ambient pressure drying with measures that substantially preserve the mesoporous network"@en .


###  https://w3id.org/gelmat/AmmoniumCompound
:AmmoniumCompound rdf:type owl:Class ;
                  rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
                  rdfs:comment "A compound containing the ammonium cation (NH4+); includes salts and aqueous ammonia species used in catalysis and pH control"@en ;
                  rdfs:label "Ammonium Compound"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A chemical compound containing the ammonium cation (NH4+)"@en .


###  https://w3id.org/gelmat/AmmoniumFluoride
:AmmoniumFluoride rdf:type owl:Class ;
                  rdfs:subClassOf :FluorideSalt ;
                  rdfs:comment "NH4F, a water-soluble fluoride salt used as an additive or etchant; can influence hydrolysis/condensation kinetics in silica sol–gel systems"@en ;
                  rdfs:label "Ammonium fluoride"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The water-soluble fluoride salt NH4F, used as an additive that modifies condensation kinetics in silica sol-gel systems"@en .


###  https://w3id.org/gelmat/AmmoniumHydroxide
:AmmoniumHydroxide rdf:type owl:Class ;
                   rdfs:subClassOf :AmmoniumCompound ;
                   rdfs:comment "Aqueous ammonia solution (NH3·H2O) commonly referred to as ammonium hydroxide; provides basic conditions and acts as a base catalyst in sol–gel reactions"@en ;
                   rdfs:label "Ammonium Hydroxide"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An aqueous solution of ammonia that provides basic conditions and acts as a base catalyst in sol-gel reactions"@en ;
                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_51302> .


###  https://w3id.org/gelmat/Application
:Application rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
             rdfs:comment "An intended or demonstrated use of a material. Modelled as a BFO realizable entity borne by the material and linked from it with gmat:hasApplication"@en ;
             rdfs:label "Application"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A realizable entity representing an intended or demonstrated field of use of a material"@en .


###  https://w3id.org/gelmat/Argon
:Argon rdf:type owl:Class ;
       rdfs:subClassOf :Gas .


###  https://w3id.org/gelmat/ArrheniusConstant
:ArrheniusConstant rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                   rdfs:comment "The pre-exponential factor (A) in the Arrhenius equation k = A·exp(−Ea/RT), representing the frequency of molecular collisions with correct orientation. Units match the rate constant (e.g., s⁻¹ for first-order reactions)"@en ;
                   rdfs:label "Arrhenius pre-exponential factor"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Arrhenius constant"@en ,
                                                                  "Frequency factor"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the pre-exponential factor A in the Arrhenius equation, reflecting the frequency of correctly oriented molecular collisions"@en ;
                   :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalSecond-Time> .


###  https://w3id.org/gelmat/BETAnalysis
:BETAnalysis rdf:type owl:Class ;
             rdfs:subClassOf :PorosityMeasurement ;
             owl:disjointWith :BJHAnalysis ;
             rdfs:comment "Brunauer-Emmett-Teller analysis for determining specific surface area from gas adsorption isotherms"@en ;
             rdfs:label "BET analysis"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A porosity measurement in which specific surface area is determined from a gas adsorption isotherm using the Brunauer-Emmett-Teller model"@en .


###  https://w3id.org/gelmat/BJHAnalysis
:BJHAnalysis rdf:type owl:Class ;
             rdfs:subClassOf :PorosityMeasurement ;
             rdfs:comment "Barrett-Joyner-Halenda analysis for determining pore size distribution from gas desorption isotherms"@en ;
             rdfs:label "BJH analysis"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A porosity measurement in which pore size distribution is determined from a gas desorption isotherm using the Barrett-Joyner-Halenda model"@en .


###  https://w3id.org/gelmat/BTMSE
:BTMSE rdf:type owl:Class ;
       rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/Base
:Base rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
      rdfs:comment "A Bronsted base capable of accepting a proton. Bases serve as catalysts for condensation reactions in sol-gel processing (e.g. ammonium hydroxide, ammonium fluoride, sodium hydroxide)"@en ;
      rdfs:label "Base"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A chemical entity capable of accepting a proton (Bronsted base) or donating an electron pair (Lewis base)"@en .


###  https://w3id.org/gelmat/BaseCatalysis
:BaseCatalysis rdf:type owl:Class ;
               rdfs:subClassOf :Gelation ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :usesSubstance ;
                                 owl:someValuesFrom :Base
                               ] ;
               rdfs:comment "Sol-gel gelation under basic conditions (pH > 7). Promotes fast condensation and slower hydrolysis, yielding highly branched, colloidal cluster networks with larger pore sizes"@en ;
               rdfs:label "Base-catalysed gelation"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Base catalysis"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Gelation performed at pH above 7, where hydroxide ions catalyse condensation faster than hydrolysis, yielding highly branched, colloidal cluster-cluster aggregation networks with larger pore sizes"@en .


###  https://w3id.org/gelmat/BaseCatalysisPathway
:BaseCatalysisPathway rdf:type owl:Class ;
                      rdfs:subClassOf :GelationPathway ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :realisedAs ;
                                        owl:someValuesFrom :BaseCatalysis
                                      ] ;
                      rdfs:label "Base Catalysis Pathway"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway realised through base catalysis: fast condensation relative to hydrolysis at high pH, producing highly branched colloidal aggregation networks with larger pore sizes."@en .


###  https://w3id.org/gelmat/BaseCatalyst
:BaseCatalyst rdf:type owl:Class ;
              rdfs:subClassOf :Base ;
              rdfs:comment "A class of chemical substances that provide basic conditions or catalyze base-mediated reactions (e.g., deprotonation, nucleophilic activation) in a process. Convenience class typed by chemical nature; the primary way to state that a substance functions as a catalyst in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a pmat:Catalyst]"@en ;
              rdfs:label "Base Catalyst"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A base employed as a catalyst; in sol-gel processing, promotes condensation reactions under basic conditions"@en .


###  https://w3id.org/gelmat/Beads
:Beads rdf:type owl:Class ;
       rdfs:subClassOf :Geometry ;
       rdfs:comment "Small spherical or granule-shaped material geometry, often produced by dropping sol into a bath or dispersion."@en ;
       rdfs:label "Beads"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "A sample geometry consisting of small spherical or granular pieces, often produced by dropping a sol into a bath or dispersion"@en .


###  https://w3id.org/gelmat/BioAerogel
:BioAerogel rdf:type owl:Class ;
            rdfs:subClassOf :PolymerAerogel ;
            rdfs:comment "An aerogel derived from biological materials such as cellulose, chitosan, alginate, or proteins"@en ;
            rdfs:label "Biopolymer aerogel"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A polymer aerogel derived from biopolymers such as cellulose, chitosan, alginate, or proteins"@en .


###  https://w3id.org/gelmat/BiopolymerPrecursor
:BiopolymerPrecursor rdf:type owl:Class ;
                     rdfs:subClassOf :Precursor ;
                     rdfs:comment "A natural polymer (polysaccharide or protein) that forms a bio-aerogel network by physical or ionic gelation: cellulose, nanocellulose, chitosan, alginate, pectin, gelatin, starch"@en ;
                     rdfs:label "Biopolymer precursor"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A natural polymer used as the network-forming precursor of a bio-aerogel"@en .


###  https://w3id.org/gelmat/BulkDensity
:BulkDensity rdf:type owl:Class ;
             rdfs:subClassOf :Density ;
             rdfs:comment "The mass of a porous body divided by its envelope (geometric) volume, including the pore space. The most commonly reported density of aerogels, typically 1-500 kg/m3 (0.001-0.5 g/cm3) for silica aerogels; determined geometrically or by envelope (powder displacement) pycnometry"@en ;
             rdfs:label "Bulk density"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Apparent density"@en ,
                                                            "Envelope density"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The density of a porous material computed over its envelope volume, i.e. including both the solid skeleton and the gas-filled pore space"@en ;
             :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> .


###  https://w3id.org/gelmat/BulkDensityMeasurement
:BulkDensityMeasurement rdf:type owl:Class ;
                        rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                        rdfs:comment "Determination of bulk (envelope) density (gmat:BulkDensity), usually geometrically from mass and dimensions of a regular monolith, or by envelope (powder displacement) pycnometry (e.g. GeoPyc)"@en ;
                        rdfs:label "Bulk density measurement"@en ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Envelope density measurement"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines the envelope density of a sample from its mass and envelope volume"@en .


###  https://w3id.org/gelmat/CO2SupplySystem
:CO2SupplySystem rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
                 rdfs:comment "System for storing and delivering CO2 for supercritical drying processes"@en ;
                 rdfs:label "CO2 supply system"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Equipment that stores and delivers carbon dioxide to a supercritical drying process"@en .


###  https://w3id.org/gelmat/Calcination
:Calcination rdf:type owl:Class ;
             rdfs:subClassOf :ThermalTreatment ;
             rdfs:comment "Thermal treatment in air or oxygen to remove organic residues, dehydroxylate, or crystallise metal oxide networks (e.g. amorphous titania to anatase)"@en ;
             rdfs:label "Calcination"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A thermal treatment in oxidising atmosphere that removes organics or induces crystallisation in oxide materials"@en .


###  https://w3id.org/gelmat/CarbonAerogel
:CarbonAerogel rdf:type owl:Class ;
               rdfs:subClassOf :Aerogel ;
               owl:disjointWith :OrganicAerogel ;
               rdfs:comment "An aerogel with a purely carbonaceous framework, produced by pyrolysis of an organic precursor aerogel (e.g. resorcinol-formaldehyde) above 700 °C in inert atmosphere. The pyrolysis destroys all organic bonds, leaving an electrically conductive elemental carbon network. Not subclassed under OrganicAerogel — carbon aerogels contain no C-H bonds"@en ;
               rdfs:label "Carbon aerogel"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Activated carbon aerogel"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A pyrolysed aerogel whose solid framework consists of elemental (sp² or sp³ hybridised) carbon, distinct from organic aerogels which retain organic polymer backbones"@en .


###  https://w3id.org/gelmat/CarbonDioxide
:CarbonDioxide rdf:type owl:Class ;
               rdfs:subClassOf :Gas .


###  https://w3id.org/gelmat/CarbonFibre
:CarbonFibre rdf:type owl:Class ;
             rdfs:subClassOf :Reinforcement ;
             rdfs:comment "Carbon fibres used as high-temperature-stable, electrically conductive reinforcement in aerogel composites"@en ;
             rdfs:label "Carbon fibre"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Carbon fiber"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A carbon fibre used as reinforcement in aerogel composites"@en .


###  https://w3id.org/gelmat/CarbonNanotube
:CarbonNanotube rdf:type owl:Class ;
                rdfs:subClassOf :Reinforcement .


###  https://w3id.org/gelmat/Casting
:Casting rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
         rdfs:comment "Pouring the sol into a mould (gmat:Mold) where gelation takes place, defining the geometry (monolith, slab) of the resulting gel"@en ;
         rdfs:label "Casting"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Molding"@en ,
                                                        "Moulding"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which a sol is poured into a mould that defines the shape of the gel formed in it"@en .


###  https://w3id.org/gelmat/CatalystSolution
:CatalystSolution rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
                  rdfs:comment "A solution containing catalysts and solvents prepared for mixing with precursor solution to initiate sol-gel reactions"@en ;
                  rdfs:label "Catalyst solution"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A solution of a catalyst in a solvent, prepared for addition to a precursor solution to initiate or accelerate sol-gel reactions"@en .


###  https://w3id.org/gelmat/CatalystSupport
:CatalystSupport rdf:type owl:Class ;
                 rdfs:subClassOf :Application ;
                 rdfs:comment "Use of a high-surface-area material as carrier for catalytically active phases"@en ;
                 rdfs:label "Catalyst support"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The application of a material as a carrier for catalytically active species"@en .


###  https://w3id.org/gelmat/Cellulose
:Cellulose rdf:type owl:Class ;
           rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/CelluloseFibre
:CelluloseFibre rdf:type owl:Class ;
                rdfs:subClassOf :Reinforcement ;
                rdfs:comment "Cellulosic fibres (pulp, cotton, regenerated cellulose) used as bio-based reinforcement in aerogel composites"@en ;
                rdfs:label "Cellulose fibre"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Cellulose fiber"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A cellulosic fibre used as bio-based reinforcement in aerogel composites"@en .


###  https://w3id.org/gelmat/ChainGrowthPolymerisation
:ChainGrowthPolymerisation rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/polymat/PolymerSynthesis> ;
                           rdfs:comment """A reaction in which the growth of a polymer chain proceeds exclusively by reaction between a monomer and the reactive site on the polymer chain with regeneration of the reactive site at the end of each growth step
(http://purl.obolibrary.org/obo/MOP_0000634)"""@en ;
                           rdfs:label "Chain growth polymerisation"@en ;
                           <http://www.w3.org/2004/02/skos/core#definition> "A polymer synthesis in which chain growth proceeds exclusively by reaction between monomer and a reactive site on the growing chain, with regeneration of the reactive site at each step"@en .


###  https://w3id.org/gelmat/Chitosan
:Chitosan rdf:type owl:Class ;
          rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/CitricAcid
:CitricAcid rdf:type owl:Class ;
            rdfs:subClassOf :AcidCatalyst .


###  https://w3id.org/gelmat/Clay
:Clay rdf:type owl:Class ;
      rdfs:subClassOf :Reinforcement ;
      rdfs:comment "Layered clay minerals (montmorillonite, sepiolite, laponite) used as inorganic filler and fire-retardant reinforcement in (bio)polymer aerogel composites"@en ;
      rdfs:label "Clay"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A layered silicate mineral used as filler and reinforcement in aerogel composites"@en .


###  https://w3id.org/gelmat/CoefficientOfDetermination
:CoefficientOfDetermination rdf:type owl:Class ;
                            rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                            rdfs:comment "The coefficient of determination (R²) of a regression fit, quantifying the goodness of fit of a model to experimental data (e.g. an Arrhenius fit of gelation kinetics). Dimensionless, 0-1"@en ;
                            rdfs:label "Coefficient of determination"@en ;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "R-squared"@en ,
                                                                           "R²"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "A dimensionless statistical quantity (0 ≤ R² ≤ 1) expressing the proportion of variance in observed data explained by a fitted model"@en ;
                            :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/CompositeAerogel
:CompositeAerogel rdf:type owl:Class ;
                  rdfs:subClassOf :Aerogel ;
                  rdfs:comment "An aerogel containing reinforcing materials or fillers embedded within the aerogel matrix, such as fiber-reinforced aerogels"@en ;
                  rdfs:label "Composite aerogel"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An aerogel containing reinforcing materials or fillers embedded within the aerogel matrix"@en .


###  https://w3id.org/gelmat/CompressionTesting
:CompressionTesting rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                    rdfs:comment "Measurement of mechanical strength and stress-strain behavior under compressive loads"@en ;
                    rdfs:label "Compression testing"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "An analysis that measures the stress-strain behaviour and strength of a material under compressive load"@en .


###  https://w3id.org/gelmat/CompressiveModulus
:CompressiveModulus rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity> ;
                    rdfs:comment "The ratio of compressive stress to compressive strain in the elastic region of the stress-strain curve, expressed in kPa or MPa. For aerogels this reflects network stiffness and cross-linking density"@en ;
                    rdfs:label "Compressive modulus"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "Young's modulus (compression)"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The elastic modulus measured under uniaxial compression, equal to the slope of the linear region of the compressive stress-strain curve"@en ;
                    :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  https://w3id.org/gelmat/CompressiveStrength
:CompressiveStrength rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/CompressiveStress> ;
                     rdfs:comment "The maximum compressive stress a material can sustain before fracture, yielding, or excessive deformation. A critical mechanical property for structural and load-bearing aerogel applications"@en ;
                     rdfs:label "Compressive strength"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the maximum compressive stress a material can withstand before failure; expressed as an om:Measure with unit kPa or MPa."@en ;
                     :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  https://w3id.org/gelmat/Condensation
:Condensation rdf:type owl:Class ;
              rdfs:subClassOf :CreationProcess ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :usesSubstance ;
                                owl:someValuesFrom :Silanol
                              ] ;
              rdfs:comment "Reaction between silanol groups (Si-OH + HO-Si -> Si-O-Si + H2O) or between silanol and alkoxy groups forming siloxane bonds that build the three-dimensional gel network"@en ;
              rdfs:label "Condensation"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Formation of siloxane (Si-O-Si) network bonds by reaction of silanol intermediates, releasing water or alcohol as by-products"@en .


###  https://w3id.org/gelmat/ContactAngle
:ContactAngle rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
              rdfs:comment "The angle at which a liquid-vapor interface meets a solid surface, quantifying wettability. Key metric for hydrophobic aerogels (contact angle > 90 degrees) and superhydrophobic aerogels (contact angle > 150 degrees)"@en ;
              rdfs:label "Contact angle"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the angle between a liquid droplet interface and a solid surface, used to quantify hydrophobicity; expressed as an om:Measure with unit degrees. Values above 90° indicate hydrophobic surfaces."@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/radian> .


###  https://w3id.org/gelmat/Cooling
:Cooling rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
         rdfs:comment "Controlled reduction of temperature after a thermal step or to induce thermal gelation (e.g. gelatin); the descending counterpart of temperature ramping"@en ;
         rdfs:label "Cooling"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which the temperature of a sample is lowered in a controlled manner"@en .


###  https://w3id.org/gelmat/CoolingSystem
:CoolingSystem rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
               rdfs:comment "Equipment for controlled cooling during processing"@en ;
               rdfs:label "Cooling system"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Equipment that provides controlled cooling during processing"@en .


###  https://w3id.org/gelmat/CorrelationLength
:CorrelationLength rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Length> ;
                   rdfs:comment "The upper cutoff length ξ of fractal scaling in an aerogel network, corresponding to the characteristic cluster (blob) size above which the material appears homogeneous. Obtained from the crossover (knee) in a SAXS/SANS curve; typically a few to tens of nanometres"@en ;
                   rdfs:label "Correlation length"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Cluster size"@en ,
                                                                  "Fractal correlation length"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The correlation length ξ marking the upper length-scale cutoff of fractal self-similarity in a gel network (the characteristic cluster/blob size), determined from the low-q crossover of a scattering curve"@en ;
                   :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> .


###  https://w3id.org/gelmat/Cracking
:Cracking rdf:type owl:Class ;
          rdfs:subClassOf :AerogelDefect ;
          rdfs:comment "The defect state of one or more cracks being present in the aerogel structure. Typically results from capillary stress or rapid pressure/temperature changes during drying — but this class denotes the persisting crack feature, not the crack-formation event."@en ;
          rdfs:label "Crack"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Cracking"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect consisting of one or more fracture discontinuities in the solid network of the material"@en .


###  https://w3id.org/gelmat/CreationProcess
:CreationProcess rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Method> ;
                 rdfs:comment "An action of bringing something into existence"@en ;
                 rdfs:label "Creation process"@en ;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <http://emmo.info/emmo#EMMO_43e99ae1> ,
                                                                  <https://w3id.org/pmd/co/Process> ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A method by which a material entity is brought into existence, comprising the constituent steps of a synthesis workflow"@en .


###  https://w3id.org/gelmat/Crosslinker
:Crosslinker rdf:type owl:Class ;
             rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
             rdfs:comment "A chemical agent that forms bonds between polymer chains to create network structures. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:CrosslinkerRole]"@en ;
             rdfs:label "Crosslinker"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A chemical agent that forms covalent or physical bonds between polymer chains, producing a three-dimensional network structure"@en .


###  https://w3id.org/gelmat/CrosslinkerRole
:CrosslinkerRole rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                 rdfs:comment "The role of a substance that forms bonds between polymer chains or particles in a given step; distinct from the convenience substance class gmat:Crosslinker, which types substances by chemical nature"@en ;
                 rdfs:label "Crosslinker role"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that bridges polymer chains or colloidal particles into a network during a synthesis step"@en .


###  https://w3id.org/gelmat/Cryogel
:Cryogel rdf:type owl:Class ;
         rdfs:subClassOf :Gel ;
         rdfs:comment "A dried gel obtained by freeze drying (lyophilisation) of a wet gel; ice crystal growth typically leaves a more macroporous, often lamellar structure than supercritical drying"@en ;
         rdfs:label "Cryogel"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A dried gel produced by freezing the pore liquid and removing it by sublimation (freeze drying)"@en .


###  https://w3id.org/gelmat/Curing
:Curing rdf:type owl:Class ;
        rdfs:subClassOf :ThermalTreatment ;
        rdfs:comment "Moderate-temperature treatment that completes cross-linking or imidisation of a polymer network (e.g. thermal imidisation of poly(amic acid), post-curing of RF gels)"@en ;
        rdfs:label "Curing"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A thermal treatment that completes the cross-linking reactions of a polymer or hybrid network"@en .


###  https://w3id.org/gelmat/DeionizedWater
:DeionizedWater rdf:type owl:Class ;
                rdfs:subClassOf :Water .


###  https://w3id.org/gelmat/Density
:Density rdf:type owl:Class ;
         rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
         rdfs:comment "The mass per unit volume of a material. Canonical unit: kg/m3 (SI); the lab convention g/cm3 (= 1000 kg/m3) is also common. Bulk density is typically 1-500 kg/m3 (0.001-0.5 g/cm3); skeletal density (determined by He pycnometry) is typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica"@en ;
         rdfs:label "Density"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The ratio of the mass of a material to its volume; for aerogels the bulk density captures the contribution of both the solid skeleton and the gas-filled pore space"@en ;
         :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> .


###  https://w3id.org/gelmat/Depressurization
:Depressurization rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
                  owl:disjointWith :Pressurization ;
                  rdfs:comment "Controlled reduction of pressure during supercritical drying to return to ambient conditions, performed slowly to avoid re-condensation of supercritical fluid"@en ;
                  rdfs:label "Depressurization"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which pressure is reduced in a controlled manner, in supercritical drying performed slowly to avoid re-condensation of the fluid"@en .


###  https://w3id.org/gelmat/Derivation
:Derivation rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/prov#Influence> ;
            rdfs:comment "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity"@en ;
            rdfs:label "Derivation"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing one"@en .


###  https://w3id.org/gelmat/Diamine
:Diamine rdf:type owl:Class ;
         rdfs:subClassOf :PolymerPrecursor ;
         rdfs:comment "An aromatic or aliphatic diamine (e.g. ODA, DMBZ) that reacts with dianhydrides to form the poly(amic acid) intermediate of polyimide aerogels"@en ;
         rdfs:label "Diamine"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A diamine monomer that condenses with dianhydrides to form polyimide networks"@en .


###  https://w3id.org/gelmat/Dianhydride
:Dianhydride rdf:type owl:Class ;
             rdfs:subClassOf :PolymerPrecursor ;
             rdfs:comment "An aromatic tetracarboxylic dianhydride (e.g. PMDA, BPDA) that reacts with diamines to form the poly(amic acid) intermediate of polyimide aerogels"@en ;
             rdfs:label "Dianhydride"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A dianhydride monomer that condenses with diamines to form polyimide networks"@en .


###  https://w3id.org/gelmat/DifferentialScanningCalorimetry
:DifferentialScanningCalorimetry rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/Dimethylformamide
:Dimethylformamide rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> .


###  https://w3id.org/gelmat/DissolutionParticipation
:DissolutionParticipation rdf:type owl:Class ;
                          rdfs:subClassOf :GelationPathway ;
                          rdfs:comment "A gelation pathway mechanism involving significant dissolution and reprecipitation processes"@en ;
                          rdfs:label "Dissolution-participation"@en ;
                          <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway in which dissolution and reprecipitation of solid species contribute significantly to network formation"@en .


###  https://w3id.org/gelmat/DogBone
:DogBone rdf:type owl:Class ;
         rdfs:subClassOf :Geometry ;
         rdfs:comment "A specimen geometry with wider ends and a narrower central region (gauge length), typically used for tensile testing to ensure failure occurs in the gauge section."@en ;
         rdfs:label "Dog Bone"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sample geometry with wider ends and a narrower central gauge region, used in tensile testing to localise failure in the gauge length"@en .


###  https://w3id.org/gelmat/DrugDelivery
:DrugDelivery rdf:type owl:Class ;
              rdfs:subClassOf :Application ;
              rdfs:comment "Use of a (typically bio-)aerogel as carrier for controlled release of pharmaceutical compounds"@en ;
              rdfs:label "Drug delivery"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The application of a material as a carrier for the controlled release of active pharmaceutical ingredients"@en .


###  https://w3id.org/gelmat/Dryer
:Dryer rdf:type owl:Class ;
       rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
       rdfs:comment "Laboratory or industrial equipment designed for removing solvents or moisture from materials through controlled heating, vacuum, or other drying mechanisms"@en ;
       rdfs:label "Dryer"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "Equipment designed to remove solvent or moisture from a material by controlled heating, vacuum, sublimation, or supercritical extraction"@en .


###  https://w3id.org/gelmat/DryingControlAdditiveRole
:DryingControlAdditiveRole rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                           rdfs:comment "The role of a substance added to a sol to reduce capillary stress and prevent cracking during drying (DCCA function, e.g. glycerol, formamide, DMF); distinct from the convenience substance class gmat:DryingControlChemicalAdditive"@en ;
                           rdfs:label "Drying control additive role"@en ;
                           <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that moderates evaporation and capillary stress during drying of a gel"@en .


###  https://w3id.org/gelmat/DryingControlChemicalAdditive
:DryingControlChemicalAdditive rdf:type owl:Class ;
                               rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
                               rdfs:comment "Chemical additives (DCCA) used to reduce capillary stress and prevent cracking during ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:DryingControlAdditiveRole]"@en ;
                               rdfs:label "Drying control chemical additive"@en ;
                               <http://www.w3.org/2004/02/skos/core#altLabel> "DCCA"@en ;
                               <http://www.w3.org/2004/02/skos/core#definition> "A chemical additive incorporated into a sol to reduce capillary stress and prevent cracking during drying"@en .


###  https://w3id.org/gelmat/Duration
:Duration rdf:type owl:Class ;
          rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Time> ;
          rdfs:comment "A quantity representing the length of time over which a process or event occurs, typically expressed in seconds, minutes, or hours"@en ;
          rdfs:label "Duration"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the length of time over which a process or event extends"@en ;
          :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> .


