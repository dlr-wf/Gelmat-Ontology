###  https://w3id.org/polymat/RAFTPolymerisation
<https://w3id.org/polymat/RAFTPolymerisation> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/polymat/RadicalPolymerisation> ;
                                              rdfs:comment """A type of living polymerisation involving a conventional radical polymerisation which is mediated by a RAFT agent (a thiocarbonylthio compound); this affords control over the generated molecular weight and polydispersity
(https://en.wikipedia.org/wiki/Reversible_addition%E2%88%92fragmentation_chain-transfer_polymerization)"""@en ;
                                              rdfs:label "Reversible addition-fragmentation chain-transfer polymerisation"@en ;
                                              <http://www.w3.org/2004/02/skos/core#altLabel> "RAFT polymerisation"@en .


###  https://w3id.org/polymat/RadicalPolymerisation
<https://w3id.org/polymat/RadicalPolymerisation> rdf:type owl:Class ;
                                                 rdfs:subClassOf :ChainGrowthPolymerisation ;
                                                 rdfs:comment """A chain polymerisation in which the active centers are radicals
(http://purl.obolibrary.org/obo/MOP_0000639)"""@en ;
                                                 rdfs:label "Radical polymerisation"@en .


###  https://w3id.org/polymat/RandomCopolymer
<https://w3id.org/polymat/RandomCopolymer> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/polymat/Copolymer> ;
                                           rdfs:comment """A copolymer consisting of macromolecules in which the probability of finding a given monomeric unit at any given site in the chain is independent of the nature of the adjacent units
(https://goldbook.iupac.org/terms/view/R05126)"""@en ;
                                           rdfs:label "Random copolymer"@en .


