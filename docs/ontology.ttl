:ExchangeRatio rdf:type owl:Class ;
               rdfs:subClassOf :ProcessParameter ;
               rdfs:comment "Volume ratio of fresh solvent to gel volume during solvent exchange cycles"@en ;
               rdfs:label "Exchange ratio"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the volume ratio of fresh solvent to gel during a solvent exchange cycle"@en .


###  https://w3id.org/gelmat/FTIRSpectroscopy
:FTIRSpectroscopy rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/FlexuralModulus
:FlexuralModulus rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity> ;
                 rdfs:comment "The ratio of stress to strain in flexural (bending) deformation, measured by three- or four-point bending, expressed in Pa"@en ;
                 rdfs:label "Flexural modulus"@en ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Bending modulus"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The elastic modulus measured under bending load, equal to the slope of the linear region of the flexural stress-strain curve"@en ;
                 :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  https://w3id.org/gelmat/FlexuralStrength
:FlexuralStrength rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Stress> ;
                  rdfs:comment "The maximum stress at the outer fibre of a specimen at the point of failure under bending load, expressed in Pa"@en ;
                  rdfs:label "Flexural strength"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Bending strength"@en ,
                                                                 "Modulus of rupture"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The maximum bending stress a material can sustain before rupture, determined by three- or four-point flexural testing"@en ;
                  :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  https://w3id.org/gelmat/FluorideAdditive
:FluorideAdditive rdf:type owl:Class ;
                  rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
                  rdfs:comment "A class of fluoride-containing substances added in small amounts to modify reaction pathways, surface chemistry, or microstructure during processing"@en ;
                  rdfs:label "Fluoride additive"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A fluoride-containing substance added in small amounts to modify hydrolysis-condensation kinetics, surface chemistry, or microstructure"@en .


###  https://w3id.org/gelmat/FluorideSalt
:FluorideSalt rdf:type owl:Class ;
              rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
              rdfs:comment "An ionic compound containing fluoride anions (F−) paired with a metal or ammonium cation; used for etching, complexation, or catalytic effects"@en ;
              rdfs:label "Fluoride Salt"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "An ionic compound of the fluoride anion with a metal or ammonium cation"@en .


###  https://w3id.org/gelmat/ForceCell
:ForceCell rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
           rdfs:comment "A sensor designed to convert mechanical force to electric signal."@en ;
           rdfs:label "Load Cell"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "An instrument that converts mechanical force into an electrical signal for quantitative force measurement"@en .


