:Formaldehyde rdf:type owl:Class ;
              rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/Formamide
:Formamide rdf:type owl:Class ;
           rdfs:subClassOf :DryingControlChemicalAdditive .


###  https://w3id.org/gelmat/FractalDimension
:FractalDimension rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                  rdfs:comment "A dimensionless exponent describing the self-similar (power-law) scaling of an aerogel network with length scale, determined from small-angle scattering (SAXS/SANS). General parent for the mass fractal dimension (Dm, network mass scaling) and the surface fractal dimension (Ds, interface roughness scaling)"@en ;
                  rdfs:label "Fractal dimension"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A dimensionless exponent quantifying the fractal (self-similar, power-law) scaling of an aerogel network; specialised as mass fractal dimension (1-3) or surface fractal dimension (2-3)"@en ;
                  :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/FreezeCasting
:FreezeCasting rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
               rdfs:comment "Directional or bulk freezing of a suspension or gel so that growing ice crystals template an aligned macroporous architecture, subsequently revealed by freeze drying"@en ;
               rdfs:label "Freeze casting"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Directional freezing"@en ,
                                                              "Ice templating"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which controlled freezing templates the pore structure of a material via ice crystal growth"@en .


###  https://w3id.org/gelmat/FreezeDryer
:FreezeDryer rdf:type owl:Class ;
             rdfs:subClassOf :Dryer ;
             rdfs:comment "Equipment that removes liquid from a frozen material by sublimation under reduced pressure (lyophilisation). Used in aerogel production via the freeze-drying route to obtain cryogels"@en ;
             rdfs:label "Freeze Dryer"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A dryer that removes frozen solvent from a material by sublimation under reduced pressure (lyophilisation)"@en .


###  https://w3id.org/gelmat/FreezeDrying
:FreezeDrying rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/polymat/Drying> ;
              rdfs:comment "Drying method where the solvent is frozen and then sublimated under vacuum, producing cryogels with distinct morphology"@en ;
              rdfs:label "Freeze drying"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Lyophilization"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A drying method in which the pore solvent is frozen and removed by sublimation under reduced pressure, yielding cryogels"@en .


###  https://w3id.org/gelmat/Furfural
:Furfural rdf:type owl:Class ;
          rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/GPTMS
:GPTMS rdf:type owl:Class ;
       rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/Gas
:Gas rdf:type owl:Class ;
     rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
     rdfs:comment "A substance in the gaseous state used in processing or characterisation: pyrolysis and calcination atmospheres (N2, Ar, air), sorption adsorbates (N2, CO2), and drying media"@en ;
     rdfs:label "Gas"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "A chemical entity in the gaseous aggregation state, used as process atmosphere, adsorbate, or drying medium"@en .


###  https://w3id.org/gelmat/Gel
:Gel rdf:type owl:Class ;
     rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
     rdfs:comment "A gel is a soft material entity consisting of a continuous solid network permeated by a liquid phase, exhibiting both solid-like and liquid-like properties"@en ;
     rdfs:label "Gel"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "A nonfluid colloidal or polymer network that is expanded throughout its whole volume by a fluid, exhibiting both solid-like and liquid-like properties"@en .


###  https://w3id.org/gelmat/Gelatin
:Gelatin rdf:type owl:Class ;
         rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/Gelation
:Gelation rdf:type owl:Class ;
          rdfs:subClassOf :CreationProcess ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                            owl:someValuesFrom :SolGelTransition
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :usesSubstance ;
                            owl:someValuesFrom <https://w3id.org/polymat/Monomer>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :usesSubstance ;
                            owl:someValuesFrom [ owl:intersectionOf ( <https://w3id.org/polymat/Substance>
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <http://www.w3.org/ns/prov#hadRole> ;
                                                                        owl:someValuesFrom <https://w3id.org/polymat/Catalyst>
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ]
                          ] ;
          rdfs:comment "The sol-gel transition process where a liquid colloidal solution transforms into a solid gel network through hydrolysis and condensation reactions"@en ;
          rdfs:label "Gelation"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The sol-gel process stage in which condensation reactions cause the growing network to span the entire reaction volume, producing a solid gel at the gel point (SolGelTransition); the sol irreversibly loses fluidity"@en ;
          :hasStepOrder "2"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/GelationPathway
:GelationPathway rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Feature> ;
                 rdfs:comment "The mechanistic route by which a sol transforms into a gel network. A GelationPathway describes the mechanism, not the process itself — it is a feature of the gelation, not an instance of it"@en ;
                 rdfs:label "Gelation pathway"@en ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Gelation mechanism"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The mechanistic route by which a sol transforms into a gel network; describes the mechanism of a gelation, not the process itself"@en .


###  https://w3id.org/gelmat/GelationTime
:GelationTime rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Time> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <https://w3id.org/polymat/isParameterOf> ;
                                owl:someValuesFrom :Gelation
                              ] ;
              rdfs:comment "The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event. A key kinetic parameter sensitive to catalyst concentration, pH, temperature, and water-to-precursor ratio"@en ;
              rdfs:label "Gelation time"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Gel time"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The elapsed time from initiation of gelation (e.g. catalyst addition) to the SolGelTransition event; a key kinetic parameter controlled by catalyst type, concentration, pH, temperature, and water-to-precursor ratio"@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> .


###  https://w3id.org/gelmat/GellingAgentRole
:GellingAgentRole rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                  rdfs:comment "The role of a substance that triggers or promotes gelation (e.g. a base added to induce condensation, a cation bath for alginate gelation)"@en ;
                  rdfs:label "Gelling agent role"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that induces or accelerates the sol-gel transition in a gelation step"@en .


###  https://w3id.org/gelmat/Geometry
:Geometry rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/polymat/Feature> ;
          rdfs:comment "The shape, size, and physical configuration of a material entity."@en ;
          rdfs:label "Geometry"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A feature representing the shape and physical configuration of a material entity"@en .


###  https://w3id.org/gelmat/Geopyc
:Geopyc rdf:type owl:Class ;
        rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
        rdfs:comment "Device for measuring envelope density of materials."@en ;
        rdfs:label "Geopyc"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "An instrument that measures the envelope density of a material by quasi-fluid displacement"@en .


###  https://w3id.org/gelmat/GlassFibre
:GlassFibre rdf:type owl:Class ;
            rdfs:subClassOf :Reinforcement ;
            rdfs:comment "Glass fibres (loose, mat, or felt), the most common reinforcement of commercial silica aerogel insulation composites"@en ;
            rdfs:label "Glass fibre"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Glass fiber"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A fibrous glass reinforcement used in aerogel composites and blankets"@en .


###  https://w3id.org/gelmat/Glycerol
:Glycerol rdf:type owl:Class ;
          rdfs:subClassOf :DryingControlChemicalAdditive .


###  https://w3id.org/gelmat/GrapheneOxide
:GrapheneOxide rdf:type owl:Class ;
               rdfs:subClassOf :Reinforcement .


###  https://w3id.org/gelmat/GuardedHotPlate
:GuardedHotPlate rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalConductivityTesting ;
                 rdfs:comment "Steady-state absolute thermal conductivity measurement between a guarded hot plate and cold plates (ISO 8302); the primary reference method for insulation materials"@en ;
                 rdfs:label "Guarded hot plate method"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A steady-state thermal conductivity measurement in which a guarded hot plate imposes a known heat flux across a slab specimen"@en .


###  https://w3id.org/gelmat/HeatFlowMeter
:HeatFlowMeter rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
               rdfs:comment "Device for measuring thermal conductivity of the material."@en ;
               rdfs:label "Heat Flow Meter"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An instrument that measures the thermal conductivity of a material from the heat flux through a specimen under a temperature gradient"@en .


###  https://w3id.org/gelmat/HeatFlowMeterMethod
:HeatFlowMeterMethod rdf:type owl:Class ;
                     rdfs:subClassOf :ThermalConductivityTesting ;
                     rdfs:comment "Steady-state comparative thermal conductivity measurement using calibrated heat flux transducers (ISO 8301); faster than the guarded hot plate; instrument class gmat:HeatFlowMeter"@en ;
                     rdfs:label "Heat flow meter method"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A steady-state thermal conductivity measurement in which the heat flux through a slab specimen is recorded by calibrated flux transducers"@en .


###  https://w3id.org/gelmat/HeatingBath
:HeatingBath rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
             rdfs:comment "Temperature-controlled liquid bath for uniform heating of samples"@en ;
             rdfs:label "Heating bath"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Oil bath"@en ,
                                                            "Water bath"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "An instrument consisting of a temperature-controlled liquid bath used for uniform heating of samples"@en .


###  https://w3id.org/gelmat/HeatingRate
:HeatingRate rdf:type owl:Class ;
             rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
             rdfs:comment "The rate of temperature change during a thermal process step (drying, pyrolysis, calcination, temperature ramping), typically reported in K/min or degC/min"@en ;
             rdfs:label "Heating rate"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Ramp rate"@en ,
                                                            "Temperature ramp rate"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the change of temperature per unit time imposed during a controlled heating or cooling step"@en ;
             :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvinPerSecond-Time> .


###  https://w3id.org/gelmat/HeliumPycnometry
:HeliumPycnometry rdf:type owl:Class ;
                  rdfs:subClassOf :SkeletalDensityMeasurement ;
                  rdfs:comment "Gas displacement pycnometry with helium; the standard realisation of skeletal density measurement (gmat:SkeletalDensity), performed e.g. on an Accupyc instrument"@en ;
                  rdfs:label "Helium pycnometry"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Gas pycnometry"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A skeletal density measurement that determines the skeletal volume of a sample by helium gas displacement"@en .


###  https://w3id.org/gelmat/Heptane
:Heptane rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> .


###  https://w3id.org/gelmat/Hexamethyldisilazane
:Hexamethyldisilazane rdf:type owl:Class ;
                      rdfs:subClassOf :SilylationAgent .


###  https://w3id.org/gelmat/Hexane
:Hexane rdf:type owl:Class ;
        rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> .


###  https://w3id.org/gelmat/HighTemperatureSupercriticalDrying
:HighTemperatureSupercriticalDrying rdf:type owl:Class ;
                                    rdfs:subClassOf :SupercriticalDrying ;
                                    rdfs:comment "Supercritical drying directly from the organic pore solvent (ethanol or methanol, Tc ~240-243 degC) in an autoclave, without exchange to CO2; the original Kistler-type HOT route, distinguished from low-temperature scCO2 drying"@en ;
                                    rdfs:label "High-temperature supercritical drying"@en ;
                                    <http://www.w3.org/2004/02/skos/core#altLabel> "HOT supercritical drying"@en ,
                                                                                   "Supercritical ethanol drying"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A supercritical drying method in which the organic pore solvent itself is brought above its critical point, as opposed to exchange against supercritical CO2"@en .


###  https://w3id.org/gelmat/HybridAerogel
:HybridAerogel rdf:type owl:Class ;
               rdfs:subClassOf :Aerogel ;
               rdfs:comment "An aerogel composed of both organic and inorganic components, combining properties of different material classes"@en ;
               rdfs:label "Hybrid aerogel"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An aerogel composed of two or more chemically distinct network components, at least one of which is organic and at least one inorganic, covalently or physically integrated within the same porous framework"@en .


###  https://w3id.org/gelmat/HydrofluoricAcid
:HydrofluoricAcid rdf:type owl:Class ;
                  rdfs:subClassOf :AcidCatalyst .


###  https://w3id.org/gelmat/Hydrogel
:Hydrogel rdf:type owl:Class ;
          rdfs:subClassOf :WetGel ;
          rdfs:comment "A hydrogel is a gel in which the liquid phase consists mainly of water."@en ;
          rdfs:label "Hydrogel"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A wet gel in which the liquid pore phase is predominantly water; the intermediate state of a silica sol-gel system before solvent exchange"@en .


###  https://w3id.org/gelmat/Hydrolysis
:Hydrolysis rdf:type owl:Class ;
            rdfs:subClassOf :SolFormation ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :usesSubstance ;
                              owl:someValuesFrom :Water
                            ] ;
            rdfs:comment "Reaction of a silicon alkoxide precursor with water to generate silanol groups (Si-OH). Rate depends on pH, water-to-alkoxide ratio, and solvent. Acid catalysis accelerates hydrolysis; base catalysis promotes condensation"@en ;
            rdfs:label "Hydrolysis"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Nucleophilic substitution of alkoxy groups by hydroxyl groups in the presence of water, yielding silanols as sol-gel intermediates"@en .


###  https://w3id.org/gelmat/HydrophobicityTesting
:HydrophobicityTesting rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                       rdfs:comment "Measurement of water contact angle or water uptake to determine surface hydrophobicity"@en ;
                       rdfs:label "Hydrophobicity testing"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines the surface hydrophobicity of a material, typically by water contact angle or water uptake measurement"@en .


###  https://w3id.org/gelmat/Impregnation
:Impregnation rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
              rdfs:comment "Infiltrating a porous host (fibre mat, foam) with a sol, or a finished aerogel with a functional phase; the standard route to aerogel blankets and composites (see also pmat:Coating)"@en ;
              rdfs:label "Impregnation"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Infiltration"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which a liquid phase is infiltrated into a porous host material"@en .


###  https://w3id.org/gelmat/IncompleteDrying
:IncompleteDrying rdf:type owl:Class ;
                  rdfs:subClassOf :AerogelDefect ;
                  rdfs:comment "The defect state of residual solvent or moisture remaining in the aerogel pores after the drying step. Denotes the persisting residual-liquid feature of the material, not the (incomplete) drying process itself."@en ;
                  rdfs:label "Residual solvent"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Incomplete drying"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect consisting of residual solvent or moisture remaining in the pore network of the material after drying"@en .


###  https://w3id.org/gelmat/InorganicAerogel
:InorganicAerogel rdf:type owl:Class ;
                  rdfs:subClassOf :Aerogel ;
                  owl:disjointWith :OrganicAerogel ;
                  rdfs:comment "An aerogel with an inorganic backbone (e.g. SiO₂, TiO₂, Al₂O₃), typically synthesised from metal alkoxide precursors through sol-gel processing"@en ;
                  rdfs:label "Inorganic aerogel"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An aerogel whose solid framework consists entirely of inorganic components such as metal oxides, silica, or zero-valent metals, containing no covalently bonded organic groups in the network backbone"@en .


###  https://w3id.org/gelmat/IonExchange
:IonExchange rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
             rdfs:comment "Passing a sodium silicate (water glass) solution through a cation exchange resin to replace Na+ with H+, yielding silicic acid sol; the essential desalination step of the water-glass route"@en ;
             rdfs:label "Ion exchange"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which ions in a solution are replaced by contact with an ion exchange resin, notably the removal of sodium from water glass"@en .


###  https://w3id.org/gelmat/IronOxideAerogel
:IronOxideAerogel rdf:type owl:Class ;
                  rdfs:subClassOf :MetalOxideAerogel ;
                  rdfs:comment "An aerogel with an iron oxide (Fe2O3/Fe3O4) network, typically from FeCl3/epoxide routes; studied for magnetism, catalysis, and energetic composites"@en ;
                  rdfs:label "Iron oxide aerogel"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Fe2O3 aerogel"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A metal oxide aerogel whose solid framework consists of iron oxide"@en .


###  https://w3id.org/gelmat/Isocyanate
:Isocyanate rdf:type owl:Class ;
            rdfs:subClassOf :PolymerPrecursor ;
            rdfs:comment "A di- or polyisocyanate (e.g. MDI, TDI, Desmodur types) that reacts with polyols to form polyurethane aerogels, or with water/amines to form polyurea aerogels"@en ;
            rdfs:label "Isocyanate"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "An isocyanate monomer that forms polyurethane or polyurea networks in polymer aerogel synthesis"@en .


###  https://w3id.org/gelmat/Isopropanol
:Isopropanol rdf:type owl:Class ;
             rdfs:subClassOf :Alcohol .


###  https://w3id.org/gelmat/LaserFlash
:LaserFlash rdf:type owl:Class ;
            rdfs:subClassOf :ThermalConductivityTesting .


###  https://w3id.org/gelmat/Lignin
:Lignin rdf:type owl:Class ;
        rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/MTES
:MTES rdf:type owl:Class ;
      rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/MTMS
:MTMS rdf:type owl:Class ;
      rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/Macroporosity
:Macroporosity rdf:type owl:Class ;
               rdfs:subClassOf :AerogelDefect ;
               rdfs:comment "Presence of unintended macropores (> 50 nm) in the aerogel network, causing loss of mesoporosity, reduced surface area, and lower thermal insulation performance. Arises from phase separation or syneresis during gelation"@en ;
               rdfs:label "Macroporosity"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect characterised by the presence of unintended pores larger than 50 nm in the otherwise mesoporous network, caused by phase separation or syneresis during gelation, leading to reduced surface area and impaired insulation performance"@en .


###  https://w3id.org/gelmat/MagneticStirrer
:MagneticStirrer rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
                 rdfs:comment "Equipment that creates a rotating magnetic field to spin a stir bar for mixing solutions"@en ;
                 rdfs:label "Magnetic stirrer"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "An instrument that mixes a solution by rotating a magnetic stir bar through a rotating magnetic field"@en .


###  https://w3id.org/gelmat/MassFractalDimension
:MassFractalDimension rdf:type owl:Class ;
                      rdfs:subClassOf :FractalDimension ;
                      owl:disjointWith :SurfaceFractalDimension ;
                      rdfs:comment "The fractal dimension Dm describing the power-law scaling of network mass with length scale in the fractal (low-q) region of the scattering curve, I(q) ∝ q^(−Dm). Values 1.7-2.4 are typical for silica aerogels; lower values indicate more open, chain-like structures"@en ;
                      rdfs:label "Mass fractal dimension"@en ;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "Dm"@en ,
                                                                     "Mass fractal dimension"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "The mass fractal dimension (1 ≤ Dm ≤ 3) obtained from the slope of the fractal regime of a SAXS/SANS curve, describing how network mass scales with observation length"@en ;
                      :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/MassFraction
:MassFraction rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
              rdfs:comment "The mass of a component divided by the total mass of the mixture or composite, expressed as a fraction or wt%. Covers fibre loading, solid content, silica content, and similar compositional quantities"@en ;
              rdfs:label "Mass fraction"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Weight fraction"@en ,
                                                             "wt%"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A dimensionless quantity representing the ratio of the mass of a component to the total mass of the mixture, commonly expressed in weight percent"@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/MeanPoreSize
:MeanPoreSize rdf:type owl:Class ;
              owl:equivalentClass <https://w3id.org/polymat/MeanPoreDiameter> ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Length> ;
              rdfs:comment "The average pore diameter of a porous material, typically determined from BJH analysis of desorption isotherms or from small-angle scattering; expressed in nanometres. Aerogels predominantly exhibit mesopores (2-50 nm). Equivalent to pmat:MeanPoreDiameter, which Polymat declares independently for membrane materials"@en ;
              rdfs:label "Mean pore size"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Average pore diameter"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The average equivalent spherical diameter of the pore space distribution in a porous material, expressed in nanometres and typically determined by BJH desorption analysis"@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> .


###  https://w3id.org/gelmat/Melamine
:Melamine rdf:type owl:Class ;
          rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/MercuryIntrusionPorosimetry
:MercuryIntrusionPorosimetry rdf:type owl:Class ;
                             rdfs:subClassOf :PorosityMeasurement .


###  https://w3id.org/gelmat/MetalAerogel
:MetalAerogel rdf:type owl:Class ;
              rdfs:subClassOf :InorganicAerogel ;
              rdfs:comment "An aerogel in which the solid framework is composed of zero-valent metals (e.g., Au, Pt, Ag)"@en ;
              rdfs:label "Metal aerogel"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "An inorganic aerogel whose solid framework consists of zero-valent metal"@en .


###  https://w3id.org/gelmat/MetalAlkoxide
:MetalAlkoxide rdf:type owl:Class ;
               rdfs:subClassOf :MetalOxidePrecursor ;
               rdfs:comment "A metal compound with alkoxide ligands (M-OR), used as precursors in sol-gel synthesis"@en ;
               rdfs:label "Metal alkoxide"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A compound of a metal with alkoxide ligands (M(OR)n), used as a hydrolysable precursor in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/MetalOxideAerogel
:MetalOxideAerogel rdf:type owl:Class ;
                   rdfs:subClassOf :InorganicAerogel ;
                   rdfs:comment "An aerogel composed of metal oxide materials such as titanium dioxide (TiO₂), alumina (Al₂O₃), or zirconia (ZrO₂)"@en ;
                   rdfs:label "Metal oxide aerogel"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An inorganic aerogel whose solid framework consists of one or more metal oxides"@en .


###  https://w3id.org/gelmat/MetalOxidePrecursor
:MetalOxidePrecursor rdf:type owl:Class ;
                     rdfs:subClassOf :Precursor ;
                     rdfs:comment "A precursor that yields a non-silica metal oxide network (alumina, titania, zirconia, iron oxide, ...); comprises metal alkoxides as well as metal chlorides and nitrates used in epoxide-assisted routes"@en ;
                     rdfs:label "Metal oxide precursor"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A precursor whose hydrolysis and condensation (or epoxide-assisted gelation) yield a metal oxide network"@en .


###  https://w3id.org/gelmat/Methanol
:Methanol rdf:type owl:Class ;
          rdfs:subClassOf :Alcohol .


###  https://w3id.org/gelmat/MicrowaveDrying
:MicrowaveDrying rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Drying> ;
                 rdfs:comment "Drying by volumetric microwave heating of the pore liquid; a fast evaporative route reported for silica and bio-aerogels"@en ;
                 rdfs:label "Microwave drying"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A drying method in which the pore liquid is removed by volumetric microwave heating"@en .


###  https://w3id.org/gelmat/Mixing
:Mixing rdf:type owl:Class ;
        rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
        rdfs:comment "Process of combining two or more substances with mechanical agitation to create a homogeneous solution or suspension"@en ;
        rdfs:label "Mixing"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which two or more substances are combined under mechanical agitation to yield a homogeneous solution or suspension"@en .


###  https://w3id.org/gelmat/ModulePerformance
:ModulePerformance rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                   rdfs:comment """The ability to process large amounts of feed stream (high permeability) while maintaining high selectivity for the desired substance. Further advantageous properties of a membrane module are fouling resistance, hight mechanical stability and low manufacturing costs
(https://en.wikipedia.org/wiki/Membrane_technology)"""@en ;
                   rdfs:label "Module performance"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An analysis that assesses the throughput and selectivity of a separation module"@en .


###  https://w3id.org/gelmat/MolarRatio
:MolarRatio rdf:type owl:Class ;
            rdfs:subClassOf :ProcessParameter ;
            rdfs:comment "The ratio of moles between two or more substances in a reaction or mixture. Used to describe stoichiometric proportions of reagents (e.g., H2O/MTMS = 59.75)."@en ;
            rdfs:label "Molar Ratio"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the ratio of amounts of substance (moles) between two or more substances in a reaction or mixture"@en .


###  https://w3id.org/gelmat/Mold
:Mold rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/polymat/Apparatus> ;
      rdfs:comment "A container or form that gives shape to liquid or semi-solid material during gelation, curing, or solidification processes"@en ;
      rdfs:label "Mold"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An apparatus consisting of a container or form that imparts shape to a liquid or semi-solid material during gelation, curing, or solidification"@en .


###  https://w3id.org/gelmat/Monolith
:Monolith rdf:type owl:Class ;
          rdfs:subClassOf :Geometry ;
          rdfs:comment "A material geometry consisting of a single, continuous, bulk piece (often cylindrical or rectangular) as opposed to powders, beads, or films."@en ;
          rdfs:label "Monolith"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A sample geometry consisting of a single continuous bulk piece, as opposed to powders, beads, or films"@en .


###  https://w3id.org/gelmat/Nanocellulose
:Nanocellulose rdf:type owl:Class ;
               rdfs:subClassOf :Cellulose .


###  https://w3id.org/gelmat/NetworkConnectivity
:NetworkConnectivity rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/polymat/Feature> ;
                     rdfs:comment "A structural descriptor of the aerogel solid network expressing the average number of siloxane bonds per node; related to cross-linking density and mechanical stiffness. Determined from solid-state NMR (Q2/Q3/Q4 species) or SAXS"@en ;
                     rdfs:label "Network connectivity"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Cross-linking density"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The average number of siloxane (or equivalent) bonds per network node, quantifying the degree of cross-linking. Determined from 29Si NMR Q-species ratios: Q2 (2 siloxane bonds), Q3 (3), Q4 (4, fully connected)"@en .


###  https://w3id.org/gelmat/NitricAcid
:NitricAcid rdf:type owl:Class ;
            rdfs:subClassOf :AcidCatalyst .


###  https://w3id.org/gelmat/Nitrogen
:Nitrogen rdf:type owl:Class ;
          rdfs:subClassOf :Gas .


###  https://w3id.org/gelmat/NonuniformStructure
:NonuniformStructure rdf:type owl:Class ;
                     rdfs:subClassOf :AerogelDefect ;
                     rdfs:comment "Spatial inhomogeneity in aerogel structure, density, or properties, typically caused by non-uniform gelation or drying"@en ;
                     rdfs:label "Non-uniform structure"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect consisting of spatial inhomogeneity in the structure, density, or properties of the material"@en .


###  https://w3id.org/gelmat/Opacity
:Opacity rdf:type owl:Class ;
         rdfs:subClassOf :AerogelDefect ;
         rdfs:comment "Loss of optical transparency in aerogel, typically caused by large pores, density inhomogeneities, or structural defects"@en ;
         rdfs:label "Opacity"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect consisting of reduced or absent optical transparency of the material"@en .


###  https://w3id.org/gelmat/OpticalTransmittanceMeasurement
:OpticalTransmittanceMeasurement rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                                 rdfs:comment "Measurement of light transmission through aerogel at various wavelengths"@en ;
                                 rdfs:label "Optical transmittance measurement"@en ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An analysis that measures the fraction of incident light transmitted through a material at given wavelengths"@en .


###  https://w3id.org/gelmat/OrganicAerogel
:OrganicAerogel rdf:type owl:Class ;
                rdfs:subClassOf :Aerogel ;
                rdfs:comment "An aerogel in which the solid framework is composed of organic macromolecules (polymers, biopolymers) rather than inorganic networks or elemental carbon"@en ;
                rdfs:label "Organic aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An aerogel whose solid framework consists of an organic polymer network (e.g. resorcinol-formaldehyde, polyimide, cellulose). Distinguished from carbon aerogels by retention of organic functional groups and from inorganic aerogels by the absence of metal oxide or silica frameworks"@en .


###  https://w3id.org/gelmat/OrganicPrecursor
:OrganicPrecursor rdf:type owl:Class ;
                  rdfs:subClassOf :Precursor ;
                  rdfs:comment "A small organic molecule that polycondenses into an organic gel network (resorcinol-formaldehyde and related chemistries); the parent chemistry of organic and, after pyrolysis, carbon aerogels"@en ;
                  rdfs:label "Organic precursor"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An organic monomer that forms an organic polymer network by polycondensation in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/OrganosilicaAerogel
:OrganosilicaAerogel rdf:type owl:Class ;
                     rdfs:subClassOf :HybridAerogel ;
                     owl:disjointWith :SilicaAerogel ;
                     rdfs:comment "An aerogel derived from organosilica precursors (e.g. MTMS, BTMSE) in which organic groups are covalently bonded within the silica network, imparting hydrophobicity and flexibility compared to pure silica aerogels"@en ;
                     rdfs:label "Organosilica aerogel"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Hybrid silica aerogel"@en ,
                                                                    "Methylsilica aerogel"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A hybrid aerogel in which organic functional groups are incorporated into the inorganic silica backbone via covalent Si–C bonds"@en .


###  https://w3id.org/gelmat/OrganosiliconCompound
:OrganosiliconCompound rdf:type owl:Class ;
                       rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
                       rdfs:comment "Any compound containing silicon–carbon bonds; includes silanes, siloxanes, and silicon alkoxides used as precursors in sol–gel chemistry"@en ;
                       rdfs:label "Organosilicon Compound"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A chemical compound containing at least one silicon-carbon bond"@en .


###  https://w3id.org/gelmat/Oven
:Oven rdf:type owl:Class ;
      rdfs:subClassOf :Dryer ;
      rdfs:comment "A thermally insulated chamber used for drying, heating, or thermal treatment of materials at controlled temperatures. In aerogel processing, ovens are used for ambient pressure drying and post-treatment heat curing"@en ;
      rdfs:label "Oven"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A dryer consisting of a thermally insulated chamber for drying, heating, or thermal treatment at controlled temperature"@en .


###  https://w3id.org/gelmat/OverheadStirrer
:OverheadStirrer rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
                 rdfs:comment "Mechanical stirring equipment mounted above container for mixing viscous solutions or gels"@en ;
                 rdfs:label "Overhead stirrer"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "An instrument with a motor-driven impeller mounted above the vessel, used for mixing viscous solutions or gels"@en .


###  https://w3id.org/gelmat/OxalicAcid
:OxalicAcid rdf:type owl:Class ;
            rdfs:subClassOf :AcidCatalyst .


###  https://w3id.org/gelmat/PEDS
:PEDS rdf:type owl:Class ;
      rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/PHAdjuster
:PHAdjuster rdf:type owl:Class ;
            rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
            rdfs:comment "A substance used to control pH during gelation or processing, such as acids or bases"@en ;
            rdfs:label "pH adjuster"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A substance added to control the pH of a mixture during gelation or processing"@en .


###  https://w3id.org/gelmat/PHCondition
:PHCondition rdf:type owl:Class ;
             rdfs:subClassOf :ProcessParameter ;
             rdfs:comment "The pH level maintained during a sol-gel process step (sol formation, gelation, aging). Acid conditions (pH 1-5) favour hydrolysis; base conditions (pH 7-10) favour condensation. pH is controlled by addition of acid or base catalysts. As a ProcessParameter this class is an om:Quantity, so the preferred value pattern is om:hasValue pointing to a dimensionless om:Measure (see gmat:PHValue); gmat:hasPHValue remains available as a datatype shortcut"@en ;
             rdfs:label "pH condition"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A process parameter specifying the hydrogen ion concentration of the reaction medium, expressed on a scale of 0-14, that governs the relative rates of hydrolysis and condensation in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/PHValue
:PHValue rdf:type owl:Class ;
         rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
         rdfs:comment "The pH of a solution or reaction medium as a dimensionless quantity (0-14). Preferred over the datatype shortcut gmat:hasPHValue when the value should participate in the om:Quantity/om:Measure pattern; a gmat:PHCondition process parameter carries its magnitude as a PHValue-style dimensionless om:Measure"@en ;
         rdfs:label "pH value"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "pH"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A dimensionless quantity representing the negative decadic logarithm of the hydrogen ion activity of a solution"@en ;
         :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/ParticleSize
:ParticleSize rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Length> ;
              rdfs:comment "The diameter or dimension of the primary particles making up the aerogel framework"@en ;
              rdfs:label "Particle size"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the characteristic dimension of the primary particles composing a material framework"@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> .


###  https://w3id.org/gelmat/Pectin
:Pectin rdf:type owl:Class ;
        rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/PhaseSeparation
:PhaseSeparation rdf:type owl:Class ;
                 rdfs:subClassOf :GelationPathway ;
                 rdfs:comment "A gelation mechanism driven by the separation of phases within the sol"@en ;
                 rdfs:label "Phase separation"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway in which network formation is driven by separation of the sol into distinct phases"@en .


###  https://w3id.org/gelmat/Phenol
:Phenol rdf:type owl:Class ;
        rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/PhenolicAerogel
:PhenolicAerogel rdf:type owl:Class ;
                 rdfs:subClassOf :OrganicAerogel ;
                 rdfs:comment "An organic aerogel derived from phenolic resin precursors"@en ;
                 rdfs:label "Phenolic aerogel"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "An organic aerogel derived from phenolic resin precursors such as resorcinol-formaldehyde"@en .


###  https://w3id.org/gelmat/PoissonRatio
:PoissonRatio rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
              rdfs:comment "The negative ratio of transverse strain to axial strain under uniaxial load; a dimensionless elastic constant. Reported for aerogels to characterise their compressible, low-Poisson network (often 0.1-0.2)"@en ;
              rdfs:label "Poisson ratio"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "Poisson's ratio"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The dimensionless ratio of transverse contraction strain to longitudinal extension strain in the direction of an applied uniaxial load"@en ;
              :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/PolyimideAerogel
:PolyimideAerogel rdf:type owl:Class ;
                  rdfs:subClassOf :PolymerAerogel ;
                  rdfs:comment "An organic aerogel based on polyimide polymer chains"@en ;
                  rdfs:label "Polyimide aerogel"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A polymer aerogel whose network is formed from polyimide chains"@en .


###  https://w3id.org/gelmat/PolymerAerogel
:PolymerAerogel rdf:type owl:Class ;
                rdfs:subClassOf :Aerogel ;
                rdfs:comment "An aerogel composed of organic polymer networks, such as resorcinol-formaldehyde, polyurethane, or polyimide aerogels"@en ;
                rdfs:label "Polymer aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An aerogel whose solid network is composed of organic polymer chains"@en .


###  https://w3id.org/gelmat/PolymerPrecursor
:PolymerPrecursor rdf:type owl:Class ;
                  rdfs:subClassOf :Precursor ;
                  rdfs:comment "A monomer or oligomer that forms a synthetic polymer aerogel network by step-growth chemistry: dianhydrides and diamines (polyimide), isocyanates and polyols (polyurethane/polyurea)"@en ;
                  rdfs:label "Polymer precursor"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A monomer or oligomer that forms a synthetic polymer network in polymer aerogel synthesis"@en .


###  https://w3id.org/gelmat/Polyol
:Polyol rdf:type owl:Class ;
        rdfs:subClassOf :PolymerPrecursor ;
        rdfs:comment "A polyfunctional alcohol that reacts with isocyanates to form the polyurethane network of polyurethane aerogels"@en ;
        rdfs:label "Polyol"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A polyfunctional alcohol monomer that forms polyurethane networks with isocyanates"@en .


###  https://w3id.org/gelmat/PolyurethaneAerogel
:PolyurethaneAerogel rdf:type owl:Class ;
                     rdfs:subClassOf :PolymerAerogel ;
                     rdfs:comment "An aerogel based on a polyurethane polymer network formed by the reaction of polyisocyanates with polyols"@en ;
                     rdfs:label "Polyurethane aerogel"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A polymer aerogel whose network is formed by the reaction of polyisocyanates with polyols"@en .


###  https://w3id.org/gelmat/PoreSizeDistribution
:PoreSizeDistribution rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                      rdfs:comment "A statistical description of the range and frequency of pore sizes within a porous material, typically determined by BJH analysis or mercury intrusion porosimetry. Aerogels predominantly feature mesopores (2-50 nm)"@en ;
                      rdfs:label "Pore size distribution"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A material property describing the statistical distribution of pore sizes within a porous material, typically characterised by BJH analysis of N₂ adsorption isotherms."@en ;
                      :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> .


###  https://w3id.org/gelmat/PoreVolume
:PoreVolume rdf:type owl:Class ;
            rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
            rdfs:comment "The volume of open pores per unit mass of a porous material, as reported in the literature from N2 physisorption (total pore volume at p/p0 ~ 0.99) or mercury intrusion; conventionally given in cm3/g (= 0.001 m3/kg). A specific (mass-normalised) volume, hence placed directly under om:Quantity rather than om:Volume, with canonical unit m3/kg"@en ;
            rdfs:label "Pore volume"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Specific pore volume"@en ,
                                                           "Total pore volume"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the total volume of open pores per unit mass of a porous material"@en ;
            :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetrePerKilogram> .


###  https://w3id.org/gelmat/PorodExponent
:PorodExponent rdf:type owl:Class ;
               rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
               rdfs:comment "The power-law exponent P of the scattering intensity, I(q) ∝ q^(−P), in the high-q region. Directly read from the scattering slope: 1 ≤ P ≤ 3 indicates a mass fractal (P = Dm), while 3 < P ≤ 4 indicates a surface fractal (P = 6 − Ds), with P = 4 for a smooth (Porod) interface"@en ;
               rdfs:label "Porod exponent"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Power-law exponent"@en ,
                                                              "Scattering exponent"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The dimensionless power-law exponent of small-angle scattering intensity versus q, from which the mass fractal (P = Dm) or surface fractal (P = 6 − Ds) dimension is derived"@en ;
               :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/Porosity
:Porosity rdf:type owl:Class ;
          rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
          rdfs:comment "The ratio of void volume to total volume in a porous material, expressed as a fraction or percentage. Aerogels typically exhibit porosity > 90%, which directly impacts their thermal, acoustic, and mechanical properties"@en ;
          rdfs:label "Porosity"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the fraction of void space in a material relative to its total volume; expressed as an om:Measure with unit fraction (0–1) or percent."@en ;
          :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/PorosityMeasurement
:PorosityMeasurement rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                     rdfs:comment "Measurement of pore volume, pore size distribution, and surface area, typically using BET or BJH methods"@en ;
                     rdfs:label "Porosity measurement"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines pore volume, pore size distribution, or related textural properties of a porous material"@en .


###  https://w3id.org/gelmat/Precursor
:Precursor rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
           rdfs:comment "A chemical entity that is chemically converted into the solid network of a gel during sol-gel synthesis. Grouped by material family: silica, metal oxide, organic, polymer, and biopolymer precursors. The function in a specific step is additionally stated through the role pattern (prov:hadRole some gmat:PrecursorRole)"@en ;
           rdfs:label "Precursor"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A chemical entity that reacts to form the solid network of a gel in sol-gel synthesis"@en .


###  https://w3id.org/gelmat/PrecursorRole
:PrecursorRole rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Role> ;
               rdfs:comment "The role of a substance that is chemically converted into the solid network of the gel (e.g. TEOS in a silica synthesis, resorcinol and formaldehyde in an RF synthesis)"@en ;
               rdfs:label "Precursor role"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that serves as the network-forming reactant of a sol-gel synthesis step"@en .


###  https://w3id.org/gelmat/PressurePlate
:PressurePlate rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
               rdfs:comment "A device to apply and distribute a precise, uniform compressive load."@en ;
               rdfs:label "Pressure Plate"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An instrument that applies and distributes a precise, uniform compressive load to a specimen"@en .


###  https://w3id.org/gelmat/PressureProfile
:PressureProfile rdf:type owl:Class ;
                 rdfs:subClassOf :ProcessParameter ;
                 rdfs:comment "Pressure conditions including set points, ramp rates, and hold times during a process"@en ;
                 rdfs:label "Pressure profile"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the pressure conditions of a process, including set points, ramp rates, and hold times"@en .


###  https://w3id.org/gelmat/PressureVessel
:PressureVessel rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/polymat/Equipment> ;
                rdfs:comment "Container designed to hold gases or liquids at pressure different from ambient"@en ;
                rdfs:label "Pressure vessel"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Equipment consisting of a container designed to hold gases or liquids at a pressure substantially different from ambient"@en .


###  https://w3id.org/gelmat/Pressurization
:Pressurization rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
                rdfs:comment "Controlled increase of pressure during supercritical drying to bring the drying fluid above its critical point, typically performed at controlled ramp rate"@en ;
                rdfs:label "Pressurization"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which pressure is increased in a controlled manner, in supercritical drying bringing the drying fluid above its critical point"@en .


###  https://w3id.org/gelmat/ProcessParameter
:ProcessParameter rdf:type owl:Class ;
                  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ,
                                  <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                  rdfs:comment "A quality (in the BFO sense) that characterises the material inputs or setup of a synthesis process — e.g. a molar or volume ratio of reagents, a pH condition, or a stirring rate. Modelled as a quality that inheres in an independent continuant (typically the reacting mixture / sol), carrying its numeric magnitude via an om:Measure. Achieved, per-run values (not plan prescriptions). Also a subclass of om:Quantity (itself under pmat:Feature), so that process parameters can carry values via om:hasValue and satisfy the pmat:Feature domain of pmat:isParameterOf."@en ;
                  rdfs:label "Process parameter"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A quality inhering in an independent continuant that characterises the material inputs or setup of a synthesis process, recording an achieved per-run value"@en .


###  https://w3id.org/gelmat/Pycnometer
:Pycnometer rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
            rdfs:comment "Device for measuring volume and density of materials, typically using helium displacement"@en ;
            rdfs:label "Pycnometer"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Helium pycnometer"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "An instrument that measures the volume and density of a material, typically by gas displacement"@en .


###  https://w3id.org/gelmat/Pyrolysis
:Pyrolysis rdf:type owl:Class ;
           rdfs:subClassOf :ThermalTreatment ;
           rdfs:comment "Thermal decomposition of an organic aerogel in inert atmosphere (N2, Ar), typically 600-1100 degC, converting it into a carbon aerogel"@en ;
           rdfs:label "Pyrolysis"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Carbonisation"@en ,
                                                          "Carbonization"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A thermal treatment in inert atmosphere that decomposes an organic network into carbon; the route from organic to carbon aerogels"@en .


###  https://w3id.org/gelmat/RamanSpectroscopy
:RamanSpectroscopy rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                   rdfs:comment "Raman scattering spectroscopy; for carbon aerogels the D/G band ratio quantifies graphitisation, for oxides it identifies phases"@en ;
                   rdfs:label "Raman spectroscopy"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An analysis that records inelastic (Raman) light scattering to characterise molecular and lattice vibrations"@en .


###  https://w3id.org/gelmat/RatioValue
:RatioValue rdf:type owl:Class ;
            rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Measure> ;
            rdfs:comment "A value node representing the numerical proportion between substances in a ratio; a dimensionless om:Measure pointed to by a ProcessParameter quality, not a quality itself. Single-valued ratios carry om:hasNumericalValue (xsd:double, unit om:one; two-part ratio a:b = a/b) for numeric querying, alongside the display string in gmat:hasRatioString. Multi-component ratios (e.g. '1:10:4:4') are represented by the string only."@en ;
            rdfs:label "Ratio Value"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A dimensionless measure holding the numerical proportion between substances in a ratio, referenced by a process parameter quality"@en .


###  https://w3id.org/gelmat/RawData
:RawData rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/polymat/DataType> ;
         rdfs:comment "Original, unprocessed data collected directly from experiment"@en ;
         rdfs:label "Raw data"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "Original, unprocessed data collected directly from an experiment"@en .


###  https://w3id.org/gelmat/Reinforcement
:Reinforcement rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
               rdfs:comment "A material embedded in an aerogel matrix as a reinforcing or functional filler phase - fibres, nanocarbons, clays. Linked from a gmat:CompositeAerogel with gmat:hasReinforcement; the function in a synthesis step is stated with prov:hadRole some gmat:ReinforcementRole"@en ;
               rdfs:label "Reinforcement"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A substance incorporated into a composite aerogel as reinforcing or functional filler phase"@en .


###  https://w3id.org/gelmat/ReinforcementRole
:ReinforcementRole rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                   rdfs:comment "The role of a substance embedded as a reinforcing or filler phase in a composite (e.g. glass fibre, cellulose fibre, graphene oxide, carbon nanotubes)"@en ;
                   rdfs:label "Reinforcement role"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance incorporated into a composite to improve its mechanical or functional properties"@en .


###  https://w3id.org/gelmat/Resorcinol
:Resorcinol rdf:type owl:Class ;
            rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/SANS
:SANS rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/SAXS
:SAXS rdf:type owl:Class ;
      rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/Shrinkage
:Shrinkage rdf:type owl:Class ;
           rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
           rdfs:comment "The relative dimensional change (linear or volumetric) of a gel during the drying process, expressed as a fraction or percentage. High shrinkage indicates capillary-force-driven pore collapse, common in ambient pressure drying"@en ;
           rdfs:label "Shrinkage"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the linear dimensional change of a gel or aerogel during processing (drying, aging) relative to the original gel dimension; expressed as an om:Measure with unit percent."@en ;
           :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/Silanol
:Silanol rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
         rdfs:comment "A silicon hydroxide species (Si-OH) formed as an intermediate during hydrolysis of silicon alkoxide precursors. Silanols undergo condensation to form siloxane (Si-O-Si) bonds and build the gel network"@en ;
         rdfs:label "Silanol"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An intermediate species containing a silicon-bound hydroxyl group (Si-OH), the key reactive monomer formed by hydrolysis of silicon alkoxides in sol-gel processing"@en .


###  https://w3id.org/gelmat/SilicaAerogel
:SilicaAerogel rdf:type owl:Class ;
               rdfs:subClassOf :InorganicAerogel ;
               rdfs:comment "An aerogel with a pure silicon dioxide (SiO₂) backbone, typically produced from tetraethoxysilane (TEOS) or tetramethylorthosilicate (TMOS) via the sol-gel process followed by supercritical drying"@en ;
               rdfs:label "Silica aerogel"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "SiO₂ aerogel"@en ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://emmo.info/emmo#EMMO_4207e895> ;
               <http://www.w3.org/2004/02/skos/core#definition> "An inorganic aerogel in which the solid network consists predominantly of amorphous SiO₂, giving low density (0.003–0.35 g/cm³), high surface area (> 500 m²/g), and low thermal conductivity"@en .


###  https://w3id.org/gelmat/SilicaPrecursor
:SilicaPrecursor rdf:type owl:Class ;
                 rdfs:subClassOf :Precursor ;
                 rdfs:comment "A precursor that yields a silica (SiO2) or organosilica network, comprising silicon alkoxides (TEOS, TMOS, MTMS, ...) and silicates (sodium silicate / water glass)"@en ;
                 rdfs:label "Silica precursor"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A precursor whose hydrolysis and condensation yield a silica or organosilica network"@en .


###  https://w3id.org/gelmat/SilicatePrecursor
:SilicatePrecursor rdf:type owl:Class ;
                   rdfs:subClassOf :SilicaPrecursor ;
                   rdfs:comment "An inorganic silicate salt used as a low-cost silica source, typically requiring an ion exchange or acid neutralisation step to remove the alkali cations before or during gelation"@en ;
                   rdfs:label "Silicate precursor"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An inorganic silicate used as a silica source in the water-glass route to silica gels"@en .


###  https://w3id.org/gelmat/SiliconAlkoxidePrecursor
:SiliconAlkoxidePrecursor rdf:type owl:Class ;
                          rdfs:subClassOf :OrganosiliconCompound ,
                                          :SilicaPrecursor ;
                          rdfs:comment "A subclass of organosilicon compounds with silicon bound to alkoxy groups (Si–OR); commonly employed as sol–gel precursors for silica networks"@en ;
                          rdfs:label "Silicon alkoxide precursor"@en ;
                          <http://www.w3.org/2004/02/skos/core#definition> "A silicon compound bearing hydrolysable alkoxy groups (Si-OR), employed as a sol-gel precursor for silica or organosilica networks"@en .


###  https://w3id.org/gelmat/SilylationAgent
:SilylationAgent rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
                 rdfs:comment "A reactive organosilicon compound used to replace silanol surface groups with alkylsilyl groups, rendering the gel surface hydrophobic. Applied during surface modification before ambient pressure drying. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SilylationAgentRole]"@en ;
                 rdfs:label "Silylation agent"@en ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Silylating agent"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A reactive organosilicon compound that replaces surface silanol groups with alkylsilyl groups, rendering a gel surface hydrophobic"@en .


###  https://w3id.org/gelmat/SilylationAgentRole
:SilylationAgentRole rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                     rdfs:comment "The role of a substance that silylates surface silanol groups during a surface modification step; distinct from the convenience substance class gmat:SilylationAgent"@en ;
                     rdfs:label "Silylation agent role"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that replaces surface silanol groups with alkylsilyl groups during surface modification"@en .


###  https://w3id.org/gelmat/Sintering
:Sintering rdf:type owl:Class ;
           rdfs:subClassOf :ThermalTreatment ;
           rdfs:comment "High-temperature densification of a porous network by viscous flow or diffusion below the melting point; used deliberately for densification or as an unwanted effect limiting the service temperature of aerogels"@en ;
           rdfs:label "Sintering"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A thermal treatment that densifies a porous solid by particle coalescence below the melting point"@en .


###  https://w3id.org/gelmat/SkeletalDensity
:SkeletalDensity rdf:type owl:Class ;
                 rdfs:subClassOf :Density ;
                 rdfs:comment "The mass of a porous body divided by the volume of its solid skeleton only, excluding open pore space; determined by helium pycnometry (gmat:SkeletalDensityMeasurement). Typically 1800-2200 kg/m3 (1.8-2.2 g/cm3) for silica aerogels"@en ;
                 rdfs:label "Skeletal density"@en ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "True density"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The density of the solid skeleton of a porous material, computed over the skeletal volume that excludes open pores; measured by gas displacement (helium) pycnometry"@en ;
                 :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> .


###  https://w3id.org/gelmat/SkeletalDensityMeasurement
:SkeletalDensityMeasurement rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                            rdfs:comment "Measurement of true density of solid material in aerogel, typically using helium pycnometry"@en ;
                            rdfs:label "Skeletal density measurement"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines the density of the solid skeleton of a porous material, typically by helium pycnometry"@en .


###  https://w3id.org/gelmat/Slabs
:Slabs rdf:type owl:Class ;
       rdfs:subClassOf :Geometry ;
       rdfs:comment "A flat, thick piece of material, typically rectangular in shape, often used for thermal conductivity measurements."@en ;
       rdfs:label "Slab"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "A sample geometry consisting of a flat, thick, typically rectangular piece, often used for thermal conductivity measurements"@en .


###  https://w3id.org/gelmat/SodiumCarbonate
:SodiumCarbonate rdf:type owl:Class ;
                 rdfs:subClassOf :BaseCatalyst .


###  https://w3id.org/gelmat/SodiumHydroxide
:SodiumHydroxide rdf:type owl:Class ;
                 rdfs:subClassOf :BaseCatalyst .


###  https://w3id.org/gelmat/SodiumSilicate
:SodiumSilicate rdf:type owl:Class ;
                rdfs:subClassOf :SilicatePrecursor .


###  https://w3id.org/gelmat/Sol
:Sol rdf:type owl:Class ;
     rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
     rdfs:comment "A colloidal suspension of solid particles in a liquid, formed during the initial stage of sol-gel synthesis before gelation occurs"@en ;
     rdfs:label "Sol"@en ;
     <http://www.w3.org/2004/02/skos/core#definition> "A colloidal suspension of solid particles dispersed in a liquid, constituting the initial stage of sol-gel synthesis prior to gelation"@en .


###  https://w3id.org/gelmat/SolConcentration
:SolConcentration rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/AmountOfSubstanceConcentration> ;
                  rdfs:comment "The molar or mass concentration of the precursor monomer in the sol (mol/L or wt%). Controls the density and pore volume of the final aerogel"@en ;
                  rdfs:label "Sol concentration"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The molar or mass concentration of the precursor monomer in the starting sol, governing the density of the resulting aerogel; higher concentrations yield denser, stronger, less porous aerogels"@en ;
                  :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/molePerCubicmetre> .


###  https://w3id.org/gelmat/SolFormation
:SolFormation rdf:type owl:Class ;
              rdfs:subClassOf :CreationProcess ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                owl:someValuesFrom :Condensation
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                owl:someValuesFrom :Hydrolysis
                              ] ;
              rdfs:comment "Process of creating a colloidal suspension (sol) by mixing precursors, solvents, and catalysts before gelation. Comprises hydrolysis of alkoxide groups and condensation of silanol intermediates"@en ;
              rdfs:label "Sol formation"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The first stage of sol-gel synthesis in which precursor molecules undergo hydrolysis and initial condensation to form a stable colloidal suspension (sol) of nanoscale particles or oligomers in a solvent"@en ;
              :hasStepOrder "1"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/SolGelPolymerisation
:SolGelPolymerisation rdf:type owl:Class ;
                      rdfs:subClassOf :GelationPathway ;
                      rdfs:comment "A gelation pathway involving the polymerization of precursors via sol-gel chemistry"@en ;
                      rdfs:label "Sol-gel polymerisation"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway in which the network forms by polymerisation of precursors via hydrolysis and condensation reactions"@en .


###  https://w3id.org/gelmat/SolGelTransition
:SolGelTransition rdf:type owl:Class ;
                  rdfs:subClassOf :CreationProcess ;
                  rdfs:comment "The gel point event at which the sol loses fluidity and transitions to a solid gel network due to percolation of the condensing silica network. Characterised by a sharp increase in viscosity and loss of flow. Placed under gmat:CreationProcess (not under gmat:Gelation, whose usesSubstance existentials would be wrongly inherited by an instantaneous event) so that it is visible to anything that enumerates synthesis steps; the containment in gelation is expressed by gmat:Gelation asserting BFO_0000051 (has part) some SolGelTransition"@en ;
                  rdfs:label "Sol-gel transition"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Gel point"@en ,
                                                                 "Gelation point"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The critical event (gel point) at which percolation of the condensing network spans the reaction volume, converting the flowable sol into a solid gel; marked by divergence of viscosity and loss of steady-state flow"@en .


###  https://w3id.org/gelmat/SolidStateNMR
:SolidStateNMR rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
               rdfs:comment "Solid-state NMR spectroscopy (29Si, 13C, 27Al); 29Si Q/T-species ratios quantify network connectivity (gmat:NetworkConnectivity) and condensation degree; performed on a pmat:NMRSpectrometer"@en ;
               rdfs:label "Solid-state NMR spectroscopy"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "ssNMR"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An analysis that records nuclear magnetic resonance spectra of solid samples, typically under magic-angle spinning"@en .


###  https://w3id.org/gelmat/SolventExchange
:SolventExchange rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :transformsGel ;
                                   owl:someValuesFrom :WetGel
                                 ] ;
                 rdfs:comment "Process of systematically replacing pore liquid in wet gel structures (hydrogels or alcogels) with a more volatile or supercritical-compatible solvent through multiple washing cycles"@en ;
                 rdfs:label "Solvent exchange"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which the pore liquid of a wet gel is progressively replaced by a target solvent (e.g. ethanol, acetone, or liquid CO2) to remove water and residual reactants before drying"@en ;
                 :hasStepOrder "4"^^xsd:positiveInteger .


###  https://w3id.org/gelmat/Sonication
:Sonication rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
            rdfs:comment "Application of ultrasound to disperse particles (fibres, GO, CNT) in a sol, accelerate hydrolysis, or degas a mixture"@en ;
            rdfs:label "Sonication"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Ultrasonication"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A sample preparation step in which ultrasound is applied to disperse, mix, or degas a liquid system"@en .


###  https://w3id.org/gelmat/SpecificHeatCapacity
:SpecificHeatCapacity rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/SpecificHeatCapacity> ;
                      rdfs:comment "The amount of heat energy required to raise the temperature of a unit mass of material by one degree, typically expressed in J/(kg*K). Relevant for aerogel thermal energy storage applications"@en ;
                      rdfs:label "Specific heat capacity"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the heat energy required to raise the temperature of a unit mass of material by one kelvin; expressed as an om:Measure with unit J/(kg·K)."@en ;
                      :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerKelvinKilogram> .


###  https://w3id.org/gelmat/SpecificSurfaceAreaMeasurement
:SpecificSurfaceAreaMeasurement rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                                rdfs:comment "Measurement of specific surface area of porous materials, typically performed using gas adsorption methods such as BET (Brunauer-Emmett-Teller) analysis"@en ;
                                rdfs:label "Specific surface area measurement"@en ;
                                <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines the specific surface area of a porous material, typically by gas physisorption"@en .


###  https://w3id.org/gelmat/SpringbackFailure
:SpringbackFailure rdf:type owl:Class ;
                   rdfs:subClassOf :AerogelDefect ;
                   rdfs:comment "Incomplete recovery of pore volume after capillary compression during ambient pressure drying; the gel does not fully spring back to its wet-gel dimensions due to insufficient surface silylation or network weakness"@en ;
                   rdfs:label "Springback failure"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect in which the gel network fails to recover its original pore volume after capillary compression during ambient pressure drying, due to insufficient hydrophobisation or network weakness, yielding higher density and lower surface area than expected"@en .


###  https://w3id.org/gelmat/Starch
:Starch rdf:type owl:Class ;
        rdfs:subClassOf :BiopolymerPrecursor .


###  https://w3id.org/gelmat/Stirring
:Stirring rdf:type owl:Class ;
          rdfs:subClassOf :Mixing ;
          rdfs:comment "Mechanical agitation of a solution or sol at a controlled stirring rate (gmat:StirringRate) using magnetic or overhead stirrers"@en ;
          rdfs:label "Stirring"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A mixing step performed by mechanical agitation at a controlled stirring rate"@en .


###  https://w3id.org/gelmat/StirringRate
:StirringRate rdf:type owl:Class ;
              rdfs:subClassOf :ProcessParameter ;
              rdfs:comment "Rotation speed of stirring mechanism during mixing, typically measured in RPM"@en ;
              rdfs:label "Stirring rate"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the rotation speed of the stirring mechanism during mixing"@en .


###  https://w3id.org/gelmat/StockSolution
:StockSolution rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
               rdfs:comment "A concentrated solution prepared in advance and stored for repeated use in synthesis procedures to ensure consistency across multiple experiments"@en ;
               rdfs:label "Stock solution"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A concentrated solution of defined composition prepared in advance and stored for repeated use in synthesis procedures"@en .


###  https://w3id.org/gelmat/StructuralCollapse
:StructuralCollapse rdf:type owl:Class ;
                    rdfs:subClassOf :AerogelDefect ;
                    rdfs:comment "The defect state of a collapsed or densified aerogel network, typically caused by capillary forces during improper drying. Denotes the persisting collapsed-structure feature of the material, not the collapse event."@en ;
                    rdfs:label "Collapsed structure"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "Structural collapse"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "An aerogel defect consisting of a collapsed or densified region of the solid network in which the original porous structure is lost"@en .


###  https://w3id.org/gelmat/SupercriticalCO2
:SupercriticalCO2 rdf:type owl:Class ;
                  rdfs:subClassOf :SupercriticalFluid ;
                  owl:disjointWith :SupercriticalEthanol .


###  https://w3id.org/gelmat/SupercriticalDryer
:SupercriticalDryer rdf:type owl:Class ;
                    rdfs:subClassOf :Dryer ;
                    rdfs:comment "Specialized equipment for supercritical drying that heats and pressurizes fluid (typically CO2) above its critical point to extract solvents from gel materials"@en ;
                    rdfs:label "Supercritical dryer"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "Autoclave"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A dryer that heats and pressurises a fluid above its critical point to extract pore solvent from a gel without capillary stress"@en .


###  https://w3id.org/gelmat/SupercriticalDrying
:SupercriticalDrying rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/polymat/Drying> ;
                     rdfs:comment "Drying method using supercritical fluid (typically CO2) to remove solvent from porous materials while preserving the nanoscale structure by avoiding capillary forces"@en ;
                     rdfs:label "Supercritical drying"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A drying method in which the pore liquid is brought above its critical temperature and pressure before venting to gas phase, eliminating the liquid-vapour interface and thus capillary stress, preserving the aerogel network"@en .


###  https://w3id.org/gelmat/SupercriticalEthanol
:SupercriticalEthanol rdf:type owl:Class ;
                      rdfs:subClassOf :SupercriticalFluid ;
                      rdfs:comment "Ethanol in supercritical state (above 241°C and 61.4 bar), alternative to CO2 for aerogel drying"@en ;
                      rdfs:label "Supercritical ethanol"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Ethanol in the supercritical state, used as a high-temperature alternative drying medium in supercritical drying of gels"@en ;
                      <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://purl.obolibrary.org/obo/CHEBI_16236> .


###  https://w3id.org/gelmat/SupercriticalFluid
:SupercriticalFluid rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/polymat/Substance> ;
                    rdfs:comment "A substance at temperature and pressure above its critical point, exhibiting properties between gas and liquid phases"@en ;
                    rdfs:label "Supercritical fluid"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A substance held at a temperature and pressure above its critical point, exhibiting properties intermediate between those of a gas and a liquid"@en .


###  https://w3id.org/gelmat/SupercriticalFluidRole
:SupercriticalFluidRole rdf:type owl:Class ;
                        rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                        rdfs:comment "The role of a substance used in its supercritical state as the extraction medium of a supercritical drying step (typically CO2 or ethanol)"@en ;
                        rdfs:label "Supercritical fluid role"@en ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that serves as the supercritical extraction medium in a supercritical drying step"@en .


###  https://w3id.org/gelmat/SurfaceArea
:SurfaceArea rdf:type owl:Class ;
             rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
             rdfs:comment "The specific surface area (BET) of a porous material in m2/g, measured by N2 physisorption and analysis of the adsorption isotherm using the Brunauer-Emmett-Teller model. Aerogels typically exhibit 200-1000 m2/g"@en ;
             rdfs:label "Surface area"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "BET surface area"@en ,
                                                            "Specific surface area"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The total internal and external surface area of a porous material per unit mass, determined by BET N2 physisorption; the primary indicator of aerogel texture and catalytic or adsorption capacity"@en ;
             :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerGram> .


###  https://w3id.org/gelmat/SurfaceFractalDimension
:SurfaceFractalDimension rdf:type owl:Class ;
                         rdfs:subClassOf :FractalDimension ;
                         rdfs:comment "The fractal dimension Ds describing the roughness/self-similarity of the solid-pore interface, obtained from the Porod region of the scattering curve, I(q) ∝ q^(−(6−Ds)). Values 2 ≤ Ds < 3, where Ds = 2 denotes a smooth surface and values toward 3 denote an increasingly rough, space-filling interface"@en ;
                         rdfs:label "Surface fractal dimension"@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "Ds"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The surface fractal dimension (2 ≤ Ds ≤ 3) obtained from the Porod region of a SAXS/SANS curve, quantifying the roughness of the solid-pore interface"@en ;
                         :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/SurfaceModification
:SurfaceModification rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
                     rdfs:comment "Chemical treatment to alter aerogel surface properties, such as hydrophobization or functionalization"@en ;
                     rdfs:label "Surface modification"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Chemical treatment of the internal pore surfaces of a wet gel to alter surface chemistry, typically to introduce hydrophobic groups that prevent capillary collapse during ambient pressure drying"@en .


###  https://w3id.org/gelmat/SurfaceSilylation
:SurfaceSilylation rdf:type owl:Class ;
                   rdfs:subClassOf :SurfaceModification ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasSilylationAgent ;
                                     owl:someValuesFrom :SilylationAgent
                                   ] ;
                   rdfs:comment "Chemical modification of wet gel surface Si-OH groups by reaction with a silylating agent (TMCS, HMDS) to replace surface hydroxyls with hydrophobic alkylsilyl groups. Essential pre-treatment before ambient pressure drying to prevent capillary collapse"@en ;
                   rdfs:label "Surface silylation"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Hydrophobic surface modification"@en ,
                                                                  "TMCS treatment"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A surface modification step in which surface silanol groups (Si-OH) react with a chlorosilane or silazane reagent (e.g. TMCS, HMDS) to install hydrophobic trialkylsilyl groups, enabling ambient pressure drying"@en .


###  https://w3id.org/gelmat/Surfactant
:Surfactant rdf:type owl:Class ;
            rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
            rdfs:comment "A surface-active agent used to stabilize emulsions or modify interfacial properties in synthesis. Convenience class typed by chemical nature; the primary way to state the function in a given step is the role pattern: step gmat:usesSubstance substance, substance prov:hadRole [a gmat:SurfactantRole]"@en ;
            rdfs:label "Surfactant"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A surface-active agent that lowers interfacial tension, used to stabilise emulsions or modify interfacial properties during synthesis"@en .


###  https://w3id.org/gelmat/SurfactantRole
:SurfactantRole rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/polymat/Role> ;
                rdfs:comment "The role of a substance acting as a surface-active agent (emulsion stabiliser, pore templating agent) in a given step; distinct from the convenience substance class gmat:Surfactant"@en ;
                rdfs:label "Surfactant role"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A role borne by a substance that lowers interfacial tension or templates porosity during a synthesis step"@en .


###  https://w3id.org/gelmat/SynthesisProtocol
:SynthesisProtocol rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
                   rdfs:comment "A plan specification (recipe/protocol) that prescribes how a sol-gel synthesis is to be carried out. As a generically dependent continuant it is the reusable, copyable information artifact that a concrete synthesis process (an occurrent) realises. Distinguishes the recipe from any individual run of it."@en ;
                   rdfs:label "Synthesis protocol"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A generically dependent continuant that is an information artifact prescribing the ordered activities, materials, and conditions for carrying out a sol-gel synthesis; realised by one or more concrete synthesis processes."@en .


###  https://w3id.org/gelmat/SyringePump
:SyringePump rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/polymat/Pump> ;
             owl:disjointWith :VacuumPump ;
             rdfs:comment "A precision fluid delivery device that uses a motor-driven plunger to dispense exact volumes at controlled flow rates. Used in aerogel synthesis for controlled addition of reagents or for supercritical fluid delivery"@en ;
             rdfs:label "Syringe Pump"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A pump that dispenses precise fluid volumes at controlled flow rates by means of a motor-driven plunger"@en .


###  https://w3id.org/gelmat/TEMImaging
:TEMImaging rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/TMOS
:TMOS rdf:type owl:Class ;
      rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/Tannin
:Tannin rdf:type owl:Class ;
        rdfs:subClassOf :OrganicPrecursor .


###  https://w3id.org/gelmat/TapDensity
:TapDensity rdf:type owl:Class ;
            rdfs:subClassOf :Density ;
            rdfs:comment "The bulk density of a powder or granulate after mechanical tapping of the container until no further volume change occurs; relevant for aerogel powders, beads, and granulates"@en ;
            rdfs:label "Tap density"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The density of a powder or granular material measured after tapping the container to a constant volume"@en ;
            :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> .


###  https://w3id.org/gelmat/TemperatureProfile
:TemperatureProfile rdf:type owl:Class ;
                    rdfs:subClassOf :ProcessParameter ;
                    rdfs:comment "Temperature conditions including set points, ramp rates, and hold times during a process. Use this class only for temperature programmes (ramps, multi-segment profiles); a single constant temperature value should be modelled as an om:Temperature instance linked to the process with pmat:isParameterOf"@en ;
                    rdfs:label "Temperature profile"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the temperature conditions of a process, including set points, ramp rates, and hold times"@en .


###  https://w3id.org/gelmat/TemperatureRamping
:TemperatureRamping rdf:type owl:Class ;
                    rdfs:subClassOf :ThermalTreatment ;
                    rdfs:comment "Controlled heating or cooling process during synthesis or drying"@en ;
                    rdfs:label "Temperature ramping"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A creation process step in which temperature is increased or decreased at a controlled rate during synthesis or drying"@en .


###  https://w3id.org/gelmat/TensileClamps
:TensileClamps rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
               rdfs:comment "A tool specialized to securely hold a specimen while a pulling (tensile) force is applied."@en ;
               rdfs:label "Tensile Clamps"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "An instrument that securely grips a specimen while a tensile force is applied"@en .


###  https://w3id.org/gelmat/Tetraethoxysilane
:Tetraethoxysilane rdf:type owl:Class ;
                   rdfs:subClassOf :SiliconAlkoxidePrecursor ,
                                   <https://w3id.org/polymat/Monomer> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                     owl:someValuesFrom <https://w3id.org/polymat/Monomer>
                                   ] .


###  https://w3id.org/gelmat/ThermalConductivity
:ThermalConductivity rdf:type owl:Class ;
                     rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalConductivity> ;
                     rdfs:comment "The property of a material to conduct heat, defined as the rate of heat flow through a unit thickness per unit area per unit temperature difference. For aerogels, low thermal conductivity is a key performance metric, with values typically in the range 0.012-0.025 W/(m*K)"@en ;
                     rdfs:label "Thermal conductivity"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the rate of heat transfer through a material; expressed as an om:Measure with unit W/(m·K). Lower values indicate better thermal insulation."@en ;
                     :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/wattPerMetreKelvin> .


###  https://w3id.org/gelmat/ThermalConductivityTesting
:ThermalConductivityTesting rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/polymat/Analysis> ;
                            rdfs:comment "Measurement of heat transfer properties through aerogel material"@en ;
                            rdfs:label "Thermal conductivity testing"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An analysis that measures the heat transport properties of a material"@en .


###  https://w3id.org/gelmat/ThermalDiffusivity
:ThermalDiffusivity rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/ThermalDiffusivity> ;
                    rdfs:comment "The rate at which heat diffuses through a material, equal to thermal conductivity divided by the product of density and specific heat capacity, expressed in m^2/s. Very low for aerogels, reflecting their insulating behaviour"@en ;
                    rdfs:label "Thermal diffusivity"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the rate of thermal diffusion through a material (thermal conductivity / (density × specific heat capacity)); expressed as an om:Measure with unit m²/s"@en ;
                    :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/squareMetrePerSecond-Time> .


###  https://w3id.org/gelmat/ThermalExpansionCoefficient
:ThermalExpansionCoefficient rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                             rdfs:comment "The fractional change in length (linear) per unit change in temperature at constant pressure, expressed in K^-1. OM-2 defines no dedicated class, so this quantity is placed directly under om:Quantity with a reciprocal-kelvin canonical unit"@en ;
                             rdfs:label "Thermal expansion coefficient"@en ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "CTE"@en ,
                                                                            "Coefficient of thermal expansion"@en ,
                                                                            "Linear thermal expansion coefficient"@en ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the linear coefficient of thermal expansion, i.e. the relative change in a material's length per unit temperature change at constant pressure; expressed as an om:Measure with unit K⁻¹"@en ;
                             :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/reciprocalKelvin> .


###  https://w3id.org/gelmat/ThermalInsulation
:ThermalInsulation rdf:type owl:Class ;
                   rdfs:subClassOf :Application ;
                   rdfs:comment "Use of a material to suppress heat transfer - building insulation, industrial piping, aerospace thermal protection; the dominant aerogel application"@en ;
                   rdfs:label "Thermal insulation"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The application of a material as a barrier against heat transfer"@en .


###  https://w3id.org/gelmat/ThermalTreatment
:ThermalTreatment rdf:type owl:Class ;
                  rdfs:subClassOf :CreationProcess ;
                  rdfs:comment "A high-temperature post-treatment of a dried gel or aerogel - pyrolysis/carbonisation, calcination, curing, sintering. Characterised by a temperature (om:Temperature or gmat:TemperatureProfile), a gmat:Duration, a gmat:HeatingRate, and a gas atmosphere (gmat:hasAtmosphere)"@en ;
                  rdfs:label "Thermal treatment"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Heat treatment"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A creation process step in which a material is held at elevated temperature under a controlled atmosphere to transform its composition or structure"@en .


###  https://w3id.org/gelmat/ThermogravimetricAnalysis
:ThermogravimetricAnalysis rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/TitaniaAerogel
:TitaniaAerogel rdf:type owl:Class ;
                rdfs:subClassOf :MetalOxideAerogel ;
                rdfs:comment "An aerogel with a TiO2 network, typically from titanium isopropoxide; studied for photocatalysis"@en ;
                rdfs:label "Titania aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "TiO2 aerogel"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A metal oxide aerogel whose solid framework consists of titanium dioxide"@en .


###  https://w3id.org/gelmat/TitaniumIsopropoxide
:TitaniumIsopropoxide rdf:type owl:Class ;
                      rdfs:subClassOf :MetalAlkoxide .


###  https://w3id.org/gelmat/TransientHotWire
:TransientHotWire rdf:type owl:Class ;
                  rdfs:subClassOf :ThermalConductivityTesting ;
                  rdfs:comment "Transient thermal conductivity measurement from the temperature rise of a line heat source embedded in the sample; includes the related transient plane source (Hot Disk) variant"@en ;
                  rdfs:label "Transient hot wire method"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Hot wire method"@en ,
                                                                 "Transient plane source"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A transient thermal conductivity measurement based on the temperature response of an embedded line or plane heat source"@en .


###  https://w3id.org/gelmat/Transmittance
:Transmittance rdf:type owl:Class ;
               rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
               rdfs:comment "The fraction of incident electromagnetic radiation that passes through a material at a given wavelength. Transparent silica aerogels can exhibit > 90% transmittance in the visible range"@en ;
               rdfs:label "Transmittance"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A material property quantity representing the fraction of incident light transmitted through a material at a specified wavelength; expressed as an om:Measure with unit percent or dimensionless (0–1)."@en ;
               :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/one> .


###  https://w3id.org/gelmat/Triflex
:Triflex rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/polymat/Instrument> ;
         rdfs:comment "A device for physisorption measurements, including pore size distribution and specific surface area analysis."@en ;
         rdfs:label "Triflex"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A physisorption analysis instrument used for specific surface area and pore size distribution measurements"@en .


###  https://w3id.org/gelmat/Trimethylchlorosilane
:Trimethylchlorosilane rdf:type owl:Class ;
                       rdfs:subClassOf :SilylationAgent .


###  https://w3id.org/gelmat/TwoStepCatalysis
:TwoStepCatalysis rdf:type owl:Class ;
                  rdfs:subClassOf :Gelation ;
                  rdfs:comment "Two-stage acid-then-base catalysis route: an acid pre-hydrolysis step produces partially hydrolysed monomers; subsequent base addition (typically ammonium hydroxide or ammonium fluoride) triggers rapid condensation and gelation. Common route for MTMS and TEOS aerogels"@en ;
                  rdfs:label "Two-step acid-base catalysis"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Acid-base two-step"@en ,
                                                                 "Two-step catalysis"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A sol-gel route combining an acid pre-hydrolysis step with a subsequent base addition step that triggers rapid condensation and gelation; standard route for MTMS and BTMSE aerogel synthesis"@en .


###  https://w3id.org/gelmat/TwoStepCatalysisPathway
:TwoStepCatalysisPathway rdf:type owl:Class ;
                         rdfs:subClassOf :GelationPathway ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :realisedAs ;
                                           owl:someValuesFrom :TwoStepCatalysis
                                         ] ;
                         rdfs:label "Two-Step Catalysis Pathway"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A gelation pathway combining an acid pre-hydrolysis step with a subsequent base addition step; the standard pathway for MTMS and BTMSE-based aerogel synthesis."@en .


###  https://w3id.org/gelmat/Urea
:Urea rdf:type owl:Class ;
      rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> .


###  https://w3id.org/gelmat/VTMS
:VTMS rdf:type owl:Class ;
      rdfs:subClassOf :SiliconAlkoxidePrecursor .


###  https://w3id.org/gelmat/VacuumDrying
:VacuumDrying rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/polymat/Drying> ;
              rdfs:comment "Drying method performed under reduced pressure to lower solvent boiling point and facilitate removal"@en ;
              rdfs:label "Vacuum drying"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A drying method performed under reduced pressure to lower the solvent boiling point and facilitate solvent removal"@en .


###  https://w3id.org/gelmat/VacuumPump
:VacuumPump rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/polymat/Pump> ;
            rdfs:comment "Device for removing gas molecules from a sealed volume to create partial vacuum"@en ;
            rdfs:label "Vacuum pump"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A pump that removes gas molecules from a sealed volume to create a partial vacuum"@en .


###  https://w3id.org/gelmat/VolumeRatio
:VolumeRatio rdf:type owl:Class ;
             rdfs:subClassOf :ProcessParameter ;
             rdfs:comment "The ratio of volumes between two or more substances in a mixture or solution. Used to describe the proportions of reagents by volume (e.g., MTMS:MeOH = 1:10)."@en ;
             rdfs:label "Volume Ratio"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A process parameter representing the ratio of volumes between two or more substances in a mixture or solution"@en .


###  https://w3id.org/gelmat/VolumetricFlowRate
:VolumetricFlowRate rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
                    rdfs:comment "Rate at which a volume of fluid flows through a system, typically measured in ml/h or L/min. Used to characterize pump speeds and fluid delivery rates in synthesis processes."@en ;
                    rdfs:label "Volumetric Flow Rate"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A quantity representing the volume of fluid passing through a system per unit time"@en ;
                    :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/cubicMetrePerSecond-Time> .


###  https://w3id.org/gelmat/WashingCycle
:WashingCycle rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/polymat/SamplePreparation> ;
              rdfs:comment "Individual iteration of solvent replacement during solvent exchange process"@en ;
              rdfs:label "Washing cycle"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "A single iteration of solvent replacement within a solvent exchange procedure"@en .


###  https://w3id.org/gelmat/Water
:Water rdf:type owl:Class ;
       rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEBI_24431> ;
       rdfs:comment "Water (H2O), used as a reactant in hydrolysis reactions during sol-gel synthesis and as the liquid phase in hydrogels"@en ;
       rdfs:label "Water"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "The chemical substance H2O, serving as a reactant in hydrolysis reactions and as the pore liquid in hydrogels"@en .


###  https://w3id.org/gelmat/WaterToSilicaRatio
:WaterToSilicaRatio rdf:type owl:Class ;
                    rdfs:subClassOf :MolarRatio ;
                    rdfs:comment "The molar ratio of water to silicon alkoxide precursor (r = [H2O]/[Si]) used in sol preparation. Controls degree of hydrolysis; r < 4 gives incomplete hydrolysis for TEOS; higher r values favour fully hydrolysed sols"@en ;
                    rdfs:label "Water-to-silica ratio"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "H2O:Si ratio"@en ,
                                                                   "r-ratio"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The molar ratio r = [H2O]/[Si] of water to silicon alkoxide precursor; governs the completeness of hydrolysis. Stoichiometric full hydrolysis of TEOS requires r = 4; r < 4 yields partially hydrolysed species; r >> 4 produces fully hydrolysed, more condensed networks"@en .


###  https://w3id.org/gelmat/WetGel
:WetGel rdf:type owl:Class ;
        rdfs:subClassOf :Gel ;
        rdfs:comment "A gel containing liquid within its porous network structure, formed after gelation and before drying. The liquid phase determines the specific type (hydrogel if water, alcogel if alcohol)."@en ;
        rdfs:label "Wet gel"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A gel whose pore network is filled with a liquid phase, existing after gelation and before drying"@en .


###  https://w3id.org/gelmat/XPSAnalysis
:XPSAnalysis rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/XRayDiffraction
:XRayDiffraction rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/polymat/Analysis> .


###  https://w3id.org/gelmat/Xerogel
:Xerogel rdf:type owl:Class ;
         rdfs:subClassOf :Gel ;
         rdfs:comment "A dried gel with a collapsed or partially collapsed pore structure, formed when a wet gel is dried under ambient conditions causing capillary forces to shrink the network"@en ;
         rdfs:label "Xerogel"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A dried gel formed when a wet gel is dried under ambient conditions; capillary forces during liquid evaporation partially or fully collapse the pore network, resulting in a denser material than the corresponding aerogel"@en .


###  https://w3id.org/gelmat/YoungsModulus
:YoungsModulus rdf:type owl:Class ;
               rdfs:subClassOf <http://www.ontology-of-units-of-measure.org/resource/om-2/ModulusOfElasticity> ;
               rdfs:comment "The ratio of tensile (or uniaxial) stress to axial strain in the linear-elastic region of the stress-strain curve, expressed in Pa. Characterises the intrinsic stiffness of the aerogel solid network; typically 10^4-10^7 Pa for silica aerogels"@en ;
               rdfs:label "Young's modulus"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Elastic modulus"@en ,
                                                              "Modulus of elasticity"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The elastic modulus relating uniaxial stress to axial strain in the linear-elastic regime; equal to the slope of the initial linear portion of the stress-strain curve"@en ;
               :hasCanonicalUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> .


###  https://w3id.org/gelmat/ZirconiaAerogel
:ZirconiaAerogel rdf:type owl:Class ;
                 rdfs:subClassOf :MetalOxideAerogel ;
                 rdfs:comment "An aerogel with a ZrO2 network, typically from zirconium n-propoxide or ZrOCl2/epoxide routes; used in catalysis and high-temperature insulation"@en ;
                 rdfs:label "Zirconia aerogel"@en ;
