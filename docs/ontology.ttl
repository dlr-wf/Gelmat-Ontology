      <https://w3id.org/polymat/hasAcronym> "VTMS" ;
      <https://w3id.org/polymat/hasCASNr> "2768-02-7" ;
      <https://w3id.org/polymat/hasIUPACName> "ethenyl(trimethoxy)silane" .


###  https://w3id.org/gelmat/XPSAnalysis
:XPSAnalysis rdf:type owl:NamedIndividual ;
             <https://w3id.org/polymat/hasAcronym> "XPS" .


###  https://w3id.org/gelmat/XRayDiffraction
:XRayDiffraction rdf:type owl:NamedIndividual ;
                 <https://w3id.org/polymat/hasAcronym> "XRD" .


###  https://w3id.org/gelmat/ZirconiumPropoxide
:ZirconiumPropoxide rdf:type owl:NamedIndividual ;
                    <https://w3id.org/polymat/hasCASNr> "23519-77-9" .


###  https://w3id.org/polymat/
<https://w3id.org/polymat/> rdf:type owl:NamedIndividual .


#################################################################
#    Annotations
#################################################################

:APTES rdfs:comment "(3-Aminopropyl)triethoxysilane (APTES, H2N(CH2)3Si(OC2H5)3), an amine-functional silica precursor and coupling agent; used for amine-modified aerogels (CO2 sorption) and for cross-linking with epoxies or isocyanates"@en ;
       rdfs:label "(3-Aminopropyl)triethoxysilane"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "APTES"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "The amine-functional silicon alkoxide H2N(CH2)3Si(OC2H5)3, used as a co-precursor and coupling agent in sol-gel processing"@en .


:AceticAcid rdfs:comment "Acetic acid (CH3COOH), a weak carboxylic acid used as mild hydrolysis catalyst and chelating modifier in sol-gel synthesis"@en ;
            rdfs:label "Acetic acid"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The carboxylic acid CH3COOH, used as a weak acid catalyst and chelating modifier in sol-gel processing"@en ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_15366> .


:Alginate rdfs:comment "Alginate (usually sodium alginate from brown algae), ionically gelled with divalent cations (Ca2+) to form alginate bio-aerogels"@en ;
          rdfs:label "Alginate"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Sodium alginate"@en ;
          <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/CHEBI_17548> ;
          <http://www.w3.org/2004/02/skos/core#definition> "The algal polysaccharide of mannuronic and guluronic acid units, ionically gelled to form bio-aerogels"@en .


:AluminiumSecButoxide rdfs:comment "Aluminium tri-sec-butoxide (Al(OsBu)3), the standard alkoxide precursor for alumina aerogels via the Yoldas route"@en ;
                      rdfs:label "Aluminium sec-butoxide"@en ;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "ASB"@en ,
                                                                     "Aluminium tri-sec-butoxide"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "The aluminium alkoxide Al(OC4H9)3 (sec-butoxide ligands), used as a precursor for alumina gels"@en .


:Argon rdfs:comment "Argon gas, an inert noble gas atmosphere for pyrolysis and other high-temperature treatments"@en ;
       rdfs:label "Argon"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Ar"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "The noble gas Ar, used as inert process atmosphere"@en ;
       <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_49475> .


:BTMSE rdfs:comment "1,2-Bis(trimethoxysilyl)ethane (BTMSE), a bridged bis-silane precursor yielding ethylene-bridged polysilsesquioxane networks with enhanced flexibility and strength"@en ;
       rdfs:label "1,2-Bis(trimethoxysilyl)ethane"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "BTME"@en ,
                                                      "BTMSE"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "A bridged silicon dialkoxide precursor, (CH3O)3Si-CH2CH2-Si(OCH3)3, that forms ethylene-bridged organosilica networks"@en .


:CarbonDioxide rdfs:comment "Carbon dioxide gas (CO2), used as physical activation agent for carbon aerogels and as sorption adsorbate; its supercritical state is modelled separately as gmat:SupercriticalCO2"@en ;
               rdfs:label "Carbon dioxide"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "CO2"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The gas CO2; in the supercritical state (see gmat:SupercriticalCO2) the standard aerogel drying medium"@en ;
               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16526> .


:CarbonNanotube rdfs:comment "Single- or multi-walled carbon nanotubes used as conductive reinforcement in aerogel composites and as network formers of CNT aerogels"@en ;
                rdfs:label "Carbon nanotube"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "CNT"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A tubular carbon nanostructure used as conductive reinforcement or network former in aerogels"@en ;
                <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_50594> .


:Cellulose rdfs:comment "Cellulose, the beta-1,4-glucan biopolymer; dissolved-and-regenerated or used as nanocellulose to form cellulose bio-aerogels"@en ;
           rdfs:label "Cellulose"@en ;
           <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/CHEBI_18246> ;
           <http://www.w3.org/2004/02/skos/core#definition> "The polysaccharide (C6H10O5)n of beta-1,4-linked glucose units, used as a bio-aerogel precursor"@en .


:Chitosan rdfs:comment "Chitosan, the deacetylated derivative of chitin; an amino-polysaccharide gelled by pH change or cross-linkers to form chitosan bio-aerogels"@en ;
          rdfs:label "Chitosan"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The amino-polysaccharide obtained by deacetylation of chitin, used as a bio-aerogel precursor"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16261> .


:CitricAcid rdfs:comment "Citric acid, a tricarboxylic acid used as mild catalyst and chelating agent in sol-gel and bio-aerogel synthesis"@en ;
            rdfs:label "Citric acid"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The tricarboxylic acid C6H8O7, used as a weak acid catalyst and chelating agent in sol-gel processing"@en ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_30769> .


:DeionizedWater rdfs:comment "Purified water with ions removed, used in aerogel synthesis to control reaction conditions and avoid contamination"@en ;
                rdfs:label "Deionized water"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Water from which dissolved ions have been removed, used to control reaction conditions and avoid ionic contamination"@en .


:DifferentialScanningCalorimetry rdfs:comment "Measurement of heat flow to or from a sample relative to a reference during a temperature programme; yields specific heat capacity, glass transitions, and phase change enthalpies; performed on a pmat:DifferentialScanningCalorimeter"@en ;
                                 rdfs:label "Differential scanning calorimetry"@en ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "DSC"@en ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "An analysis that measures differential heat flow between a sample and a reference as a function of temperature"@en .


:Dimethylformamide rdfs:comment "N,N-Dimethylformamide (DMF), a polar aprotic solvent for polyimide and polyurethane aerogel synthesis, and a drying control chemical additive (DCCA) in silica sol-gel processing"@en ;
                   rdfs:label "Dimethylformamide"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "DMF"@en ,
                                                                  "N,N-Dimethylformamide"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The polar aprotic solvent HCON(CH3)2, used as reaction solvent for polymer aerogels and as a DCCA in silica sol-gel processing"@en ;
                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17741> .


:EDXAnalysis rdfs:comment "Energy-dispersive X-ray spectroscopy performed in an electron microscope, mapping elemental composition of aerogel samples"@en ;
             rdfs:label "EDX analysis"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "EDS"@en ,
                                                            "Energy-dispersive X-ray spectroscopy"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "An analysis that determines elemental composition from characteristic X-rays excited by an electron beam"@en .


:Ethanol rdfs:comment "A primary aliphatic alcohol (C2H5OH), volatile and miscible with water; widely used as a laboratory solvent and processing medium"@en ;
         rdfs:label "Ethanol"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The primary aliphatic alcohol C2H5OH, used as a solvent, reactant, and pore liquid in sol-gel processing"@en ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16236> .


:FTIRSpectroscopy rdfs:comment "Fourier-transform infrared spectroscopy, used to verify siloxane network formation, silylation (Si-CH3 bands), and residual organics; performed on a pmat:FTIRSpectrometer (the device class already present in Polymat)"@en ;
                  rdfs:label "FTIR spectroscopy"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "FTIR"@en ,
                                                                 "Infrared spectroscopy"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An analysis that records the infrared absorption spectrum of a sample by Fourier-transform interferometry"@en .


:Formaldehyde rdfs:comment "Formaldehyde (HCHO, usually as aqueous formalin), the cross-linking aldehyde of resorcinol-formaldehyde, phenol-formaldehyde, and melamine-formaldehyde aerogel chemistries"@en ;
              rdfs:label "Formaldehyde"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "The aldehyde HCHO, used as the condensation partner in phenolic and amino resin aerogel syntheses"@en ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16842> .


:Formamide rdfs:comment "Formamide (HCONH2), the classic drying control chemical additive (DCCA) that narrows the pore size distribution and reduces cracking during drying"@en ;
           rdfs:label "Formamide"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The amide HCONH2, used as a drying control chemical additive in sol-gel processing"@en ;
           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16397> .


:Furfural rdfs:comment "Furfural, a biomass-derived aldehyde used in phenol-furfural and tannin-furfural organic and carbon aerogels"@en ;
          rdfs:label "Furfural"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The furan aldehyde used as a bio-based condensation partner in organic aerogel syntheses"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_34768> .


:GPTMS rdfs:comment "(3-Glycidyloxypropyl)trimethoxysilane (GPTMS), an epoxy-functional silica precursor and coupling agent for organic-inorganic hybrid aerogels"@en ;
       rdfs:label "(3-Glycidyloxypropyl)trimethoxysilane"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "GLYMO"@en ,
                                                      "GPTMS"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "The epoxy-functional silicon alkoxide used as a coupling agent and hybrid network precursor in sol-gel processing"@en .


:Gelatin rdfs:comment "Gelatin, the protein derived from collagen, thermally gelled to form protein-based bio-aerogels"@en ;
         rdfs:label "Gelatin"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The collagen-derived protein used as a thermally gelling bio-aerogel precursor"@en ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_5291> .


:Glycerol rdfs:comment "Glycerol (glycerine), a triol used as drying control chemical additive (DCCA) and plasticiser in sol-gel and bio-aerogel processing"@en ;
          rdfs:label "Glycerol"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Glycerine"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The triol C3H8O3, used as a drying control chemical additive and plasticiser"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17754> .


:GrapheneOxide rdfs:comment "Graphene oxide (GO) sheets, used as reinforcement and functional filler, and as the precursor of reduced-graphene-oxide (rGO) aerogels"@en ;
               rdfs:label "Graphene oxide"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "GO"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Oxidised graphene sheets used as filler, reinforcement, or network former in carbon-based aerogels"@en ;
               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_132889> .


:Heptane rdfs:comment "n-Heptane, a low-surface-tension alkane used as exchange solvent before ambient pressure drying, analogous to n-hexane but less volatile"@en ;
         rdfs:label "n-Heptane"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Heptane"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "The alkane C7H16, used as a low-surface-tension exchange solvent prior to ambient pressure drying"@en ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_43098> .


:Hexamethyldisilazane rdfs:comment "Hexamethyldisilazane (HMDS, CAS 999-97-3): a milder silylating agent than TMCS that reacts with silanol groups producing trimethylsilyl-protected surfaces and ammonia as by-product"@en ,
                                   "PubChem CID 68519 (hexamethyldisilazane, CAS 999-97-3)"@en ;
                      rdfs:label "Hexamethyldisilazane"@en ;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "Bis(trimethylsilyl)amine"@en ,
                                                                     "HMDS"@en ;
                      <http://www.w3.org/2004/02/skos/core#closeMatch> <https://pubchem.ncbi.nlm.nih.gov/compound/68519> ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A mild silylating agent (CAS 999-97-3) that reacts with surface silanol groups to install trimethylsilyl groups with ammonia as by-product; preferred over TMCS where HCl by-product is undesirable"@en .


:Hexane rdfs:comment "n-Hexane, a low-surface-tension alkane used as the final exchange solvent before ambient pressure drying of silylated gels"@en ;
        rdfs:label "n-Hexane"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Hexane"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The alkane C6H14, used as a low-surface-tension exchange solvent prior to ambient pressure drying"@en ;
        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_29021> .


:HydrofluoricAcid rdfs:comment "Hydrofluoric acid (HF), a fluoride catalyst that strongly accelerates condensation of silica sols; acts mechanistically like a nucleophilic (base-type) catalyst despite being an acid"@en ;
                  rdfs:label "Hydrofluoric acid"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "HF"@en ;
                  <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/CHEBI_29228> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The aqueous acid HF, used as a fluoride-mediated condensation catalyst in silica sol-gel processing"@en .


:Isopropanol rdfs:comment "Isopropanol (2-propanol, IPA), a common solvent-exchange medium and pore liquid in aerogel processing"@en ;
             rdfs:label "Isopropanol"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "2-Propanol"@en ,
                                                            "IPA"@en ,
                                                            "Isopropyl alcohol"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The secondary alcohol (CH3)2CHOH, used as a solvent and exchange medium in sol-gel processing"@en ;
             <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17824> .


:LaserFlash rdfs:comment "Laser flash analysis: a light pulse heats one face of a disc specimen and the rear-face temperature transient yields thermal diffusivity, from which conductivity is computed with density and heat capacity"@en ;
            rdfs:label "Laser flash analysis"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "LFA"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A transient method that determines thermal diffusivity from the rear-face temperature response to a light pulse"@en .


:Lignin rdfs:comment "Lignin, the aromatic biopolymer by-product of pulping, used as a bio-based phenolic precursor (usually blended with resorcinol or phenol) for organic and carbon aerogels"@en ;
        rdfs:label "Lignin"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The aromatic plant biopolymer used as a bio-based phenolic precursor in organic aerogel syntheses"@en ;
        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_6457> .


:MTES rdfs:comment "Methyltriethoxysilane (MTES, CH3Si(OC2H5)3), an organosilica precursor bearing one methyl group; used as co-precursor with TEOS to introduce hydrophobicity"@en ;
      rdfs:label "Methyltriethoxysilane"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "MTES"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "The silicon alkoxide CH3Si(OC2H5)3 with one non-hydrolysable methyl group, used to produce hydrophobic organosilica networks"@en .


:MTMS rdfs:comment "Trimethoxymethylsilane (MTMS, CAS 1185-55-3): an organosilica precursor bearing one methyl group, used to produce hydrophobic methylsilica (organosilica) aerogels via the sol-gel route"@en ;
      rdfs:label "Trimethoxymethylsilane"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "MTMS"@en ,
                                                     "Methyltrimethoxysilane"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A silicon alkoxide precursor with one Si–CH₃ group and three Si–OCH₃ groups, yielding aerogel networks with pendant methyl groups that confer hydrophobicity"@en .


:Melamine rdfs:comment "Melamine, the triamine monomer of melamine-formaldehyde (MF) aerogels and a nitrogen source for N-doped carbon aerogels"@en ;
          rdfs:label "Melamine"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The triazine triamine used with formaldehyde as the precursor pair of MF aerogels"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_27915> .


:MercuryIntrusionPorosimetry rdfs:comment "Determination of macro- and mesopore size distribution by pressurised mercury intrusion; note that compressible aerogels are often crushed rather than intruded, so results need careful interpretation"@en ;
                             rdfs:label "Mercury intrusion porosimetry"@en ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "MIP"@en ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A porosity measurement in which mercury is forced into the pores of a material under increasing pressure to determine pore volume and size distribution"@en .


:Methanol rdfs:comment "The simplest alcohol (CH3OH), commonly used as a solvent and reactant in sol-gel chemistry. Methanol can serve as a pore liquid in alcogels and as a solvent exchange medium prior to supercritical drying"@en ;
          rdfs:label "Methanol"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The simplest alcohol, CH3OH, used as a solvent, reactant, and pore liquid in sol-gel processing"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17790> .


:Nanocellulose rdfs:comment "Nanoscale cellulose - cellulose nanofibrils (CNF) or cellulose nanocrystals (CNC) - used as precursor and as reinforcement in bio-based and composite aerogels"@en ;
               rdfs:label "Nanocellulose"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "CNC"@en ,
                                                              "CNF"@en ,
                                                              "Cellulose nanocrystal"@en ,
                                                              "Cellulose nanofibril"@en ;
               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.obolibrary.org/obo/CHEBI_133349> ;
               <http://www.w3.org/2004/02/skos/core#definition> "Cellulose in nanofibrillar or nanocrystalline form, used as network former or reinforcement in aerogels"@en .


:NitricAcid rdfs:comment "Nitric acid (HNO3), a strong mineral acid used as hydrolysis catalyst in silica and metal oxide sol-gel synthesis"@en ;
            rdfs:label "Nitric acid"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The strong mineral acid HNO3, used as an acid catalyst in sol-gel processing"@en ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_48107> .


:Nitrogen rdfs:comment "Nitrogen gas (N2), the standard inert pyrolysis and calcination atmosphere and the standard adsorbate of BET/BJH physisorption at 77 K"@en ;
          rdfs:label "Nitrogen"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "N2"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "The diatomic gas N2, used as inert process atmosphere and physisorption adsorbate"@en ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17997> .


:OxalicAcid rdfs:comment "Oxalic acid ((COOH)2), a dicarboxylic acid used as mild hydrolysis catalyst, particularly in MTMS-based and two-step syntheses"@en ;
            rdfs:label "Oxalic acid"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The dicarboxylic acid (COOH)2, used as a weak acid catalyst in sol-gel processing"@en ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_16995> .


:PEDS rdfs:comment "Polyethoxydisiloxane (PEDS), a pre-polymerised (partially hydrolysed and condensed) TEOS oligomer sold as an ethanolic solution; a common industrial silica precursor with reproducible reactivity"@en ;
      rdfs:label "Polyethoxydisiloxane"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "PEDS"@en ,
                                                     "Pre-polymerised TEOS"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A partially hydrolysed and condensed oligomeric ethoxysiloxane used as a pre-polymerised silica precursor"@en .


:Pectin rdfs:comment "Pectin, the galacturonic-acid-rich plant polysaccharide, gelled ionically or by acid to form pectin bio-aerogels"@en ;
        rdfs:label "Pectin"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The plant polysaccharide rich in galacturonic acid, used as a bio-aerogel precursor"@en ;
        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_17309> .


:Phenol rdfs:comment "Phenol (C6H5OH), used with formaldehyde in phenol-formaldehyde (PF) organic and carbon aerogels as a lower-cost alternative to resorcinol"@en ;
        rdfs:label "Phenol"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The aromatic alcohol C6H5OH, used with formaldehyde as the precursor pair of PF aerogels"@en ;
        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_15882> .


:Resorcinol rdfs:comment "Resorcinol (1,3-dihydroxybenzene), the standard phenolic monomer of resorcinol-formaldehyde (RF) organic and carbon aerogels"@en ;
            rdfs:label "Resorcinol"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "The phenolic compound benzene-1,3-diol, used with formaldehyde as the precursor pair of RF aerogels"@en ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/CHEBI_27810> .


:SANS rdfs:comment "Small-angle neutron scattering; complements SAXS with contrast-variation capability for multi-phase and hydrogenous aerogel systems"@en ;
      rdfs:label "Small-angle neutron scattering"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "SANS"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "An analysis that measures elastic neutron scattering at small angles to characterise nanostructure of a material"@en .


:SAXS rdfs:comment "Small-angle X-ray scattering; yields fractal dimensions (gmat:MassFractalDimension, gmat:SurfaceFractalDimension), Porod exponent, correlation length, and primary particle size of aerogel networks"@en ;
