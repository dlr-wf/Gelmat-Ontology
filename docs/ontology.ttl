@prefix : <https://w3id.org/gelmat/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/gelmat/> .

<https://w3id.org/gelmat/> rdf:type owl:Ontology ;
                            owl:versionIRI <https://w3id.org/gelmat/1.1.0> ;
                            owl:imports <http://www.ontology-of-units-of-measure.org/resource/om-2> ,
                                        <https://w3id.org/polymat/> ;
                            <http://omv.ontoware.org/2005/05/ontology#designedForOntologyTask> "knowledge representation in sol-gel materials synthesis, characterisation, and material properties" ;
                            <http://omv.ontoware.org/2005/05/ontology#usedOntologyEngineeringTool> "https://www.isibang.ac.in/ns/mod/index.html#Protege" ;
                            <http://purl.org/dc/terms/abstract> "Gelmat is an ontology for sol-gel materials. It extends the Polymat domain ontology with classes for sol-gel synthesis processes, gel characterisation methods, drying routes, laboratory equipment, process parameters, and material properties. It enables semantic description and formal documentation of sol-gel and aerogel research workflows, covering silica, organosilica, organic, carbon, and composite sol-gel derived materials." ;
                            <http://purl.org/dc/terms/author> "Antoni Dudij, Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ,
                                                              "Barbara Milow (https://orcid.org/0000-0002-6350-7728), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ,
                                                              "Prakul Pandit (https://orcid.org/0000-0002-1343-3046), Institute for Frontier Materials on Earth and in Space, German Aerospace Center (DLR), Cologne, Germany" ;
                            <http://purl.org/dc/terms/bibliographicCitation> "Pandit, P., Dudij, A., & Milow, B. (2026). Gelmat: An Ontology for Sol-Gel Materials (Version 1.1.0). German Aerospace Center (DLR). https://w3id.org/gelmat/" ;
                            <http://purl.org/dc/terms/created> "2026-03-12"^^xsd:date ;
                            <http://purl.org/dc/terms/license> <https://spdx.org/licenses/CC-BY-NC-4.0.html> ;
                            <http://purl.org/dc/terms/modified> "2026-09-14"^^xsd:date ;
                            <http://purl.org/dc/terms/title> "Gelmat: An Ontology for Sol-Gel Materials" ;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "gmat" ;
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/gelmat/" ;
                            rdfs:comment "Gelmat is an ontology for sol-gel materials. It extends the Polymat ontology (Dembska, Held, Schindler; DLR/Hereon) with classes for sol-gel synthesis routes, gel types, surface modification, drying methods, characterisation methods, process parameters, and material properties. Covers all major sol-gel derived material classes including silica, organosilica, organic, carbon, and composite aerogels." ;
                            rdfs:label "Gelmat" ;
                            owl:versionInfo "1.1.0" .

