                                               rdfs:subClassOf <https://w3id.org/polymat/DataRepository> ;
                                               rdfs:comment "A storage device connected to a dedicated server that is used to host/manage digital data"@en ;
                                               rdfs:label "Personal server drive"@en .


###  https://w3id.org/polymat/PhysicalData
<https://w3id.org/polymat/PhysicalData> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/polymat/DataType> ;
                                        rdfs:comment "Data in the form of physical objects, e.g. paper files"@en ;
                                        rdfs:label "Physical data"@en .


###  https://w3id.org/polymat/PhysicalLocation
<https://w3id.org/polymat/PhysicalLocation> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/polymat/Location> ;
                                            rdfs:comment "A physical structure (e.g. building) or space (e.g. room) or place (e.g. geographical location)"@en ;
                                            rdfs:label "Physical location"@en .


###  https://w3id.org/polymat/Plastic
<https://w3id.org/polymat/Plastic> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/polymat/Polymer> ;
                                   rdfs:comment """A synthetic or semi-synthetic material that use polymers as a main ingredient;  due to plasticity, it can be molded, extruded or pressed into solid objects of various shapes.
(https://en.wikipedia.org/wiki/Plastic)"""@en ;
                                   rdfs:label "Plastic"@en .


###  https://w3id.org/polymat/Polyaddition
<https://w3id.org/polymat/Polyaddition> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/polymat/PolymerSynthesis> ;
                                        rdfs:comment """An all-degree polymerisation that proceeds by addition reactions
(http://purl.obolibrary.org/obo/MOP_0000643)

A polymerisation in which the growth of polymer chains proceeds by addition reactions between molecules of all degrees of polymerisation
(http://purl.obolibrary.org/obo/REX_0000266)"""@en ;
                                        rdfs:label "Polyaddition"@en .


###  https://w3id.org/polymat/Polycondensation
<https://w3id.org/polymat/Polycondensation> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/polymat/PolymerSynthesis> ;
                                            rdfs:comment """An all-degree polymerisation that proceeds by condensation reactions
(http://purl.obolibrary.org/obo/MOP_0000644)

Polymerization by a repeated condensation process
(http://purl.obolibrary.org/obo/REX_0000252)

Formation of a polymer by chemical condensation with the elimination of small molecules, e.g. water
(https://www.dictionary.com/browse/polycondensation)"""@en ;
                                            rdfs:label "Polycondensation"@en .


###  https://w3id.org/polymat/Polymer
<https://w3id.org/polymat/Polymer> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                   rdfs:comment "A material made of long, macromolecular chains of repeating molecular units"@en ,
                                                """A mixture, which is composed of macromolecules of different kinds and which may be differentiated by composition, length, degree of branching etc.
(http://purl.obolibrary.org/obo/CHEBI_60027)"""@en ,
                                                """A molecule composed of a connected set of monomeric residues
(http://semanticscience.org/resource/SIO_000314)"""@en ,
                                                """A substance or material consisting of very large molecules, or macromolecules, composed of many repeating subunits
(http://purl.obolibrary.org/obo/PROCO_0000054)"""@en ;
                                   rdfs:label "Polymer"@en .


###  https://w3id.org/polymat/PolymerBlend
<https://w3id.org/polymat/PolymerBlend> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/polymat/Polymer> ;
                                        rdfs:comment """A macroscopically homogeneous mixture of two or more polymers (homopolymers or copolymers) that have been blended together to create a new material with different physical properties
(https://www.mdpi.com/journal/materials/special_issues/polymer_blend)"""@en ;
                                        rdfs:label "Polymer blend"@en .


###  https://w3id.org/polymat/PolymerSynthesis
<https://w3id.org/polymat/PolymerSynthesis> rdf:type owl:Class ;
                                            rdfs:subClassOf :CreationProcess ;
                                            rdfs:comment """A chemical reaction in which monomers are joined together by covalent bonding to form polymer structures
(https://www.sigmaaldrich.com/DE/en/applications/materials-science-and-engineering/polymer-synthesis)"""@en ;
                                            rdfs:label "Polymer synthesis"@en ;
                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Polymerisation"@en .


###  https://w3id.org/polymat/PressureIncrease
<https://w3id.org/polymat/PressureIncrease> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/polymat/MembranePerformanceForGases> ;
                                            rdfs:comment """Measuring the time until reaching a  certain permeate pressure during a gas permeability measurement on a membrane. For a single experiment, the feed pressure is set at the beginning and decreases over time due to permeatation.
(https://doi.org/10.3390/membranes9020022)"""@en ;
                                            rdfs:label "Pressure increase"@en .


###  https://w3id.org/polymat/Procedure
<https://w3id.org/polymat/Procedure> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ,
                                                     <http://www.w3.org/ns/prov#Entity> ;
                                     rdfs:comment "An executed procedure consisting of a set of activities carried out as the accepted way of doing something. This class denotes the occurrent that unfolds in time, not the recipe/plan that prescribes it — for the latter, see gmat:SynthesisProtocol. Axioms deliberately match Polymat 1.1.0 (BFO occurrent + prov:Entity) so that resolving the owl:imports of Polymat does not introduce conflicting redeclarations. Note: Procedure is placed under BFO occurrent (BFO_0000003) rather than BFO process (BFO_0000015) because Polymat maps BFO_0000015 to prov:Activity, which PROV-O declares disjoint from prov:Entity."@en ;
                                     rdfs:label "Procedure"@en .


###  https://w3id.org/polymat/ProcessedData
<https://w3id.org/polymat/ProcessedData> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/polymat/DataType> ;
                                         rdfs:comment "Data derived from raw data through various transformations, calculations, filtering or other operations"@en ;
                                         rdfs:label "Processed data"@en .


