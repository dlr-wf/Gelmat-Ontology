###  https://w3id.org/gelmat/hasCanonicalUnit
:hasCanonicalUnit rdf:type owl:AnnotationProperty ;
                  rdfs:label "has canonical unit"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Links a quantity class to the canonical (recommended) OM-2 unit of measure in which instances of that quantity are conventionally expressed. Machine-readable counterpart to the unit named in the class definition."@en ;
                  rdfs:range <http://www.ontology-of-units-of-measure.org/resource/om-2/Unit> .


###  https://w3id.org/gelmat/hasStepOrder
:hasStepOrder rdf:type owl:AnnotationProperty ;
              rdfs:label "has step order"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "An integer indicating the canonical execution order of a sub-process within a synthesis workflow (1 = first step). Used to provide SPARQL-queryable ordering of BFO parthood sub-steps that are otherwise unordered."@en ;
              rdfs:range xsd:positiveInteger .


